---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, resume, nature, statut, domaines, annee } = projet.data;
const meta = [nature, statut, annee].filter(Boolean).join(' · ');
---

<a class="carte" href={`/projets/${projet.id}`}>
  <div class="carte-entete">
    {meta && <span class="etiquette">{meta}</span>}
    {domaines && domaines.length > 0 && (
      <div class="domaines">
        {domaines.map((d) => (
          <span class="domaine-tag">{d}</span>
        ))}
      </div>
    )}
  </div>
  <h3>{titre}</h3>
  <p class="discret">{resume}</p>
</a>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 2rem 0;
    border-top: 1px solid var(--filet);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .carte:hover {
    border-top-color: var(--encre);
  }
  .carte-entete {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .domaines {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .domaine-tag {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--filet);
    color: var(--discret);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    transition: transform 0.2s ease;
  }
  p {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .carte:hover h3 {
    transform: translateX(0.35rem);
  }
</style>
