---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, resume, nature, statut, domaines, annee } = projet.data;
const meta = [nature, statut, annee].filter(Boolean).join(' · ');

const logoMap: Record<string, string> = {
  '127il': '/assets/logos/127il.svg',
  'fix-my-drone': '/assets/logos/fix-my-drone.svg',
  'inskin': '/assets/logos/inskin.png',
  'komeon': '/assets/logos/komeon.png',
  'lestourangeaux': '/assets/logos/lestourangeaux.svg',
  'multi-motors': '/assets/logos/multi-motors.png',
  'openbots': '/assets/logos/openbots.png',
  'pensee-nocturne': '/assets/logos/pensee-nocturne.svg',
  'superviseur': '/assets/logos/superviseur.svg',
  'tete-de-piaf': '/assets/logos/tdp.png',
  'tours2tours': '/assets/logos/tours2tours.png',
};

const logoUrl = logoMap[projet.id];
---

<a class="carte-seeworld" href={`/projets/${projet.id}`}>
  <span class="carte-ext">↗</span>

  <div class="carte-haut">
    {logoUrl && (
      <div class="carte-logo">
        <img src={logoUrl} alt={titre} loading="lazy" />
      </div>
    )}
    <div class="carte-titres">
      {meta && <span class="etiquette carte-meta">{meta}</span>}
      <h3 class="carte-nom">{titre}</h3>
    </div>
  </div>

  <p class="carte-desc">{resume}</p>

  {domaines && domaines.length > 0 && (
    <div class="carte-domaines">
      {domaines.map((d) => (
        <span class="domaine-pill">{d}</span>
      ))}
    </div>
  )}
</a>

<style>
  .carte-seeworld {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px 20px 18px;
    border: 2px dashed var(--dash);
    border-radius: 12px;
    background: var(--paper);
    text-decoration: none;
    position: relative;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s ease,
                border-style 0.2s ease,
                box-shadow 0.2s ease;
  }

  .carte-seeworld:hover {
    transform: translateY(-4px);
    border-style: solid;
    border-color: var(--ink);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .carte-ext {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 13px;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.35);
    transition: color 0.2s, transform 0.2s;
  }

  .carte-seeworld:hover .carte-ext {
    color: var(--ink);
    transform: translate(1px, -1px);
  }

  .carte-haut {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .carte-logo {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    padding: 4px;
    background: #fafafa;
  }

  .carte-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease;
  }

  .carte-seeworld:hover .carte-logo img {
    transform: scale(1.1);
  }

  .carte-titres {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .carte-meta {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.5);
  }

  .carte-nom {
    margin: 0;
    font: 700 16px/1.2 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .carte-desc {
    margin: 0 0 14px;
    font: 400 13px/1.55 var(--font);
    color: rgba(0, 0, 0, 0.8);
    letter-spacing: 0.02em;
    flex: 1;
  }

  .carte-domaines {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 10px;
    border-top: 2px dashed rgba(0, 0, 0, 0.2);
  }

  .domaine-pill {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border: 1px dashed var(--dash);
    border-radius: 11px;
    font: 700 9px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
    background: #fafafa;
  }
</style>
