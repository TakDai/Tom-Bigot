---
import '../styles/global.css';

interface Props {
  titre?: string;
  description?: string;
  sansNav?: boolean;
}

const {
  titre,
  description = 'Tom Bigot — Développeur, créateur technique & ingénieur systèmes. Portfolio et blog technique.',
  sansNav = false,
} = Astro.props;

const titreComplet = titre ? `${titre} — Tom Bigot` : 'TOM BIGOT — Portfolio & Blog';
const chemin = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(chemin, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Flux RSS de Tom Bigot" href="/rss.xml" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(chemin, Astro.site)} />
    <meta property="og:image" content="https://tom-bigot.fr/assets/tom-bigot-full.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://tom-bigot.fr/assets/tom-bigot-full.jpg" />
    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Tom Bigot",
      "url": "https://tom-bigot.fr",
      "jobTitle": "Développeur, Opérateur Projectionniste & Pilote Drone FPV",
      "sameAs": ["https://github.com/TakDai"],
      "knowsAbout": [
        "Software Engineering",
        "Cinéma Numérique DCI",
        "Ingestion DCP & KDM",
        "Drone FPV",
        "Systèmes Embarqués",
        "Sécurité & Web"
      ]
    })} />
  </head>
  <body>
    <!-- Lien d'évitement accessibilité WCAG -->
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <!-- ================= CONTENU ================= -->
    <main class="page-main" id="main-content">
      <slot />
    </main>

    <!-- ================= PIED DE PAGE ================= -->
    <footer class="foot">
      <div class="foot-brand">
        <svg class="foot-logo" viewBox="0 0 100 100" width="20" height="20" fill="none" aria-hidden="true">
          <path fill="currentColor" fill-rule="evenodd" d="M 12,18 L 84,18 C 86,18 88,20 88,22 L 88,26 C 88,28 86,30 84,30 L 56,30 L 56,34 C 68,34 78,39 78,50 C 78,57 73,62 66,64 C 74,66 80,72 80,80 C 80,90 70,96 56,96 L 26,96 C 24,96 24,94 24,92 L 24,30 L 14,30 C 12,30 12,28 12,26 Z M 36,42 L 54,42 C 62,42 66,44 66,50 C 66,56 62,58 54,58 L 36,58 Z M 36,68 L 54,68 C 63,68 68,71 68,80 C 68,87 63,88 54,88 L 36,88 Z" />
        </svg>
        <span class="brand-nom">TOM BIGOT</span>
        <span class="foot-sep">&bull;</span>
        <span>Portfolio</span>
        <span class="foot-sep">&bull;</span>
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
      <div class="foot-links">
        <a href="/#projets">Projets</a>
        <span class="foot-sep">&bull;</span>
        <a href="/#actualites">Actualités</a>
        <span class="foot-sep">&bull;</span>
        <a href="/#services">Services</a>
        <span class="foot-sep">&bull;</span>
        <a href="/#agenda">Agenda</a>
        <span class="foot-sep">&bull;</span>
        <a href="https://github.com/TakDai" target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="foot-sep">&bull;</span>
        <a href="mailto:contact@tom-bigot.fr">contact@tom-bigot.fr</a>
        <span class="foot-sep">&bull;</span>
        <a href="/mentions-legales">Mentions</a>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ---------- ACCESSIBILITÉ ---------- */
  .skip-link {
    position: absolute;
    top: -999px;
    left: 16px;
    background: #000000;
    color: #ffffff;
    padding: 10px 18px;
    font: 700 12px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 9999;
    border: 2px solid #ffffff;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 16px;
  }

  /* ---------- EN-TÊTE ---------- */
  .topnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 clamp(16px, 3vw, 36px);
    border-bottom: 2px dashed var(--dash);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .site-logo-icon {
    width: 14px;
    height: 14px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--ink);
    display: inline-block;
  }

  .site-logo-img {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: inline-block;
    flex-shrink: 0;
  }

  .site-name {
    font: 700 17px/1 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .nav-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .page-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ---------- PIED DE PAGE ---------- */
  .foot {
    border-top: 2px dashed var(--dash);
    padding: 18px clamp(16px, 3vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font: 700 11px var(--font);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    background: var(--paper);
  }

  .foot-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-nom {
    color: var(--ink);
  }

  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
  }

  .foot-logo {
    width: 20px;
    height: 20px;
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .foot-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .foot-sep {
    opacity: 0.35;
  }

  .foot a {
    color: var(--ink);
    transition: opacity 0.2s;
  }

  .foot a:hover {
    opacity: 0.6;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .topnav {
      height: auto;
      padding: 12px 16px;
      flex-direction: column;
      gap: 10px;
    }
    .foot {
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }
  }
</style>
