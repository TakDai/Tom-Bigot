---
import '../styles/global.css';

interface Props {
  titre?: string;
  description?: string;
}

const {
  titre,
  description = 'Tom Bigot — Développeur, créateur technique & projets de l’écosystème seeworld.',
} = Astro.props;

const titreComplet = titre ? `${titre} — Tom Bigot` : 'TOM BIGOT — SEEWORLD';
const chemin = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(chemin, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(chemin, Astro.site)} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <!-- ================= EN-TÊTE (Style Officiel SEEWORLD) ================= -->
    <nav class="topnav" aria-label="Navigation principale">
      <a class="site-logo" href="/" aria-label="Tom Bigot — Accueil">
        <img src="/assets/logo-seeworld.svg" alt="SEEWORLD" width="32" height="32" />
        <span class="site-name">TOM BIGOT</span>
      </a>
      <div class="nav-group">
        <a class={`nav-pill ${chemin === '/' ? 'active' : ''}`} href="/#competences">Compétences</a>
        <a class={`nav-pill ${chemin.startsWith('/projets') ? 'active' : ''}`} href="/#projets">Projets</a>
        <a class={`nav-pill ${chemin === '/a-propos' ? 'active' : ''}`} href="/a-propos">À propos</a>
        <a class={`nav-pill ${chemin === '/contact' ? 'active' : ''}`} href="/contact">Contact</a>
      </div>
    </nav>

    <!-- ================= CONTENU ================= -->
    <main class="page-main">
      <slot />
    </main>

    <!-- ================= PIED DE PAGE ================= -->
    <footer class="foot">
      <div class="foot-brand">
        <span class="brand-nom">TOM BIGOT</span>
        <span class="foot-sep">&bull;</span>
        <a href="https://seeworld.fr" target="_blank" rel="noopener">SEEWORLD</a>
        <span class="foot-sep">&bull;</span>
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
      <div class="foot-links">
        <a href="https://github.com/TakDai" target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="foot-sep">&bull;</span>
        <a href="/contact">Contact</a>
        <span class="foot-sep">&bull;</span>
        <a href="/mentions-legales">Mentions</a>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ---------- EN-TÊTE (Strictement inspiré de seeworld.fr) ---------- */
  .topnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 clamp(16px, 3vw, 36px);
    border-bottom: 2px dashed var(--dash);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .site-logo img {
    width: 32px;
    height: 32px;
    display: block;
  }

  .site-name {
    font: 700 17px/1 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .nav-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .page-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ---------- PIED DE PAGE ---------- */
  .foot {
    border-top: 2px dashed var(--dash);
    padding: 18px clamp(16px, 3vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font: 700 11px var(--font);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    background: var(--paper);
  }

  .foot-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-nom {
    color: var(--ink);
  }

  .foot-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .foot-sep {
    opacity: 0.35;
  }

  .foot a {
    color: var(--ink);
    transition: opacity 0.2s;
  }

  .foot a:hover {
    opacity: 0.6;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .topnav {
      height: auto;
      padding: 12px 16px;
      flex-direction: column;
      gap: 10px;
    }
    .foot {
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }
  }
</style>
