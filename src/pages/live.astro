---
import Base from '../layouts/Base.astro';

const TWITCH_CHANNEL = '127il';
// URL par défaut du flux HLS distribué par le VPS (MediaMTX / Nginx)
const DEFAULT_HLS_URL = 'https://live.tom-bigot.fr/stream/live/index.m3u8';
---

<Base
  titre="Live & Régie Directe — 127IL"
  description="Lecteur vidéo autonome et sortie de flux directe de Tom Bigot (127IL). Transmission en temps réel depuis OBS relayée vers Twitch et le web."
>
  <main class="live-screen">
    <!-- En-tête de la page avec statut et raccourcis -->
    <header class="live-header">
      <div class="header-topline">
        <div class="live-breadcrumb">
          <a href="/" class="back-link">
            <span class="back-arrow">&larr;</span>
            <span>Retour au portfolio</span>
          </a>
          <span class="breadcrumb-sep">&bull;</span>
          <span class="breadcrumb-tag">127IL &bull; LECTEUR AUTONOME &amp; RELAIS TWITCH</span>
        </div>

        <div class="live-status-pill" id="liveStatusBadge">
          <span class="status-dot" id="statusDot"></span>
          <span class="status-text" id="statusText">EN ATTENTE DE FLUX</span>
        </div>
      </div>

      <div class="header-main-info">
        <div class="title-zone">
          <h1 class="page-title">SORTIE FLUX DIRECTE &bull; 127IL</h1>
          <p class="page-subtitle">
            Lecteur vidéo propriétaire haute fidélité : flux vidéo injecté depuis OBS vers le VPS, redistribué ici en direct et retransmis simultanément vers Twitch.
          </p>
        </div>

        <!-- Outils régie & affichage -->
        <div class="stream-toolbar">
          <button type="button" class="tool-btn" id="btnCinemaMode" title="Agrandir le lecteur">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M7 15h10" />
            </svg>
            <span>Mode Cinéma</span>
          </button>

          <button type="button" class="tool-btn" id="btnToggleChat" title="Afficher ou masquer le chat">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            <span id="chatToggleLabel">Masquer le Chat</span>
          </button>

          <button type="button" class="tool-btn" id="btnConfigStream" title="Configurer l'adresse du flux VPS">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            <span>Source VPS</span>
          </button>

          <a href="https://stream.tom-bigot.fr/admin/" target="_blank" rel="noopener noreferrer" class="tool-btn" title="Console d'Administration Régie">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            <span>Régie Studio</span>
          </a>

          <a href={`https://twitch.tv/${TWITCH_CHANNEL}`} target="_blank" rel="noopener noreferrer" class="tool-btn tool-btn-twitch" title="Voir aussi sur Twitch">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
            </svg>
            <span>Sur Twitch</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Zone principale : Lecteur Propriétaire + Chat Twitch -->
    <section class="live-stage-container" id="liveStage">
      <!-- Zone Lecteur Vidéo Propriétaire -->
      <div class="player-wrapper" id="playerWrapper">
        <div class="video-container" id="videoContainer">
          <!-- Élément vidéo HTML5 autonome -->
          <video
            id="liveVideo"
            playsinline
            autoplay
            muted
            preload="auto"
            poster="/assets/live-poster.svg"
          ></video>

          <!-- Écran de veille / Standby hors ligne -->
          <div class="player-standby-overlay" id="standbyOverlay">
            <div class="standby-box">
              <div class="standby-radar">
                <span class="radar-circle"></span>
                <span class="radar-dot"></span>
              </div>
              <h3 class="standby-title">EN ATTENTE DE DIFFUSION OBS</h3>
              <p class="standby-desc">
                Le lecteur est connecté à votre relais VPS. Dès que vous lancez la transmission dans OBS, la vidéo démarre immédiatement et est relayée vers Twitch.
              </p>
              <div class="standby-actions">
                <button type="button" class="btn-standby-reload" id="btnManualCheck">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                  </svg>
                  <span>Rechercher le flux</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Contrôles personnalisés du lecteur (Glacial / seeworld style) -->
          <div class="custom-controls" id="customControls">
            <div class="controls-left">
              <button type="button" class="ctrl-btn" id="btnPlayPause" title="Lecture / Pause">
                <svg id="iconPlay" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                <svg id="iconPause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display:none;">
                  <rect x="6" y="4" width="4" height="16"/>
                  <rect x="14" y="4" width="4" height="16"/>
                </svg>
              </button>

              <div class="live-badge-inline" id="ctrlLiveBadge">
                <span class="live-dot"></span>
                <span>DIRECT</span>
              </div>

              <div class="volume-box">
                <button type="button" class="ctrl-btn" id="btnMute" title="Activer / Couper le son">
                  <svg id="iconVolumeHigh" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                  </svg>
                  <svg id="iconVolumeMuted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <line x1="23" y1="9" x2="17" y2="15"/>
                    <line x1="17" y1="9" x2="23" y2="15"/>
                  </svg>
                </button>
                <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="0.8" class="vol-slider" title="Volume" />
              </div>
            </div>

            <div class="controls-right">
              <span class="latency-tag" id="latencyIndicator">LATENCE : &mdash;</span>

              <button type="button" class="ctrl-btn" id="btnPip" title="Picture in Picture">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <rect x="12" y="12" width="8" height="6" rx="1"/>
                </svg>
              </button>

              <button type="button" class="ctrl-btn" id="btnFullscreen" title="Plein écran">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Barre d'information sous le lecteur -->
        <div class="player-meta-bar">
          <div class="channel-info">
            <div class="channel-avatar">
              <svg viewBox="0 0 100 100" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="18,34 50,18 82,34 50,50" stroke-width="6" />
                <line x1="50" y1="50" x2="50" y2="88" stroke-width="6.5" />
                <path d="M 50,50 L 74,38 C 84,33 86,45 78,54 L 50,68" stroke-width="6" />
                <path d="M 50,68 L 76,55 C 86,50 88,65 76,75 L 50,88" stroke-width="6" />
              </svg>
            </div>
            <div class="channel-details">
              <div class="channel-name-row">
                <span class="channel-title">127IL &bull; Tom Bigot</span>
                <span class="badge-tag">FLUX DIRECT PROPRIÉTAIRE</span>
              </div>
              <p class="channel-description">
                Diffusion directe depuis votre station de travail &bull; Monitoring audio ASIO &amp; Live Coding.
              </p>
            </div>
          </div>

          <div class="stream-routing-info">
            <span class="relay-pill">
              <span class="relay-dot"></span>
              <span>Relais Twitch : Actif</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Zone Chat du Live Propre (127IL Native Live Chat) -->
      <aside class="chat-wrapper" id="chatWrapper">
        <div class="chat-header">
          <div class="chat-header-title">
            <span class="chat-indicator"></span>
            <span>CHAT DU DIRECT</span>
            <span class="chat-viewers-count" id="chatViewersBadge">&bull; 1 EN LIGNE</span>
          </div>
          <div class="chat-header-actions">
            <button type="button" class="chat-pseudo-btn" id="btnChangePseudo" title="Changer votre pseudo">
              <span id="displayPseudoLabel">VISITEUR</span> ✏️
            </button>
            <button type="button" class="chat-close-btn" id="btnCloseChat" title="Fermer le chat">
              &times;
            </button>
          </div>
        </div>

        <!-- Liste des messages du direct -->
        <div class="chat-messages-container" id="chatMessagesList">
          <div class="chat-system-msg">
            BIENVENUE SUR LE DIRECT 127IL ! CHAT EN TEMPS RÉEL SOUVERAIN ET SANS TRACKER. RESPECTEZ LA COURTOISIE.
          </div>
        </div>

        <!-- Formulaire d'envoi de message -->
        <form class="chat-form" id="chatForm">
          <div class="chat-input-row">
            <input
              type="text"
              id="chatInputMessage"
              class="chat-text-input"
              placeholder="Envoyer un message au direct..."
              maxlength="350"
              autocomplete="off"
              required
            />
            <button type="submit" class="chat-send-btn" id="btnSendChat">
              <span>ENVOYER</span>
            </button>
          </div>
          <div class="chat-status-bar" id="chatStatusBar" style="display:none;">
            <span id="chatStatusText"></span>
          </div>
        </form>
      </aside>
    </section>

    <!-- Panneau de réglage de la source VPS -->
    <div class="source-config-modal" id="configModal" style="display: none;">
      <div class="modal-card">
        <div class="modal-head">
          <h3>CONFIGURATION DE LA SOURCE FLUX (VPS)</h3>
          <button type="button" class="close-card-btn" id="btnCloseConfig">&times;</button>
        </div>
        <p class="modal-desc">
          Indiquez l'URL HTTP(S) du fichier <code>.m3u8</code> généré par votre serveur MediaMTX / Nginx sur votre VPS :
        </p>
        <div class="input-action-row">
          <input
            type="url"
            id="inputHlsUrl"
            value={DEFAULT_HLS_URL}
            placeholder="https://live.tom-bigot.fr/stream/live/index.m3u8"
            class="text-input"
          />
          <button type="button" class="btn-action" id="btnSaveHlsUrl">Connecter</button>
          <button type="button" class="btn-action btn-secondary" id="btnResetHlsUrl">Réinitialiser</button>
        </div>
        <small class="modal-hint">
          Cette URL est mémorisée localement dans votre navigateur pour vos prochains lancements.
        </small>
      </div>
    </div>

    <!-- Section Architecture Système & Régie VPS -->
    <section class="live-grid-info">
      <!-- 01. Architecture du Pipeline -->
      <article class="info-card">
        <div class="card-tag">01 &bull; ARCHITECTURE TECHNIQUE</div>
        <h2 class="card-title">COMMENT LE FLUX CIRCULE</h2>
        <p>
          Ce lecteur n'est pas une simple intégration vidéo : il est relié directement à votre serveur d'ingestion personnel pour une indépendance totale.
        </p>

        <div class="pipeline-flow">
          <div class="pipe-step">
            <span class="step-num">1</span>
            <div class="step-content">
              <h4>OBS Studio (Votre PC)</h4>
              <p>Encode le flux vidéo (NVENC 1080p60) et l'audio studio ASIO, puis l'envoie en RTMP/SRT à votre VPS.</p>
            </div>
          </div>

          <div class="pipe-step">
            <span class="step-num">2</span>
            <div class="step-content">
              <h4>Votre VPS (MediaMTX)</h4>
              <p>Reçoit le flux. D'un côté, il découpe le direct en HLS pour ce lecteur web. De l'autre, il pousse le flux brut à Twitch.</p>
            </div>
          </div>

          <div class="pipe-step">
            <span class="step-num">3</span>
            <div class="step-content">
              <h4>Double Sortie Simultanée</h4>
              <p>Ce lecteur web affiche votre flux en basse latence, tandis que votre chaîne <strong>twitch.tv/127il</strong> est alimentée en temps réel.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- 02. Configuration dans OBS -->
      <article class="info-card">
        <div class="card-tag">02 &bull; CONFIGURATION OBS STUDIO</div>
        <h2 class="card-title">PARAMÉTRER VOTRE SORTIE OBS</h2>
        <p>
          Dans les paramètres d'OBS Studio, configurez votre sortie vers votre VPS :
        </p>

        <div class="settings-specs">
          <div class="spec-row">
            <span class="spec-label">Service :</span>
            <code>Personnalisé...</code>
          </div>
          <div class="spec-row">
            <span class="spec-label">Serveur RTMP :</span>
            <code>rtmp://&lt;IP_DE_VOTRE_VPS&gt;:1935/live</code>
          </div>
          <div class="spec-row">
            <span class="spec-label">Ou Serveur SRT (Ultra-rapide) :</span>
            <code>srt://&lt;IP_DE_VOTRE_VPS&gt;:8890?streamid=publish:live</code>
          </div>
          <div class="spec-row">
            <span class="spec-label">Clé de stream :</span>
            <code>direct</code>
          </div>
        </div>

        <div class="obs-settings-pill">
          <strong>Relais Twitch :</strong> Votre clé Twitch <code>live_...</code> est renseignée une seule fois sur le VPS dans le fichier <code>.env</code>. Dès que vous cliquez sur <em>Démarrer le streaming</em> dans OBS, le direct part vers le VPS et vers Twitch instantanément !
        </div>
      </article>

      <!-- 03. Déploiement sur votre VPS -->
      <article class="info-card">
        <div class="card-tag">03 &bull; DÉPLOIEMENT DU SERVEUR VPS</div>
        <h2 class="card-title">VOTRE RELAIS EN 1 COMMANDE</h2>
        <p>
          Les fichiers complets (Docker Compose, MediaMTX et script de relais) sont disponibles dans le projet <code>127il</code> :
        </p>

        <div class="commands-box">
          <pre><code># 1. Cloner ou déposer les fichiers sur votre VPS
cd ~/127il

# 2. Configurer votre clé de stream Twitch
cp .env.example .env
nano .env  # TWITCH_STREAM_KEY=live_...

# 3. Lancer la régie de diffusion
docker compose up -d</code></pre>
        </div>

        <div class="ecosystem-links">
          <a href="/projets/127il" class="eco-link">Fiche technique 127IL &rarr;</a>
          <a href="https://github.com/TakDai/127il" target="_blank" rel="noopener noreferrer" class="eco-link">Dépôt GitHub 127il &rarr;</a>
          <a href="https://twitch.tv/127il" target="_blank" rel="noopener noreferrer" class="eco-link">Chaîne Twitch 127IL &rarr;</a>
        </div>
      </article>
    </section>
  </main>
</Base>

<!-- Chargement local de hls.js pour une autonomie totale sans dépendance externe -->
<script is:inline src="/assets/hls.min.js"></script>

<script is:inline>
  (function () {
    const video = document.getElementById('liveVideo');
    const standbyOverlay = document.getElementById('standbyOverlay');
    const statusText = document.getElementById('statusText');
    const statusDot = document.getElementById('statusDot');
    const latencyIndicator = document.getElementById('latencyIndicator');
    const btnPlayPause = document.getElementById('btnPlayPause');
    const iconPlay = document.getElementById('iconPlay');
    const iconPause = document.getElementById('iconPause');
    const btnMute = document.getElementById('btnMute');
    const iconVolumeHigh = document.getElementById('iconVolumeHigh');
    const iconVolumeMuted = document.getElementById('iconVolumeMuted');
    const volumeSlider = document.getElementById('volumeSlider');
    const btnFullscreen = document.getElementById('btnFullscreen');
    const btnPip = document.getElementById('btnPip');
    const playerWrapper = document.getElementById('playerWrapper');
    const stage = document.getElementById('liveStage');
    const btnCinema = document.getElementById('btnCinemaMode');
    const btnToggleChat = document.getElementById('btnToggleChat');
    const btnCloseChat = document.getElementById('btnCloseChat');
    const chatWrapper = document.getElementById('chatWrapper');
    const chatLabel = document.getElementById('chatToggleLabel');
    const btnConfigStream = document.getElementById('btnConfigStream');
    const configModal = document.getElementById('configModal');
    const btnCloseConfig = document.getElementById('btnCloseConfig');
    const inputHlsUrl = document.getElementById('inputHlsUrl');
    const btnSaveHlsUrl = document.getElementById('btnSaveHlsUrl');
    const btnResetHlsUrl = document.getElementById('btnResetHlsUrl');
    const btnManualCheck = document.getElementById('btnManualCheck');

    // Récupération de l'URL du flux enregistrée
    const savedHlsUrl = localStorage.getItem('127il_hls_url') || inputHlsUrl.value.trim();
    if (inputHlsUrl) inputHlsUrl.value = savedHlsUrl;

    const streamFallbackUrls = [
      savedHlsUrl,
      'https://stream.tom-bigot.fr/live/tom/tom/index.m3u8',
      'https://stream.tom-bigot.fr/live/tom/index.m3u8'
    ];
    let fallbackIdx = 0;

    let hlsInstance = null;
    let isLiveActive = false;
    let pollInterval = null;

    function setLiveState(isOnline) {
      isLiveActive = isOnline;
      if (isOnline) {
        if (standbyOverlay) standbyOverlay.style.display = 'none';
        if (statusText) statusText.textContent = 'EN DIRECT (127IL)';
        if (statusDot) statusDot.classList.add('live-on');
      } else {
        if (standbyOverlay) standbyOverlay.style.display = 'flex';
        if (statusText) statusText.textContent = 'EN ATTENTE DE FLUX';
        if (statusDot) statusDot.classList.remove('live-on');
        if (latencyIndicator) latencyIndicator.textContent = 'LATENCE : —';
      }
    }

    function initHlsStream(streamUrl) {
      if (!video) return;

      if (hlsInstance) {
        hlsInstance.destroy();
        hlsInstance = null;
      }

      if (window.Hls && window.Hls.isSupported()) {
        const hls = new window.Hls({
          enableWorker: true,
          lowLatencyMode: true,
          backBufferLength: 30,
          liveSyncDurationCount: 2,
          liveMaxLatencyDurationCount: 4,
          maxLiveSyncPlaybackRate: 1.15,
        });

        hls.loadSource(streamUrl);
        hls.attachMedia(video);

        hls.on(window.Hls.Events.MANIFEST_PARSED, function () {
          setLiveState(true);
          video.play().catch(function () {
            // Autoplay avec son potentiellement bloqué par le navigateur
            video.muted = true;
            updateVolumeIcons();
            video.play();
          });
        });

        hls.on(window.Hls.Events.LEVEL_UPDATED, function (event, data) {
          if (data && data.details && data.details.live) {
            setLiveState(true);
            if (hls.latency !== undefined && latencyIndicator) {
              latencyIndicator.textContent = 'LATENCE : ' + hls.latency.toFixed(1) + 's';
            }
          }
        });

        hls.on(window.Hls.Events.ERROR, function (event, data) {
          if (data.fatal) {
            setLiveState(false);
            switch (data.type) {
              case window.Hls.ErrorTypes.NETWORK_ERROR:
                // Basculer sur l'URL candidate alternative en cas d'erreur 404
                fallbackIdx = (fallbackIdx + 1) % streamFallbackUrls.length;
                setTimeout(function () {
                  hls.loadSource(streamFallbackUrls[fallbackIdx]);
                }, 2000);
                break;
              case window.Hls.ErrorTypes.MEDIA_ERROR:
                hls.recoverMediaError();
                break;
              default:
                hls.destroy();
                break;
            }
          }
        });

        hlsInstance = hls;
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        // Fallback Safari / iOS
        video.src = streamUrl;
        video.addEventListener('loadedmetadata', function () {
          setLiveState(true);
          video.play();
        });
        video.addEventListener('error', function () {
          setLiveState(false);
        });
      }
    }

    // Lancer la détection du flux
    initHlsStream(savedHlsUrl);

    // Recheck régulier si hors ligne
    pollInterval = setInterval(function () {
      if (!isLiveActive && hlsInstance) {
        hlsInstance.loadSource(savedHlsUrl);
      }
    }, 5000);

    if (btnManualCheck) {
      btnManualCheck.addEventListener('click', function () {
        initHlsStream(inputHlsUrl.value.trim());
      });
    }

    // Play / Pause
    if (btnPlayPause && video) {
      btnPlayPause.addEventListener('click', function () {
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      });

      video.addEventListener('play', function () {
        if (iconPlay) iconPlay.style.display = 'none';
        if (iconPause) iconPause.style.display = 'block';
      });

      video.addEventListener('pause', function () {
        if (iconPlay) iconPlay.style.display = 'block';
        if (iconPause) iconPause.style.display = 'none';
      });
    }

    // Gestion du volume et coupure son
    function updateVolumeIcons() {
      if (!iconVolumeHigh || !iconVolumeMuted || !video) return;
      if (video.muted || video.volume === 0) {
        iconVolumeHigh.style.display = 'none';
        iconVolumeMuted.style.display = 'block';
      } else {
        iconVolumeHigh.style.display = 'block';
        iconVolumeMuted.style.display = 'none';
      }
    }

    if (btnMute && video) {
      btnMute.addEventListener('click', function () {
        video.muted = !video.muted;
        updateVolumeIcons();
      });
    }

    if (volumeSlider && video) {
      volumeSlider.addEventListener('input', function () {
        video.volume = parseFloat(this.value);
        video.muted = (video.volume === 0);
        updateVolumeIcons();
      });
    }

    // Plein écran
    if (btnFullscreen && playerWrapper) {
      btnFullscreen.addEventListener('click', function () {
        if (!document.fullscreenElement) {
          if (playerWrapper.requestFullscreen) {
            playerWrapper.requestFullscreen();
          } else if (playerWrapper.webkitRequestFullscreen) {
            playerWrapper.webkitRequestFullscreen();
          }
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen();
          }
        }
      });
    }

    // Picture in Picture
    if (btnPip && video && document.pictureInPictureEnabled) {
      btnPip.addEventListener('click', function () {
        if (document.pictureInPictureElement) {
          document.exitPictureInPicture();
        } else {
          video.requestPictureInPicture();
        }
      });
    } else if (btnPip) {
      btnPip.style.display = 'none';
    }

    // Mode Cinéma
    if (btnCinema && stage) {
      btnCinema.addEventListener('click', function () {
        stage.classList.toggle('cinema-mode');
        btnCinema.classList.toggle('active');
      });
    }

    // Toggle Chat
    function toggleChat(forceState) {
      if (!chatWrapper || !stage) return;
      const isHidden = chatWrapper.classList.contains('hidden');
      const shouldHide = forceState !== undefined ? !forceState : !isHidden;

      if (shouldHide) {
        chatWrapper.classList.add('hidden');
        stage.classList.add('no-chat');
        if (chatLabel) chatLabel.textContent = 'Afficher le Chat';
      } else {
        chatWrapper.classList.remove('hidden');
        stage.classList.remove('no-chat');
        if (chatLabel) chatLabel.textContent = 'Masquer le Chat';
      }
    }

    if (btnToggleChat) {
      btnToggleChat.addEventListener('click', function () {
        toggleChat();
      });
    }

    if (btnCloseChat) {
      btnCloseChat.addEventListener('click', function () {
        toggleChat(false);
      });
    }

    // Configuration Modal
    if (btnConfigStream && configModal) {
      btnConfigStream.addEventListener('click', function () {
        configModal.style.display = configModal.style.display === 'none' ? 'flex' : 'none';
      });
    }

    if (btnCloseConfig && configModal) {
      btnCloseConfig.addEventListener('click', function () {
        configModal.style.display = 'none';
      });
    }

    if (btnSaveHlsUrl && inputHlsUrl && configModal) {
      btnSaveHlsUrl.addEventListener('click', function () {
        const url = inputHlsUrl.value.trim();
        if (url) {
          localStorage.setItem('127il_hls_url', url);
          initHlsStream(url);
          configModal.style.display = 'none';
        }
      });
    }

    if (btnResetHlsUrl && inputHlsUrl && configModal) {
      btnResetHlsUrl.addEventListener('click', function () {
        inputHlsUrl.value = 'https://live.tom-bigot.fr/stream/live/index.m3u8';
        localStorage.removeItem('127il_hls_url');
        initHlsStream(inputHlsUrl.value);
        configModal.style.display = 'none';
      });
    }

    // ========================================================================
    // CHAT DU DIRECT 127IL AUTONOME (WEBSOCKET NATIF)
    // ========================================================================
    const chatMessagesList = document.getElementById('chatMessagesList');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInputMessage');
    const chatViewersBadge = document.getElementById('chatViewersBadge');
    const btnChangePseudo = document.getElementById('btnChangePseudo');
    const displayPseudoLabel = document.getElementById('displayPseudoLabel');
    const chatStatusBar = document.getElementById('chatStatusBar');
    const chatStatusText = document.getElementById('chatStatusText');

    // Gestion du pseudo utilisateur
    let myPseudo = localStorage.getItem('127il_chat_pseudo');
    if (!myPseudo) {
      myPseudo = 'Visiteur-' + Math.floor(1000 + Math.random() * 9000);
      localStorage.setItem('127il_chat_pseudo', myPseudo);
    }
    if (displayPseudoLabel) displayPseudoLabel.textContent = myPseudo.toUpperCase();

    if (btnChangePseudo) {
      btnChangePseudo.addEventListener('click', function () {
        const nouveau = prompt('Choisissez votre pseudo pour le direct (max 20 car.) :', myPseudo);
        if (nouveau && nouveau.trim().length > 0) {
          myPseudo = nouveau.trim().substring(0, 20);
          localStorage.setItem('127il_chat_pseudo', myPseudo);
          displayPseudoLabel.textContent = myPseudo.toUpperCase();
        }
      });
    }

    let chatWs = null;
    let wsReconnectTimer = null;

    function renderChatMessage(msg) {
      if (!chatMessagesList) return;
      const row = document.createElement('div');
      row.className = 'chat-message-row';
      row.dataset.msgId = msg.id;

      const timeSpan = `<span class="msg-time">${msg.time || msg.created_at?.slice(11,16) || ''}</span>`;
      let badgeHtml = '';
      if (msg.badge) {
        badgeHtml = `<span class="msg-badge badge-${msg.role || 'viewer'}">${msg.badge}</span>`;
      }
      const userColor = msg.color || '#ffffff';
      const userSpan = `<span class="msg-user" style="color: ${userColor};">${msg.username}</span>`;
      const contentSpan = `<span class="msg-content">${msg.content}</span>`;

      row.innerHTML = `${timeSpan} ${badgeHtml} ${userSpan}<span class="msg-sep">:</span> ${contentSpan}`;
      chatMessagesList.appendChild(row);

      // Auto-scroll vers le bas
      chatMessagesList.scrollTop = chatMessagesList.scrollHeight;
    }

    function initNativeChat() {
      if (wsReconnectTimer) clearTimeout(wsReconnectTimer);

      const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${wsProtocol}//${window.location.host}/chat-ws`;

      try {
        chatWs = new WebSocket(wsUrl);

        chatWs.onopen = function () {
          console.log('[127IL Chat] Connecté au serveur de chat.');
        };

        chatWs.onmessage = function (event) {
          try {
            const data = jsonParseSafe(event.data);
            if (!data) return;

            if (data.type === 'init') {
              if (chatMessagesList) {
                // Conserver message de bienvenue
                const welcome = chatMessagesList.querySelector('.chat-system-msg');
                chatMessagesList.innerHTML = '';
                if (welcome) chatMessagesList.appendChild(welcome);
              }
              if (Array.isArray(data.messages)) {
                data.messages.forEach(renderChatMessage);
              }
              if (chatViewersBadge && data.viewers !== undefined) {
                chatViewersBadge.textContent = `• ${data.viewers} EN LIGNE`;
              }
            } else if (data.type === 'message' && data.data) {
              renderChatMessage(data.data);
            } else if (data.type === 'viewers' && chatViewersBadge) {
              chatViewersBadge.textContent = `• ${data.count} EN LIGNE`;
            } else if (data.type === 'delete' && data.id) {
              const el = chatMessagesList.querySelector(`[data-msg-id="${data.id}"]`);
              if (el) el.remove();
            } else if (data.type === 'clear') {
              if (chatMessagesList) {
                const welcome = chatMessagesList.querySelector('.chat-system-msg');
                chatMessagesList.innerHTML = '';
                if (welcome) chatMessagesList.appendChild(welcome);
                const notice = document.createElement('div');
                notice.className = 'chat-system-msg';
                notice.textContent = 'LE CHAT A ÉTÉ RÉINITIALISÉ PAR LA RÉGIE.';
                chatMessagesList.appendChild(notice);
              }
            } else if (data.type === 'error' || data.type === 'system') {
              showChatNotice(data.error || data.content);
            }
          } catch (e) {
            console.error('[127IL Chat] Erreur payload :', e);
          }
        };

        chatWs.onclose = function () {
          console.warn('[127IL Chat] Connexion fermée. Reconnexion dans 3s...');
          wsReconnectTimer = setTimeout(initNativeChat, 3000);
        };

        chatWs.onerror = function () {
          try { chatWs.close(); } catch (e) {}
        };
      } catch (err) {
        wsReconnectTimer = setTimeout(initNativeChat, 3000);
      }
    }

    function jsonParseSafe(str) {
      try { return JSON.parse(str); } catch (e) { return null; }
    }

    function showChatNotice(text) {
      if (!chatStatusBar || !chatStatusText) return;
      chatStatusText.textContent = text;
      chatStatusBar.style.display = 'block';
      setTimeout(function () {
        chatStatusBar.style.display = 'none';
      }, 4000);
    }

    if (chatForm && chatInput) {
      chatForm.addEventListener('submit', function (e) {
        e.preventDefault();
        const text = chatInput.value.trim();
        if (!text) return;

        if (!chatWs || chatWs.readyState !== WebSocket.OPEN) {
          showChatNotice('Connexion au chat en cours...');
          return;
        }

        chatWs.send(JSON.stringify({
          action: 'message',
          username: myPseudo,
          content: text
        }));

        chatInput.value = '';
        chatInput.focus();
      });
    }

    initNativeChat();
  })();
</script>

