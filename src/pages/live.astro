---
// live.astro — Interface Directe Pure 127IL / Seeworld (Flux + Chat Uniquement)
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>127IL &bull; DIRECT EN LIGNE</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    /* ==========================================================================
       SEEWORLD / TOM-BIGOT.FR DESIGN SYSTEM — PURE STREAM & CHAT EXPERIENCE
       - Fond Noir Pur (#000000) & Blanc (#FFFFFF)
       - Typographie officielle : Glacial Indifference
       - Filets pointillés signatures : 2px dashed rgba(255, 255, 255, 0.4)
       - Pilules 15px radius, Cartes 12px radius
       - 100% de l'écran dédié au flux et au chat
       ========================================================================== */

    @font-face {
      font-family: "Glacial Indifference";
      font-weight: 400;
      font-style: normal;
      font-display: swap;
      src: url("/fonts/glacial-indifference-400.woff2") format("woff2");
    }

    @font-face {
      font-family: "Glacial Indifference";
      font-weight: 700;
      font-style: normal;
      font-display: swap;
      src: url("/fonts/glacial-indifference-700.woff2") format("woff2");
    }

    :root {
      --bg: #000000;
      --paper: #ffffff;
      --ink: #000000;
      --dash: rgba(255, 255, 255, 0.4);
      --dash-subtle: rgba(255, 255, 255, 0.2);
      --hover-bg: rgba(255, 255, 255, 0.12);
      --font: "Glacial Indifference", "Century Gothic", "Futura", "Trebuchet MS", sans-serif;
      --chat-width: 360px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100%;
      height: 100%;
      background: var(--bg);
      color: var(--paper);
      overflow: hidden;
      font-family: var(--font);
      -webkit-font-smoothing: antialiased;
      user-select: none;
    }

    /* Conteneur principal écran partagé */
    .app-viewport {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      overflow: hidden;
      background: #000000;
    }

    /* --------------------------------------------------------------------------
       ZONE FLUX VIDÉO
       -------------------------------------------------------------------------- */
    .video-zone {
      position: relative;
      flex: 1;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000000;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #liveVideo {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000000;
      cursor: pointer;
      transition: object-fit 0.2s ease;
    }
    #liveVideo.cover {
      object-fit: cover;
    }

    /* Vignette cinéma */
    .vignette {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 70%, rgba(0, 0, 0, 0.55) 100%);
      z-index: 2;
    }

    /* Barre HUD supérieure flottante */
    .stream-hud-top {
      position: absolute;
      top: 20px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 20;
      pointer-events: none;
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s ease;
    }
    .stream-hud-top > * { pointer-events: auto; }

    .seeworld-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 16px;
      border: 2px dashed var(--dash);
      border-radius: 15px;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--paper);
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .seeworld-pill:hover,
    .seeworld-pill.active {
      border-style: solid;
      border-color: var(--paper);
      background: rgba(255, 255, 255, 0.15);
      transform: translateY(-1px);
    }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #888;
      transition: all 0.3s ease;
    }
    .live-dot.live-on {
      background: #10b981;
      box-shadow: 0 0 10px #10b981;
    }

    .top-action-cluster {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Barre HUD inférieure flottante */
    .stream-hud-bottom {
      position: absolute;
      bottom: 20px;
      left: 20px;
      right: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 2px dashed var(--dash);
      border-radius: 15px;
      padding: 8px 16px;
      z-index: 20;
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s ease;
    }

    .hud-hidden {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translateY(12px) !important;
    }
    .stream-hud-top.hud-hidden {
      transform: translateY(-12px) !important;
    }

    .ctrl-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ctrl-btn {
      background: transparent;
      border: 1.5px solid transparent;
      color: var(--paper);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .ctrl-btn:hover {
      border-color: var(--paper);
      background: rgba(255, 255, 255, 0.1);
    }
    .ctrl-btn svg {
      width: 17px;
      height: 17px;
      fill: currentColor;
    }

    /* Volume */
    .vol-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 60px;
      height: 3px;
      background: rgba(255, 255, 255, 0.3);
      outline: none;
      border-radius: 2px;
      cursor: pointer;
    }
    .vol-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--paper);
      cursor: pointer;
    }

    .btn-sync-live {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border: 1.5px dashed var(--dash);
      border-radius: 12px;
      background: transparent;
      color: var(--paper);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-sync-live:hover {
      border-style: solid;
      border-color: var(--paper);
      background: rgba(255, 255, 255, 0.1);
    }
    .btn-sync-live.behind {
      border-color: #f59e0b;
      color: #f59e0b;
      border-style: solid;
    }

    /* Écran de veille Radar Seeworld */
    .standby-screen {
      position: absolute;
      inset: 0;
      background: #000000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 10;
      gap: 20px;
      text-align: center;
      padding: 24px;
    }
    .standby-screen.hidden { display: none; }

    .seeworld-radar {
      position: relative;
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .radar-circle {
      position: absolute;
      inset: 0;
      border: 2px dashed var(--dash);
      border-radius: 50%;
      animation: radarSpin 14s linear infinite;
    }
    .radar-circle:nth-child(2) {
      inset: 16px;
      border: 1px dashed rgba(255, 255, 255, 0.25);
      animation: radarSpinRev 9s linear infinite;
    }
    .radar-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--paper);
      box-shadow: 0 0 16px rgba(255, 255, 255, 0.9);
      animation: radarPulse 2s ease-in-out infinite alternate;
    }

    @keyframes radarSpin { to { transform: rotate(360deg); } }
    @keyframes radarSpinRev { to { transform: rotate(-360deg); } }
    @keyframes radarPulse {
      0% { transform: scale(0.85); opacity: 0.6; }
      100% { transform: scale(1.15); opacity: 1; }
    }

    .standby-title {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--paper);
    }
    .standby-desc {
      font-size: 12px;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.65);
      max-width: 440px;
      line-height: 1.6;
    }

    /* --------------------------------------------------------------------------
       ZONE CHAT DU DIRECT SOUVERAIN (MODES : VOLET / TRANSPARENT / REPLIÉ)
       -------------------------------------------------------------------------- */
    .chat-panel {
      position: relative;
      width: var(--chat-width);
      height: 100%;
      background: #000000;
      border-left: 2px dashed var(--dash);
      display: flex;
      flex-direction: column;
      z-index: 30;
      transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
    }

    /* MODE 1 : REPLIÉ (COLLAPSED) */
    .chat-panel.collapsed {
      width: 0 !important;
      border-left: none !important;
      transform: translateX(100%);
      pointer-events: none;
      visibility: hidden;
    }

    /* MODE 2 : TRANSPARENT FLOTTANT SUR LA VIDÉO */
    .chat-panel.transparent {
      position: absolute;
      top: 76px;
      right: 20px;
      bottom: 84px;
      height: auto;
      width: 340px;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 2px dashed var(--dash);
      border-radius: 15px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
      overflow: hidden;
    }

    /* Header du Chat */
    .chat-header {
      padding: 12px 14px;
      background: rgba(0, 0, 0, 0.75);
      border-bottom: 2px dashed var(--dash-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .chat-header-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .chat-header-controls {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .chat-head-btn {
      background: transparent;
      border: 1.5px dashed var(--dash-subtle);
      border-radius: 12px;
      color: var(--paper);
      font: 700 10px var(--font);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 3px 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .chat-head-btn:hover,
    .chat-head-btn.active {
      border-style: solid;
      border-color: var(--paper);
      background: rgba(255, 255, 255, 0.12);
    }

    /* Liste des messages */
    .chat-messages {
      flex: 1;
      padding: 14px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      scroll-behavior: smooth;
    }
    .chat-messages::-webkit-scrollbar { width: 4px; }
    .chat-messages::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.25);
      border-radius: 2px;
    }

    .chat-welcome-card {
      border: 1.5px dashed var(--dash-subtle);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.5;
      background: rgba(255, 255, 255, 0.02);
    }

    .chat-msg-row {
      font-size: 13px;
      font-family: var(--font);
      letter-spacing: 0.04em;
      line-height: 1.45;
      word-break: break-word;
      padding: 3px 6px;
      border-radius: 6px;
      transition: background 0.15s ease;
    }
    .chat-msg-row:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    .msg-time {
      font-size: 10px;
      opacity: 0.45;
      margin-right: 6px;
      font-variant-numeric: tabular-nums;
    }
    .msg-badge {
      display: inline-block;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 1px 5px;
      border-radius: 4px;
      margin-right: 6px;
      vertical-align: middle;
    }
    .msg-badge.badge-admin { background: #10b981; color: #000; }
    .msg-badge.badge-mod { background: #9146ff; color: #fff; }
    .msg-user { font-weight: 700; letter-spacing: 0.06em; }
    .msg-content { color: #ffffff; }

    /* Formulaire de saisie */
    .chat-footer {
      padding: 10px 12px;
      background: rgba(0, 0, 0, 0.85);
      border-top: 2px dashed var(--dash-subtle);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .chat-input-row {
      display: flex;
      gap: 6px;
    }

    .chat-input {
      flex: 1;
      background: #080808;
      border: 1.5px solid rgba(255, 255, 255, 0.25);
      border-radius: 12px;
      padding: 8px 12px;
      color: #fff;
      font-family: var(--font);
      font-size: 12px;
      outline: none;
      transition: border-color 0.2s ease;
    }
    .chat-input:focus {
      border-color: #fff;
    }

    .chat-send-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 14px;
      border: 2px dashed var(--dash);
      border-radius: 15px;
      background: transparent;
      color: #fff;
      font: 700 11px var(--font);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .chat-send-btn:hover {
      border-style: solid;
      border-color: #fff;
      background: rgba(255, 255, 255, 0.15);
    }

    /* Pilule flottante pour rouvrir le chat quand il est replié */
    .floating-reopen-chat {
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 25;
      display: none;
    }
    .floating-reopen-chat.visible {
      display: block;
    }
  </style>
  <script is:inline src="/assets/hls.min.js"></script>
</head>
<body>
  <div class="app-viewport" id="appViewport">
    
    <!-- 1. FLUX VIDÉO EN DIRECT -->
    <main class="video-zone" id="videoZone">
      <video id="liveVideo" playsinline autoplay muted preload="auto"></video>
      
      <!-- Vignette cinématographique -->
      <div class="vignette"></div>

      <!-- Écran de veille Radar Seeworld -->
      <div class="standby-screen" id="standbyScreen">
        <div class="seeworld-radar">
          <div class="radar-circle"></div>
          <div class="radar-circle"></div>
          <div class="radar-dot"></div>
        </div>
        <div>
          <h2 class="standby-title">EN ATTENTE DE DIFFUSION OBS</h2>
          <p class="standby-desc">
            Le relais VPS est connecté. Dès que vous lancez le stream dans OBS Studio, la vidéo apparaît instantanément ici.
          </p>
        </div>
      </div>

      <!-- HUD Haut Flottant -->
      <header class="stream-hud-top" id="hudTop">
        <div class="seeworld-pill">
          <span class="live-dot" id="liveDot"></span>
          <span id="liveStateLabel">DIRECT</span>
          <span style="opacity:0.35;">&bull;</span>
          <span id="channelTag">127IL</span>
          <span style="opacity:0.35;">&bull;</span>
          <span id="latencyBadge">--s</span>
        </div>

        <div class="top-action-cluster">
          <!-- Bascule d'affichage du chat -->
          <button class="seeworld-pill" id="btnToggleChatMode" title="Changer l'affichage du chat">
            <span id="chatModeLabel">CHAT : VOLET</span>
          </button>
          <a href="/config" target="_blank" class="seeworld-pill" title="Accéder à la régie studio">
            <span>RÉGIE &nearr;</span>
          </a>
        </div>
      </header>

      <!-- HUD Bas Flottant -->
      <footer class="stream-hud-bottom" id="hudBottom">
        <div class="ctrl-group">
          <!-- Play / Pause -->
          <button class="ctrl-btn" id="btnPlayPause" title="Lecture / Pause (Espace)">
            <svg id="playIcon" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </button>

          <!-- Recalage Direct -->
          <button class="btn-sync-live" id="btnSyncLive" title="Se recaler immédiatement sur le direct (L)">
            <span style="width:5px; height:5px; border-radius:50%; background:currentColor;"></span>
            <span id="syncText">CALÉ DIRECT</span>
          </button>

          <!-- Volume -->
          <div class="ctrl-group">
            <button class="ctrl-btn" id="btnMute" title="Activer / Couper le son (M)">
              <svg id="volIcon" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
            </button>
            <input type="range" id="volSlider" class="vol-slider" min="0" max="1" step="0.05" value="1" title="Volume">
          </div>
        </div>

        <div class="ctrl-group">
          <!-- Aspect Fit / Fill -->
          <button class="ctrl-btn" id="btnAspect" title="Adapter / Remplir l'écran (C)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18"/></svg>
          </button>

          <!-- Picture in Picture -->
          <button class="ctrl-btn" id="btnPip" title="Incrustation Image dans l'image (P)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><rect x="12" y="10" width="8" height="6" rx="1"/></svg>
          </button>

          <!-- Plein Écran -->
          <button class="ctrl-btn" id="btnFullscreen" title="Plein écran (F)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
        </div>
      </footer>
    </main>

    <!-- Bouton flottant pour réouvrir le chat si replié -->
    <div class="floating-reopen-chat" id="floatingReopen">
      <button class="seeworld-pill" id="btnReopenChat">
        <span>💬 CHAT DU DIRECT</span>
      </button>
    </div>

    <!-- 2. LE CHAT DU DIRECT (MODES : VOLET / TRANSPARENT / REPLIÉ) -->
    <aside class="chat-panel" id="chatPanel">
      <div class="chat-header">
        <div class="chat-header-title">
          <span>CHAT</span>
          <span style="opacity:0.5; font-size:10px;" id="chatViewersBadge">&bull; 1 EN LIGNE</span>
        </div>
        <div class="chat-header-controls">
          <!-- Bouton Transparence -->
          <button type="button" class="chat-head-btn" id="btnTransparent" title="Basculer en incrustation transparente">
            <span>TRANSPARENT</span>
          </button>
          <!-- Pseudo -->
          <button type="button" class="chat-head-btn" id="btnChangePseudo" title="Changer votre pseudo">
            <span id="displayPseudo">VISITEUR</span> ✏️
          </button>
          <!-- Replier / Masquer -->
          <button type="button" class="chat-head-btn" id="btnFoldChat" title="Replier le chat">
            <span>&times;</span>
          </button>
        </div>
      </div>

      <!-- Messages -->
      <div class="chat-messages" id="chatMessages">
        <div class="chat-welcome-card">
          BIENVENUE SUR LE DIRECT 127IL ! CHAT EN TEMPS RÉEL SOUVERAIN ET SANS TRACKER.
        </div>
      </div>

      <!-- Saisie -->
      <form class="chat-footer" id="chatForm">
        <div class="chat-input-row">
          <input
            type="text"
            id="chatInput"
            class="chat-input"
            placeholder="Envoyer un message..."
            maxlength="350"
            autocomplete="off"
            required
          />
          <button type="submit" class="chat-send-btn">
            <span>ENVOYER</span>
          </button>
        </div>
      </form>
    </aside>

  </div>

  <script>
    (function () {
      const videoZone = document.getElementById('videoZone');
      const video = document.getElementById('liveVideo');
      const standbyScreen = document.getElementById('standbyScreen');
      const hudTop = document.getElementById('hudTop');
      const hudBottom = document.getElementById('hudBottom');
      const liveDot = document.getElementById('liveDot');
      const liveStateLabel = document.getElementById('liveStateLabel');
      const latencyBadge = document.getElementById('latencyBadge');
      const channelTag = document.getElementById('channelTag');
      const btnPlayPause = document.getElementById('btnPlayPause');
      const playIcon = document.getElementById('playIcon');
      const btnMute = document.getElementById('btnMute');
      const volIcon = document.getElementById('volIcon');
      const volSlider = document.getElementById('volSlider');
      const btnSyncLive = document.getElementById('btnSyncLive');
      const syncText = document.getElementById('syncText');
      const btnAspect = document.getElementById('btnAspect');
      const btnPip = document.getElementById('btnPip');
      const btnFullscreen = document.getElementById('btnFullscreen');
      
      // Chat Elements
      const chatPanel = document.getElementById('chatPanel');
      const btnToggleChatMode = document.getElementById('btnToggleChatMode');
      const chatModeLabel = document.getElementById('chatModeLabel');
      const btnTransparent = document.getElementById('btnTransparent');
      const btnFoldChat = document.getElementById('btnFoldChat');
      const floatingReopen = document.getElementById('floatingReopen');
      const btnReopenChat = document.getElementById('btnReopenChat');
      const chatMessages = document.getElementById('chatMessages');
      const chatForm = document.getElementById('chatForm');
      const chatInput = document.getElementById('chatInput');
      const chatViewersBadge = document.getElementById('chatViewersBadge');
      const btnChangePseudo = document.getElementById('btnChangePseudo');
      const displayPseudo = document.getElementById('displayPseudo');

      // ----------------------------------------------------------------------
      // GESTION DES 3 MODES DE CHAT (SIDEBAR, TRANSPARENT, COLLAPSED)
      // ----------------------------------------------------------------------
      // 'sidebar' | 'transparent' | 'collapsed'
      let currentChatMode = localStorage.getItem('127il_chat_mode') || 'sidebar';

      function applyChatMode(mode) {
        currentChatMode = mode;
        localStorage.setItem('127il_chat_mode', mode);

        chatPanel.classList.remove('collapsed', 'transparent');
        floatingReopen.classList.remove('visible');
        btnTransparent.classList.remove('active');

        if (mode === 'collapsed') {
          chatPanel.classList.add('collapsed');
          floatingReopen.classList.add('visible');
          chatModeLabel.textContent = 'CHAT : MASQUÉ';
        } else if (mode === 'transparent') {
          chatPanel.classList.add('transparent');
          btnTransparent.classList.add('active');
          chatModeLabel.textContent = 'CHAT : TRANSPARENT';
        } else {
          // sidebar
          chatModeLabel.textContent = 'CHAT : VOLET';
        }
      }

      applyChatMode(currentChatMode);

      btnToggleChatMode.addEventListener('click', function () {
        if (currentChatMode === 'sidebar') applyChatMode('transparent');
        else if (currentChatMode === 'transparent') applyChatMode('collapsed');
        else applyChatMode('sidebar');
      });

      btnTransparent.addEventListener('click', function () {
        if (currentChatMode === 'transparent') applyChatMode('sidebar');
        else applyChatMode('transparent');
      });

      btnFoldChat.addEventListener('click', function () {
        applyChatMode('collapsed');
      });

      btnReopenChat.addEventListener('click', function () {
        applyChatMode('sidebar');
      });

      // ----------------------------------------------------------------------
      // GESTION DU PSEUDO DU DIRECT
      // ----------------------------------------------------------------------
      let myPseudo = localStorage.getItem('127il_chat_pseudo');
      if (!myPseudo) {
        myPseudo = 'Visiteur-' + Math.floor(1000 + Math.random() * 9000);
        localStorage.setItem('127il_chat_pseudo', myPseudo);
      }
      displayPseudo.textContent = myPseudo.toUpperCase();

      btnChangePseudo.addEventListener('click', function () {
        const p = prompt('Votre pseudo pour le chat (max 20 car.) :', myPseudo);
        if (p && p.trim()) {
          myPseudo = p.trim().substring(0, 20);
          localStorage.setItem('127il_chat_pseudo', myPseudo);
          displayPseudo.textContent = myPseudo.toUpperCase();
        }
      });

      // ----------------------------------------------------------------------
      // LECTEUR ULTRA-BASSE LATENCE HLS
      // ----------------------------------------------------------------------
      let pathSlug = window.location.pathname.replace(/^\/+|\/+$/g, '');
      if (!pathSlug || pathSlug === 'live') pathSlug = 'tom';
      channelTag.textContent = '127IL • ' + pathSlug.toUpperCase();

      const candidates = [
        window.location.origin + '/live/' + pathSlug + '/index.m3u8',
        window.location.origin + '/live/' + pathSlug + '/' + pathSlug + '/index.m3u8',
        window.location.origin + '/live/tom/tom/index.m3u8',
        window.location.origin + '/live/tom/index.m3u8'
      ];
      let candidateIdx = 0;
      let hls = null;
      let hudTimer = null;

      function showHud() {
        hudTop.classList.remove('hud-hidden');
        hudBottom.classList.remove('hud-hidden');
        clearTimeout(hudTimer);
        hudTimer = setTimeout(function () {
          if (!video.paused) {
            hudTop.classList.add('hud-hidden');
            hudBottom.classList.add('hud-hidden');
          }
        }, 3000);
      }
      videoZone.addEventListener('mousemove', showHud);

      function initHls() {
        const streamUrl = candidates[candidateIdx];
        if (hls) { hls.destroy(); hls = null; }

        if (window.Hls && window.Hls.isSupported()) {
          hls = new window.Hls({
            enableWorker: true,
            lowLatencyMode: true,
            backBufferLength: 30,
            liveSyncDurationCount: 1,
            liveMaxLatencyDurationCount: 2.5,
            maxLiveSyncPlaybackRate: 1.25,
            progressive: true
          });
          hls.loadSource(streamUrl);
          hls.attachMedia(video);

          hls.on(window.Hls.Events.MANIFEST_PARSED, function () {
            standbyScreen.classList.add('hidden');
            liveDot.classList.add('live-on');
            liveStateLabel.textContent = 'DIRECT';
            video.play().catch(function() {
              video.muted = true;
              video.play();
            });
          });

          hls.on(window.Hls.Events.LEVEL_UPDATED, function (e, data) {
            standbyScreen.classList.add('hidden');
            liveDot.classList.add('live-on');
            if (hls && hls.latency !== undefined) {
              const lat = hls.latency;
              latencyBadge.textContent = lat.toFixed(1) + 's';
              if (lat < 2.0) {
                btnSyncLive.classList.remove('behind');
                syncText.textContent = 'CALÉ DIRECT';
              } else {
                btnSyncLive.classList.add('behind');
                syncText.textContent = 'RECALER (' + lat.toFixed(0) + 's)';
              }
            }
          });

          hls.on(window.Hls.Events.ERROR, function (e, data) {
            if (data.fatal) {
              standbyScreen.classList.remove('hidden');
              liveDot.classList.remove('live-on');
              liveStateLabel.textContent = 'ATTENTE';
              candidateIdx = (candidateIdx + 1) % candidates.length;
              setTimeout(initHls, 2500);
            }
          });
        }
      }

      // Contrôles Vidéo
      function togglePlay() {
        if (video.paused) { video.play(); playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"></polygon>'; }
        else { video.pause(); playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>'; }
      }
      btnPlayPause.addEventListener('click', togglePlay);
      video.addEventListener('click', togglePlay);

      btnSyncLive.addEventListener('click', function () {
        if (hls && video.seekable.length > 0) {
          video.currentTime = video.seekable.end(video.seekable.length - 1);
        }
      });

      btnMute.addEventListener('click', function () {
        video.muted = !video.muted;
        volSlider.value = video.muted ? 0 : video.volume;
      });

      volSlider.addEventListener('input', function (e) {
        video.volume = parseFloat(e.target.value);
        video.muted = video.volume === 0;
      });

      btnAspect.addEventListener('click', function () {
        video.classList.toggle('cover');
      });

      btnPip.addEventListener('click', function () {
        if (document.pictureInPictureElement) document.exitPictureInPicture();
        else if (video.requestPictureInPicture) video.requestPictureInPicture();
      });

      btnFullscreen.addEventListener('click', function () {
        if (!document.fullscreenElement) document.getElementById('appViewport').requestFullscreen().catch(function(){});
        else document.exitFullscreen().catch(function(){});
      });

      // ----------------------------------------------------------------------
      // CLIENT CHAT NATIF WEBSOCKET
      // ----------------------------------------------------------------------
      let chatWs = null;

      function renderMsg(msg) {
        const row = document.createElement('div');
        row.className = 'chat-msg-row';
        row.dataset.msgId = msg.id;

        const time = `<span class="msg-time">${msg.time || msg.created_at?.slice(11,16) || ''}</span>`;
        let badge = '';
        if (msg.badge) {
          badge = `<span class="msg-badge badge-${msg.role || 'viewer'}">${msg.badge}</span>`;
        }
        const user = `<span class="msg-user" style="color:${msg.color || '#fff'}">${msg.username}</span>`;
        const content = `<span class="msg-content">${msg.content}</span>`;

        row.innerHTML = `${time} ${badge} ${user}: ${content}`;
        chatMessages.appendChild(row);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      function connectChat() {
        const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const url = `${proto}//${window.location.host}/chat-ws`;

        try {
          chatWs = new WebSocket(url);
          chatWs.onmessage = function (e) {
            try {
              const data = JSON.parse(e.data);
              if (data.type === 'init') {
                const welcome = chatMessages.querySelector('.chat-welcome-card');
                chatMessages.innerHTML = '';
                if (welcome) chatMessages.appendChild(welcome);
                if (Array.isArray(data.messages)) data.messages.forEach(renderMsg);
                if (data.viewers) chatViewersBadge.textContent = `• ${data.viewers} EN LIGNE`;
              } else if (data.type === 'message' && data.data) {
                renderMsg(data.data);
              } else if (data.type === 'viewers') {
                chatViewersBadge.textContent = `• ${data.count} EN LIGNE`;
              } else if (data.type === 'delete' && data.id) {
                const el = chatMessages.querySelector(`[data-msg-id="${data.id}"]`);
                if (el) el.remove();
              } else if (data.type === 'clear') {
                chatMessages.innerHTML = '<div class="chat-welcome-card">CHAT PURGÉ PAR LA RÉGIE.</div>';
              }
            } catch (err) {}
          };
          chatWs.onclose = function () { setTimeout(connectChat, 3000); };
        } catch (err) { setTimeout(connectChat, 3000); }
      }

      if (chatForm && chatInput) {
        chatForm.addEventListener('submit', function (e) {
          e.preventDefault();
          const text = chatInput.value.trim();
          if (!text || !chatWs || chatWs.readyState !== WebSocket.OPEN) return;
          chatWs.send(JSON.stringify({
            action: 'message',
            username: myPseudo,
            content: text
          }));
          chatInput.value = '';
          chatInput.focus();
        });
      }

      // Raccourcis clavier universels
      window.addEventListener('keydown', function (e) {
        if (['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;
        switch (e.key.toLowerCase()) {
          case ' ':
          case 'k':
            e.preventDefault();
            togglePlay();
            break;
          case 'f':
            btnFullscreen.click();
            break;
          case 'm':
            btnMute.click();
            break;
          case 'c':
            btnAspect.click();
            break;
          case 'l':
            btnSyncLive.click();
            break;
        }
      });

      // Démarrage
      initHls();
      connectChat();
    })();
  </script>
</body>
</html>
