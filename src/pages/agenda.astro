                <option value="Intérieur sécurisé (ERP, Bureaux, Salle de spectacle)">Intérieur clos / ERP (Cinewhoop protégé)</option>
                <option value="Site privé extérieur (Circuit, Domaine, Usine)">Site privé extérieur (Espace sécurisé)</option>
                <option value="Extérieur naturel (Campagne, Forêt, Falaise)">Extérieur naturel (Grands espaces)</option>
                <option value="Espace public / Urbain (Démarches requises)">Zone urbaine / Espace public</option>
              </select>
            </div>

            <div class="form-field full-width">
              <label for="fpvLivrables"><strong>LIVRABLES SOUHAITÉS &amp; POST-PRODUCTION</strong></label>
              <select id="fpvLivrables" name="fpvLivrables">
                <option value="Rushs 4K/5K stabilisés Gyroflow (Prêt au montage)">Rushs 4K/5K stabilisés par Gyroflow (Prêt pour montage)</option>
                <option value="Rushs bruts Flat/Log + logs gyroscopiques">Rushs bruts Log + fichiers gyro bruts (.csv)</option>
                <option value="Prestation globale (Tournage + Montage + Étalonnage)">Prestation complète : tournage + montage + étalonnage</option>
              </select>
            </div>

            <div class="form-field full-width">
              <label for="fpvBrief"><strong>DESCRIPTION DU PROJET &amp; BRIEF CRÉATIF *</strong></label>
              <textarea id="fpvBrief" name="fpvBrief" rows="5" placeholder="Décrivez votre projet : sujet du tournage, dynamique souhaitée, contraintes d'accès, budget envisagé, délai de rendu..." required></textarea>
            </div>
          </div>

          <div class="form-footer">
            <button type="submit" class="btn-noir btn-submit">
              Envoyer la demande de tournage / devis FPV &rarr;
            </button>
            <p class="form-notice">
              Devis détaillé transmis sous 24h à 48h ouvrées. Démarches réglementaires et sécurité garanties.
            </p>
          </div>

          <div id="confirmationBannerFpv" class="confirmation-box" style="display: none;">
            <h3>DEMANDE FPV TRANSMISE</h3>
            <p id="confirmationMessageFpv"></p>
            <a href="#" id="mailtoFallbackBtnFpv" class="btn-outline btn-inline">Ouvrir dans votre messagerie &rarr;</a>
          </div>
        </form>
      </section>
    </div>

    <!-- Rappel des garanties des 2 agendas -->
    <section class="prose-card memo-cabine">
      <span class="etiquette">INDÉPENDANCE DES PLANNINGS</span>
      <h2>ENGAGEMENTS D'EXPLOITATION &amp; TOURNAGE</h2>
      <div class="specs-grid">
        <div class="spec-box">
          <strong>Planning Cabines Dédié</strong>
          <p>Réservé aux 2 cinémas partenaires, avec affichage exclusif des séances, remplacements et semaines de CFA.</p>
        </div>
        <div class="spec-box">
          <strong>Planning FPV Indépendant</strong>
          <p>Consacré aux tournages cinématiques, repérages techniques et chiffrage des devis de vol.</p>
        </div>
        <div class="spec-box">
          <strong>Confidentialité Totale</strong>
          <p>Aucun croisement de données entre exploitants cinéma et productions audiovisuelles.</p>
        </div>
        <div class="spec-box">
          <strong>Réactivité &amp; Rigueur</strong>
          <p>Confirmation immédiate et coordination rigoureuse pour chaque intervention sur le terrain.</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // ==========================================================================
  // COMMUTATION MAÎTRESSE DES AGENDAS INDÉPENDANTS
  // ==========================================================================
  const btnSelectCinema = document.getElementById('btnSelectCinema');
  const btnSelectFpv = document.getElementById('btnSelectFpv');
  const quickLinkCinema = document.getElementById('quickLinkCinema');
  const quickLinkFpv = document.getElementById('quickLinkFpv');
  const wrapperCinema = document.getElementById('agenda-cinema-wrapper');
  const wrapperFpv = document.getElementById('agenda-fpv-wrapper');

  function activerAgenda(type: 'cinema' | 'fpv') {
    if (type === 'cinema') {
      btnSelectCinema?.classList.add('active');
      btnSelectCinema?.setAttribute('aria-selected', 'true');
      btnSelectFpv?.classList.remove('active');
      btnSelectFpv?.setAttribute('aria-selected', 'false');

      quickLinkCinema?.classList.add('active-nav-pill');
      quickLinkFpv?.classList.remove('active-nav-pill');

      if (wrapperCinema) wrapperCinema.style.display = 'block';
      if (wrapperFpv) wrapperFpv.style.display = 'none';
      history.replaceState(null, '', '#agenda-cinema');
    } else {
      btnSelectFpv?.classList.add('active');
      btnSelectFpv?.setAttribute('aria-selected', 'true');
      btnSelectCinema?.classList.remove('active');
      btnSelectCinema?.setAttribute('aria-selected', 'false');

      quickLinkFpv?.classList.add('active-nav-pill');
      quickLinkCinema?.classList.remove('active-nav-pill');

      if (wrapperFpv) wrapperFpv.style.display = 'block';
      if (wrapperCinema) wrapperCinema.style.display = 'none';
      history.replaceState(null, '', '#agenda-fpv');
    }
  }

  btnSelectCinema?.addEventListener('click', () => activerAgenda('cinema'));
  btnSelectFpv?.addEventListener('click', () => activerAgenda('fpv'));
  quickLinkCinema?.addEventListener('click', (e) => {
    e.preventDefault();
    activerAgenda('cinema');
  });
  quickLinkFpv?.addEventListener('click', (e) => {
    e.preventDefault();
    activerAgenda('fpv');
  });

  // Détection du sous-domaine ou du hash dans l'URL à l'arrivée
  const host = window.location.hostname.toLowerCase();
  const hash = window.location.hash.toLowerCase();

  if (host.startsWith('fpv') || host.startsWith('drone') || hash.includes('fpv')) {
    activerAgenda('fpv');
  } else {
    activerAgenda('cinema');
  }

  // Date de chargement pour détection d'envoi anti-bot (OWASP OAT-007)
  const pageLoadedAt = Date.now();

  // Validation anti-bot et honeypot (OWASP Automated Threats OAT-007 / OAT-014)
  function verifyAntiBot(form: HTMLFormElement, hpFieldName: string): boolean {
    const data = new FormData(form);
    const hpVal = data.get(hpFieldName);
    if (hpVal && String(hpVal).trim() !== '') {
      console.warn('[OWASP Guard] Soumission automatisée de robot bloquée via champ honeypot.');
      return false;
    }
    const elapsed = Date.now() - pageLoadedAt;
    if (elapsed < 2000) {
      console.warn('[OWASP Guard] Soumission ultra-rapide anormale détectée (' + elapsed + 'ms).');
      alert('Veuillez patienter au moins 2 secondes avant de transmettre le formulaire.');
      return false;
    }
    return true;
  }

  // ==========================================================================
  // GESTION DU CALENDRIER & PANIER DE VACATIONS
  // ==========================================================================
  const cinemaDatesSelectionnees = new Set<string>();
  const cinemaMonthViews = document.querySelectorAll('.cinema-month-view');
  const btnPrevCinemaMonth = document.getElementById('btnPrevCinemaMonth') as HTMLButtonElement | null;
  const btnNextCinemaMonth = document.getElementById('btnNextCinemaMonth') as HTMLButtonElement | null;
  const cinemaMonthTitle = document.getElementById('cinemaMonthTitle');
  let activeCinemaMonth = 0;

  function afficherMoisCinema(idx: number) {
    cinemaMonthViews.forEach((view, i) => {
      if (i === idx) {
        view.classList.remove('is-hidden-month');
        view.classList.add('is-active-month');
        const name = view.getAttribute('data-month-name');
        if (cinemaMonthTitle && name) cinemaMonthTitle.textContent = name;
      } else {
        view.classList.add('is-hidden-month');
        view.classList.remove('is-active-month');
      }
    });
    if (btnPrevCinemaMonth) btnPrevCinemaMonth.disabled = idx === 0;
    if (btnNextCinemaMonth) btnNextCinemaMonth.disabled = idx === cinemaMonthViews.length - 1;
  }

  if (btnPrevCinemaMonth && btnNextCinemaMonth) {
    afficherMoisCinema(0);
    btnPrevCinemaMonth.addEventListener('click', () => {
      if (activeCinemaMonth > 0) {
        activeCinemaMonth--;
        afficherMoisCinema(activeCinemaMonth);
      }
    });
    btnNextCinemaMonth.addEventListener('click', () => {
      if (activeCinemaMonth < cinemaMonthViews.length - 1) {
        activeCinemaMonth++;
        afficherMoisCinema(activeCinemaMonth);
      }
    });
  }

  // Clic sur les cellules libres Cinéma
  const selectionBarCinema = document.getElementById('selectionBarCinema');
  const selectedCinemaDatesList = document.getElementById('selectedCinemaDatesList');
  const btnClearCinemaDates = document.getElementById('btnClearCinemaDates');
  const inputDatesCinema = document.getElementById('datesCinemaInput') as HTMLInputElement | null;

  function majSelectionCinema() {
    if (!selectionBarCinema || !selectedCinemaDatesList || !inputDatesCinema) return;
    selectedCinemaDatesList.innerHTML = '';

    if (cinemaDatesSelectionnees.size === 0) {
      selectionBarCinema.style.display = 'none';
      inputDatesCinema.value = '';
      return;
    }

    selectionBarCinema.style.display = 'flex';
    const tri = Array.from(cinemaDatesSelectionnees).sort();
    inputDatesCinema.value = tri.join(', ');

    tri.forEach((date) => {
      const pill = document.createElement('span');
      pill.className = 'date-pill-selected';
      const strong = document.createElement('strong');
      strong.textContent = date;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '×';
      btn.setAttribute('aria-label', `Retirer la date ${date}`);
      btn.addEventListener('click', (ev) => {
        ev.stopPropagation();
        cinemaDatesSelectionnees.delete(date);
        document.querySelectorAll(`.day-cine-selectable[data-date="${date}"]`).forEach((c) => c.classList.remove('day-selected'));
        majSelectionCinema();
      });
      pill.append(strong, btn);
      selectedCinemaDatesList.appendChild(pill);
    });
  }

  document.querySelectorAll('.day-cine-selectable').forEach((cell) => {
    cell.addEventListener('click', () => {
      const date = cell.getAttribute('data-date');
      if (!date) return;

      if (cinemaDatesSelectionnees.has(date)) {
        cinemaDatesSelectionnees.delete(date);
        cell.classList.remove('day-selected');
      } else {
        cinemaDatesSelectionnees.add(date);
        cell.classList.add('day-selected');
      }
      majSelectionCinema();
    });
  });

  // Clic sur les cellules occupées/verrouillées : information claire
  document.querySelectorAll('.day-cine-locked').forEach((cell) => {
    cell.addEventListener('click', () => {
      const date = cell.getAttribute('data-date');
      const label = cell.getAttribute('data-label') || 'Créneau réservé';
      const detail = cell.getAttribute('data-detail') || '';

      alert(
        `Date indisponible (${date}) :\n\n` +
        `Attribution : ${label}${detail ? ' (' + detail + ')' : ''}\n\n` +
        `Ce créneau est déjà réservé ou engagé en formation CFA.\n` +
        `Pour poser une vacation, veuillez choisir l'un des créneaux blancs "+ Choisir" (Disponible).`
      );
    });
  });

  btnClearCinemaDates?.addEventListener('click', () => {
    cinemaDatesSelectionnees.clear();
    document.querySelectorAll('.day-cine-selectable').forEach((c) => c.classList.remove('day-selected'));
    majSelectionCinema();
  });

  // Sélection radio manuelle dans le formulaire
  const inputStructureCine = document.getElementById('structureCine') as HTMLInputElement | null;
  document.querySelectorAll('input[name="cinemaChoix"]').forEach((radio) => {
    radio.addEventListener('change', (ev) => {
      const target = ev.target as HTMLInputElement;
      if (target.checked && inputStructureCine) {
        if (target.value.includes('Studios')) {
          inputStructureCine.value = 'Cinémas Les Studios (Tours)';
        } else if (target.value.includes('Ciné-Off')) {
          inputStructureCine.value = 'Ciné-Off (Circuit itinérant)';
        }
      }
    });
  });

  // Fonctions de nettoyage et de sécurisation OWASP A03 (Anti-Injection d'en-têtes & XSS)
  function cleanSingleLine(val: string, maxLen = 120): string {
    return (val || '').replace(/[\r\n\t]+/g, ' ').trim().slice(0, maxLen);
  }
  function cleanMultiLine(val: string, maxLen = 1500): string {
    return (val || '').replace(/[\r]+/g, '').trim().slice(0, maxLen);
  }

  // Soumission formulaire Cinéma
  const formCinema = document.getElementById('agendaFormCinema') as HTMLFormElement | null;
  const confCinema = document.getElementById('confirmationBannerCinema');
  const confMsgCinema = document.getElementById('confirmationMessageCinema');
  const mailtoBtnCinema = document.getElementById('mailtoFallbackBtnCinema') as HTMLAnchorElement | null;

  formCinema?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!verifyAntiBot(formCinema, 'cine_website_url')) return;
    const data = new FormData(formCinema);
    const struct = cleanSingleLine((data.get('structureCine') as string) || 'Cinéma');
    const contact = cleanSingleLine((data.get('contactCine') as string) || '');
    const email = cleanSingleLine((data.get('emailCine') as string) || '');
    const tel = cleanSingleLine((data.get('telCine') as string) || 'Non renseigné', 30);
    const dates = cleanSingleLine((data.get('datesCinemaInput') as string) || 'Non spécifiées', 300);
    const vacation = cleanSingleLine((data.get('typeVacation') as string) || '', 80);
    const techno = cleanSingleLine((data.get('technoCabine') as string) || '', 80);
    const notes = cleanMultiLine((data.get('notesCabine') as string) || 'Aucune');

    const sujet = encodeURIComponent(`[CABINE CINÉMA] Proposition de dates — ${struct} (${dates})`);
    const corps = encodeURIComponent(
      `Bonjour Tom,\n\nUne demande d'intervention cabine vient d'être posée via l'agenda Cinéma indépendant :\n\n` +
      `• Établissement : ${struct}\n` +
      `• Responsable cabine : ${contact}\n` +
      `• Email : ${email}\n` +
      `• Téléphone direct : ${tel}\n` +
      `• Date(s) cabine : ${dates}\n` +
      `• Vacation demandée : ${vacation}\n` +
      `• Configuration : ${techno}\n\n` +
      `Titres des films & Notes d'exploitation :\n${notes}\n\n` +
      `---\nTransmis depuis l'agenda Cinéma tom-bigot.fr`
    );

    const mailtoUrl = `mailto:contact@tom-bigot.fr?subject=${sujet}&body=${corps}`;

    if (confCinema && confMsgCinema) {
      confCinema.style.display = 'block';
      confMsgCinema.textContent = `Votre demande pour le "${struct}" sur les dates (${dates}) a été transmise.`;
      if (mailtoBtnCinema) mailtoBtnCinema.href = mailtoUrl;
      confCinema.scrollIntoView({ behavior: 'smooth' });
    }
    window.location.href = mailtoUrl;
  });


  // ==========================================================================
  // GESTION INDÉPENDANTE DE L'AGENDA DRONE FPV
  // ==========================================================================
  const fpvDatesSelectionnees = new Set<string>();
  const fpvMonthViews = document.querySelectorAll('.fpv-month-view');
  const btnPrevFpvMonth = document.getElementById('btnPrevFpvMonth') as HTMLButtonElement | null;
  const btnNextFpvMonth = document.getElementById('btnNextFpvMonth') as HTMLButtonElement | null;
  const fpvMonthTitle = document.getElementById('fpvMonthTitle');
  let activeFpvMonth = 0;

  function afficherMoisFpv(idx: number) {
    fpvMonthViews.forEach((view, i) => {
      if (i === idx) {
        view.classList.remove('is-hidden-month');
        view.classList.add('is-active-month');
        const name = view.getAttribute('data-month-name');
        if (fpvMonthTitle && name) fpvMonthTitle.textContent = name;
      } else {
        view.classList.add('is-hidden-month');
        view.classList.remove('is-active-month');
      }
    });
    if (btnPrevFpvMonth) btnPrevFpvMonth.disabled = idx === 0;
    if (btnNextFpvMonth) btnNextFpvMonth.disabled = idx === fpvMonthViews.length - 1;
  }

  if (btnPrevFpvMonth && btnNextFpvMonth) {
    afficherMoisFpv(0);
    btnPrevFpvMonth.addEventListener('click', () => {
      if (activeFpvMonth > 0) {
        activeFpvMonth--;
        afficherMoisFpv(activeFpvMonth);
      }
    });
    btnNextFpvMonth.addEventListener('click', () => {
      if (activeFpvMonth < fpvMonthViews.length - 1) {
        activeFpvMonth++;
        afficherMoisFpv(activeFpvMonth);
      }
    });
  }

  // Clic sur les cellules FPV
  const selectionBarFpv = document.getElementById('selectionBarFpv');
  const selectedFpvDatesList = document.getElementById('selectedFpvDatesList');
  const btnClearFpvDates = document.getElementById('btnClearFpvDates');
  const inputDatesFpv = document.getElementById('fpvDatesInput') as HTMLInputElement | null;

  function majSelectionFpv() {
    if (!selectionBarFpv || !selectedFpvDatesList || !inputDatesFpv) return;
    selectedFpvDatesList.innerHTML = '';

    if (fpvDatesSelectionnees.size === 0) {
      selectionBarFpv.style.display = 'none';
      inputDatesFpv.value = '';
      return;
    }

    selectionBarFpv.style.display = 'flex';
    const tri = Array.from(fpvDatesSelectionnees).sort();
    inputDatesFpv.value = tri.join(', ');

    tri.forEach((date) => {
      const pill = document.createElement('span');
      pill.className = 'date-pill-selected';
      const strong = document.createElement('strong');
      strong.textContent = date;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '×';
      btn.setAttribute('aria-label', `Retirer la date ${date}`);
      btn.addEventListener('click', (ev) => {
        ev.stopPropagation();
        fpvDatesSelectionnees.delete(date);
        document.querySelectorAll(`.day-fpv-selectable[data-date="${date}"]`).forEach((c) => c.classList.remove('day-selected'));
        majSelectionFpv();
      });
      pill.append(strong, btn);
      selectedFpvDatesList.appendChild(pill);
    });
  }

  document.querySelectorAll('.day-fpv-selectable').forEach((cell) => {
    cell.addEventListener('click', () => {
      const date = cell.getAttribute('data-date');
      const statut = cell.getAttribute('data-statut');
      const detail = cell.getAttribute('data-detail') || '';
      if (!date) return;

      if (statut === 'indisponible') {
        alert(`Date non disponible :\n\nTom n'est pas disponible pour une session de vol FPV le ${date} (${detail || 'Autre créneau'}).`);
        return;
      }
      if (statut === 'reserve_tournage') {
        alert(`Date mobilisée :\n\nUn tournage FPV est déjà confirmé le ${date} (${detail}).`);
        return;
      }

      if (fpvDatesSelectionnees.has(date)) {
        fpvDatesSelectionnees.delete(date);
        cell.classList.remove('day-selected');
      } else {
        fpvDatesSelectionnees.add(date);
        cell.classList.add('day-selected');
      }
      majSelectionFpv();
    });
  });

  btnClearFpvDates?.addEventListener('click', () => {
    fpvDatesSelectionnees.clear();
    document.querySelectorAll('.day-fpv-selectable').forEach((c) => c.classList.remove('day-selected'));
    majSelectionFpv();
  });

  // Presets FPV
  const selectFpvType = document.getElementById('fpvTypeDemande') as HTMLSelectElement | null;
  document.querySelectorAll('[data-fpv-type]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-fpv-type');
      if (selectFpvType && val) selectFpvType.value = val;
      document.getElementById('formFpvContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Soumission formulaire FPV
  const formFpv = document.getElementById('agendaFormFpv') as HTMLFormElement | null;
  const confFpv = document.getElementById('confirmationBannerFpv');
  const confMsgFpv = document.getElementById('confirmationMessageFpv');
  const mailtoBtnFpv = document.getElementById('mailtoFallbackBtnFpv') as HTMLAnchorElement | null;

  formFpv?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!verifyAntiBot(formFpv, 'fpv_website_url')) return;
    const data = new FormData(formFpv);
    const societe = cleanSingleLine((data.get('fpvSociete') as string) || 'Client FPV');
    const contact = cleanSingleLine((data.get('fpvContactNom') as string) || '');
    const email = cleanSingleLine((data.get('fpvEmail') as string) || '');
    const tel = cleanSingleLine((data.get('fpvTelephone') as string) || '', 30);
    const typeDemande = cleanSingleLine((data.get('fpvTypeDemande') as string) || '', 60);
    const dates = cleanSingleLine((data.get('fpvDatesInput') as string) || 'Non spécifiées', 300);
    const lieu = cleanSingleLine((data.get('fpvLieu') as string) || '', 100);
    const env = cleanSingleLine((data.get('fpvEnvironnement') as string) || '', 80);
    const livrables = cleanSingleLine((data.get('fpvLivrables') as string) || '', 100);
    const brief = cleanMultiLine((data.get('fpvBrief') as string) || '');

    const sujet = encodeURIComponent(`[DRONE FPV - ${typeDemande.toUpperCase()}] ${societe} (${dates})`);
    const corps = encodeURIComponent(
      `Bonjour Tom,\n\nUne nouvelle demande pour une prestation Drone FPV vient d'être formulée via l'agenda FPV indépendant :\n\n` +
      `• Commanditaire / Boîte de prod : ${societe}\n` +
      `• Contact : ${contact}\n` +
      `• Email : ${email}\n` +
      `• Téléphone : ${tel}\n\n` +
      `CAHIER DES CHARGES DU VOL :\n` +
      `• Prestation : ${typeDemande}\n` +
      `• Date(s) souhaitée(s) : ${dates}\n` +
      `• Lieu du vol : ${lieu}\n` +
      `• Environnement : ${env}\n` +
      `• Livrables vidéo : ${livrables}\n\n` +
      `Briefing créatif :\n${brief}\n\n` +
      `---\nTransmis depuis l'agenda Drone FPV tom-bigot.fr`
    );

    const mailtoUrl = `mailto:contact@tom-bigot.fr?subject=${sujet}&body=${corps}`;

    if (confFpv && confMsgFpv) {
      confFpv.style.display = 'block';
      confMsgFpv.textContent = `Votre demande pour "${societe}" (${typeDemande}) a été transmise.`;
      if (mailtoBtnFpv) mailtoBtnFpv.href = mailtoUrl;
      confFpv.scrollIntoView({ behavior: 'smooth' });
    }
    window.location.href = mailtoUrl;
  });
</script>

<style>
  .agenda-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 56px) clamp(16px, 3vw, 36px);
  }

  .agenda-header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 2px dashed var(--dash);
  }

  /* Bandeau Hub Organisations */
  .org-subdomain-hub {
    margin-bottom: 32px;
    padding: 20px;
    border: 2px solid #000000;
    background: #fafafa;
    box-shadow: 4px 4px 0px #000000;
  }

  .org-hub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .hub-privacy-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    background: #000000;
    color: #ffffff;
    text-transform: uppercase;
  }

  .org-hub-desc {
    font-size: 0.9rem;
    color: #444444;
    margin: 0 0 16px 0;
    line-height: 1.4;
  }

  .org-hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .org-hub-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    background: #ffffff;
    border: 2px solid #000000;
    text-decoration: none;
    color: #000000;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .org-hub-card:hover {
    transform: translateY(-3px);
    box-shadow: 3px 3px 0px #000000;
    background: #fdfdfd;
  }

  .hub-icon {
    font-size: 1.6rem;
    line-height: 1;
    padding: 4px;
  }

  .hub-info {
