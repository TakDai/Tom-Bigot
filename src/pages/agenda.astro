  { jour: 12, dateStr: '2026-11-12', statut: 'libre', label: 'Disponible' },
  { jour: 13, dateStr: '2026-11-13', statut: 'option', label: 'Option en cours', detail: 'En attente confirmation' },
  { jour: 14, dateStr: '2026-11-14', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Séance 35mm Spéciale' },
  { jour: 15, dateStr: '2026-11-15', statut: 'libre', label: 'Disponible' },
  { jour: 16, dateStr: '2026-11-16', statut: 'formation', label: 'CFA / Formation', detail: 'Sonorisation Dolby & Processeurs' },
