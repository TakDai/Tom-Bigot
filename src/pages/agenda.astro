  { jour: 12, dateStr: '2026-11-12', statut: 'libre', label: 'Disponible' },
  { jour: 13, dateStr: '2026-11-13', statut: 'option', label: 'Option en cours', detail: 'En attente confirmation cinéma' },
  { jour: 14, dateStr: '2026-11-14', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Séance 35mm Spéciale' },
