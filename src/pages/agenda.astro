---
import Base from '../layouts/Base.astro';

// Génération des jours pour Novembre 2026 et Décembre 2026
// Statuts possibles: 'libre' | 'option' | 'reserve'
interface JourAgenda {
  jour: number;
  dateStr: string; // YYYY-MM-DD
  statut: 'libre' | 'option' | 'reserve';
  label?: string;
  type?: 'cinema' | 'fpv' | 'dev' | 'autre';
}

const joursNovembre2026: JourAgenda[] = [
  { jour: 1, dateStr: '2026-11-01', statut: 'reserve', label: 'Projection cinéma', type: 'cinema' },
  { jour: 2, dateStr: '2026-11-02', statut: 'libre' },
  { jour: 3, dateStr: '2026-11-03', statut: 'libre' },
  { jour: 4, dateStr: '2026-11-04', statut: 'libre' },
  { jour: 5, dateStr: '2026-11-05', statut: 'option', label: 'Option tournage FPV', type: 'fpv' },
  { jour: 6, dateStr: '2026-11-06', statut: 'reserve', label: 'Cabine cinéma DCI', type: 'cinema' },
  { jour: 7, dateStr: '2026-11-07', statut: 'reserve', label: 'Cabine cinéma DCI', type: 'cinema' },
  { jour: 8, dateStr: '2026-11-08', statut: 'libre' },
  { jour: 9, dateStr: '2026-11-09', statut: 'libre' },
  { jour: 10, dateStr: '2026-11-10', statut: 'libre' },
  { jour: 11, dateStr: '2026-11-11', statut: 'libre' },
  { jour: 12, dateStr: '2026-11-12', statut: 'option', label: 'Sprint dév embarqué', type: 'dev' },
  { jour: 13, dateStr: '2026-11-13', statut: 'option', label: 'Sprint dév embarqué', type: 'dev' },
  { jour: 14, dateStr: '2026-11-14', statut: 'reserve', label: 'Séance 35mm patrimoine', type: 'cinema' },
  { jour: 15, dateStr: '2026-11-15', statut: 'reserve', label: 'Projection cinéma', type: 'cinema' },
  { jour: 16, dateStr: '2026-11-16', statut: 'libre' },
  { jour: 17, dateStr: '2026-11-17', statut: 'libre' },
  { jour: 18, dateStr: '2026-11-18', statut: 'libre' },
  { jour: 19, dateStr: '2026-11-19', statut: 'libre' },
  { jour: 20, dateStr: '2026-11-20', statut: 'option', label: 'Tournage FPV extérieur', type: 'fpv' },
  { jour: 21, dateStr: '2026-11-21', statut: 'reserve', label: 'Cabine cinéma week-end', type: 'cinema' },
  { jour: 22, dateStr: '2026-11-22', statut: 'reserve', label: 'Cabine cinéma week-end', type: 'cinema' },
  { jour: 23, dateStr: '2026-11-23', statut: 'libre' },
  { jour: 24, dateStr: '2026-11-24', statut: 'libre' },
  { jour: 25, dateStr: '2026-11-25', statut: 'libre' },
  { jour: 26, dateStr: '2026-11-26', statut: 'libre' },
  { jour: 27, dateStr: '2026-11-27', statut: 'libre' },
  { jour: 28, dateStr: '2026-11-28', statut: 'libre' },
  { jour: 29, dateStr: '2026-11-29', statut: 'reserve', label: 'Festival cinéma', type: 'cinema' },
  { jour: 30, dateStr: '2026-11-30', statut: 'libre' },
];

// 1er Nov 2026 était un Dimanche (index 6 si Lundi=0)
const decalageNovembre = 6; 
---

<Base
  titre="Agenda & Disponibilités"
  description="Consultez le planning d'intervention de Tom Bigot (projection cinéma, tournages drone FPV, missions de développement) et déposez une demande de dates autorisée."
>
  <main class="prose-screen">
    <header class="page-head">
      <div class="head-topline">
        <span class="etiquette">PLANIFICATION &bull; EN DIRECT</span>
        <a href="#demande-intervention" class="nav-pill pill-accent">Accès formulaire d'intervention &darr;</a>
      </div>
      <h1 class="page-title">AGENDA &amp; DISPONIBILITÉS</h1>
      <p class="page-subtitle">
        Planning prévisionnel de mes interventions pour exploitants de salles, directeurs de production et porteurs de projets techniques. Sélectionnez vos dates pour soumettre une demande.
      </p>
    </header>

    <!-- Légende & Repères -->
    <div class="agenda-toolbar">
      <div class="legend-group">
        <span class="legend-badge badge-libre">
          <span class="legend-dot dot-libre"></span>
          <span>DISPONIBLE (LIBRE)</span>
        </span>
        <span class="legend-badge badge-option">
          <span class="legend-dot dot-option"></span>
          <span>OPTION EN COURS</span>
        </span>
        <span class="legend-badge badge-reserve">
          <span class="legend-dot dot-reserve"></span>
          <span>RÉSERVÉ / INDISPONIBLE</span>
        </span>
      </div>
      <div class="month-label">
        <strong>NOVEMBRE 2026</strong>
      </div>
    </div>

    <!-- Calendrier Visuel -->
    <section class="calendar-card" aria-label="Calendrier Novembre 2026">
      <div class="calendar-grid">
        <!-- En-têtes des jours de la semaine -->
        <div class="weekday-col">LUN</div>
        <div class="weekday-col">MAR</div>
        <div class="weekday-col">MER</div>
        <div class="weekday-col">JEU</div>
        <div class="weekday-col">VEN</div>
        <div class="weekday-col">SAM</div>
        <div class="weekday-col">DIM</div>

        <!-- Cases vides avant le 1er jour -->
        {Array.from({ length: decalageNovembre }).map((_, i) => (
          <div class="day-cell day-empty" aria-hidden="true"></div>
        ))}

        <!-- Jours du mois -->
        {joursNovembre2026.map((item) => (
          <button
            type="button"
            class={`day-cell day-${item.statut} ${item.statut === 'libre' ? 'day-selectable' : ''}`}
            data-date={item.dateStr}
            data-statut={item.statut}
            title={item.label ? `${item.dateStr} — ${item.label}` : `${item.dateStr} — ${item.statut.toUpperCase()}`}
          >
            <div class="day-number">{item.jour}</div>
            <div class="day-status-indicator">
              {item.statut === 'libre' && <span class="status-txt txt-libre">Libre</span>}
              {item.statut === 'option' && <span class="status-txt txt-option">Option</span>}
              {item.statut === 'reserve' && <span class="status-txt txt-reserve">Occupé</span>}
            </div>
            {item.label && <div class="day-tag">{item.label}</div>}
          </button>
        ))}
      </div>
    </section>

    <!-- Zone de Demande d'Intervention / Réservation Autorisée -->
    <section id="demande-intervention" class="prose-card form-container">
      <div class="form-header">
        <span class="etiquette">RÉSERVATIONS &bull; ACCÈS AUTORISÉ</span>
        <h2>DEMANDE D'INTERVENTION &amp; POSE DE DATES</h2>
        <p class="form-intro">
          Cet espace est réservé aux cinémas partenaires, sociétés de production et collaborateurs disposant d'un code d'autorisation. Si vous n'avez pas encore de code, vous pouvez tout de même initier une première prise de contact.
        </p>
      </div>

      <form id="agendaForm" class="styled-agenda-form">
        <div class="form-row auth-row">
          <div class="form-field full-width">
            <label for="codeAcces">
              <strong>CODE D'AUTORISATION / ACCÈS PARTENAIRE</strong>
              <span class="label-help">(Obligatoire pour validation automatique directe)</span>
            </label>
            <div class="input-with-action">
              <input
                type="password"
                id="codeAcces"
                name="codeAcces"
                placeholder="Ex : CABINE-XXXX ou PROD-XXXX"
                autocomplete="off"
              />
              <button type="button" id="btnVerifierCode" class="btn-outline btn-inline">
                Vérifier
              </button>
            </div>
            <div id="codeFeedback" class="code-status"></div>
          </div>
        </div>

        <div class="form-grid-fields">
          <div class="form-field">
            <label for="typeMission">
              <strong>DOMAINE D'INTERVENTION *</strong>
            </label>
            <select id="typeMission" name="typeMission" required>
              <option value="">Sélectionnez un domaine...</option>
              <option value="projectionniste">Projectionniste Cinéma (DCI / 35mm / Cabine)</option>
              <option value="pilote-fpv">Pilote FPV Cinématique (Tournage / Suivi / Action)</option>
              <option value="developpement">Mission Développement (Web / STM32 / Systèmes)</option>
              <option value="autre">Autre demande technique</option>
            </select>
          </div>

          <div class="form-field">
            <label for="structure">
              <strong>ÉTABLISSEMENT / PRODUCTION / STRUCTURE *</strong>
            </label>
            <input
              type="text"
              id="structure"
              name="structure"
              placeholder="Ex : Cinéma Le Rex, Studio Prod..."
              required
            />
          </div>

          <div class="form-field">
            <label for="dateDebut">
              <strong>DATE DE DÉBUT SOUHAITÉE *</strong>
            </label>
            <input
              type="date"
              id="dateDebut"
              name="dateDebut"
              value="2026-11-04"
              required
            />
          </div>

          <div class="form-field">
            <label for="dateFin">
              <strong>DATE DE FIN (OU DATE UNIQUE) *</strong>
            </label>
            <input
              type="date"
              id="dateFin"
              name="dateFin"
              value="2026-11-04"
              required
            />
          </div>

          <div class="form-field">
            <label for="contactNom">
              <strong>NOM &amp; PRÉNOM DU CONTACT *</strong>
            </label>
            <input
              type="text"
              id="contactNom"
              name="contactNom"
              placeholder="Ex : Camille Martin"
              required
            />
          </div>

          <div class="form-field">
            <label for="contactEmail">
              <strong>EMAIL PROFESSIONNEL *</strong>
            </label>
            <input
              type="email"
              id="contactEmail"
              name="contactEmail"
              placeholder="Ex : direction@etablissement.fr"
              required
            />
          </div>

          <div class="form-field full-width">
            <label for="detailsMission">
              <strong>DÉTAILS DE LA MISSION &amp; HORAIRES PRÉVUS *</strong>
            </label>
            <textarea
              id="detailsMission"
              name="detailsMission"
              rows="5"
              placeholder="Précisez : horaires des séances, type d'appareil de projection ou format de tournage, contraintes particulières..."
              required
            ></textarea>
          </div>
        </div>

        <div class="form-footer">
          <button type="submit" class="btn-noir btn-submit">
            Envoyer la demande de réservation &rarr;
          </button>
          <p class="form-notice">
            Une confirmation par email vous sera envoyée sous 24h ouvrées. En cas d'urgence cabine ou tournage, contactez directement le standard.
          </p>
        </div>

        <div id="confirmationBanner" class="confirmation-box" style="display:none;">
          <h3>DEMANDE ENREGISTRÉE AVEC SUCCÈS</h3>
          <p id="confirmationMessage">
            Vos dates ont été prises en compte. Une notification immédiate a été transmise à Tom Bigot.
          </p>
          <a href="#" id="mailtoFallbackBtn" class="btn-outline btn-inline">
            Ouvrir une copie dans votre client mail &rarr;
          </a>
        </div>
      </form>
    </section>

    <!-- Raccourcis vers les sections détaillées -->
    <section class="prose-card links-ecosystem">
      <span class="etiquette">EXPLORER LES DOMAINES</span>
      <h2>DÉTAIL DE MES SPÉCIALITÉS</h2>
      <div class="swatch-grid">
        <a href="/projectionniste" class="card-link-block">
          <span class="etiquette">SALLE &bull; CABINE</span>
          <h3>Projectionniste Cinéma &rarr;</h3>
          <p>Compétences DCI &amp; 35mm, serveurs Doremi/Dolby, calibration acoustique et maintenance.</p>
        </a>
        <a href="/pilote-fpv" class="card-link-block">
          <span class="etiquette">AÉRIEN &bull; ACTION</span>
          <h3>Pilote Drone FPV &rarr;</h3>
          <p>Flotte cinématique sur mesure, poursuites dynamiques haute vitesse et cinewhoops intérieurs.</p>
        </a>
        <a href="/developpement" class="card-link-block">
          <span class="etiquette">SYSTÈMES &bull; LOGICIEL</span>
          <h3>Projets de Développement &rarr;</h3>
          <p>Architectures légères sans framework obèse, C/C++ sur STM32 et serveurs Debian autonomes.</p>
        </a>
      </div>
    </section>
  </main>
</Base>

<script>
  // Gestion du clic sur les cases du calendrier pour pré-remplir les dates
  const dayCells = document.querySelectorAll('.day-cell[data-date]');
  const inputDateDebut = document.getElementById('dateDebut') as HTMLInputElement | null;
  const inputDateFin = document.getElementById('dateFin') as HTMLInputElement | null;
  const inputCode = document.getElementById('codeAcces') as HTMLInputElement | null;
  const btnVerifier = document.getElementById('btnVerifierCode');
  const codeFeedback = document.getElementById('codeFeedback');
  const agendaForm = document.getElementById('agendaForm') as HTMLFormElement | null;
  const confirmationBanner = document.getElementById('confirmationBanner');
  const confirmationMessage = document.getElementById('confirmationMessage');
  const mailtoFallbackBtn = document.getElementById('mailtoFallbackBtn') as HTMLAnchorElement | null;

  // Codes partenaires autorisés (simulation sécurisée côté client avec fallback mail)
  const CODES_VALIDES = ['PROJ-2026', 'CABINE-75', 'CABINE-37', 'FPV-PROD', 'DEV-AUTORISE', 'TOM-INVITE'];

  dayCells.forEach((cell) => {
    cell.addEventListener('click', () => {
      const date = cell.getAttribute('data-date');
      const statut = cell.getAttribute('data-statut');
      
      if (!date) return;

      // Retirer la sélection active précédente
      document.querySelectorAll('.day-selected').forEach((el) => el.classList.remove('day-selected'));
      cell.classList.add('day-selected');

      if (inputDateDebut && inputDateFin) {
        inputDateDebut.value = date;
        inputDateFin.value = date;
      }

      // Scroll doux vers le formulaire
      const formElem = document.getElementById('demande-intervention');
      if (formElem) {
        formElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Vérification du code d'accès
  if (btnVerifier && inputCode && codeFeedback) {
    btnVerifier.addEventListener('click', () => {
      const code = inputCode.value.trim().toUpperCase();
      if (!code) {
        codeFeedback.innerHTML = '<span class="code-err">Veuillez renseigner un code d\'accès.</span>';
        return;
      }

      if (CODES_VALIDES.includes(code) || code.startsWith('CABINE') || code.startsWith('PROD') || code.startsWith('DEV')) {
        codeFeedback.innerHTML = '<span class="code-ok">&#10003; Code partenaire validé — Réservation prioritaire débloquée.</span>';
        inputCode.style.borderColor = 'var(--ink)';
      } else {
        codeFeedback.innerHTML = '<span class="code-warn">Code non reconnu. Votre demande sera traitée avec validation manuelle.</span>';
      }
    });
  }

  // Soumission du formulaire
  if (agendaForm) {
    agendaForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(agendaForm);
      const code = (formData.get('codeAcces') as string) || 'AUCUN';
      const typeMission = formData.get('typeMission') as string;
      const structure = formData.get('structure') as string;
      const debut = formData.get('dateDebut') as string;
      const fin = formData.get('dateFin') as string;
      const nom = formData.get('contactNom') as string;
      const email = formData.get('contactEmail') as string;
      const details = formData.get('detailsMission') as string;

      // Préparation du mailto fallback
      const sujet = encodeURIComponent(`[RÉSERVATION AGENDA] ${structure} — ${typeMission} (${debut})`);
      const corps = encodeURIComponent(
        `Bonjour Tom,\n\nVoici une demande d'intervention déposée via ton agenda en ligne :\n\n` +
        `• Code d'accès : ${code}\n` +
        `• Domaine : ${typeMission}\n` +
        `• Établissement / Structure : ${structure}\n` +
        `• Contact : ${nom} (${email})\n` +
        `• Dates : du ${debut} au ${fin}\n\n` +
        `Détails & Horaires :\n${details}\n\n` +
        `Transmis depuis tom-bigot.fr`
      );

      const mailtoUrl = `mailto:contact@tom-bigot.fr?subject=${sujet}&body=${corps}`;

      if (confirmationBanner && confirmationMessage) {
        confirmationBanner.style.display = 'block';
        confirmationMessage.textContent = `Votre demande pour "${structure}" du ${debut} au ${fin} a été enregistrée. Une confirmation directe a été envoyée.`;
        if (mailtoFallbackBtn) {
          mailtoFallbackBtn.href = mailtoUrl;
        }
        confirmationBanner.scrollIntoView({ behavior: 'smooth' });
      }

      // Envoi du clic mailto si nécessaire ou copie
      window.location.href = mailtoUrl;
    });
  }
</script>

<style>
  .prose-screen {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 56px) clamp(16px, 3vw, 36px);
  }

  .page-head {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 2px dashed var(--dash);
  }

  .head-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .pill-accent {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .pill-accent:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .page-title {
    font: 900 clamp(32px, 5vw, 56px)/1.05 var(--font);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 16px 0;
  }

  .page-subtitle {
    font: 400 17px/1.5 var(--font);
    color: rgba(0, 0, 0, 0.75);
    max-width: 760px;
    margin: 0;
  }

  /* Toolbar de l'agenda */
  .agenda-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 16px 20px;
    background: var(--paper);
    border: 2px dashed var(--dash);
    margin-bottom: 20px;
  }

  .legend-group {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .legend-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 700 11px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    display: inline-block;
  }

  .dot-libre {
    background: #000000;
    border: 2px solid #000000;
  }

  .dot-option {
    background: #ffffff;
    border: 2px dashed #000000;
  }

  .dot-reserve {
    background: #e2e2e2;
    border: 2px solid #888888;
  }

  .month-label {
    font: 700 14px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Grille Calendrier */
  .calendar-card {
    background: var(--paper);
    border: 2px dashed var(--dash);
    padding: 16px;
    margin-bottom: 40px;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
  }

  .weekday-col {
    font: 700 11px var(--font);
    letter-spacing: 0.14em;
    text-align: center;
    padding: 8px 4px;
    background: rgba(0, 0, 0, 0.04);
    color: var(--ink);
  }

  .day-cell {
    min-height: 84px;
    padding: 8px;
    border: 2px dashed var(--dash);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: left;
    transition: all 0.15s ease;
    cursor: default;
    position: relative;
  }

  .day-empty {
    border: none;
    background: transparent;
  }

  .day-selectable {
    cursor: pointer;
  }

  .day-selectable:hover {
    border-color: var(--ink);
    border-style: solid;
    transform: translateY(-2px);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .day-selected {
    border: 2px solid var(--ink) !important;
    background: rgba(0, 0, 0, 0.05);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .day-reserve {
    background: #f7f7f7;
    opacity: 0.75;
  }

  .day-option {
    background: #fafafa;
  }

  .day-number {
    font: 700 15px/1 var(--font);
    color: var(--ink);
  }

  .day-status-indicator {
    font: 700 10px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .txt-libre {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .txt-option {
    color: #666;
    font-style: italic;
  }

  .txt-reserve {
    color: #999;
  }

  .day-tag {
    font: 600 10px/1.2 var(--font);
    color: rgba(0, 0, 0, 0.7);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Formulaire */
  .prose-card {
    background: var(--paper);
    border: 2px dashed var(--dash);
    padding: clamp(20px, 3.5vw, 36px);
    margin-bottom: 40px;
  }

  .form-header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px dashed var(--dash);
  }

  .form-header h2 {
    font: 800 clamp(20px, 3vw, 28px)/1.2 var(--font);
    letter-spacing: -0.01em;
    margin: 8px 0;
  }

  .form-intro {
    font: 400 15px/1.5 var(--font);
    color: rgba(0, 0, 0, 0.7);
    margin: 0;
  }

  .auth-row {
    background: rgba(0, 0, 0, 0.03);
    padding: 18px;
    border: 2px dashed var(--dash);
    margin-bottom: 24px;
  }

  .input-with-action {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  .input-with-action input {
    flex: 1;
  }

  .form-grid-fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font: 700 11px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .label-help {
    font-weight: 400;
    text-transform: none;
    opacity: 0.65;
  }

  input[type='text'],
  input[type='email'],
  input[type='password'],
  input[type='date'],
  select,
  textarea {
    font: 400 14px var(--font);
    padding: 10px 12px;
    border: 2px solid var(--dash);
    background: var(--paper);
    color: var(--ink);
    border-radius: 0;
    transition: border-color 0.2s;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
