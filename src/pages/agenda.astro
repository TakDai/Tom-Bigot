---
import Base from '../layouts/Base.astro';

// Typage des créneaux
export interface JourPlanning {
  jour: number;
  dateStr: string; // YYYY-MM-DD
  statut: 'libre' | 'formation' | 'reserve_cine1' | 'reserve_cine2' | 'option';
  label?: string;
  detail?: string;
}

export interface MoisPlanning {
  nom: string;
  annee: number;
  decalageLundi: number; // 0=Lundi, 1=Mardi... 6=Dimanche
  jours: JourPlanning[];
}

// 1. Novembre 2026 (1er Nov = Dimanche => décalage 6)
const joursNovembre2026: JourPlanning[] = [
