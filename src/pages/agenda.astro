  { jour: 19, dateStr: '2026-11-19', statut: 'formation', label: 'CFA / Formation', detail: 'Maintenance préventive cabine' },
  { jour: 20, dateStr: '2026-11-20', statut: 'formation', label: 'CFA / Formation', detail: 'Contrôles réglementaires' },
  { jour: 21, dateStr: '2026-11-21', statut: 'reserve_cine2', label: 'Cinéma 2', detail: 'Week-end cabine DCI' },
  { jour: 22, dateStr: '2026-11-22', statut: 'reserve_cine2', label: 'Cinéma 2', detail: 'Week-end cabine DCI' },
  { jour: 23, dateStr: '2026-11-23', statut: 'libre', label: 'Disponible' },
  { jour: 24, dateStr: '2026-11-24', statut: 'libre', label: 'Disponible' },
  { jour: 25, dateStr: '2026-11-25', statut: 'libre', label: 'Disponible' },
  { jour: 26, dateStr: '2026-11-26', statut: 'libre', label: 'Disponible' },
  { jour: 27, dateStr: '2026-11-27', statut: 'libre', label: 'Disponible' },
  { jour: 28, dateStr: '2026-11-28', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Soirée ciné-débat régie' },
  { jour: 29, dateStr: '2026-11-29', statut: 'libre', label: 'Disponible' },
  { jour: 30, dateStr: '2026-11-30', statut: 'libre', label: 'Disponible' },
];

// 2. Décembre 2026 (1er Dec = Mardi => décalage 1)
const joursDecembre2026: JourPlanning[] = [
  { jour: 1, dateStr: '2026-12-01', statut: 'libre', label: 'Disponible' },
  { jour: 2, dateStr: '2026-12-02', statut: 'libre', label: 'Disponible' },
  { jour: 3, dateStr: '2026-12-03', statut: 'libre', label: 'Disponible' },
  { jour: 4, dateStr: '2026-12-04', statut: 'libre', label: 'Disponible' },
  { jour: 5, dateStr: '2026-12-05', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Cabine Week-end' },
  { jour: 6, dateStr: '2026-12-06', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Cabine Week-end' },
  { jour: 7, dateStr: '2026-12-07', statut: 'formation', label: 'CFA / Formation', detail: 'Pratique exploitation multi-salles' },
  { jour: 8, dateStr: '2026-12-08', statut: 'formation', label: 'CFA / Formation', detail: 'Processeurs IMS et automatisations' },
  { jour: 9, dateStr: '2026-12-09', statut: 'formation', label: 'CFA / Formation', detail: 'Diagnostic pannes de projection' },
  { jour: 10, dateStr: '2026-12-10', statut: 'formation', label: 'CFA / Formation', detail: 'Normes SMPTE & DCI' },
  { jour: 11, dateStr: '2026-12-11', statut: 'formation', label: 'CFA / Formation', detail: 'Bilan intermédiaire de compétences' },
  { jour: 12, dateStr: '2026-12-12', statut: 'libre', label: 'Disponible' },
  { jour: 13, dateStr: '2026-12-13', statut: 'libre', label: 'Disponible' },
  { jour: 14, dateStr: '2026-12-14', statut: 'libre', label: 'Disponible' },
  { jour: 15, dateStr: '2026-12-15', statut: 'libre', label: 'Disponible' },
  { jour: 16, dateStr: '2026-12-16', statut: 'reserve_cine2', label: 'Cinéma 2', detail: 'Sortie événementielle' },
  { jour: 17, dateStr: '2026-12-17', statut: 'libre', label: 'Disponible' },
  { jour: 18, dateStr: '2026-12-18', statut: 'libre', label: 'Disponible' },
  { jour: 19, dateStr: '2026-12-19', statut: 'reserve_cine2', label: 'Cinéma 2', detail: 'Vacances de Noël - Affluence' },
  { jour: 20, dateStr: '2026-12-20', statut: 'reserve_cine2', label: 'Cinéma 2', detail: 'Vacances de Noël - Affluence' },
  { jour: 21, dateStr: '2026-12-21', statut: 'libre', label: 'Disponible' },
  { jour: 22, dateStr: '2026-12-22', statut: 'libre', label: 'Disponible' },
  { jour: 23, dateStr: '2026-12-23', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Séances jeunesse' },
  { jour: 24, dateStr: '2026-12-24', statut: 'libre', label: 'Disponible' },
  { jour: 25, dateStr: '2026-12-25', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Séances de Noël' },
  { jour: 26, dateStr: '2026-12-26', statut: 'reserve_cine1', label: 'Cinéma 1', detail: 'Séances de Noël' },
  { jour: 27, dateStr: '2026-12-27', statut: 'libre', label: 'Disponible' },
  { jour: 28, dateStr: '2026-12-28', statut: 'libre', label: 'Disponible' },
  { jour: 29, dateStr: '2026-12-29', statut: 'libre', label: 'Disponible' },
  { jour: 30, dateStr: '2026-12-30', statut: 'libre', label: 'Disponible' },
  { jour: 31, dateStr: '2026-12-31', statut: 'reserve_cine2', label: 'Cinéma 2', detail: 'Séances Réveillon' },
];

const planningMois: MoisPlanning[] = [
  { nom: 'Novembre', annee: 2026, decalageLundi: 6, jours: joursNovembre2026 },
  { nom: 'Décembre', annee: 2026, decalageLundi: 1, jours: joursDecembre2026 },
];
---

<Base
  titre="Agenda & Réservations (Cabine & Drone FPV)"
  description="Planning des disponibilités de Tom Bigot. Réservation de vacations pour les 2 cinémas partenaires (avec suivi CFA) et calendrier de tournage / demandes de devis pour les clients drone FPV."
>
  <main class="prose-screen agenda-page">
    <header class="page-head agenda-header">
      <div class="head-topline">
        <span class="etiquette">PLANIFICATION &bull; EN DIRECT</span>
        <a href="#zone-formulaires" class="nav-pill pill-accent">Accéder aux formulaires de réservation &darr;</a>
      </div>
      <h1 class="page-title">AGENDA &amp; RÉSERVATIONS</h1>
      <p class="page-subtitle">
        Planning centralisé pour mes <strong>deux cinémas partenaires</strong> (coordination avec mes dates de formation CFA) et pour mes <strong>clients de production audiovisuelle en drone FPV</strong> (pose de dates de tournage, repérage ou demande de devis).
      </p>
    </header>

    <!-- Commutateur de profil : Cinéma vs Drone FPV -->
    <div class="domain-tabs-container">
      <div class="domain-tabs" role="tablist">
        <button
          type="button"
          id="tabBtnCinema"
          class="domain-tab active"
          role="tab"
          aria-selected="true"
          aria-controls="panelCinema"
        >
          <span class="tab-icon">🏛️</span>
          <span class="tab-label">
            <strong>CABINES CINÉMA</strong>
            <span>Mes 2 cinémas partenaires &amp; formations CFA</span>
          </span>
        </button>
        <button
          type="button"
          id="tabBtnFpv"
          class="domain-tab"
          role="tab"
          aria-selected="false"
          aria-controls="panelFpv"
        >
          <span class="tab-icon">🚁</span>
          <span class="tab-label">
            <strong>DRONE FPV &bull; DEVIS &amp; RDV</strong>
            <span>Tournages, repérages et chiffrage devis</span>
          </span>
        </button>
      </div>
    </div>

    <!-- CONSOLE CINÉMA : Raccourcis 2 cinémas partenaires -->
    <section id="bannerCinema" class="partner-quick-access domain-panel active-panel" aria-label="Sélection rapide cinéma partenaire">
      <div class="partner-banner-label">
        <span class="etiquette">ACCÈS EXPLOITANTS</span>
        <strong>Vous êtes l'un de mes cinémas partenaires ?</strong>
      </div>
      <div class="partner-buttons">
        <button type="button" class="btn-partner" data-preset-cine="cine1">
          <span class="partner-icon">🏛️</span>
          <span class="partner-info">
            <strong class="partner-name">CINÉMA PARTENAIRE 1</strong>
            <span class="partner-code">Sélectionner pour poser des vacations &rarr;</span>
          </span>
        </button>
        <button type="button" class="btn-partner" data-preset-cine="cine2">
          <span class="partner-icon">🎥</span>
          <span class="partner-info">
            <strong class="partner-name">CINÉMA PARTENAIRE 2</strong>
            <span class="partner-code">Sélectionner pour poser des vacations &rarr;</span>
          </span>
        </button>
      </div>
    </section>

    <!-- CONSOLE FPV : Raccourcis prestations FPV -->
    <section id="bannerFpv" class="fpv-quick-access domain-panel" style="display: none;" aria-label="Services drone FPV">
      <div class="partner-banner-label">
        <span class="etiquette">PRODUCTIONS &bull; MARQUES &bull; ÉVÉNEMENTS</span>
        <strong>Besoin d'un tournage FPV ou d'un devis chiffré ?</strong>
      </div>
      <div class="fpv-preset-grid">
        <button type="button" class="btn-fpv-preset" data-fpv-type="Tournage Cinématique FPV (Journée)">
          <span class="fpv-tag">TOURNAGE EXTÉRIEUR</span>
          <strong>Poursuite &amp; Action 5"</strong>
          <span>Pointes &gt;150 km/h &bull; Stabilisation Gyroflow</span>
        </button>
        <button type="button" class="btn-fpv-preset" data-fpv-type="Plan-séquence intérieur Cinewhoop">
          <span class="fpv-tag">INTÉRIEUR SÉCURISÉ</span>
          <strong>Cinewhoop Caréné</strong>
          <span>Bureaux, usines, musées &bull; Hélices protégées</span>
        </button>
        <button type="button" class="btn-fpv-preset" data-fpv-type="Rendez-vous préparatoire / Repérage">
          <span class="fpv-tag">PRÉPARATION</span>
          <strong>Repérage &amp; Briefing</strong>
          <span>Visite technique sur site &bull; Validation sécurité</span>
        </button>
        <button type="button" class="btn-fpv-preset" data-fpv-type="Demande de devis estimatif">
          <span class="fpv-tag">CHIFFRAGE</span>
          <strong>Devis sous 24h</strong>
          <span>Estimation détaillée selon votre cahier des charges</span>
        </button>
      </div>
    </section>

    <!-- Légende officielle des créneaux -->
    <div class="agenda-toolbar">
      <div class="legend-grid">
        <div class="legend-badge badge-libre">
          <span class="legend-box box-libre"></span>
          <div class="legend-txt">
            <strong>DISPONIBLE (LIBRE)</strong>
            <span>Créneau ouvert aux séances ou tournages FPV</span>
          </div>
        </div>
        <div class="legend-badge badge-formation">
          <span class="legend-box box-formation"></span>
          <div class="legend-txt">
            <strong>CFA / FORMATION</strong>
            <span>Période en apprentissage (non mobilisable)</span>
          </div>
        </div>
        <div class="legend-badge badge-cine1">
          <span class="legend-box box-cine1"></span>
          <div class="legend-txt">
            <strong>CINÉMA 1 (RÉSERVÉ)</strong>
            <span>Vacation ou remplacement planifié</span>
          </div>
        </div>
        <div class="legend-badge badge-cine2">
          <span class="legend-box box-cine2"></span>
          <div class="legend-txt">
            <strong>CINÉMA 2 (RÉSERVÉ)</strong>
            <span>Vacation ou remplacement planifié</span>
          </div>
        </div>
        <div class="legend-badge badge-option">
          <span class="legend-box box-option"></span>
          <div class="legend-txt">
            <strong>OPTION EN COURS</strong>
            <span>Date en cours de confirmation</span>
          </div>
        </div>
      </div>

      <!-- Contrôleur de mois -->
      <div class="month-selector-bar">
        <button type="button" id="btnPrevMonth" class="btn-outline btn-month" aria-label="Mois précédent">&larr; Mois précédent</button>
        <div class="current-month-display">
          <span class="etiquette">CALENDRIER SYNCHRONISÉ</span>
          <h2 id="activeMonthTitle" class="month-heading">NOVEMBRE 2026</h2>
        </div>
        <button type="button" id="btnNextMonth" class="btn-outline btn-month" aria-label="Mois suivant">Mois suivant &rarr;</button>
      </div>
    </div>

    <!-- Calendriers pour chaque mois -->
    {planningMois.map((mois, indexMois) => (
      <section
        id={`calendar-view-${indexMois}`}
        class={`calendar-card month-view ${indexMois === 0 ? 'is-active-month' : 'is-hidden-month'}`}
        aria-label={`Calendrier ${mois.nom} ${mois.annee}`}
        data-month-index={indexMois}
        data-month-name={`${mois.nom.toUpperCase()} ${mois.annee}`}
      >
        <div class="calendar-grid">
          <div class="weekday-col">LUN</div>
          <div class="weekday-col">MAR</div>
          <div class="weekday-col">MER</div>
          <div class="weekday-col">JEU</div>
          <div class="weekday-col">VEN</div>
          <div class="weekday-col">SAM</div>
          <div class="weekday-col">DIM</div>

          <!-- Cases vides de début de mois -->
          {Array.from({ length: mois.decalageLundi }).map((_, i) => (
            <div class="day-cell day-empty" aria-hidden="true"></div>
          ))}

          <!-- Jours du mois -->
          {mois.jours.map((item) => {
            const isLibre = item.statut === 'libre';
            const isFormation = item.statut === 'formation';
            const isCine1 = item.statut === 'reserve_cine1';
            const isCine2 = item.statut === 'reserve_cine2';
            const isOption = item.statut === 'option';

            return (
              <div
                class={`day-cell day-${item.statut} ${isLibre ? 'day-selectable' : 'day-locked'}`}
                data-date={item.dateStr}
                data-statut={item.statut}
                data-label={item.label}
                data-detail={item.detail || ''}
                role={isLibre ? 'button' : 'region'}
                tabindex={isLibre ? '0' : '-1'}
                title={item.detail ? `${item.dateStr} : ${item.label} (${item.detail})` : `${item.dateStr} : ${item.label}`}
              >
                <div class="day-topline">
                  <span class="day-number">{item.jour}</span>
                  {isLibre && <span class="tag-libre">+ Choisir</span>}
                  {isFormation && <span class="tag-formation">CFA</span>}
                  {isCine1 && <span class="tag-cine1">Ciné 1</span>}
                  {isCine2 && <span class="tag-cine2">Ciné 2</span>}
                  {isOption && <span class="tag-option">Option</span>}
                </div>

                <div class="day-body">
                  <div class="day-label-main">{item.label}</div>
                  {item.detail && <div class="day-detail-txt">{item.detail}</div>}
                </div>

                {isLibre && (
                  <div class="day-action-hint">
                    <span>Cliquez pour ajouter</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <!-- Panier de dates sélectionnées en direct -->
    <div id="selectionBar" class="selection-summary-bar" style="display: none;">
      <div class="selection-info">
        <span class="etiquette">DATES RETENUES SUR LE CALENDRIER</span>
        <div id="selectedDatesList" class="selected-tags-container"></div>
      </div>
      <div class="selection-actions">
        <button type="button" id="btnClearSelection" class="btn-clear">Vider la sélection</button>
        <a href="#zone-formulaires" class="btn-noir btn-jump-form">Finaliser la demande &darr;</a>
      </div>
    </div>

    <!-- ZONE DES DEUX FORMULAIRES (CINÉMA & FPV) -->
    <div id="zone-formulaires">
      <!-- FORMULAIRE 1 : CABINES CINÉMA -->
      <section id="formCinemaContainer" class="prose-card form-container">
        <div class="form-header">
          <div class="form-pre">
            <span class="etiquette">CABINE PROJECTION &bull; FORMULAIRE EXPLOITANT</span>
            <span class="badge-direct">TRANSMISSION DIRECTE</span>
          </div>
          <h2>POSER DES DATES D'INTERVENTION EN CABINE</h2>
          <p class="form-intro">
            Réservé à mes <strong>cinémas partenaires</strong> ou exploitants de salles. Sélectionnez vos dates libres sur le planning ci-dessus et indiquez vos séances.
          </p>
        </div>

        <form id="agendaFormCinema" class="styled-agenda-form">
          <div class="form-section-title">
            <span class="step-num">1</span>
            <h3>IDENTIFICATION DU CINÉMA PARTENAIRE</h3>
          </div>

          <div class="form-grid-fields">
            <div class="form-field full-width">
              <label>
                <strong>ÉTABLISSEMENT / SALLE DE CINÉMA *</strong>
              </label>
              <div class="cinema-radio-group">
                <label class="cinema-option-card">
                  <input type="radio" name="cinemaChoix" value="Cinéma Partenaire 1" id="radioCine1" checked />
                  <span class="option-content">
                    <strong>🏛️ Cinéma Partenaire 1</strong>
                    <span class="sub">Partenaire régulier</span>
                  </span>
                </label>
                <label class="cinema-option-card">
                  <input type="radio" name="cinemaChoix" value="Cinéma Partenaire 2" id="radioCine2" />
                  <span class="option-content">
                    <strong>🎥 Cinéma Partenaire 2</strong>
                    <span class="sub">Partenaire régulier</span>
                  </span>
                </label>
                <label class="cinema-option-card">
                  <input type="radio" name="cinemaChoix" value="Autre cinéma" id="radioCineAutre" />
                  <span class="option-content">
                    <strong>🏢 Autre établissement</strong>
                    <span class="sub">Festival / Salle indépendante</span>
                  </span>
                </label>
              </div>
            </div>

            <div class="form-field">
              <label for="structure">
                <strong>NOM PRÉCIS DU CINÉMA OU FESTIVAL *</strong>
              </label>
              <input
                type="text"
                id="structure"
                name="structure"
                value="Cinéma Partenaire 1"
                required
              />
            </div>

            <div class="form-field">
              <label for="contactNom">
                <strong>RESPONSABLE CABINE / DIRECTION *</strong>
              </label>
              <input
                type="text"
                id="contactNom"
                name="contactNom"
                placeholder="Ex : Philippe D."
                required
              />
            </div>

            <div class="form-field">
              <label for="contactEmail">
                <strong>EMAIL PROFESSIONNEL DU CINÉMA *</strong>
              </label>
              <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                placeholder="Ex : cabine@cinema.fr"
                required
              />
            </div>

            <div class="form-field">
              <label for="contactTelephone">
                <strong>TÉLÉPHONE DIRECT CABINE / RESPONSABLE</strong>
              </label>
              <input
                type="tel"
                id="contactTelephone"
                name="contactTelephone"
                placeholder="Ex : 02 47 XX XX XX"
              />
            </div>
          </div>

          <div class="form-section-title">
            <span class="step-num">2</span>
            <h3>CRÉNEAUX, SÉANCES &amp; DATES DEMANDÉES</h3>
          </div>

          <div class="form-grid-fields">
            <div class="form-field full-width">
              <label for="datesCinemaInput">
                <strong>DATE(S) RETENUE(S) POUR LA MISSION *</strong>
                <span class="label-help">(Sélectionnées automatiquement en cliquant sur le calendrier)</span>
              </label>
              <input
                type="text"
                id="datesCinemaInput"
                name="datesCinemaInput"
                placeholder="Ex : 2026-11-09, 2026-11-10..."
                required
              />
            </div>

            <div class="form-field">
              <label for="typeVacation">
                <strong>TYPE DE VACATION CABINE *</strong>
              </label>
              <select id="typeVacation" name="typeVacation" required>
                <option value="Soirée (18h00 - 23h30)">Soirée (18h00 - 23h30)</option>
                <option value="Après-midi + Soirée (13h45 - 23h30)">Après-midi + Soirée (13h45 - 23h30)</option>
                <option value="Après-midi seule (13h45 - 18h00)">Après-midi seule (13h45 - 18h00)</option>
                <option value="Matinée scolaire / Débat (08h30 - 12h30)">Matinée scolaire / Débat (08h30 - 12h30)</option>
                <option value="Journée continue (Week-end / Sortie)">Journée continue (Week-end / Affluence)</option>
                <option value="Remplacement d'urgence cabine">Remplacement d'urgence / Imprévu</option>
              </select>
            </div>

            <div class="form-field">
              <label for="technoCabine">
                <strong>SYSTÈME &amp; FORMAT DE PROJECTION</strong>
              </label>
              <select id="technoCabine" name="technoCabine">
                <option value="Numérique DCI standard (Barco/Christie)">Numérique DCI standard (Barco / Christie / Doremi)</option>
                <option value="Numérique DCI + Événementiel (Micros HF / Conférence)">DCI + Régie Débat / Rencontre réalisateur</option>
                <option value="Séance 35mm Argentique (Plateau / Bobines)">Séance 35mm Argentique (Montage bobines)</option>
                <option value="Autre configuration cabine">Autre configuration</option>
              </select>
            </div>

            <div class="form-field full-width">
              <label for="notesCabine">
                <strong>TITRES DES FILMS OU PRÉCISIONS POUR LA CABINE</strong>
              </label>
              <textarea
                id="notesCabine"
                name="notesCabine"
                rows="4"
                placeholder="Précisez les films au programme, horaires d'allumage des projecteurs, livraisons KDM ou particularités techniques..."
              ></textarea>
            </div>
          </div>

          <div class="form-footer">
            <button type="submit" class="btn-noir btn-submit">
              Valider et transmettre la proposition de dates &rarr;
            </button>
            <p class="form-notice">
              Une copie est automatiquement préparée pour votre messagerie et transmise en direct à Tom Bigot.
            </p>
          </div>

          <div id="confirmationBannerCinema" class="confirmation-box" style="display: none;">
            <h3>DEMANDE DE CABINE TRANSMISE AVEC SUCCÈS</h3>
            <p id="confirmationMessageCinema"></p>
            <a href="#" id="mailtoFallbackBtnCinema" class="btn-outline btn-inline">
              Ouvrir la copie dans votre messagerie &rarr;
            </a>
          </div>
        </form>
      </section>

      <!-- FORMULAIRE 2 : DRONE FPV (TOURNAGE, RENDEZ-VOUS & DEVIS) -->
      <section id="formFpvContainer" class="prose-card form-container" style="display: none;">
        <div class="form-header">
          <div class="form-pre">
            <span class="etiquette">TOURNAGE AÉRIEN &bull; DRONE FPV</span>
            <span class="badge-direct">DEVIS &amp; DATES EN DIRECT</span>
          </div>
          <h2>RÉSERVER UN TOURNAGE FPV OU DEMANDER UN DEVIS</h2>
          <p class="form-intro">
            Pour les boîtes de production, marques, organisateurs d'événements et entreprises. Choisissez une date sur le calendrier ou déposez votre demande de devis chiffré.
          </p>
        </div>

        <form id="agendaFormFpv" class="styled-agenda-form">
          <div class="form-section-title">
            <span class="step-num">1</span>
            <h3>COORDONNÉES DE PRODUCTION &amp; CLIENT</h3>
          </div>

          <div class="form-grid-fields">
            <div class="form-field">
              <label for="fpvSociete">
                <strong>SOCIÉTÉ / AGENCE / PRODUCTION *</strong>
              </label>
              <input
                type="text"
                id="fpvSociete"
                name="fpvSociete"
                placeholder="Ex : Studio Prod, Agence X, Client..."
                required
              />
            </div>

            <div class="form-field">
              <label for="fpvContactNom">
                <strong>NOM &amp; PRÉNOM DU RESPONSABLE *</strong>
              </label>
              <input
                type="text"
                id="fpvContactNom"
                name="fpvContactNom"
                placeholder="Ex : Julie Laurent"
                required
              />
            </div>

            <div class="form-field">
              <label for="fpvEmail">
                <strong>EMAIL PROFESSIONNEL *</strong>
              </label>
              <input
                type="email"
                id="fpvEmail"
                name="fpvEmail"
                placeholder="Ex : production@studio.fr"
                required
              />
            </div>

            <div class="form-field">
              <label for="fpvTelephone">
                <strong>TÉLÉPHONE DIRECT TOURNAGE *</strong>
              </label>
              <input
                type="tel"
                id="fpvTelephone"
                name="fpvTelephone"
                placeholder="Ex : 06 XX XX XX XX"
                required
              />
            </div>
          </div>

          <div class="form-section-title">
            <span class="step-num">2</span>
            <h3>OBJET DE LA DEMANDE &amp; DATES</h3>
          </div>

          <div class="form-grid-fields">
            <div class="form-field">
              <label for="fpvTypeDemande">
                <strong>TYPE D'INTERVENTION FPV SOUHAITÉE *</strong>
              </label>
              <select id="fpvTypeDemande" name="fpvTypeDemande" required>
                <option value="Tournage Cinématique FPV (Journée complète)">Tournage Journée complète (&gt; 6h de vol)</option>
                <option value="Tournage Cinématique FPV (Demi-journée)">Tournage Demi-journée (&le; 4h de vol)</option>
                <option value="Plan-séquence intérieur Cinewhoop">Plan-séquence intérieur (Bureaux / Musée / Usine)</option>
                <option value="Suivi haute vitesse / Sports / Véhicules">Suivi dynamique haute vitesse (Voitures / Sports)</option>
                <option value="Rendez-vous préparatoire & Repérage site">Rendez-vous préparatoire &amp; Repérage technique</option>
                <option value="Demande de devis estimatif sans date fixée">Demande de devis chiffré (dates prévisionnelles)</option>
              </select>
            </div>

            <div class="form-field">
              <label for="fpvDatesInput">
                <strong>DATE(S) ENVISAGÉE(S) OU CHOISIE(S) *</strong>
                <span class="label-help">(Sélectionnées sur le calendrier ou à renseigner)</span>
              </label>
              <input
                type="text"
                id="fpvDatesInput"
                name="fpvDatesInput"
                placeholder="Ex : 2026-11-23, ou période envisagée"
                required
              />
            </div>

            <div class="form-field">
              <label for="fpvLieu">
                <strong>LIEU PRÉVU DU VOL / TOURNAGE *</strong>
              </label>
              <input
                type="text"
                id="fpvLieu"
                name="fpvLieu"
                placeholder="Ex : Tours (37), Région Centre, Paris..."
                required
              />
            </div>

            <div class="form-field">
              <label for="fpvEnvironnement">
                <strong>ENVIRONNEMENT DE VOL</strong>
              </label>
              <select id="fpvEnvironnement" name="fpvEnvironnement">
                <option value="Intérieur sécurisé (ERP, Bureaux, Salle de spectacle)">Intérieur clos / ERP (Cinewhoop protégé)</option>
                <option value="Site privé extérieur (Circuit, Domaine, Usine)">Site privé extérieur (Espace sécurisé)</option>
                <option value="Extérieur naturel (Campagne, Forêt, Falaise)">Extérieur naturel (Grands espaces)</option>
                <option value="Espace public / Urbain (Démarches préfectorales requises)">Zone urbaine / Espace public</option>
              </select>
            </div>

            <div class="form-field full-width">
              <label for="fpvLivrables">
                <strong>LIVRABLES SOUHAITÉS &amp; POST-PRODUCTION</strong>
              </label>
              <select id="fpvLivrables" name="fpvLivrables">
                <option value="Rushs 4K/5K stabilisés Gyroflow (Prêt au montage)">Rushs 4K/5K stabilisés par Gyroflow (Prêt pour montage)</option>
                <option value="Rushs bruts Flat/Log + logs gyroscopiques">Rushs bruts Log + fichiers gyro bruts (.csv)</option>
                <option value="Prestation globale (Prise de vue + Montage + Étalonnage)">Prestation complète : tournage + montage + étalonnage</option>
              </select>
            </div>

            <div class="form-field full-width">
              <label for="fpvBrief">
                <strong>DESCRIPTION DU PROJET &amp; BRIEFS CRÉATIFS *</strong>
              </label>
              <textarea
                id="fpvBrief"
                name="fpvBrief"
                rows="5"
                placeholder="Décrivez votre projet : sujet du tournage, dynamique souhaitée, contraintes d'accès, budget envisagé, délai de rendu..."
                required
              ></textarea>
            </div>
          </div>

          <div class="form-footer">
            <button type="submit" class="btn-noir btn-submit">
              Envoyer la demande de tournage / devis FPV &rarr;
            </button>
            <p class="form-notice">
              Devis détaillé transmis sous 24h à 48h ouvrées. Démarches réglementaires et sécurité garanties.
            </p>
          </div>

          <div id="confirmationBannerFpv" class="confirmation-box" style="display: none;">
            <h3>DEMANDE FPV TRANSMISE AVEC SUCCÈS</h3>
            <p id="confirmationMessageFpv"></p>
            <a href="#" id="mailtoFallbackBtnFpv" class="btn-outline btn-inline">
              Ouvrir la copie dans votre messagerie &rarr;
            </a>
          </div>
        </form>
      </section>
    </div>

    <!-- Rappel des compétences cabine & FPV -->
    <section class="prose-card memo-cabine">
      <span class="etiquette">DOUBLE EXPERTISE OPÉRATIONNELLE</span>
      <h2>ENGAGEMENTS TECHNIQUES</h2>
      <div class="specs-grid">
        <div class="spec-box">
          <strong>Cabine Cinéma DCI &amp; 35mm</strong>
          <p>Disponibilité pour vos sorties nationales, remplacements d'urgence et séances de patrimoine.</p>
        </div>
        <div class="spec-box">
          <strong>Périodes CFA &amp; Apprentissage</strong>
          <p>Calendrier transparent pour ne jamais bloquer la planification de vos plannings de projection.</p>
        </div>
        <div class="spec-box">
          <strong>Drones FPV sur Mesure</strong>
          <p>Flotte cinématique 2.5", 3.5" et 5" adaptée à chaque scénario de cadrage aérien au millimètre.</p>
        </div>
        <div class="spec-box">
          <strong>Post-Production Gyroflow</strong>
          <p>Données inertielles synchronisées pour une fluidité digne des productions cinématographiques.</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // État local des dates sélectionnées
  const datesSelectionnees = new Set<string>();

  // Gestion des onglets de domaine (Cinéma vs FPV)
  const tabCinema = document.getElementById('tabBtnCinema');
  const tabFpv = document.getElementById('tabBtnFpv');
  const bannerCinema = document.getElementById('bannerCinema');
  const bannerFpv = document.getElementById('bannerFpv');
  const formCinemaContainer = document.getElementById('formCinemaContainer');
  const formFpvContainer = document.getElementById('formFpvContainer');

  let activeMode: 'cinema' | 'fpv' = 'cinema';

  function setMode(mode: 'cinema' | 'fpv') {
    activeMode = mode;
    if (mode === 'cinema') {
      tabCinema?.classList.add('active');
      tabCinema?.setAttribute('aria-selected', 'true');
      tabFpv?.classList.remove('active');
      tabFpv?.setAttribute('aria-selected', 'false');

      if (bannerCinema) bannerCinema.style.display = 'flex';
      if (bannerFpv) bannerFpv.style.display = 'none';
      if (formCinemaContainer) formCinemaContainer.style.display = 'block';
      if (formFpvContainer) formFpvContainer.style.display = 'none';
    } else {
      tabFpv?.classList.add('active');
      tabFpv?.setAttribute('aria-selected', 'true');
      tabCinema?.classList.remove('active');
      tabCinema?.setAttribute('aria-selected', 'false');

      if (bannerFpv) bannerFpv.style.display = 'flex';
      if (bannerCinema) bannerCinema.style.display = 'none';
      if (formFpvContainer) formFpvContainer.style.display = 'block';
      if (formCinemaContainer) formCinemaContainer.style.display = 'none';
    }
  }

  tabCinema?.addEventListener('click', () => setMode('cinema'));
  tabFpv?.addEventListener('click', () => setMode('fpv'));

  // Détection du hash #fpv ou #cinema dans l'URL
  if (window.location.hash.toLowerCase().includes('fpv')) {
    setMode('fpv');
  }

  // Contrôleur de mois (Novembre 2026 / Décembre 2026)
  const viewsMois = document.querySelectorAll('.month-view');
  const btnPrev = document.getElementById('btnPrevMonth') as HTMLButtonElement | null;
  const btnNext = document.getElementById('btnNextMonth') as HTMLButtonElement | null;
  const activeMonthTitle = document.getElementById('activeMonthTitle');

  let activeIndex = 0;
  const totalMois = viewsMois.length;

  function afficherMois(index: number) {
    viewsMois.forEach((view, i) => {
      if (i === index) {
        view.classList.remove('is-hidden-month');
        view.classList.add('is-active-month');
        const monthName = view.getAttribute('data-month-name');
        if (activeMonthTitle && monthName) {
          activeMonthTitle.textContent = monthName;
        }
      } else {
        view.classList.add('is-hidden-month');
        view.classList.remove('is-active-month');
      }
    });

    if (btnPrev) btnPrev.disabled = index === 0;
    if (btnNext) btnNext.disabled = index === totalMois - 1;
  }

  if (btnPrev && btnNext) {
    afficherMois(activeIndex);
    btnPrev.addEventListener('click', () => {
      if (activeIndex > 0) {
        activeIndex--;
        afficherMois(activeIndex);
      }
    });
    btnNext.addEventListener('click', () => {
      if (activeIndex < totalMois - 1) {
        activeIndex++;
        afficherMois(activeIndex);
      }
    });
  }

  // Presets pour les cinémas
  const btnPresetCine = document.querySelectorAll('[data-preset-cine]');
  const inputStructure = document.getElementById('structure') as HTMLInputElement | null;
  const radioCine1 = document.getElementById('radioCine1') as HTMLInputElement | null;
  const radioCine2 = document.getElementById('radioCine2') as HTMLInputElement | null;

  btnPresetCine.forEach((btn) => {
    btn.addEventListener('click', () => {
      setMode('cinema');
      const preset = btn.getAttribute('data-preset-cine');
      if (preset === 'cine1') {
        if (radioCine1) radioCine1.checked = true;
        if (inputStructure) inputStructure.value = 'Cinéma Partenaire 1';
      } else if (preset === 'cine2') {
        if (radioCine2) radioCine2.checked = true;
        if (inputStructure) inputStructure.value = 'Cinéma Partenaire 2';
      }
      btnPresetCine.forEach((b) => b.classList.remove('active-preset'));
      btn.classList.add('active-preset');

      const toolbar = document.querySelector('.agenda-toolbar');
      toolbar?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Presets pour FPV
  const btnFpvPreset = document.querySelectorAll('[data-fpv-type]');
  const selectFpvType = document.getElementById('fpvTypeDemande') as HTMLSelectElement | null;

  btnFpvPreset.forEach((btn) => {
    btn.addEventListener('click', () => {
      setMode('fpv');
      const val = btn.getAttribute('data-fpv-type');
      if (selectFpvType && val) {
        selectFpvType.value = val;
      }
      const toolbar = document.querySelector('.agenda-toolbar');
      toolbar?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Sélection dynamique des dates sur le calendrier
  const dayCells = document.querySelectorAll('.day-cell');
  const selectionBar = document.getElementById('selectionBar');
  const selectedDatesList = document.getElementById('selectedDatesList');
  const btnClearSelection = document.getElementById('btnClearSelection');
  const inputDatesCinema = document.getElementById('datesCinemaInput') as HTMLInputElement | null;
  const inputDatesFpv = document.getElementById('fpvDatesInput') as HTMLInputElement | null;

  function actualiserAffichageSelection() {
    if (!selectionBar || !selectedDatesList) return;

    selectedDatesList.innerHTML = '';

    if (datesSelectionnees.size === 0) {
      selectionBar.style.display = 'none';
      if (inputDatesCinema) inputDatesCinema.value = '';
      if (inputDatesFpv) inputDatesFpv.value = '';
      return;
    }

    selectionBar.style.display = 'flex';
    const datesTriees = Array.from(datesSelectionnees).sort();
    const strDates = datesTriees.join(', ');

    if (inputDatesCinema) inputDatesCinema.value = strDates;
    if (inputDatesFpv) inputDatesFpv.value = strDates;

    datesTriees.forEach((date) => {
      const pill = document.createElement('span');
      pill.className = 'date-pill-selected';
      pill.innerHTML = `<strong>${date}</strong> <button type="button" aria-label="Supprimer ${date}">&times;</button>`;

      const btnRemove = pill.querySelector('button');
      btnRemove?.addEventListener('click', (ev) => {
        ev.stopPropagation();
        retirerDate(date);
      });

      selectedDatesList.appendChild(pill);
    });
  }

  function ajouterDate(date: string) {
    datesSelectionnees.add(date);
    document.querySelectorAll(`.day-cell[data-date="${date}"]`).forEach((cell) => {
      cell.classList.add('day-selected');
    });
    actualiserAffichageSelection();
  }

  function retirerDate(date: string) {
    datesSelectionnees.delete(date);
    document.querySelectorAll(`.day-cell[data-date="${date}"]`).forEach((cell) => {
      cell.classList.remove('day-selected');
    });
    actualiserAffichageSelection();
  }

  dayCells.forEach((cell) => {
    cell.addEventListener('click', () => {
      const date = cell.getAttribute('data-date');
      const statut = cell.getAttribute('data-statut');
      const label = cell.getAttribute('data-label') || '';
      const detail = cell.getAttribute('data-detail') || '';

      if (!date) return;

      if (statut === 'formation') {
        alert(
          `Date indisponible :\n\nTom est en CFA / Formation projectionniste le ${date} (${detail || 'Apprentissage'}).\nCette date ne peut pas accueillir de vacation cinéma ni de tournage FPV.`
        );
        return;
      }

      if (statut === 'reserve_cine1' || statut === 'reserve_cine2') {
        alert(
          `Date déjà réservée :\n\nTom est déjà programmé pour une séance cabine le ${date} (${label} — ${detail}).\nMerci de choisir une date libre.`
        );
        return;
      }

      if (datesSelectionnees.has(date)) {
        retirerDate(date);
      } else {
        ajouterDate(date);
      }
    });
  });

  btnClearSelection?.addEventListener('click', () => {
    datesSelectionnees.clear();
    document.querySelectorAll('.day-selected').forEach((c) => c.classList.remove('day-selected'));
    actualiserAffichageSelection();
  });

  // Soumission Formulaire Cinéma
  const formCinema = document.getElementById('agendaFormCinema') as HTMLFormElement | null;
  const confCinema = document.getElementById('confirmationBannerCinema');
  const confMsgCinema = document.getElementById('confirmationMessageCinema');
  const mailtoBtnCinema = document.getElementById('mailtoFallbackBtnCinema') as HTMLAnchorElement | null;

  formCinema?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(formCinema);
    const structure = (data.get('structure') as string) || 'Cinéma';
    const contact = (data.get('contactNom') as string) || '';
    const email = (data.get('contactEmail') as string) || '';
    const tel = (data.get('contactTelephone') as string) || 'Non renseigné';
    const dates = (data.get('datesCinemaInput') as string) || 'Non spécifiées';
    const vacation = (data.get('typeVacation') as string) || '';
    const techno = (data.get('technoCabine') as string) || '';
    const notes = (data.get('notesCabine') as string) || 'Aucune';

    const sujet = encodeURIComponent(`[CABINE CINÉMA] Proposition de dates — ${structure} (${dates})`);
    const corps = encodeURIComponent(
      `Bonjour Tom,\n\nUne demande d'intervention cabine vient d'être posée via ton agenda :\n\n` +
      `• Établissement : ${structure}\n` +
      `• Contact responsable : ${contact}\n` +
      `• Email : ${email}\n` +
      `• Téléphone cabine : ${tel}\n` +
      `• Date(s) demandée(s) : ${dates}\n` +
      `• Vacation : ${vacation}\n` +
      `• Système : ${techno}\n\n` +
      `Titres des films & Notes d'exploitation :\n${notes}\n\n` +
      `---\nTransmis depuis tom-bigot.fr`
    );

    const mailtoUrl = `mailto:contact@tom-bigot.fr?subject=${sujet}&body=${corps}`;

    if (confCinema && confMsgCinema) {
      confCinema.style.display = 'block';
      confMsgCinema.textContent = `Votre demande pour le "${structure}" sur les dates (${dates}) a été enregistrée. Une copie directe a été transmise.`;
      if (mailtoBtnCinema) mailtoBtnCinema.href = mailtoUrl;
      confCinema.scrollIntoView({ behavior: 'smooth' });
    }
    window.location.href = mailtoUrl;
  });

  // Soumission Formulaire FPV
  const formFpv = document.getElementById('agendaFormFpv') as HTMLFormElement | null;
  const confFpv = document.getElementById('confirmationBannerFpv');
  const confMsgFpv = document.getElementById('confirmationMessageFpv');
  const mailtoBtnFpv = document.getElementById('mailtoFallbackBtnFpv') as HTMLAnchorElement | null;

  formFpv?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(formFpv);
    const societe = (data.get('fpvSociete') as string) || 'Client FPV';
    const contact = (data.get('fpvContactNom') as string) || '';
    const email = (data.get('fpvEmail') as string) || '';
    const tel = (data.get('fpvTelephone') as string) || '';
    const typeDemande = (data.get('fpvTypeDemande') as string) || '';
    const dates = (data.get('fpvDatesInput') as string) || 'Non spécifiées';
    const lieu = (data.get('fpvLieu') as string) || '';
    const env = (data.get('fpvEnvironnement') as string) || '';
    const livrables = (data.get('fpvLivrables') as string) || '';
    const brief = (data.get('fpvBrief') as string) || '';

    const sujet = encodeURIComponent(`[DRONE FPV - ${typeDemande.toUpperCase()}] ${societe} (${dates})`);
    const corps = encodeURIComponent(
      `Bonjour Tom,\n\nUne nouvelle demande pour une prestation Drone FPV vient d'être formulée via ton agenda en ligne :\n\n` +
      `• Structure / Production : ${societe}\n` +
      `• Contact : ${contact}\n` +
      `• Email : ${email}\n` +
      `• Téléphone : ${tel}\n\n` +
      `DÉTAILS DU PROJET :\n` +
      `• Type de demande : ${typeDemande}\n` +
      `• Date(s) souhaitée(s) : ${dates}\n` +
      `• Lieu du tournage / vol : ${lieu}\n` +
      `• Environnement : ${env}\n` +
      `• Livrables vidéo : ${livrables}\n\n` +
      `Brief créatif & Précisions :\n${brief}\n\n` +
      `---\nTransmis depuis l'agenda tom-bigot.fr`
    );

    const mailtoUrl = `mailto:contact@tom-bigot.fr?subject=${sujet}&body=${corps}`;

    if (confFpv && confMsgFpv) {
      confFpv.style.display = 'block';
      confMsgFpv.textContent = `Votre demande pour "${societe}" (${typeDemande}) a été enregistrée. Une copie a été préparée pour votre messagerie et transmise à Tom.`;
      if (mailtoBtnFpv) mailtoBtnFpv.href = mailtoUrl;
      confFpv.scrollIntoView({ behavior: 'smooth' });
    }
    window.location.href = mailtoUrl;
  });
</script>

<style>
  .agenda-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 56px) clamp(16px, 3vw, 36px);
  }

  .agenda-header {
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 2px dashed var(--dash);
  }

  .head-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .pill-accent {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .pill-accent:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .page-title {
    font: 900 clamp(30px, 4.5vw, 52px)/1.08 var(--font);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 14px 0;
  }

  .page-subtitle {
    font: 400 16.5px/1.55 var(--font);
    color: rgba(0, 0, 0, 0.75);
    max-width: 820px;
