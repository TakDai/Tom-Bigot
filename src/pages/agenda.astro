---

<Base
  titre="Agendas Indépendants : Cabine Cinéma & Drone FPV"
  description="Consultez les agendas dédiés et indépendants de Tom Bigot : planning cabines pour cinémas partenaires (avec suivi CFA) et calendrier tournage / devis pour clients drone FPV."
>
  <main class="prose-screen agenda-page">
    <header class="page-head agenda-header">
      <div class="head-topline">
        <span class="etiquette">PLANIFICATION &bull; AGENDAS INDÉPENDANTS</span>
        <div class="agenda-switch-pills">
          <a href="#agenda-cinema" id="quickLinkCinema" class="nav-pill active-nav-pill">Agenda Cinéma</a>
          <a href="#agenda-fpv" id="quickLinkFpv" class="nav-pill">Agenda Drone FPV</a>
        </div>
      </div>
      <h1 class="page-title">AGENDAS INDÉPENDANTS</h1>
      <p class="page-subtitle">
        Deux espaces de planification totalement distincts pour garantir la confidentialité et la précision de chaque métier : l'agenda <strong>Cabines Cinéma</strong> pour mes 2 cinémas partenaires et l'agenda <strong>Drone FPV</strong> pour les productions audiovisuelles.
      </p>
    </header>

    <!-- BANDEAU ACCÈS DIRECT PAR ORGANISATION -->
    <aside class="org-subdomain-hub" aria-label="Espaces dédiés par organisation">
      <div class="org-hub-header">
        <span class="etiquette">PAGES DÉDIÉES &bull; SOUS-DOMAINES RÉSERVÉS</span>
        <span class="hub-privacy-badge">ISOLATION STRICTE CONFIDENTIALITÉ</span>
      </div>
      <p class="org-hub-desc">
        Chaque établissement dispose désormais de sa propre page exclusive avec formulaire adapté et calendrier isolé. Cliquez sur votre espace dédié :
      </p>
      <div class="org-hub-grid">
        <a href="/agenda/cine-off" class="org-hub-card">
          <span class="hub-icon">🎞️</span>
          <div class="hub-info">
            <strong>Ciné-Off (37)</strong>
            <small>cine-off.tom-bigot.fr</small>
            <span>Circuit itinérant &bull; Tournées &rarr;</span>
          </div>
        </a>
        <a href="/agenda/les-studios" class="org-hub-card">
          <span class="hub-icon">🏛️</span>
          <div class="hub-info">
            <strong>Les Studios (Tours)</strong>
            <small>studios.tom-bigot.fr</small>
            <span>7 Écrans &bull; Cabines &amp; 35mm &rarr;</span>
          </div>
        </a>
        <a href="/agenda/fpv" class="org-hub-card">
          <span class="hub-icon">🚁</span>
          <div class="hub-info">
            <strong>Drone FPV &amp; Devis</strong>
            <small>fpv.tom-bigot.fr</small>
            <span>Tournages &bull; Devis instantané &rarr;</span>
          </div>
        </a>
        <a href="/agenda/admin" class="org-hub-card">
          <span class="hub-icon">🛡️</span>
          <div class="hub-info">
            <strong>Superviseur</strong>
            <small>admin.tom-bigot.fr</small>
            <span>Master planning consolidé &rarr;</span>
          </div>
        </a>
      </div>
    </aside>

    <!-- GRAND SÉLECTEUR D'AGENDA INDÉPENDANT -->
    <nav class="agenda-master-selector" aria-label="Sélection de l'agenda">
      <button
        type="button"
        id="btnSelectCinema"
        class="agenda-master-tab active"
        aria-controls="agenda-cinema-wrapper"
        aria-selected="true"
      >
        <span class="master-tab-icon">🏛️</span>
        <div class="master-tab-text">
          <div class="master-tab-title-line">
            <strong>1. AGENDA CABINES CINÉMA</strong>
            <span class="subdomain-badge">cine.tom-bigot.fr</span>
          </div>
          <span>Mes 2 cinémas partenaires &bull; Suivi des semaines CFA</span>
        </div>
        <span class="master-tab-arrow">&rarr;</span>
      </button>

      <button
        type="button"
        id="btnSelectFpv"
        class="agenda-master-tab"
        aria-controls="agenda-fpv-wrapper"
        aria-selected="false"
      >
        <span class="master-tab-icon">🚁</span>
        <div class="master-tab-text">
          <div class="master-tab-title-line">
            <strong>2. AGENDA DRONE FPV &amp; DEVIS</strong>
            <span class="subdomain-badge">fpv.tom-bigot.fr</span>
          </div>
          <span>Tournages cinématiques, repérages &bull; Devis sous 24h</span>
        </div>
        <span class="master-tab-arrow">&rarr;</span>
      </button>
