---

<Base
  titre="Agenda & Calendrier"
  description="Calendrier consolidé et disponibilités en direct de Tom Bigot : exploitation cabines cinéma numérique DCI et tournages drone FPV."
>
  <main class="agenda-large-screen">
    <!-- En-tête minimaliste avec bouton retour -->
    <header class="agenda-page-head">
      <div class="agenda-breadcrumb">
        <a href="/" class="back-link">
          <span class="back-arrow">&larr;</span>
          <span>Retour au portfolio</span>
        </a>
        <span class="breadcrumb-sep">&bull;</span>
        <span class="breadcrumb-tag">CALENDRIER TEMPS RÉEL</span>
      </div>

      <div class="head-titles">
        <h1 class="page-title">AGENDA &amp; CALENDRIER</h1>
        <p class="page-subtitle">
          Vue d'ensemble consolidée : exploitation de cabines cinéma numérique DCI, tournages par drone FPV et formations techniques.
        </p>
      </div>

      <!-- Légende minimaliste -->
      <div class="agenda-legend-bar">
        <div class="legend-item">
          <span class="legend-indicator ind-disponible"></span>
          <span>Disponible (Libre)</span>
        </div>
        <div class="legend-item">
          <span class="legend-indicator ind-cabine"></span>
          <span>Cabine Numérique DCI</span>
        </div>
        <div class="legend-item">
          <span class="legend-indicator ind-fpv"></span>
          <span>Tournage Drone FPV</span>
        </div>
        <div class="legend-item">
          <span class="legend-indicator ind-formation"></span>
          <span>Formation CFA DCI</span>
        </div>
        <div class="legend-item">
          <span class="legend-indicator ind-option"></span>
          <span>Option Posée</span>
        </div>
      </div>
    </header>

    <!-- Grande vue sur tout le calendrier -->
    <section class="calendar-master-view" aria-label="Grand calendrier des disponibilités">
      {moisListe.map((mois) => (
        <div class="month-block" id={mois.id}>
          <div class="month-head">
            <h2 class="month-title">{mois.nom.toUpperCase()} {mois.annee}</h2>
            <span class="month-count">{mois.jours.length} JOURS</span>
          </div>

          <!-- Grille des 7 jours de la semaine -->
          <div class="weekdays-row" aria-hidden="true">
            {joursSemaine.map((j) => (
              <div class="weekday-cell">{j}</div>
            ))}
          </div>

          <!-- Grille des jours du mois -->
          <div class="days-grid">
            {/* Cases vides pour le décalage du 1er jour */}
            {Array.from({ length: mois.decalageLundi }).map((_, i) => (
              <div class="day-cell day-offset" aria-hidden="true"></div>
            ))}

            {/* Cases des jours */}
            {mois.jours.map((item) => (
              <button
                type="button"
                class={`day-cell day-${item.type}`}
                data-date={item.dateStr}
                data-jour={item.jour}
                data-type={item.type}
                data-badge={item.badge}
                data-titre={item.titre}
                data-detail={item.detail}
                aria-label={`${item.jourSemaine} ${item.jour} ${mois.nom} 2026 : ${item.badge} - ${item.titre}`}
              >
                <div class="day-top">
                  <span class="day-number">{item.jour < 10 ? `0${item.jour}` : item.jour}</span>
                  <span class="day-weekday-mobile">{item.jourSemaine}</span>
                </div>
                <div class="day-body">
                  <span class={`day-badge badge-${item.type}`}>{item.badge}</span>
                  <span class="day-titre">{item.titre}</span>
                  <span class="day-detail">{item.detail}</span>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Boîte d'action rapide / Contact -->
    <aside class="agenda-action-box">
      <div class="action-box-main">
        <span class="action-box-tag">RÉSERVATION &amp; VACATIONS</span>
        <h3 class="action-box-title">Poser une option sur une date</h3>
        <p class="action-box-desc">
          Un créneau disponible vous intéresse pour un remplacement cabine, une régie de festival ou une captation par drone FPV ? Écrivez-moi directement avec la date souhaitée.
        </p>
      </div>
      <div class="action-box-btns">
        <a href="mailto:contact@tom-bigot.fr?subject=Option%20créneau%20agenda" class="btn-noir">
          <span>Contacter par email</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/" class="btn-retour-home">
          <span>Retour au portfolio</span>
          <span class="btn-arrow">&larr;</span>
        </a>
      </div>
    </aside>

    <!-- Modal dialogue de détail pour chaque jour -->
    <dialog id="dayModal" class="minimal-modal">
      <div class="modal-card">
        <header class="modal-header">
          <span class="modal-tag" id="modalTag">DÉTAIL DU CRÉNEAU</span>
          <button type="button" class="btn-close-modal" id="btnCloseModal" aria-label="Fermer la vue détaillée">&times;</button>
        </header>
        <div class="modal-body">
          <h4 class="modal-date" id="modalDate">Vendredi 13 Novembre 2026</h4>
          <div class="modal-status-badge" id="modalBadge">DISPONIBLE</div>
          <p class="modal-text" id="modalDetail">Détail du jour...</p>
        </div>
        <footer class="modal-footer">
          <a href="#" id="modalMailto" class="btn-noir">
            <span>Poser une option pour ce jour</span>
            <span class="btn-arrow">&rarr;</span>
          </a>
        </footer>
      </div>
    </dialog>
  </main>

  <script>
    function initMinimalAgenda() {
      const dayModal = document.getElementById('dayModal') as HTMLDialogElement | null;
      const modalDate = document.getElementById('modalDate');
      const modalBadge = document.getElementById('modalBadge');
      const modalDetail = document.getElementById('modalDetail');
      const modalMailto = document.getElementById('modalMailto') as HTMLAnchorElement | null;
      const btnCloseModal = document.getElementById('btnCloseModal');

      if (!dayModal) return;

      document.querySelectorAll('.day-cell:not(.day-offset)').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dateStr = btn.getAttribute('data-date') || '';
          const badge = btn.getAttribute('data-badge') || '';
          const titre = btn.getAttribute('data-titre') || '';
          const detail = btn.getAttribute('data-detail') || '';
          const type = btn.getAttribute('data-type') || '';

          if (modalDate) modalDate.textContent = dateStr;
          if (modalBadge) {
            modalBadge.textContent = `${badge} — ${titre}`;
            modalBadge.className = `modal-status-badge badge-${type}`;
          }
          if (modalDetail) modalDetail.textContent = detail;
          if (modalMailto) {
            modalMailto.href = `mailto:contact@tom-bigot.fr?subject=Option%20créneau%20agenda%20du%20${encodeURIComponent(dateStr)}`;
          }

          dayModal.showModal();
        });
      });

      if (btnCloseModal) {
        btnCloseModal.addEventListener('click', () => dayModal.close());
      }

      dayModal.addEventListener('click', (e) => {
        const rect = dayModal.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          dayModal.close();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMinimalAgenda);
    } else {
      initMinimalAgenda();
    }
  </script>
</Base>

<style>
  /* ==========================================================================
     PAGE AGENDA GRAND FORMAT & MINIMALISTE
     ========================================================================== */
  .agenda-large-screen {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 56px) clamp(16px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vh, 48px);
    color: #000000;
  }

  /* Fil d'ariane & Bouton retour */
  .agenda-breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 700 11px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #000000;
    text-decoration: none;
    padding: 6px 14px;
    border: 1.5px solid #000000;
    border-radius: 6px;
    background: #ffffff;
    transition: all 0.15s ease;
  }

  .back-link:hover {
    background: #000000;
    color: #ffffff;
    transform: translateX(-2px);
  }

  .back-arrow {
    font-size: 13px;
  }

  .breadcrumb-sep {
    color: rgba(0, 0, 0, 0.3);
  }

  .breadcrumb-tag {
    color: rgba(0, 0, 0, 0.6);
  }

  /* Titre & sous-titre */
  .head-titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 8px;
  }

  .page-title {
    margin: 0;
    font: 900 clamp(28px, 4.5vw, 48px)/1.1 var(--font);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000000;
  }

  .page-subtitle {
    margin: 0;
    font: 400 clamp(14px, 1.6vw, 17px)/1.55 var(--font);
    color: rgba(0, 0, 0, 0.75);
    max-width: 820px;
  }

  /* Barre de légende */
  .agenda-legend-bar {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    flex-wrap: wrap;
    padding: 14px 18px;
    border: 1.5px dashed #000000;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 3px 3px 0 #000000;
    font: 700 11px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .legend-indicator {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1.5px solid #000000;
    display: inline-block;
  }

  .ind-disponible {
    background: #ffffff;
    border-style: dashed;
  }

  .ind-cabine {
    background: #000000;
  }

  .ind-fpv {
    background: #000000;
    border-radius: 50%;
  }

  .ind-formation {
    background: #e5e5e5;
  }

  .ind-option {
    background: #ffffff;
    border-style: dotted;
  }

  /* Grande vue du calendrier */
