---
import Base from '../layouts/Base.astro';

interface CalendarDay {
  jour: number;
  dateStr: string;
  jourSemaine: string;
}

interface CalendarMonth {
  nom: string;
  annee: number;
  id: string;
  decalageLundi: number;
  jours: CalendarDay[];
}

const joursSemaineLabels = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];

function buildMonth(annee: number, moisIndex: number, nom: string, nbJours: number): CalendarMonth {
  const premierJour = new Date(annee, moisIndex, 1);
  const dayOfWeek = premierJour.getDay();
  const decalageLundi = (dayOfWeek + 6) % 7;

  const jours: CalendarDay[] = [];
  for (let j = 1; j <= nbJours; j++) {
    const d = new Date(annee, moisIndex, j);
    const mm = String(moisIndex + 1).padStart(2, '0');
    const dd = String(j).padStart(2, '0');
    jours.push({
      jour: j,
      dateStr: `${annee}-${mm}-${dd}`,
      jourSemaine: joursSemaineLabels[d.getDay()],
    });
  }

  return {
    nom,
    annee,
    id: `${nom.toLowerCase()}-${annee}`,
    decalageLundi,
    jours,
  };
}

const moisNovembre2026 = buildMonth(2026, 10, 'Novembre', 30);
const moisDecembre2026 = buildMonth(2026, 11, 'Décembre', 31);
const moisListe = [moisNovembre2026, moisDecembre2026];
const joursSemaine = ['LUN', 'MAR', 'MER', 'JEU', 'VEN', 'SAM', 'DIM'];
---

<Base
  titre="Agenda & Calendrier"
  description="Calendrier des disponibilités et réservations de mission de Tom Bigot : cabines de cinéma, drone FPV et développement logiciel."
>
  <main class="agenda-large-screen">
    <!-- En-tête minimaliste avec bouton retour -->
    <header class="agenda-page-head">
      <div class="agenda-breadcrumb">
        <a href="/" class="back-link">
          <span class="back-arrow">&larr;</span>
          <span>Retour au portfolio</span>
        </a>
        <span class="breadcrumb-sep">&bull;</span>
        <span class="breadcrumb-tag">CALENDRIER DE MISSION</span>
      </div>

      <div class="head-titles">
        <h1 class="page-title">AGENDA &amp; CALENDRIER</h1>
        <p class="page-subtitle">
          Calendrier des disponibilités pour vacations cabine cinéma, tournages drone FPV et missions techniques.
        </p>
      </div>

      <!-- Barre d'état minimaliste -->
      <div class="agenda-legend-bar">
        <div class="legend-item">
          <span class="legend-indicator ind-disponible"></span>
          <span>Créneau disponible / Optionnable</span>
        </div>
        <span class="legend-sep">&bull;</span>
        <span class="legend-hint">Cliquez sur une date pour poser une option ou échanger sur vos besoins.</span>
      </div>
    </header>

    <!-- Grande vue sur tout le calendrier -->
    <section class="calendar-master-view" aria-label="Grand calendrier des disponibilités">
      {moisListe.map((mois) => (
        <div class="month-block" id={mois.id}>
          <div class="month-head">
            <h2 class="month-title">{mois.nom.toUpperCase()} {mois.annee}</h2>
            <span class="month-count">{mois.jours.length} JOURS</span>
          </div>

          <!-- Grille des 7 jours de la semaine -->
          <div class="weekdays-row" aria-hidden="true">
            {joursSemaine.map((j) => (
              <div class="weekday-cell">{j}</div>
            ))}
          </div>

          <!-- Grille des jours du mois -->
          <div class="days-grid">
            {/* Cases vides pour le décalage du 1er jour */}
            {Array.from({ length: mois.decalageLundi }).map((_, i) => (
              <div class="day-cell day-offset" aria-hidden="true"></div>
            ))}

            {/* Cases des jours */}
            {mois.jours.map((item) => (
              <button
                type="button"
                class="day-cell day-disponible"
                data-date={item.dateStr}
                data-jour={item.jour}
                data-semaine={item.jourSemaine}
                data-mois={`${mois.nom} ${mois.annee}`}
                aria-label={`${item.jourSemaine} ${item.jour} ${mois.nom} ${mois.annee} : Disponible`}
              >
                <div class="day-top">
                  <span class="day-number">{item.jour < 10 ? `0${item.jour}` : item.jour}</span>
                  <span class="day-weekday-mobile">{item.jourSemaine}</span>
                </div>
                <div class="day-body">
                  <span class="day-badge badge-disponible">DISPONIBLE</span>
                  <span class="day-titre">Créneau ouvert</span>
                  <span class="day-detail">Poser une option</span>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Boîte d'action rapide / Contact -->
    <aside class="agenda-action-box">
      <div class="action-box-main">
        <span class="action-box-tag">RÉSERVATION &amp; VACATIONS</span>
        <h3 class="action-box-title">Poser une option ou échanger sur vos dates</h3>
        <p class="action-box-desc">
          Une date vous intéresse pour un remplacement cabine cinéma, une prestation drone FPV ou un projet logiciel ? Écrivez-moi directement avec la date souhaitée.
        </p>
      </div>
      <div class="action-box-btns">
        <a href="mailto:contact@tom-bigot.fr?subject=Option%20créneau%20agenda" class="btn-noir">
          <span>Contacter par email</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/" class="btn-retour-home">
          <span>Retour au portfolio</span>
          <span class="btn-arrow">&larr;</span>
        </a>
      </div>
    </aside>

    <!-- Modal dialogue de détail pour chaque jour -->
    <dialog id="dayModal" class="minimal-modal">
      <div class="modal-card">
        <header class="modal-header">
          <span class="modal-tag">DÉTAIL DU CRÉNEAU</span>
          <button type="button" class="btn-close-modal" id="btnCloseModal" aria-label="Fermer la vue détaillée">&times;</button>
        </header>
        <div class="modal-body">
          <h4 class="modal-date" id="modalDate">13 Novembre 2026</h4>
          <div class="modal-status-badge badge-disponible">CRÉNEAU DISPONIBLE</div>
          <p class="modal-text">
            Cette date est ouverte pour une intervention en cabine de cinéma numérique, un tournage par drone FPV ou une mission de développement.
          </p>
        </div>
        <footer class="modal-footer">
          <a href="#" id="modalMailto" class="btn-noir">
            <span>Poser une option pour ce jour</span>
            <span class="btn-arrow">&rarr;</span>
          </a>
        </footer>
      </div>
    </dialog>
  </main>

  <script>
    function initMinimalAgenda() {
      const dayModal = document.getElementById('dayModal') as HTMLDialogElement | null;
      const modalDate = document.getElementById('modalDate');
      const modalMailto = document.getElementById('modalMailto') as HTMLAnchorElement | null;
      const btnCloseModal = document.getElementById('btnCloseModal');

      if (!dayModal) return;

      document.querySelectorAll('.day-cell:not(.day-offset)').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dateStr = btn.getAttribute('data-date') || '';
          const jour = btn.getAttribute('data-jour') || '';
          const semaine = btn.getAttribute('data-semaine') || '';
          const mois = btn.getAttribute('data-mois') || '';

          if (modalDate) {
            modalDate.textContent = `${semaine} ${jour} ${mois}`;
          }
          if (modalMailto) {
            modalMailto.href = `mailto:contact@tom-bigot.fr?subject=Option%20créneau%20agenda%20du%20${encodeURIComponent(dateStr)}`;
          }

          dayModal.showModal();
        });
      });

      if (btnCloseModal) {
        btnCloseModal.addEventListener('click', () => dayModal.close());
      }

      dayModal.addEventListener('click', (e) => {
        const rect = dayModal.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          dayModal.close();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMinimalAgenda);
    } else {
      initMinimalAgenda();
    }
  </script>
</Base>

<style>
  /* ==========================================================================
     PAGE AGENDA GRAND FORMAT & MINIMALISTE
     ========================================================================== */
  .agenda-large-screen {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 56px) clamp(16px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vh, 48px);
    color: #000000;
  }

  /* Fil d'ariane & Bouton retour */
  .agenda-breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 700 11px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #000000;
    text-decoration: none;
    padding: 6px 14px;
    border: 1.5px solid #000000;
    border-radius: 6px;
    background: #ffffff;
    transition: all 0.15s ease;
  }

  .back-link:hover {
    background: #000000;
    color: #ffffff;
    transform: translateX(-2px);
  }

  .back-arrow {
    font-size: 13px;
  }

  .breadcrumb-sep {
    color: rgba(0, 0, 0, 0.3);
  }

  .breadcrumb-tag {
    color: rgba(0, 0, 0, 0.6);
  }

  /* Titre & sous-titre */
  .head-titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 8px;
  }

  .page-title {
    margin: 0;
    font: 900 clamp(28px, 4.5vw, 48px)/1.1 var(--font);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000000;
  }

  .page-subtitle {
    margin: 0;
    font: 400 clamp(14px, 1.6vw, 17px)/1.55 var(--font);
    color: rgba(0, 0, 0, 0.75);
    max-width: 820px;
  }

  /* Barre de légende */
  .agenda-legend-bar {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.8vw, 18px);
    flex-wrap: wrap;
    padding: 14px 18px;
    border: 1.5px dashed #000000;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 3px 3px 0 #000000;
    font: 700 11px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .legend-indicator {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1.5px solid #000000;
    display: inline-block;
  }

  .ind-disponible {
    background: #ffffff;
    border-style: dashed;
  }

  .legend-sep {
    color: rgba(0, 0, 0, 0.3);
  }

  .legend-hint {
    font-weight: 500;
    color: rgba(0, 0, 0, 0.7);
    text-transform: none;
    letter-spacing: normal;
    font-size: 12px;
  }

  /* Grande vue du calendrier */
  .calendar-master-view {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .month-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 2px solid #000000;
    border-radius: 14px;
    background: #ffffff;
    padding: clamp(16px, 2.5vw, 28px);
    box-shadow: 5px 5px 0 #000000;
  }

  .month-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 2px dashed rgba(0, 0, 0, 0.2);
  }

  .month-title {
    margin: 0;
    font: 900 clamp(20px, 2.5vw, 28px) var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
  }

  .month-count {
    font: 700 11px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid #000000;
    border-radius: 4px;
    background: #fafafa;
  }

  /* Ligne des jours de la semaine */
  .weekdays-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    text-align: center;
    font: 800 12px var(--font);
    letter-spacing: 0.14em;
    color: rgba(0, 0, 0, 0.65);
    padding: 6px 0;
  }

  .weekday-cell {
    padding: 4px;
  }

  /* Grille des jours */
  .days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
  }

  .day-cell {
    min-height: 100px;
    padding: 10px;
    border: 1.5px dashed #000000;
    border-radius: 8px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
    color: #000000;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
  }

  .day-cell:hover {
    transform: translateY(-2px);
    box-shadow: 3px 3px 0 #000000;
    background: #fafafa;
    border-style: solid;
  }

  .day-cell.day-offset {
    border: 1px dashed rgba(0, 0, 0, 0.1);
    background: #fafafa;
    cursor: default;
    min-height: 100px;
  }

  .day-cell.day-offset:hover {
    transform: none;
    box-shadow: none;
    background: #fafafa;
    border-style: dashed;
  }

  .day-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .day-number {
    font: 900 16px/1 var(--font);
    letter-spacing: 0.04em;
    color: #000000;
  }

  .day-weekday-mobile {
    display: none;
    font: 700 10px var(--font);
    color: rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
  }

  .day-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
  }

  .day-badge {
    align-self: flex-start;
    font: 800 9px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    line-height: 1.2;
  }

  .badge-disponible {
    background: #ffffff;
    color: #000000;
    border: 1px dashed #000000;
  }

  .day-titre {
    font: 700 11.5px/1.3 var(--font);
    letter-spacing: 0.02em;
    color: #000000;
  }

  .day-detail {
    font: 400 10.5px/1.35 var(--font);
    color: rgba(0, 0, 0, 0.6);
  }

  /* Boîte d'action rapide / Contact */
  .agenda-action-box {
    border: 1.5px dashed #000000;
    border-radius: 12px;
    background: #ffffff;
    padding: clamp(24px, 3.5vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    box-shadow: 4px 4px 0 #000000;
  }

  .action-box-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 700px;
  }

  .action-box-tag {
    font: 700 10px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
  }

  .action-box-title {
    margin: 0;
    font: 900 clamp(18px, 2.2vw, 24px) var(--font);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #000000;
  }

  .action-box-desc {
    margin: 0;
    font: 400 14px/1.55 var(--font);
    color: rgba(0, 0, 0, 0.7);
  }

  .action-box-btns {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-retour-home {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px;
    height: 38px;
    border: 1.5px solid #000000;
    border-radius: 19px;
    background: #ffffff;
    color: #000000;
    text-decoration: none;
    font: 700 12px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: all 0.15s ease;
  }

  .btn-retour-home:hover {
    background: #000000;
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Modal minimale */
  .minimal-modal {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 480px;
    width: 90%;
  }

  .minimal-modal::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
  }

  .modal-card {
    border: 2px solid #000000;
    border-radius: 12px;
    background: #ffffff;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 6px 6px 0 #000000;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1.5px dashed rgba(0, 0, 0, 0.2);
  }

  .modal-tag {
    font: 700 10.5px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
  }

  .btn-close-modal {
    border: 1.5px solid #000000;
    background: #ffffff;
    border-radius: 6px;
    width: 28px;
    height: 28px;
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-close-modal:hover {
    background: #000000;
    color: #ffffff;
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .modal-date {
    margin: 0;
    font: 900 22px var(--font);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #000000;
  }

  .modal-status-badge {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 4px;
    font: 800 11px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modal-text {
    margin: 6px 0 0 0;
    font: 400 14px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.8);
  }

  .modal-footer {
    padding-top: 12px;
    border-top: 1.5px dashed rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: flex-end;
  }

  .modal-footer .btn-noir {
    gap: 8px;
    width: 100%;
    justify-content: center;
  }

  /* Responsive pour tablette et mobile */
  @media (max-width: 900px) {
    .weekdays-row {
      display: none;
    }

    .days-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .day-cell.day-offset {
      display: none;
    }

    .day-cell {
      min-height: auto;
      padding: 14px;
    }

    .day-weekday-mobile {
      display: inline-block;
    }
  }
</style>
