---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projets = await getCollection('projets', ({ data }) => !data.brouillon);
  return projets.map((projet) => ({ params: { id: projet.id }, props: { projet } }));
}

const { projet } = Astro.props;
const { Content } = await render(projet);
const { titre, resume, nature, statut, domaines, lien, github, annee } = projet.data;
const meta = [nature, statut, annee].filter(Boolean).join(' · ');

const logoMap: Record<string, string> = {
  '127il': '/assets/logos/127il.svg',
  'fix-my-drone': '/assets/logos/fix-my-drone.svg',
  'inskin': '/assets/logos/inskin.png',
  'komeon': '/assets/logos/komeon.png',
  'lestourangeaux': '/assets/logos/lestourangeaux.svg',
  'multi-motors': '/assets/logos/multi-motors.svg',
  'openbots': '/assets/logos/openbots.png',
  'pensee-nocturne': '/assets/logos/pensee-nocturne.svg',
  'superviseur': '/assets/logos/superviseur.svg',
  'tete-de-piaf': '/assets/logos/tdp.png',
  'tours2tours': '/assets/logos/tours2tours.png',
};

const logoUrl = logoMap[projet.id];
---

<Base titre={titre} description={resume}>
  <main class="prose-screen">
    <div class="retour-bar">
      <a href="/#projets" class="nav-pill">&larr; Retour aux projets</a>
    </div>

    <header class="page-head fiche-head">
      {logoUrl && (
        <div class="fiche-logo">
          <img src={logoUrl} alt={titre} />
        </div>
      )}
      <div>
        {meta && <span class="etiquette">{meta}</span>}
        <h1 class="page-title">{titre}</h1>
        <p class="page-subtitle">{resume}</p>
      </div>
    </header>

    {
      (domaines.length > 0 || lien || github) && (
        <article class="prose-card meta-box">
          <h2>INFORMATIONS CLÉS</h2>
          <div class="meta-grille">
            {domaines.length > 0 && (
              <div>
                <span class="etiquette">Domaines</span>
                <div class="domaines-pills">
                  {domaines.map((d: string) => (
                    <span class="nav-pill pill-sm">{d}</span>
                  ))}
                </div>
              </div>
            )}
            {lien && (
              <div>
                <span class="etiquette">Accès au projet</span>
                <div style="margin-top: 6px;">
                  <a href={lien} target="_blank" rel="noopener noreferrer" class="btn-noir btn-sm">
                    Ouvrir le site ↗
                  </a>
                </div>
              </div>
            )}
            {github && (
              <div>
                <span class="etiquette">Code source &amp; Dépôt</span>
                <div style="margin-top: 6px;">
                  <a href={github} target="_blank" rel="noopener noreferrer" class="btn-outline btn-sm">
                    Voir sur GitHub ↗
                  </a>
                </div>
              </div>
            )}
          </div>
        </article>
      )
    }

    <article class="prose-card contenu-markdown">
      <Content />
    </article>

    <div class="retour-bar">
      <a href="/#projets" class="nav-pill">&larr; Retour à la liste des projets</a>
    </div>
  </main>
</Base>

<style>
  .prose-screen {
    flex: 1;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 48px) clamp(16px, 4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .retour-bar {
    display: flex;
    align-items: center;
  }

  .fiche-head {
    display: flex;
    align-items: center;
    gap: 24px;
    border-bottom: 2px dashed var(--dash);
    padding-bottom: 24px;
  }

  .fiche-logo {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed var(--dash);
    border-radius: 12px;
    padding: 8px;
    background: #fafafa;
  }

  .fiche-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .page-title {
    margin: 4px 0 8px;
    font: 700 clamp(26px, 5vw, 38px)/1.15 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-subtitle {
    margin: 0;
    font: 400 14px/1.55 var(--font);
    letter-spacing: 0.03em;
    color: rgba(0, 0, 0, 0.75);
  }

  .prose-card {
    border: 2px dashed var(--dash);
    border-radius: 12px;
    padding: clamp(20px, 3vw, 28px);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .prose-card h2 {
    margin: 0;
    font: 700 15px/1.3 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .prose-card h2::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--ink);
  }

  .meta-grille {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
  }

  .domaines-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }

  .pill-sm {
    height: 24px;
    padding: 0 10px;
    font-size: 10px;
  }

  .btn-sm {
    height: 32px;
    padding: 0 14px;
    font-size: 11px;
  }

  .contenu-markdown :global(h2) {
    margin: 24px 0 10px;
    font: 700 16px/1.3 var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contenu-markdown :global(p) {
    margin: 0 0 14px;
    font: 400 14px/1.65 var(--font);
    color: rgba(0, 0, 0, 0.85);
  }

  .contenu-markdown :global(ul) {
    margin: 0 0 14px;
    padding-left: 20px;
    font: 400 14px/1.65 var(--font);
    color: rgba(0, 0, 0, 0.85);
  }

  .contenu-markdown :global(li) {
    margin-bottom: 6px;
  }

  @media (max-width: 600px) {
    .fiche-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
