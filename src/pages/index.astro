  .r-term-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffffff;
  }

  .r-term-text {
    font: 700 8px/1.2 var(--font);
    color: #cccccc;
    text-transform: uppercase;
    word-break: normal;
    overflow-wrap: break-word;
    display: block;
  }

  .r-term-actions {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    padding: 0 4px;
    box-sizing: border-box;
  }

  .r-btn {
    display: block;
    width: 100%;
    padding: 3px 0;
    text-align: center;
    text-decoration: none;
    font: 700 7px var(--font);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 2px;
  }

  .r-btn-white {
    background: #ffffff;
    color: #000000;
  }

  .r-btn-ghost {
    background: transparent;
    color: #ffffff;
    border: 1px dashed rgba(255, 255, 255, 0.4);
  }

  .ribbon-chevron-cut {
    width: 100%;
    height: 16px;
    background: #000000;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    margin-top: 4px;
  }
