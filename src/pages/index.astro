          {nextProject && (() => {
            const v = transitionVariants[idx % transitionVariants.length];
            return (
              <div
                class="project-nonlinear-transition"
                style={`--curr-pastel: ${p.color}; --next-pastel: ${nextProject.color};`}
                aria-hidden="true"
              >
                <svg viewBox="0 0 1440 180" preserveAspectRatio="none" class="single-line-svg">
                  <!-- Fond haut : pastel du projet actuel -->
                  <rect width="1440" height="180" fill="var(--curr-pastel)" />
                  <!-- Forme basse : pastel du projet suivant délimité par la courbe non-linéaire -->
                  <path d={v.shapeD} fill="var(--next-pastel)" />
                  <!-- La ligne unique : trait net continu séparant les deux projets -->
                  <path d={v.lineD} class="single-transition-line" />
                </svg>
              </div>
            );
          })()}
        </article>
      );
    })}
