---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Récupération de tous les projets publiés
const tousProjets = await getCollection('projets', ({ data }) => !data.brouillon);

// Tri chronologique décroissant (2026, 2025...) puis par ordre croissant
const projetsChronologiques = tousProjets.sort((a, b) => {
  const anneeA = Number(a.data.annee) || 0;
  const anneeB = Number(b.data.annee) || 0;
  if (anneeB !== anneeA) {
    return anneeB - anneeA;
  }
  return a.data.ordre - b.data.ordre || a.data.titre.localeCompare(b.data.titre, 'fr');
});

// Regroupement par année
const projetsParAnnee = projetsChronologiques.reduce((groupes, projet) => {
  const annee = projet.data.annee || 'Autres';
  if (!groupes[annee]) {
    groupes[annee] = [];
  }
  groupes[annee].push(projet);
  return groupes;
}, {} as Record<string | number, typeof tousProjets>);

const annees = Object.keys(projetsParAnnee).sort((a, b) => Number(b) - Number(a));

// Derniers articles de blog (3 plus récents)
const derniersArticles = (await getCollection('blog', ({ data }) => !data.brouillon))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function formaterDate(d: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(d);
}

const logoMap: Record<string, string> = {
  '127il': '/assets/logos/127il.svg',
  'fix-my-drone': '/assets/logos/fix-my-drone.svg',
  'inskin': '/assets/logos/inskin.png',
  'komeon': '/assets/logos/komeon.png',
  'lestourangeaux': '/assets/logos/lestourangeaux.svg',
  'multi-motors': '/assets/logos/multi-motors.png',
  'openbots': '/assets/logos/openbots.png',
  'pensee-nocturne': '/assets/logos/pensee-nocturne.svg',
  'superviseur': '/assets/logos/superviseur.svg',
  'tete-de-piaf': '/assets/logos/tdp.png',
  'tours2tours': '/assets/logos/tours2tours.png',
};

const chronoItems = [
  {
    id: 'lestourangeaux',
    type: 'projet',
    annee: '2025',
    titre: 'Les Tourangeaux',
    sousTitre: 'Portail régional & écosystème local indépendant',
    tempsFort: 'Mise en ligne du portail et référencement autonome de plus de 150 artisans, tiers-lieux et initiatives tourangelles.',
    pause: 'Mise en retrait temporaire du web pour se consacrer au prototypage matériel et à l\'outillage d\'atelier.',
    resume: 'Portail communautaire indépendant valorisant les créateurs, commerces et événements de Tours et du Val de Loire.',
    statut: 'En production',
    domaines: ['Web', 'Communauté', 'Région'],
    logo: '/assets/logos/lestourangeaux.svg',
    lien: '/projets/lestourangeaux',
  },
  {
    id: 'pause-2025-2026',
    type: 'pause',
    annee: 'Hiver 2025-2026',
    titre: 'Pause & Installation Atelier',
    sousTitre: 'Transition Hardware & R&D physique',
    tempsFort: 'Étalonnage des fers à souder, acquisition d\'imprimantes 3D et aménagement d\'un laboratoire électronique dédié en Touraine.',
    pause: '3 mois de recherche fondamentale sans publication de code, concentrés sur la micro-électronique et les STM32.',
    resume: 'Intermède indispensable : passage d\'un environnement 100% logiciel à un véritable atelier physique de prototypage.',
    statut: 'Jalon clé',
