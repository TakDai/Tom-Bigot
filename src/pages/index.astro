          <a href="/agenda" class="btn-noir btn-pilier">Consulter mon agenda &rarr;</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ================= 03. BANDEAUX VERTICAUX PAR PROJET (DE HAUT EN BAS) ================= -->
  <section id="projets-chronologie" class="conteneur section-bandeaux-verticaux">
    <header class="timeline-header">
      <div class="header-pre">
        <span class="etiquette">03 &bull; PARCOURS PAR PROJET ({bandeauxProjets.length} BANDEAUX)</span>
      </div>
      <div class="chrono-head-flex">
        <div>
          <h2 class="timeline-main-title">CHRONOLOGIE DU TRAVAIL SUR CHAQUE PROJET</h2>
          <p class="timeline-main-desc">
            Chaque bandeau vertical retrace l'histoire d'un projet, de haut en bas : genèse, phases de développement, pauses d'atelier et temps forts d'application.
          </p>
        </div>
        <!-- Légende des types de blocs -->
        <div class="bandeaux-legende" aria-label="Légende des étapes">
          <span class="legende-pill"><span class="leg-dot phase-dot">&#9632;</span> Phase</span>
          <span class="legende-pill"><span class="leg-dot tf-dot">&#9733;</span> Temps Fort</span>
          <span class="legende-pill"><span class="leg-dot pause-dot">&#9208;</span> Pause</span>
        </div>
      </div>
    </header>

    <!-- Défilement latéral des bandeaux verticaux -->
    <div class="bandeaux-scroll-wrapper">
      <div class="bandeaux-v-grid" id="bandeauxGrid">
        {
          bandeauxProjets.map((projet) => (
            <article class="bandeau-col-v" id={`projet-${projet.id}`}>
              <!-- En-tête du bandeau (haut) -->
              <div class="bandeau-v-head">
                <div class="bandeau-v-topline">
                  <span class="bandeau-v-num">{projet.numero}</span>
                  <span class="domaine-pill">{projet.domaine}</span>
                </div>
                <div class="bandeau-v-brand">
                  <div class="bandeau-v-logo">
                    <img src={projet.logo} alt={`Logo ${projet.titre}`} loading="lazy" />
                  </div>
                  <div>
                    <h3 class="bandeau-v-title">{projet.titre}</h3>
                    <p class="bandeau-v-sub">{projet.sousTitre}</p>
                  </div>
                </div>
              </div>

              <!-- Ligne de temps verticale de haut en bas -->
              <div class="bandeau-v-track">
                <!-- Rail vertical -->
                <div class="v-track-line">
                  <div class="v-track-fill" />
                </div>

                <!-- Étapes chronologiques de haut en bas -->
                <div class="v-track-steps">
                  {projet.etapes.map((etape) => {
                    const isTempsFort = etape.type === 'temps_fort';
                    const isPause = etape.type === 'pause';
                    const isStatut = etape.type === 'statut';

                    return (
                      <div
                        class={`v-step-node ${isTempsFort ? 'is-temps-fort' : ''} ${isPause ? 'is-pause' : ''} ${isStatut ? 'is-statut' : ''}`}
                      >
                        <div class="v-step-bullet" aria-hidden="true">
                          {isTempsFort ? '★' : isPause ? '⏸' : isStatut ? '●' : '■'}
                        </div>
                        <div class="v-step-card">
                          <div class="v-step-head">
                            <span class="v-step-date">{etape.date}</span>
                            {isTempsFort && <span class="v-tf-badge">TEMPS FORT</span>}
                            {isPause && <span class="v-pause-badge">PAUSE R&D</span>}
                          </div>
                          <h4 class="v-step-title">{etape.titre}</h4>
                          <p class="v-step-desc">{etape.desc}</p>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>

              <!-- Pied de bandeau : Lien vers la fiche -->
              <div class="bandeau-v-foot">
                <a href={projet.lien} class="btn-noir bandeau-v-btn">
                  Fiche complète &rarr;
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= 03. DERNIERS ARTICLES DU BLOG ================= -->
  <section class="conteneur section-blog-home">
    <header class="timeline-header">
