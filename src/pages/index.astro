    font: 700 clamp(32px, 7vw, 64px)/1.08 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }

  .hero-subtitle {
    margin: 0 0 32px;
    font: 400 clamp(13px, 2vw, 16px)/1.55 var(--font);
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    max-width: 640px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-hero {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .scroll-cue {
    position: absolute;
    bottom: 24px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #ffffff;
    opacity: 0.8;
    transition: opacity 0.2s, transform 0.2s;
  }

  .scroll-cue:hover {
    opacity: 1;
    transform: translateY(3px);
  }

  .scroll-label {
    font: 700 10px var(--font);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    font-size: 16px;
    animation: bounceDown 2s infinite ease-in-out;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ==========================================================================
     SECTION DES BANDEAUX DU TEMPS (PARALLÈLES, AUCUN L'UN SUR L'AUTRE)
     ========================================================================== */
  .bandeaux-timeline-section {
    position: relative;
    background: #ffffff;
    padding: clamp(40px, 6vh, 80px) clamp(10px, 2vw, 24px);
    overflow-x: hidden !important;
    border-bottom: 2px dashed var(--dash);
  }

  .timeline-viewport {
    display: flex;
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
    gap: 16px;
    align-items: stretch;
    overflow-x: hidden !important;
  }

  /* Règle de temps verticale discrète */
  .timeline-time-rail {
    width: 85px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1.5px dashed rgba(0, 0, 0, 0.2);
  }

  .rail-node {
    height: 250px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 10px;
    position: relative;
    box-sizing: border-box;
  }

  .rail-year {
    font: 800 10.5px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    text-align: right;
  }

  .rail-tick {
    position: absolute;
    right: -4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #000000;
  }

  /* Piste des 10 couloirs parallèles : STRICTEMENT CÔTE À CÔTE */
  .timeline-parallel-tracks {
    display: flex;
    flex: 1;
    min-width: 0;
    gap: 8px;
    width: 100%;
    overflow-x: hidden !important;
  }

  .timeline-lane {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .lane-segment {
    height: 250px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
  }

  /* Espace vide (quand le projet n'a pas commencé ou est sous terre en pause) */
  .ribbon-empty-space {
    width: 100%;
    height: 100%;
  }

  /* ==========================================================================
     LE RUBAN NOIR EN CONTINU
     ========================================================================== */
  .ribbon-band {
    width: 100%;
    height: 100%;
    background: #000000;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 4px;
    box-sizing: border-box;
    text-align: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    transition: transform 0.15s ease;
  }

  .ribbon-band:hover {
    transform: scale(1.03);
    z-index: 5;
  }

  /* Début du ruban */
  .ribbon-start {
    justify-content: flex-start;
    padding-top: 10px;
  }

  .ribbon-rivet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    margin-bottom: 6px;
  }

  .ribbon-head-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 6px;
    border-bottom: 1px solid #222222;
    margin-bottom: 8px;
    width: 100%;
  }

  .r-num {
    font-family: monospace;
    font-size: 8.5px;
    font-weight: 700;
    color: #888888;
  }

  .r-title {
    font: 700 9px/1.2 var(--font);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ffffff;
    word-break: normal;
    overflow-wrap: break-word;
  }

  .ribbon-step-box {
    padding: 0 2px;
    width: 100%;
    box-sizing: border-box;
  }

  .r-step-title {
    font: 700 8.5px/1.25 var(--font);
    color: #cccccc;
    text-transform: uppercase;
    word-break: normal;
    overflow-wrap: break-word;
    display: block;
  }

  /* Temps fort ★ */
  .ribbon-running.is-star {
    border-left: 2px solid #ffffff;
    border-right: 2px solid #ffffff;
  }

  .r-star-pill {
    font-size: 11px;
    color: #ffffff;
    margin-bottom: 4px;
    line-height: 1;
  }

  /* ==========================================================================
     FENTE 3D (ENTRÉE DANS LE MUR & RESSORTIE)
     ========================================================================== */
  .ribbon-dive-container,
  .ribbon-emerge-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ribbon-pre-dive {
    flex: 1;
    background: linear-gradient(to bottom, #000000 0%, #222222 100%);
  }

  .wall-slit {
    width: 100%;
    height: 16px;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 4;
  }

  .slit-bevel {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: #555555;
  }

  .slit-entry .slit-bevel { top: 0; }
  .slit-exit .slit-bevel { bottom: 0; }

  .slit-hole {
    position: absolute;
    inset: 2px 0;
    background: #080808;
    box-shadow: inset 0 4px 6px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slit-cue {
    font: 800 6.5px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
  }

  /* ==========================================================================
     TERMINAISON FANION (AUJOURD'HUI)
     ========================================================================== */
  .ribbon-terminal-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ribbon-terminal {
    height: 100%;
    justify-content: space-between;
    padding-bottom: 0;
