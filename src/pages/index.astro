<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-rubans" class="btn-noir btn-hero">
          Descendre le temps &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

          <!-- ================= SECTION BANDEAUX DU TEMPS (ZOOMÉE SANS COURBE) ================= -->
  <section class="bandeaux-timeline-section" id="chronologie-rubans">
    <div class="timeline-container" style={`--timeline-height: ${totalTimelineHeight}px;`}>
      <!-- Médaillons des 10 logos en tête des bandes (sans courbe, zéro superposition) -->
      <div class="ribbon-logos-head" aria-label="Accès direct aux projets via leurs emblèmes">
        {renderedTracks.map((p) => (
          <a
            href={p.lien}
            class={`ribbon-logo-anchor logo-${p.id}`}
            style={`left: ${p.logoX - (logoSize / 2)}px; top: ${p.logoY - (logoSize / 2)}px;`}
            title={`${p.num} · ${p.titre} — ${p.domaine}`}
            data-target-id={p.id}
          >
            <div class="logo-circle">
              <img src={p.logo} alt={p.titre} />
            </div>
            <span class="logo-head-tooltip">{p.num} · {p.titre}</span>
          </a>
        ))}
      </div>

      <!-- Bandes orthogonales 100% droites (AUCUNE COURBE) -->
      <svg class="svg-lines-layer" width="100%" height={totalTimelineHeight} aria-hidden="true">
        {renderedTracks.map((p) => (
          <g class={`track-group group-${p.id}`}>
            <path
              d={p.d}
              fill="none"
              stroke="#000000"
              stroke-width={stripeWidth}
              stroke-linecap="square"
              class="infographic-ribbon"
            />
            <rect
              x={cardStartX - 10}
              y={p.spurY - 5}
              width="10"
              height="10"
              fill="#000000"
            />
          </g>
        ))}
      </svg>

      <!-- Fiches projets super-zoomées, massives et lisibles -->
      <div class="infographic-cards-column">
        {renderedTracks.map((p) => (
          <article class={`infographic-card card-${p.id}`} style={`top: ${p.targetCardY}px;`}>
            <div class="card-meta-line">
              <span class="card-num">{p.num}</span>
              <div class="card-logo-badge">
                <img src={p.logo} alt={p.titre} />
              </div>
              <div class="card-heading">
                <h3 class="card-title">{p.titre}</h3>
                <span class="card-domain">{p.domaine}</span>
              </div>
              <span class="card-date-badge">{p.date}</span>
            </div>
            <p class="card-desc">{p.desc}</p>
            <div class="card-actions">
              <a href={p.lien} class="btn-card btn-fiche">Fiche projet &rarr;</a>
              {p.site && (
                <a href={p.site} target="_blank" rel="noopener noreferrer" class="btn-card btn-site">Site officiel &#8599;</a>
              )}
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-card btn-gh">Code source &#8599;</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    // Interactions simples au hover : relier médaillon en tête, ligne SVG et fiche projet
    document.addEventListener('DOMContentLoaded', () => {
      const anchors = document.querySelectorAll('.ribbon-logo-anchor');
      const cards = document.querySelectorAll('.infographic-card');

      anchors.forEach((anchor) => {
        const id = anchor.getAttribute('data-target-id');
        if (!id) return;
        const group = document.querySelector(`.group-${id}`);
        const card = document.querySelector(`.card-${id}`);

        anchor.addEventListener('mouseenter', () => {
          if (group) group.classList.add('is-active');
          if (card) card.classList.add('is-highlighted');
        });
        anchor.addEventListener('mouseleave', () => {
          if (group) group.classList.remove('is-active');
          if (card) card.classList.remove('is-highlighted');
        });
      });

      cards.forEach((card) => {
        const classList = Array.from(card.classList);
        const cardClass = classList.find((c) => c.startsWith('card-') && c !== 'card-actions' && c !== 'card-desc');
        if (!cardClass) return;
        const id = cardClass.replace('card-', '');
        const group = document.querySelector(`.group-${id}`);
        const anchor = document.querySelector(`.logo-${id}`);

        card.addEventListener('mouseenter', () => {
          if (group) group.classList.add('is-active');
          if (anchor) anchor.classList.add('is-active');
        });
        card.addEventListener('mouseleave', () => {
          if (group) group.classList.remove('is-active');
          if (anchor) anchor.classList.remove('is-active');
        });
      });
    });
  </script>
</Base>

