import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Récupération de tous les projets publiés
const tousProjets = await getCollection('projets', ({ data }) => !data.brouillon);

// Tri chronologique décroissant (2026, 2025...) puis par ordre croissant
const projetsChronologiques = tousProjets.sort((a, b) => {
  const anneeA = Number(a.data.annee) || 0;
  const anneeB = Number(b.data.annee) || 0;
  if (anneeB !== anneeA) {
    return anneeB - anneeA;
  }
  return a.data.ordre - b.data.ordre || a.data.titre.localeCompare(b.data.titre, 'fr');
});

// Regroupement par année
const projetsParAnnee = projetsChronologiques.reduce((groupes, projet) => {
  const annee = projet.data.annee || 'Autres';
  if (!groupes[annee]) {
    groupes[annee] = [];
  }
  groupes[annee].push(projet);
  return groupes;
}, {} as Record<string | number, typeof tousProjets>);

const annees = Object.keys(projetsParAnnee).sort((a, b) => Number(b) - Number(a));

// Derniers articles de blog (3 plus récents)
const derniersArticles = (await getCollection('blog', ({ data }) => !data.brouillon))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function formaterDate(d: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(d);
}

