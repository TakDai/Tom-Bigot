---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteProjet from '../components/CarteProjet.astro';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon)).sort(
  (a, b) => a.data.ordre - b.data.ordre || a.data.titre.localeCompare(b.data.titre, 'fr'),
);

const competences = [
  {
    numero: '01',
    titre: 'Développement Web & Logiciel',
    description:
      'Conception d’applications web réactives, fluides et performantes. Code typé, architecture sobre et interfaces épurées conformes aux standards de l’écosystème.',
    technos: ['TypeScript', 'Astro', 'React', 'Node.js', 'API REST', 'WebSockets'],
  },
  {
    numero: '02',
    titre: 'Systèmes, DevOps & Cloud',
    description:
      'Administration de serveurs Linux autonomes, orchestration de conteneurs, automatisation CI/CD (GitHub Actions, OVH webhooks) et sécurisation SSL/DNS.',
    technos: ['Linux (Debian)', 'Docker', 'GitHub Actions', 'OVH & Webhooks', 'DNS & SSL/TLS'],
  },
  {
    numero: '03',
    titre: 'Robotique, Drones & Embarqué',
    description:
      'Conception matérielle et logicielle, asservissement moteur, télémétrie, prototypage sur microcontrôleurs et ingénierie de drones FPV / robots modulaires.',
    technos: ['Microcontrôleurs', 'Électronique & Capteurs', 'Drones FPV', 'Télémétrie', 'IoT'],
  },
  {
    numero: '04',
    titre: 'Architecture & Vision seeworld',
    description:
      'Démarche complète du cahier des charges à la mise en production : indépendance technique, résolution de défis complexes et construction d’outils durables.',
    technos: ['Architecture logicielle', 'Esprit Maker', 'Sobriété numérique', 'Direction technique'],
  },
];
---

<Base>
  <!-- ================= HERO ================= -->
  <section class="screen-hero">
    <div class="hero-badge">
      <span class="etiquette">SEEWORLD &bull; PORTFOLIO &bull; SAVOIR-FAIRE</span>
    </div>
    <h1 class="hero-title">CONCEVOIR,<br />CONSTRUIRE,<br />REGARDER LE MONDE.</h1>
    <p class="hero-chapo">
      Je suis <strong>Tom Bigot</strong> — développeur et créateur technique. J’associe le développement logiciel moderne,
      l’administration système et l’ingénierie embarquée pour donner vie à des plateformes et outils durables au sein du collectif <strong>seeworld</strong>.
    </p>
    <div class="hero-actions">
      <a href="#competences" class="btn-noir">Mes compétences ↓</a>
      <a href="#projets" class="btn-outline">Voir les projets</a>
      <a href="/contact" class="nav-pill">Me contacter &rarr;</a>
    </div>
  </section>

  <!-- ================= COMPÉTENCES ================= -->
  <section id="competences" class="conteneur section-bloc">
    <header class="section-head">
      <span class="etiquette">01 / SAVOIR-FAIRE</span>
      <h2 class="section-title">COMPÉTENCES & EXPERTISE TECHNIQUE</h2>
      <p class="section-desc">
        Une pratique transversale reliant le logiciel de haut niveau, le réseau et le matériel physique.
      </p>
    </header>

    <div class="grille-competences">
      {
        competences.map((c) => (
          <article class="carte-competence">
            <div class="competence-entete">
              <span class="etiquette">{c.numero}</span>
              <h3 class="competence-titre">{c.titre}</h3>
            </div>
            <p class="competence-desc">{c.description}</p>
            <div class="competence-technos">
              {c.technos.map((tech) => (
                <span class="techno-pill">{tech}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ================= PHILOSOPHIE SEEWORLD ================= -->
  <section class="conteneur section-bloc">
    <article class="prose-card encart-seeworld">
      <div class="seeworld-eyebrow">
        <img src="/assets/logo-seeworld.svg" alt="SEEWORLD" width="24" height="24" />
        <span class="etiquette">DÉMARCHE &bull; SEEWORLD</span>
      </div>
      <blockquote class="seeworld-quote">
        « REGARDER LE MONDE, COMPRENDRE COMMENT LES CHOSES FONCTIONNENT, ET EN FAIRE QUELQUE CHOSE D’UTILE ET DE DURABLE. »
      </blockquote>
      <p class="seeworld-text">
        Qu’il s’agisse d’une ligne de commande, d’un serveur auto-hébergé, d’un drone FPV ou d’un portail web, je privilégie
        l’autonomie technique, la maîtrise des fondations et la simplicité de maintenance sans dépendances superflues.
      </p>
    </article>
  </section>

  <!-- ================= PROJETS ================= -->
  <section id="projets" class="conteneur section-bloc">
    <header class="section-head">
      <span class="etiquette">02 / RÉALISATIONS ({projets.length})</span>
      <h2 class="section-title">PROJETS & CRÉATIONS</h2>
      <p class="section-desc">
        Vitrine des projets personnels et participations aux initiatives de l'écosystème seeworld.
      </p>
    </header>

    <div class="grille-projets">
      {projets.map((projet) => <CarteProjet projet={projet} />)}
    </div>
  </section>

  <!-- ================= CONTACT CTA ================= -->
  <section class="conteneur section-bloc section-fin">
    <article class="prose-card cta-box">
      <span class="etiquette">03 / ÉCHANGE</span>
      <h2 class="cta-title">UN PROJET OU UNE QUESTION ?</h2>
      <p class="cta-desc">
        Disponible pour de nouveaux défis techniques, des projets logiciels ou matériels, et des collaborations autour des technologies libres et autonomes.
      </p>
      <div class="cta-actions">
        <a href="mailto:contact@tom-bigot.fr" class="btn-noir">contact@tom-bigot.fr</a>
        <a href="/contact" class="btn-outline">Tous les moyens de contact &rarr;</a>
      </div>
    </article>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .screen-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(40px, 8vh, 80px) 20px clamp(30px, 6vh, 60px);
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge {
    margin-bottom: 20px;
  }

  .hero-title {
    margin: 0 0 24px;
    font: 700 clamp(36px, 7vw, 68px)/1.1 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hero-chapo {
    margin: 0 0 32px;
    font: 400 clamp(14px, 2vw, 16px)/1.6 var(--font);
    letter-spacing: 0.03em;
    color: rgba(0, 0, 0, 0.75);
    max-width: 640px;
  }

  .hero-chapo strong {
    font-weight: 700;
    color: var(--ink);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---------- SECTIONS COMMUNES ---------- */
  .section-bloc {
    padding-top: clamp(32px, 6vh, 56px);
    padding-bottom: clamp(16px, 3vh, 28px);
  }

  .section-fin {
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .section-head {
    border-bottom: 2px dashed var(--dash);
    padding-bottom: 20px;
    margin-bottom: 28px;
  }

  .section-title {
    margin: 6px 0 8px;
    font: 700 clamp(22px, 4vw, 32px)/1.2 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-desc {
    margin: 0;
    font: 400 13px/1.5 var(--font);
    letter-spacing: 0.03em;
    color: rgba(0, 0, 0, 0.65);
    max-width: 600px;
  }

  /* ---------- COMPÉTENCES ---------- */
  .grille-competences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 20px;
  }

  .carte-competence {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    border: 2px dashed var(--dash);
    border-radius: 12px;
    background: var(--paper);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s ease,
                border-style 0.2s ease,
                box-shadow 0.2s ease;
  }

  .carte-competence:hover {
    transform: translateY(-4px);
    border-style: solid;
    border-color: var(--ink);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .competence-entete {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
  }

  .competence-titre {
    margin: 0;
    font: 700 16px/1.3 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .competence-desc {
    margin: 0 0 16px;
    font: 400 13px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.75);
    flex: 1;
  }

  .competence-technos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 14px;
    border-top: 2px dashed rgba(0, 0, 0, 0.2);
  }

  .techno-pill {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border: 1px dashed var(--dash);
    border-radius: 12px;
    font: 700 10px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    background: #fafafa;
  }

  /* ---------- ENCART SEEWORLD ---------- */
  .prose-card {
    border: 2px dashed var(--dash);
    border-radius: 12px;
    padding: clamp(24px, 4vw, 36px);
    background: var(--paper);
    transition: border-color 0.2s;
  }

  .prose-card:hover {
    border-color: var(--ink);
  }

  .encart-seeworld {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .seeworld-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .seeworld-quote {
    margin: 0;
    font: 700 clamp(18px, 3vw, 24px)/1.3 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    border-left: 3px solid var(--ink);
    padding-left: 16px;
  }

  .seeworld-text {
    margin: 0;
    font: 400 14px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.8);
    max-width: 720px;
  }

  /* ---------- GRILLE PROJETS ---------- */
  .grille-projets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 18px;
  }

  /* ---------- CTA BOX ---------- */
  .cta-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }

  .cta-title {
    margin: 0;
    font: 700 clamp(20px, 3.5vw, 28px)/1.2 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cta-desc {
    margin: 0 0 8px;
    font: 400 14px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.7);
    max-width: 560px;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
