---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Récupération de tous les projets publiés
const tousProjets = await getCollection('projets', ({ data }) => !data.brouillon);

// Tri chronologique décroissant (2026, 2025...) puis par ordre croissant
const projetsChronologiques = tousProjets.sort((a, b) => {
  const anneeA = Number(a.data.annee) || 0;
  const anneeB = Number(b.data.annee) || 0;
  if (anneeB !== anneeA) {
    return anneeB - anneeA;
  }
  return a.data.ordre - b.data.ordre || a.data.titre.localeCompare(b.data.titre, 'fr');
});

// Regroupement par année
const projetsParAnnee = projetsChronologiques.reduce((groupes, projet) => {
  const annee = projet.data.annee || 'Autres';
  if (!groupes[annee]) {
    groupes[annee] = [];
  }
  groupes[annee].push(projet);
  return groupes;
}, {} as Record<string | number, typeof tousProjets>);

const annees = Object.keys(projetsParAnnee).sort((a, b) => Number(b) - Number(a));

const logoMap: Record<string, string> = {
  '127il': '/assets/logos/127il.svg',
  'fix-my-drone': '/assets/logos/fix-my-drone.svg',
  'inskin': '/assets/logos/inskin.png',
  'komeon': '/assets/logos/komeon.png',
  'lestourangeaux': '/assets/logos/lestourangeaux.svg',
  'multi-motors': '/assets/logos/multi-motors.png',
  'openbots': '/assets/logos/openbots.png',
  'pensee-nocturne': '/assets/logos/pensee-nocturne.svg',
  'superviseur': '/assets/logos/superviseur.svg',
  'tete-de-piaf': '/assets/logos/tdp.png',
  'tours2tours': '/assets/logos/tours2tours.png',
};
---

<Base>
  <!-- ================= 01. ACCUEIL PLEIN FORMAT VIDÉO ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/assets/logo-seeworld.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <img src="/assets/logo-seeworld.svg" alt="SEEWORLD" width="22" height="22" />
        <span class="etiquette-hero">SEEWORLD &bull; TOM BIGOT</span>
      </div>
      <h1 class="hero-title">CONCEVOIR,<br />CONSTRUIRE,<br />REGARDER LE MONDE.</h1>
      <p class="hero-subtitle">
        Développeur & créateur technique &bull; Systèmes, Web, Drones FPV & Embarqué
      </p>

      <div class="hero-actions">
        <a href="#projets-chronologie" class="btn-noir btn-hero">
          Explorer la chronologie &darr;
        </a>
        <a href="/contact" class="btn-outline btn-hero">
          Prendre contact &rarr;
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#projets-chronologie" class="scroll-cue" aria-label="Défiler vers la chronologie des projets">
      <span class="scroll-label">CHRONOLOGIE</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= 02. PRÉSENTATION CHRONOLOGIQUE VERTICALE ================= -->
  <section id="projets-chronologie" class="conteneur section-timeline">
    <header class="timeline-header">
      <div class="header-pre">
        <span class="etiquette">RÉALISATIONS &bull; {projetsChronologiques.length} PROJETS</span>
      </div>
      <h2 class="timeline-main-title">CHRONOLOGIE DES PROJETS</h2>
      <p class="timeline-main-desc">
        Parcours vertical et chronologique des développements logiciels, expérimentations matérielles et plateformes numériques.
      </p>
    </header>

    <!-- Flux chronologique vertical -->
    <div class="timeline-track">
      {
        annees.map((annee) => (
          <div class="timeline-year-group">
            <!-- Balise de l'année -->
            <div class="year-milestone">
              <span class="year-pill">{annee}</span>
            </div>

            <!-- Liste des projets de l'année -->
            <div class="year-items">
              {projetsParAnnee[annee].map((projet) => {
                const { titre, resume, nature, statut, domaines } = projet.data;
                const meta = [nature, statut].filter(Boolean).join(' · ');
                const logo = logoMap[projet.id];

                return (
                  <div class="timeline-item">
                    <!-- Point d'ancrage sur la ligne verticale -->
                    <div class="timeline-pin">
                      <span class="pin-dot" />
                    </div>

                    <!-- Carte de projet seeworld -->
                    <a class="timeline-card" href={`/projets/${projet.id}`}>
                      <span class="card-ext">↗</span>

                      <div class="card-top">
                        {logo && (
                          <div class="card-logo-frame">
                            <img src={logo} alt={titre} loading="lazy" />
                          </div>
                        )}
                        <div class="card-titles">
                          {meta && <span class="etiquette card-meta">{meta}</span>}
                          <h3 class="card-name">{titre}</h3>
                        </div>
                      </div>

                      <p class="card-summary">{resume}</p>

                      <div class="card-footer">
                        {domaines && domaines.length > 0 && (
                          <div class="card-tags">
                            {domaines.map((d: string) => (
                              <span class="domaine-pill">{d}</span>
                            ))}
                          </div>
                        )}
                        <span class="card-cta">Découvrir la fiche &rarr;</span>
                      </div>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Encart philosophie de fin de timeline -->
    <div class="timeline-end">
      <article class="prose-card end-card">
        <span class="etiquette">03 / ÉCHANGE TECHNIQUE</span>
        <h3 class="end-title">UN PROJET EN TÊTE ?</h3>
        <p class="end-desc">
          Disponible pour imaginer, concevoir ou déployer des projets informatiques et électroniques durables.
        </p>
        <div class="end-actions">
          <a href="mailto:contact@tom-bigot.fr" class="btn-noir">contact@tom-bigot.fr</a>
          <a href="/contact" class="btn-outline">Formulaire & moyens de contact</a>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  /* ==========================================================================
     HERO PLEIN FORMAT VIDÉO
     ========================================================================== */
  .hero-video-screen {
    position: relative;
    width: 100%;
    height: calc(100svh - 64px);
    min-height: 520px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #000000;
    color: #ffffff;
    border-bottom: 2px dashed var(--dash);
  }

  .video-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .video-element {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
    filter: grayscale(100%) contrast(1.15) brightness(0.65);
  }

  /* Voile monochrome pour une lisibilité parfaite */
  .video-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.8) 100%),
                linear-gradient(to bottom, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.7) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 840px;
    padding: 0 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border: 2px dashed rgba(255, 255, 255, 0.45);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    margin-bottom: 24px;
  }

  .hero-badge img {
    filter: invert(1);
  }

  .etiquette-hero {
    font: 700 11px var(--font);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .hero-title {
    margin: 0 0 20px;
    font: 700 clamp(32px, 7vw, 64px)/1.08 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }

  .hero-subtitle {
    margin: 0 0 32px;
    font: 400 clamp(13px, 2vw, 16px)/1.55 var(--font);
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-hero {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  /* Indicateur de défilement */
  .scroll-cue {
    position: absolute;
    bottom: 24px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s, transform 0.2s;
  }

  .scroll-cue:hover {
    color: #ffffff;
    transform: translateY(3px);
  }

  .scroll-label {
    font: 700 10px var(--font);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    font-size: 16px;
    line-height: 1;
    animation: bounceDown 2s infinite;
  }

  @keyframes bounceDown {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(6px);
    }
    60% {
      transform: translateY(3px);
    }
  }

  /* ==========================================================================
     PRÉSENTATION CHRONOLOGIQUE VERTICALE
     ========================================================================== */
  .section-timeline {
    padding-top: clamp(48px, 8vh, 80px);
    padding-bottom: clamp(48px, 8vh, 80px);
    max-width: 860px;
  }

  .timeline-header {
    border-bottom: 2px dashed var(--dash);
    padding-bottom: 24px;
    margin-bottom: 40px;
  }

  .header-pre {
    margin-bottom: 6px;
  }

  .timeline-main-title {
    margin: 4px 0 10px;
    font: 700 clamp(24px, 4.5vw, 36px)/1.15 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .timeline-main-desc {
    margin: 0;
    font: 400 14px/1.6 var(--font);
    letter-spacing: 0.03em;
    color: rgba(0, 0, 0, 0.7);
    max-width: 640px;
  }

  /* La colonne chronologique avec ligne pointillée verticale */
  .timeline-track {
    position: relative;
    padding-left: clamp(28px, 5vw, 44px);
    border-left: 2px dashed var(--dash);
    margin-left: clamp(14px, 3vw, 24px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .timeline-year-group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Borne / Pastille de l'année */
  .year-milestone {
    position: relative;
    margin-bottom: 4px;
  }

  .year-pill {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 16px;
    border: 2px solid var(--ink);
    border-radius: 16px;
    background: var(--ink);
    color: var(--paper);
    font: 700 13px var(--font);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .year-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Élément individuel sur la ligne */
  .timeline-item {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Point d'ancrage circulaire sur la ligne pointillée verticale */
  .timeline-pin {
    position: absolute;
    top: 24px;
    left: calc(-1 * clamp(28px, 5vw, 44px) - 8px);
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .pin-dot {
    width: 14px;
    height: 14px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    transition: background-color 0.2s, transform 0.2s;
  }

  .timeline-item:hover .pin-dot {
    background: var(--ink);
    transform: scale(1.25);
  }

  /* Carte de projet le long de la chronologie */
  .timeline-card {
    display: flex;
    flex-direction: column;
    padding: 24px 22px 20px;
    border: 2px dashed var(--dash);
    border-radius: 12px;
    background: var(--paper);
    text-decoration: none;
    position: relative;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s ease,
                border-style 0.2s ease,
                box-shadow 0.2s ease;
  }

  .timeline-card:hover {
    transform: translateX(6px);
    border-style: solid;
    border-color: var(--ink);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .card-ext {
    position: absolute;
    top: 14px;
    right: 16px;
    font-size: 14px;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.35);
    transition: color 0.2s, transform 0.2s;
  }

  .timeline-card:hover .card-ext {
    color: var(--ink);
    transform: translate(1px, -1px);
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
  }

  .card-logo-frame {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed rgba(0, 0, 0, 0.2);
    border-radius: 10px;
    padding: 6px;
    background: #fafafa;
  }

  .card-logo-frame img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease;
  }

  .timeline-card:hover .card-logo-frame img {
    transform: scale(1.1);
  }

  .card-titles {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .card-meta {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.5);
  }

  .card-name {
    margin: 0;
    font: 700 18px/1.2 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .card-summary {
    margin: 0 0 16px;
    font: 400 14px/1.6 var(--font);
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.8);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 2px dashed rgba(0, 0, 0, 0.15);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .domaine-pill {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border: 1px dashed var(--dash);
    border-radius: 11px;
    font: 700 9px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
    background: #fafafa;
  }

  .card-cta {
    font: 700 11px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .timeline-card:hover .card-cta {
    opacity: 1;
  }

  /* Encart de fin */
  .timeline-end {
    margin-top: 48px;
  }

  .end-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding: clamp(28px, 4vw, 40px);
  }

  .end-title {
    margin: 0;
    font: 700 clamp(20px, 3vw, 26px)/1.2 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .end-desc {
    margin: 0 0 8px;
    font: 400 14px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.7);
    max-width: 520px;
  }

  .end-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 600px) {
    .card-top {
      align-items: flex-start;
    }
    .timeline-card:hover {
      transform: translateY(-2px);
    }
  }
</style>
