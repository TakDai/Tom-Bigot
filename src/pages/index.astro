---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#portfolio" class="btn-noir btn-hero">
          Explorer la chronologie &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#portfolio" class="scroll-cue" aria-label="Découvrir la chronologie">
      <span class="scroll-label">CHRONOLOGIE</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION CHRONOLOGIE AU SCROLL AVEC BANDEAU VERTICAL ================= -->
  <section class="conteneur chrono-section" id="portfolio">
    <!-- Barre d'outils & filtres -->
    <div class="chrono-toolbar">
      <div class="filter-group" role="tablist" aria-label="Filtrer les projets">
        <button type="button" class="filter-pill active" data-filter="all">Tous ({bandeauxProjets.length})</button>
        <button type="button" class="filter-pill" data-filter="embarque">Électronique &amp; Embarqué</button>
        <button type="button" class="filter-pill" data-filter="hardware">Drones &amp; Matériel</button>
        <button type="button" class="filter-pill" data-filter="systemes">Systèmes &amp; Partage</button>
        <button type="button" class="filter-pill" data-filter="web">Web &amp; Interfaces</button>
      </div>

      <div class="bandeaux-legende" aria-label="Légende des étapes">
        <span class="legende-pill"><span class="leg-dot phase-dot">&#9632;</span> Phase</span>
        <span class="legende-pill"><span class="leg-dot tf-dot">&#9733;</span> Temps Fort</span>
        <span class="legende-pill"><span class="leg-dot pause-dot">&#9208;</span> Pause R&amp;D</span>
      </div>
    </div>

    <!-- Disposition : Bandeau vertical sticky + Rail chronologique au scroll -->
    <div class="chrono-layout">
      <!-- Bandeau vertical sticky de navigation et progression -->
      <aside class="chrono-sticky-band" aria-label="Sommaire chronologique">
        <div class="sticky-band-head">
          <span class="etiquette">01 &bull; 10</span>
          <h2 class="sticky-band-title">BANDEAU CHRONO</h2>
        </div>

        <div class="sticky-band-track">
          <!-- Ligne de jauge verticale sticky -->
          <div class="sticky-track-line" aria-hidden="true">
            <div class="sticky-track-fill" id="stickyTrackFill"></div>
          </div>

          <!-- Liste des repères du bandeau -->
          <nav class="sticky-band-nav" aria-label="Repères de projets">
            {
              bandeauxProjets.map((projet, idx) => (
                <a
                  href={`#projet-${projet.id}`}
                  class={`sticky-band-item ${idx === 0 ? 'active' : ''}`}
                  data-target={`projet-${projet.id}`}
                  data-cat={projet.categorie}
                >
                  <span class="sticky-item-bullet" aria-hidden="true"></span>
                  <span class="sticky-item-num">{projet.numero}</span>
                  <span class="sticky-item-title">{projet.titre}</span>
                </a>
              ))
            }
          </nav>
        </div>
      </aside>

      <!-- Flux chronologique vertical qui progresse au scroll -->
      <div class="chrono-stream">
        <!-- Rail vertical central qui se remplit au défilement -->
        <div class="stream-spine-line" aria-hidden="true">
          <div class="stream-spine-fill" id="streamSpineFill"></div>
        </div>

        {
          bandeauxProjets.map((projet) => (
            <article
              class="chrono-project-card"
              id={`projet-${projet.id}`}
              data-cat={projet.categorie}
            >
              <!-- Nœud jalon sur la ligne verticale -->
              <div class="project-spine-node" aria-hidden="true">
                <span class="node-number">{projet.numero}</span>
              </div>

              <!-- Corps de la carte de projet -->
              <div class="project-card-inner">
                <!-- En-tête de projet -->
                <div class="card-header-row">
                  <div class="card-brand-box">
                    <div class="card-logo-frame">
                      <img src={projet.logo} alt={`Logo ${projet.titre}`} loading="lazy" />
                    </div>
                    <div>
                      <span class="domaine-pill">{projet.domaine}</span>
                      <h3 class="card-project-title">{projet.titre}</h3>
                      <p class="card-project-sub">{projet.sousTitre}</p>
                    </div>
                  </div>

                  <div class="card-top-actions">
                    <a href={projet.lien} class="btn-noir btn-card-action">
                      Fiche projet &rarr;
                    </a>
                    {projet.github && (
                      <a
                        href={projet.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-outline btn-card-action"
                        title={`Dépôt GitHub de ${projet.titre}`}
                      >
                        GitHub ↗
                      </a>
                    )}
                  </div>
                </div>

                <!-- Jalons chronologiques du projet -->
                <div class="project-steps-track">
                  <div class="steps-spine-line" aria-hidden="true"></div>
                  <div class="steps-nodes-list">
                    {projet.etapes.map((etape) => {
                      const isTempsFort = etape.type === 'temps_fort';
                      const isPause = etape.type === 'pause';
                      const isStatut = etape.type === 'statut';

                      return (
                        <div
                          class={`v-step-node ${isTempsFort ? 'is-temps-fort' : ''} ${isPause ? 'is-pause' : ''} ${isStatut ? 'is-statut' : ''}`}
                        >
                          <div class="v-step-bullet" aria-hidden="true">
                            {isTempsFort ? '★' : isPause ? '⏸' : isStatut ? '●' : '■'}
                          </div>
                          <div class="v-step-card">
                            <div class="v-step-head">
                              <span class="v-step-date">{etape.date}</span>
                              {isTempsFort && <span class="v-tf-badge">TEMPS FORT</span>}
                              {isPause && <span class="v-pause-badge">PAUSE R&amp;D</span>}
                              {isStatut && <span class="v-statut-badge">STATUT ACTUEL</span>}
                            </div>
                            <h4 class="v-step-title">{etape.titre}</h4>
                            <p class="v-step-desc">{etape.desc}</p>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  // Synchronisation dynamique du bandeau vertical et progression au défilement (scroll)
  document.addEventListener('DOMContentLoaded', () => {
    const streamSpineFill = document.getElementById('streamSpineFill');
    const stickyTrackFill = document.getElementById('stickyTrackFill');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.chrono-project-card'));
    const stickyItems = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sticky-band-item'));
    const section = document.getElementById('portfolio');
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-pill');

    if (!section) return;

    let ticking = false;

    function updateScrollProgress() {
      const sRect = section.getBoundingClientRect();
      const winHeight = window.innerHeight;

      // Calcul précis du défilement dans la zone chronologie
      const start = sRect.top - winHeight * 0.45;
      const total = sRect.height - winHeight * 0.55;
      const progress = Math.max(0, Math.min(1, -start / (total || 1)));
      const pct = (progress * 100).toFixed(1) + '%';

      if (streamSpineFill) streamSpineFill.style.height = pct;
      if (stickyTrackFill) stickyTrackFill.style.height = pct;

      // Détection du projet actif
      let activeIndex = 0;
      cards.forEach((card, i) => {
        const cRect = card.getBoundingClientRect();
        if (cRect.top <= winHeight * 0.5) {
          activeIndex = i;
          card.classList.add('is-passed');
        } else {
          card.classList.remove('is-passed');
        }

        if (cRect.top <= winHeight * 0.5 && cRect.bottom >= winHeight * 0.2) {
          card.classList.add('is-active-project');
        } else {
          card.classList.remove('is-active-project');
        }
      });

      stickyItems.forEach((item, i) => {
        if (i === activeIndex) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollProgress);
        ticking = true;
      }
    }, { passive: true });

    updateScrollProgress();

    // Filtrage instantané par domaine
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-filter') || 'all';
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat');
          const isMatch = cat === 'all' || cardCat === cat;
          card.style.display = isMatch ? '' : 'none';
        });

        stickyItems.forEach((item) => {
          const itemCat = item.getAttribute('data-cat');
          const isMatch = cat === 'all' || itemCat === cat;
          item.style.display = isMatch ? '' : 'none';
        });

        updateScrollProgress();
      });
    });
  });
</script>

