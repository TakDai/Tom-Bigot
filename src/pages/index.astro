  }

  /* ==========================================================================
     RESPONSIVE (100% FLUIDE, ZÉRO SCROLL HORIZONTAL)
     ========================================================================== */
  @media (max-width: 600px) {
    .bandes-section {
      padding: 40px 12px 70px;
    }

    .bande-noire {
      width: calc(50% - 10px);
      min-width: 120px;
      flex: 1 1 calc(50% - 10px);
    }
