  <script>
    import Lenis from 'lenis';
    import 'lenis/dist/lenis.css';

    function initPage() {
      const sections = document.querySelectorAll('.project-fullscreen-section');
      const timelineNodes = document.querySelectorAll('.timeline-node-item');
      const mobileNodes = document.querySelectorAll('.mobile-timeline-btn');
      const timelineNav = document.getElementById('scrollTimeline');
      const mobileTimeline = document.getElementById('mobileTimeline');
      const timelineProgressBar = document.getElementById('timelineProgressBar');
      const mobileTimelineFill = document.getElementById('mobileTimelineFill');
      const hero = document.getElementById('top');
      const wrapper = document.getElementById('projets');

      // 1. Initialisation de Lenis pour un défilement ultra-fluide sans latence (optimisé 60/120 FPS)
      const lenis = new Lenis({
        duration: 0.8,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.0,
        touchMultiplier: 1.0,
        syncTouch: false,
        infinite: false,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // 2. Mise en cache des positions pour éliminer les recalculs de reflow
      let sectionData: Array<{
        el: Element;
        idx: number;
        top: number;
        height: number;
        watermark: HTMLElement | null;
        watermarkSpeed: number;
        rightCol: HTMLElement | null;
        rightColSpeed: number;
      }> = [];

      let heroHeight = window.innerHeight;
      let wrapperTop = 0;
      let wrapperHeight = 0;
      let currentActiveIdx = -1;

      function measureLayout() {
        const windowHeight = window.innerHeight;
        heroHeight = hero ? hero.offsetHeight : windowHeight;
        if (wrapper) {
          const wRect = wrapper.getBoundingClientRect();
          wrapperTop = wRect.top + window.scrollY;
          wrapperHeight = wrapper.offsetHeight;
        }

        sectionData = Array.from(sections).map((section, idx) => {
          const rect = section.getBoundingClientRect();
          const top = rect.top + window.scrollY;
          const height = section.offsetHeight || rect.height;
          return {
            el: section,
            idx,
            top,
            height,
            watermark: section.querySelector('.parallax-watermark'),
            watermarkSpeed: parseFloat(section.querySelector('.parallax-watermark')?.getAttribute('data-parallax-speed') || '0.28'),
            rightCol: section.querySelector('.project-right-col'),
            rightColSpeed: parseFloat(section.querySelector('.project-right-col')?.getAttribute('data-parallax-speed') || '-0.15'),
          };
        });
      }
      measureLayout();

      // 3. Mise à jour de la timeline et des éléments visuels synchronisée sur le tick Lenis
      function updateVisuals(scrollY: number) {
        const windowHeight = window.innerHeight;

        // A. Émergence dynamique de la timeline (active uniquement dans la section projets)
        if (hero && timelineNav) {
          const inProjects = scrollY >= (wrapperTop - windowHeight * 0.4) &&
                             scrollY <= (wrapperTop + wrapperHeight - windowHeight * 0.2);
          if (inProjects) {
            timelineNav.classList.add('is-visible');
            const emergeRatio = Math.max(0, Math.min(1, (scrollY - (wrapperTop - windowHeight * 0.4)) / (windowHeight * 0.3)));
            const slideX = (1 - emergeRatio) * 60;
            const scale = 0.90 + (emergeRatio * 0.10);
            const opacity = Math.min(1, emergeRatio * 1.5);

            timelineNav.style.transform = `translate3d(${slideX.toFixed(1)}px, -50%, 0) scale(${scale.toFixed(3)})`;
            timelineNav.style.opacity = opacity.toFixed(2);
            timelineNav.style.pointerEvents = 'auto';
            timelineNav.style.zIndex = '100';
          } else {
            timelineNav.classList.remove('is-visible');
            timelineNav.style.transform = 'translate3d(70px, -50%, 0) scale(0.90)';
            timelineNav.style.opacity = '0';
            timelineNav.style.pointerEvents = 'none';
            timelineNav.style.zIndex = '5';
          }
        }

        if (mobileTimeline) {
          const inProjectsMobile = scrollY >= (wrapperTop - windowHeight * 0.3) &&
                                   scrollY <= (wrapperTop + wrapperHeight - windowHeight * 0.2);
          if (inProjectsMobile) mobileTimeline.classList.add('is-visible');
          else mobileTimeline.classList.remove('is-visible');
        }

        // B. Barre de progression globale (via transform scale GPU sans reflow)
        if (wrapperHeight > windowHeight) {
          const currentScrolled = scrollY - wrapperTop;
          const totalScrollable = wrapperHeight - windowHeight;
          const progressRatio = Math.max(0, Math.min(1, currentScrolled / totalScrollable));
          if (timelineProgressBar) {
            timelineProgressBar.style.transform = `scaleY(${progressRatio.toFixed(4)})`;
          }
          if (mobileTimelineFill) {
            mobileTimelineFill.style.transform = `scaleX(${progressRatio.toFixed(4)})`;
          }
        }

        // C. Nœud actif calculé par coordonnées pures
        const midPoint = scrollY + windowHeight * 0.5;
        let activeIdx = 0;
        for (let i = 0; i < sectionData.length; i++) {
          if (midPoint >= sectionData[i].top) {
            activeIdx = i;
          }
        }

        if (activeIdx !== currentActiveIdx) {
          currentActiveIdx = activeIdx;
          timelineNodes.forEach((n, idx) => {
            n.classList.toggle('is-active', idx === activeIdx);
            n.classList.toggle('is-past', idx < activeIdx);
          });
          mobileNodes.forEach((m, idx) => {
            m.classList.toggle('is-active', idx === activeIdx);
            m.classList.toggle('is-past', idx < activeIdx);
          });
        }

        // D. Parallaxe doux uniquement sur les sections visibles
        for (let i = 0; i < sectionData.length; i++) {
          const item = sectionData[i];
          const relTop = item.top - scrollY;
          if (relTop > -item.height && relTop < windowHeight) {
            const progress = (windowHeight - relTop) / (windowHeight + item.height);
            const centeredProgress = progress - 0.5;

            if (item.watermark) {
              const translateY = centeredProgress * item.watermarkSpeed * 180;
              item.watermark.style.transform = `translate3d(0, calc(-50% + ${translateY.toFixed(1)}px), 0)`;
            }
            if (item.rightCol) {
              const translateY = centeredProgress * item.rightColSpeed * 100;
              item.rightCol.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
            }
          }
        }
      }

      lenis.on('scroll', (e: { scroll: number }) => {
        updateVisuals(e.scroll);
      });

      window.addEventListener('resize', () => {
        measureLayout();
        updateVisuals(lenis.scroll);
      });
      window.addEventListener('load', () => {
        measureLayout();
        updateVisuals(lenis.scroll);
      });
      updateVisuals(window.scrollY);

      // 4. Gestionnaire vidéo haute performance (lecture automatique fluide au défilement)
      const projectSections = Array.from(document.querySelectorAll('.project-fullscreen-section'));
      const heroVideo = document.getElementById('heroVideo') as HTMLVideoElement | null;

      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const vid = entry.target.querySelector('video') as HTMLVideoElement | null;
          if (!vid) return;
          if (entry.isIntersecting) {
            vid.muted = true;
            if (vid.preload === 'none') {
              vid.preload = 'auto';
            }
            if (vid.paused) {
              vid.play().catch(() => {});
            }
          } else {
            if (!vid.paused) {
              vid.pause();
            }
          }
        });
      }, { rootMargin: '100px 0px 100px 0px', threshold: 0.10 });

      projectSections.forEach((sec) => sectionObserver.observe(sec));

      if (hero && heroVideo) {
        const heroObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (heroVideo.paused) heroVideo.play().catch(() => {});
            } else {
              if (!heroVideo.paused) heroVideo.pause();
            }
          });
        }, { threshold: 0.10 });
        heroObserver.observe(hero);
      }

      // 5. Navigation fluide au clic gérée par Lenis
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (!href || href === '#') return;
          if (href === '#top') {
            e.preventDefault();
            lenis.scrollTo(0, {
              duration: 1.2,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
            if (history.pushState) history.pushState(null, '', href);
            return;
          }
          const targetEl = document.querySelector(href);
          if (targetEl) {
            e.preventDefault();
            lenis.scrollTo(targetEl as HTMLElement, {
              offset: 0,
              duration: 1.2,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
            if (history.pushState) history.pushState(null, '', href);
          }
        });
      });

      // 6. Gestionnaire de fiches pop-up (Modales de fiches détaillées)
      const ficheTriggers = document.querySelectorAll('[data-open-fiche]');
      const allFicheModals = Array.from(document.querySelectorAll<HTMLDialogElement>('.fiche-modal'));
      let currentOpenDialog: HTMLDialogElement | null = null;

      function openFiche(projectId: string, updateHistory = true) {
        const dialog = document.getElementById(`fiche-modal-${projectId}`) as HTMLDialogElement | null;
        if (!dialog) return;

        if (currentOpenDialog && currentOpenDialog !== dialog) {
          closeFiche(false);
        }

        currentOpenDialog = dialog;
        lenis.stop();
        document.body.classList.add('fiche-modal-open');

        dialog.showModal();
        dialog.scrollTop = 0;
        const scrollable = dialog.querySelector('.fiche-modal-scrollable');
        if (scrollable) scrollable.scrollTop = 0;

        if (updateHistory) {
          try {
            history.pushState({ modalFiche: projectId }, '', `#fiche-${projectId}`);
          } catch (_) {}
        }
      }

      function closeFiche(updateHistory = true) {
        if (!currentOpenDialog) return;
        const dialog = currentOpenDialog;
        currentOpenDialog = null;

        dialog.close();
        document.body.classList.remove('fiche-modal-open');
        lenis.start();

        if (updateHistory && window.location.hash.startsWith('#fiche-')) {
          try {
            history.pushState(null, '', window.location.pathname + window.location.search);
          } catch (_) {}
        }
      }

      ficheTriggers.forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          const mouseEvent = e as MouseEvent;
          if (mouseEvent.button !== 0 || mouseEvent.ctrlKey || mouseEvent.metaKey || mouseEvent.shiftKey) {
            return;
          }
          e.preventDefault();
          const projectId = trigger.getAttribute('data-open-fiche');
          if (projectId) openFiche(projectId);
        });

        if (trigger.tagName !== 'A') {
          trigger.addEventListener('keydown', (e) => {
            const keyEvent = e as KeyboardEvent;
            if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
              keyEvent.preventDefault();
              const projectId = trigger.getAttribute('data-open-fiche');
              if (projectId) openFiche(projectId);
            }
          });
        }
      });

      allFicheModals.forEach((dialog) => {
        dialog.querySelectorAll('[data-close-fiche]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            closeFiche();
          });
        });

        dialog.addEventListener('click', (e) => {
          const card = dialog.querySelector('.fiche-modal-card');
          if (card && !card.contains(e.target as Node)) {
            closeFiche();
          }
        });

        dialog.addEventListener('close', () => {
          if (currentOpenDialog === dialog) {
            closeFiche(true);
          }
        });
      });

      window.addEventListener('popstate', () => {
        if (window.location.hash.startsWith('#fiche-')) {
          const pid = window.location.hash.replace('#fiche-', '');
          openFiche(pid, false);
        } else if (currentOpenDialog) {
          closeFiche(false);
        }
      });

      if (window.location.hash.startsWith('#fiche-')) {
        const initialPid = window.location.hash.replace('#fiche-', '');
        setTimeout(() => openFiche(initialPid, false), 300);
      }

      // 7. Gestionnaire des onglets de l'aperçu Agenda
      const agendaTabs = document.querySelectorAll('.preview-tab');
      agendaTabs.forEach((tabBtn) => {
        tabBtn.addEventListener('click', () => {
          const targetId = tabBtn.getAttribute('data-tab-target');
          if (!targetId) return;
          agendaTabs.forEach((b) => b.classList.remove('active'));
          tabBtn.classList.add('active');
          document.querySelectorAll('.preview-tab-content').forEach((content) => {
            content.classList.toggle('is-hidden', content.id !== targetId);
          });
        });
      });

      // 8. Gestionnaire des filtres du flux d'actualités & avancements
      const filterBtns = document.querySelectorAll('.actu-filter-btn');
      const actuCards = document.querySelectorAll<HTMLElement>('.actualite-card');
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter') || 'all';
          filterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          actuCards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage);
    } else {
      initPage();
    }
  </script>
</Base>

