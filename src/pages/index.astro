<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-rubans" class="btn-noir btn-hero">
          Descendre le temps &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION BANDES NOIRES PURS ================= -->
  <section class="bandes-section" id="chronologie-rubans">
    <div class="bandes-container">
      {periodesLigneDuTemps.map((periode) => {
        const rubansVisibles = rubansProjets
          .map((p) => {
            const seg = p.segments[periode.id] || { etat: 'vide' };
            return { projet: p, segment: seg };
          })
          .filter((item) => item.segment.etat !== 'vide' && item.segment.etat !== 'en_pause');

        return (
          <div class="bandes-era-block" id={`era-${periode.id}`}>
            <div class="era-date-title">{periode.label}</div>

            <div class="bandes-row">
              {rubansVisibles.map(({ projet, segment }) => {
                const isTempsFort = segment.etat === 'temps_fort' || segment.etat === 'sortie_temps_fort';
                const isFentePause = segment.etat === 'fente_pause';
                const isSortie = segment.etat === 'sortie_phase' || segment.etat === 'sortie_temps_fort' || segment.etat === 'sortie_statut';
                const isStatut = segment.etat === 'statut' || segment.etat === 'sortie_statut';

                return (
                  <article class={`bande-noire ${isStatut ? 'is-terminal' : ''}`} id={`bande-${projet.id}-${periode.id}`}>
                    <div class="b-hanger" aria-hidden="true">
                      <span class="b-ring"></span>
                    </div>

                    {isSortie && (
                      <div class="b-slit b-slit-exit" title="Ressort de la fente">
                        <span>&uarr; SORTIE DE FENTE</span>
                      </div>
                    )}

                    <div class="b-header">
                      <span class="b-num">{projet.numero}</span>
                      <h3 class="b-titre">{projet.titre}</h3>
                    </div>

                    <div class="b-body">
                      {isTempsFort && (
                        <div class="b-star">
                          <span>&#9733; POINT FORT</span>
                        </div>
                      )}
                      <div class="b-desc">{segment.titre}</div>
                    </div>

                    {isFentePause && (
                      <div class="b-slit b-slit-entry" title="Rentre dans la fente (pause R&D)">
                        <span>&darr; FENTE PAUSE &darr;</span>
                      </div>
                    )}

                    {isStatut && (
                      <div class="b-footer">
                        <a href={projet.lien} class="b-link">Fiche &rarr;</a>
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Base>

<script>
  // Suivi de l'époque active lors du défilement
  document.addEventListener('DOMContentLoaded', () => {
    const blocks = document.querySelectorAll<HTMLElement>('.bandes-era-block');
    if (blocks.length === 0) return;

    function onScroll() {
      const scrollY = window.scrollY + 200;
      blocks.forEach((b) => {
        const top = b.offsetTop;
        const h = b.offsetHeight;
        if (scrollY >= top && scrollY < top + h) {
          b.classList.add('is-active-era');
        } else {
          b.classList.remove('is-active-era');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>

<style>
  /* ==========================================================================
     ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME
     ========================================================================== */
  .hero-video-screen {
