  }

  .scroll-label {
    font: 700 10px var(--font);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    font-size: 16px;
    animation: bounceDown 2s infinite ease-in-out;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ==========================================================================
     SECTION DES BANDEAUX NOIRS VERTICAUX (ZÉRO PACK PAR MOIS, ZÉRO SCROLL HORIZONTAL)
     ========================================================================== */
  .bandeaux-section {
    position: relative;
    background: #ffffff;
    padding: clamp(60px, 8vh, 100px) clamp(16px, 3vw, 40px);
    overflow-x: hidden !important;
    border-bottom: 2px dashed var(--dash);
  }

  .bandeaux-flow-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
    overflow-x: hidden !important;
  }

  /* ==========================================================================
     LE BANDEAU EN TISSU NOIR VERTICAL
     ========================================================================== */
  .bandeau-tissu-noir {
    position: relative;
    background: #000000;
    color: #ffffff;
    width: 220px;
    min-width: 200px;
    max-width: 240px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.28);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .bandeau-tissu-noir:hover {
    transform: translateY(-6px);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.4);
  }

  /* Anneau de suspension */
  .bandeau-suspension {
    display: flex;
    justify-content: center;
    padding-top: 14px;
  }

  .ring-rivet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #222222;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  /* En-tête */
  .bandeau-head {
    padding: 10px 16px 14px;
    border-bottom: 1px solid #222222;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .bandeau-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .bandeau-num {
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
    color: #ffffff;
  }

  .bandeau-origin-tag {
    font: 700 8.5px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888888;
  }

  .bandeau-origin-tag.origin-2025 {
    color: #000000;
    background: #ffffff;
    padding: 1px 5px;
    border-radius: 2px;
    font-weight: 800;
  }

  .bandeau-title {
    margin: 0;
    font: 700 13.5px/1.2 var(--font);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ffffff;
    word-break: normal;
    overflow-wrap: break-word;
  }

  .bandeau-sub {
    font: 400 9.5px/1.3 var(--font);
    color: #888888;
    display: block;
  }

  /* Sections du ruban */
  .bandeau-ribbon-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 14px;
  }

  .bandeau-step {
    display: flex;
    flex-direction: column;
