  }

  .scroll-label {
    font: 700 10px var(--font);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    font-size: 16px;
    animation: bounceDown 2s infinite ease-in-out;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ==========================================================================
     SECTION DES BANDES NOIRES (ZÉRO TABLEAU, ZÉRO SCROLL HORIZONTAL)
     ========================================================================== */
  .bandes-section {
    position: relative;
    background: #ffffff;
    padding: clamp(50px, 7vh, 90px) clamp(16px, 3vw, 40px);
    overflow-x: hidden !important;
    border-bottom: 2px dashed var(--dash);
  }

  .bandes-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(60px, 8vh, 90px);
    overflow-x: hidden !important;
  }

  .bandes-era-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    width: 100%;
    box-sizing: border-box;
  }

  .era-date-title {
    font: 800 clamp(20px, 2.5vw, 26px)/1 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000000;
    text-align: center;
  }

  /* La rangée de bandes noires : wrap naturel, ZÉRO scroll horizontal */
  .bandes-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden !important;
  }

  /* ==========================================================================
     LA BANDE NOIRE PURE
     ========================================================================== */
  .bande-noire {
    position: relative;
    background: #000000;
    color: #ffffff;
    width: 135px;
    min-width: 115px;
    max-width: 145px;
    flex: 0 1 135px;
    box-sizing: border-box;
    padding: 16px 12px 20px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .bande-noire:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35);
  }

  /* Attache suspension discrète */
  .b-hanger {
    display: flex;
    justify-content: center;
    margin-bottom: 8px;
  }

  .b-ring {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #333333;
  }

  /* En-tête de la bande */
  .b-header {
    border-bottom: 1px solid #222222;
    padding-bottom: 8px;
    margin-bottom: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .b-num {
    font-family: monospace;
    font-size: 10px;
    font-weight: 700;
    color: #888888;
  }

  .b-titre {
    margin: 0;
    font: 700 11px/1.2 var(--font);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ffffff;
    word-break: normal;
    overflow-wrap: break-word;
  }

  /* Corps textuel sur la bande */
  .b-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .b-star {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #ffffff;
    color: #000000;
    font: 800 7.5px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 999px;
    align-self: flex-start;
  }

  .b-desc {
    font: 400 10.5px/1.35 var(--font);
    color: #cccccc;
    word-break: normal;
    overflow-wrap: break-word;
  }

  /* Fentes 3D (entrée et sortie) */
  .b-slit {
    background: #080808;
    padding: 6px 4px;
    text-align: center;
    font: 800 7.5px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    box-shadow: inset 0 6px 8px #000000;
  }

  .b-slit-entry {
    margin-top: 10px;
    border-top: 2px solid #444444;
  }

  .b-slit-exit {
    margin-bottom: 10px;
    border-bottom: 2px solid #444444;
  }

  /* Terminaison fanion (chevron swallowtail cut) */
  .bande-noire.is-terminal {
    padding-bottom: 34px;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 16px),
      50% 100%,
      0 calc(100% - 16px)
    );
  }

  .b-footer {
    margin-top: 12px;
    display: flex;
    justify-content: center;
  }

  .b-link {
    display: inline-block;
    padding: 4px 10px;
