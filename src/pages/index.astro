const pitch = 14;
const stripeWidth = 8;
const bundleStartX = 40;
const logoSize = 36;
const logoStaggerStep = 42; // Échelon spacieux pour grands logos nets (42px > 36px, marge 6px)
const topOffset = 30;
const numTracks = projectsInfographique.length;

const cardsStartY = topOffset + (numTracks * logoStaggerStep) + 30;
const cardStartX = bundleStartX + (numTracks * pitch) + 40; // ~220px
const itemHeight = 310; // Format zoomé spacieux

const renderedTracks = projectsInfographique.map((p, idx) => {
  const trackIdx = numTracks - 1 - idx;
  const lineX = bundleStartX + (trackIdx * pitch);
  
  const logoX = lineX;
  const logoY = topOffset + (trackIdx * logoStaggerStep);

  const targetCardY = cardsStartY + (idx * itemHeight);
  const spurY = targetCardY + 65;

  // Ligne 100% orthogonale droite : AUCUNE COURBE
  // Démarre au bas exact du médaillon sans superposition
  const lineStartY = logoY + (logoSize / 2);
  const d = `M ${lineX} ${lineStartY} V ${spurY} H ${cardStartX - 2}`;

  return {
    ...p,
    trackIdx,
    lineX,
    d,
    spurY,
    logoX,
    logoY,
    targetCardY,
  };
});

const totalTimelineHeight = cardsStartY + (projectsInfographique.length * itemHeight) + 60;
