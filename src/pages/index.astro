---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-section" class="btn-noir btn-hero">
          Faire défiler la chronologie &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-section" class="scroll-cue" aria-label="Découvrir la chronologie">
      <span class="scroll-label">CHRONOLOGIE</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= ZONE DE SCROLL CHRONOLOGIQUE (BANDEAUX DYNAMIQUES) ================= -->
  <section class="chrono-scroll-wrapper" id="chronologie-section">
    <!-- Scène sticky qui reste à l'écran pendant le scroll -->
    <div class="chrono-sticky-stage">
      <!-- Barre supérieure : date courante, jauge de scroll & repères temporels -->
      <header class="chrono-stage-header">
        <div class="header-topline">
          <div class="header-badge-group">
            <span class="etiquette">CHRONOLOGIE ACTIVE AU SCROLL</span>
            <span class="stage-period-counter" id="stagePeriodCounter">PÉRIODE 1 / {periodes.length}</span>
          </div>

          <!-- Légende monochrome des jalons -->
          <div class="bandeaux-legende" aria-label="Légende des statuts">
            <span class="legende-pill"><span class="leg-dot tf-dot">&#9733;</span> Temps Fort</span>
            <span class="legende-pill"><span class="leg-dot phase-dot">&#9632;</span> Phase</span>
            <span class="legende-pill"><span class="leg-dot pause-dot">&#9208;</span> Pause R&amp;D</span>
            <span class="legende-pill"><span class="leg-dot statut-dot">&#9679;</span> Statut Actuel</span>
          </div>
        </div>

        <!-- Titre et description dynamique de la période courante -->
        <div class="current-period-display">
          <div class="period-date-badge" id="periodDateBadge">{periodes[0].dateLabel}</div>
          <div class="period-text-group">
            <h2 class="period-title" id="periodTitle">{periodes[0].titrePeriode}</h2>
            <p class="period-desc" id="periodDesc">{periodes[0].resumePeriode}</p>
          </div>
        </div>

        <!-- Scrubber horizontal de dates (permet aussi le clic direct) -->
        <div class="dates-scrubber" role="tablist" aria-label="Jalons chronologiques">
          <div class="scrubber-track-line">
            <div class="scrubber-track-fill" id="scrubberFill"></div>
          </div>
          {
            periodes.map((p, idx) => (
              <button
                type="button"
                class={`date-scrub-btn ${idx === 0 ? 'active' : ''}`}
                data-index={idx}
                aria-label={`Aller à la période ${p.dateLabel}`}
              >
                <span class="scrub-dot" aria-hidden="true"></span>
                <span class="scrub-label">{p.dateLabel}</span>
              </button>
            ))
          }
        </div>
      </header>

      <!-- Scène des bandeaux verticaux : ceux qui sont inactifs disparaissent et les autres se reforment -->
      <div class="chrono-stage-viewport">
        <div class="chrono-bands-row" id="chronoBandsRow">
          {
            projetsChrono.map((projet) => (
              <article
                class="chrono-band-item is-dormant"
                id={`bandeau-${projet.id}`}
                data-project={projet.id}
              >
                <!-- En-tête du bandeau -->
                <div class="band-item-head">
                  <div class="band-num-tag">{projet.numero}</div>
                  <div class="band-logo-box">
                    <img src={projet.logo} alt={`Logo ${projet.titre}`} loading="lazy" />
                  </div>
                  <div class="band-title-box">
                    <h3 class="band-title">{projet.titre}</h3>
                    <span class="band-domain">{projet.domaine}</span>
                  </div>
                </div>

                <!-- Corps de l'étape active à la date affichée -->
                <div class="band-step-body">
                  <div class="band-step-head">
                    <span class="band-step-date" data-field="date"></span>
                    <span class="band-step-badge" data-field="badge"></span>
                  </div>
                  <h4 class="band-step-title" data-field="title"></h4>
                  <p class="band-step-desc" data-field="desc"></p>
                </div>

                <!-- Pied du bandeau : Liens fiche & GitHub -->
                <div class="band-item-foot">
                  <a href={projet.lien} class="btn-noir band-btn-link">
                    Fiche &rarr;
                  </a>
                  {projet.github && (
                    <a
                      href={projet.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-outline band-btn-gh"
                      title={`Dépôt GitHub de ${projet.titre}`}
                    >
                      GitHub ↗
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<!-- Injecter les données structurées des périodes et états pour le script côté client -->
<script define:vars={{ periodes, projetsChrono }}>
  window.CHRONO_DATA = { periodes, projetsChrono };
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const data = (window as any).CHRONO_DATA;
    if (!data) return;

    const { periodes, projetsChrono } = data;
    const wrapper = document.getElementById('chronologie-section');
    const scrubberFill = document.getElementById('scrubberFill');
    const periodDateBadge = document.getElementById('periodDateBadge');
    const periodTitle = document.getElementById('periodTitle');
    const periodDesc = document.getElementById('periodDesc');
    const periodCounter = document.getElementById('stagePeriodCounter');
    const scrubBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.date-scrub-btn'));

    if (!wrapper) return;

    let currentIndex = -1;
    let isTicking = false;

    // Rendu dynamique de la période choisie (apparition / disparition des bandeaux & reformulation)
    function renderPeriod(index: number) {
      if (index === currentIndex) return;
      currentIndex = index;

      const currentPeriod = periodes[index];
      if (periodDateBadge) periodDateBadge.textContent = currentPeriod.dateLabel;
      if (periodTitle) periodTitle.textContent = currentPeriod.titrePeriode;
      if (periodDesc) periodDesc.textContent = currentPeriod.resumePeriode;
      if (periodCounter) periodCounter.textContent = `PÉRIODE ${index + 1} / ${periodes.length}`;

      // Mise à jour de la jauge scrubber
      const scrubPct = ((index / (periodes.length - 1)) * 100).toFixed(1) + '%';
      if (scrubberFill) scrubberFill.style.width = scrubPct;

      scrubBtns.forEach((btn, i) => {
        btn.classList.toggle('active', i === index);
      });

      // Mise à jour de chaque bandeau vertical de projet
      projetsChrono.forEach((projet: any) => {
        const bandEl = document.getElementById(`bandeau-${projet.id}`);
        if (!bandEl) return;

        const etat = projet.etatsParPeriode[index];

        if (!etat) {
          // Le projet n'est pas actif à cette date : le bandeau disparaît et les autres se reforment
          bandEl.classList.add('is-dormant');
          bandEl.classList.remove('is-active', 'is-temps-fort', 'is-pause', 'is-statut');
        } else {
          // Le projet apparaît !
          bandEl.classList.remove('is-dormant');
          bandEl.classList.add('is-active');

          // Styles spécifiques par type d'étape
          bandEl.classList.toggle('is-temps-fort', etat.type === 'temps_fort');
          bandEl.classList.toggle('is-pause', etat.type === 'pause');
          bandEl.classList.toggle('is-statut', etat.type === 'statut');

          // Remplissage des textes de l'étape
          const dateEl = bandEl.querySelector('[data-field="date"]');
          const badgeEl = bandEl.querySelector('[data-field="badge"]');
          const titleEl = bandEl.querySelector('[data-field="title"]');
          const descEl = bandEl.querySelector('[data-field="desc"]');

          if (dateEl) dateEl.textContent = etat.date;
          if (titleEl) titleEl.textContent = etat.titre;
          if (descEl) descEl.textContent = etat.desc;

          if (badgeEl) {
            if (etat.type === 'temps_fort') {
              badgeEl.textContent = 'TEMPS FORT ★';
              badgeEl.className = 'band-step-badge badge-temps-fort';
            } else if (etat.type === 'pause') {
              badgeEl.textContent = 'PAUSE R&D ⏸';
              badgeEl.className = 'band-step-badge badge-pause';
            } else if (etat.type === 'statut') {
              badgeEl.textContent = 'STATUT ACTUEL ●';
              badgeEl.className = 'band-step-badge badge-statut';
            } else {
              badgeEl.textContent = 'PHASE ■';
              badgeEl.className = 'band-step-badge badge-phase';
            }
          }
        }
      });
    }

    // Gestion du scroll vertical pour faire avancer la chronologie
    function onScroll() {
      const rect = wrapper.getBoundingClientRect();
      const winHeight = window.innerHeight;

      // La section démarre quand son sommet atteint le haut de l'écran
      const scrolled = -rect.top;
      const totalScrollable = rect.height - winHeight;

      const progress = Math.max(0, Math.min(1, scrolled / (totalScrollable || 1)));
      const rawIndex = Math.floor(progress * periodes.length);
      const targetIndex = Math.min(periodes.length - 1, Math.max(0, rawIndex));

      renderPeriod(targetIndex);
      isTicking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!isTicking) {
          window.requestAnimationFrame(onScroll);
          isTicking = true;
        }
      },
      { passive: true }
    );

    // Initialisation
    renderPeriod(0);

    // Clic sur un bouton de date dans le scrubber
    scrubBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-index') || 0);
        const rect = wrapper.getBoundingClientRect();
        const totalScrollable = rect.height - window.innerHeight;
        const targetScrollY = window.scrollY + rect.top + (idx / (periodes.length - 1)) * totalScrollable;

        window.scrollTo({
          top: targetScrollY,
          behavior: 'smooth',
        });
      });
    });
  });
</script>

