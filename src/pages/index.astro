<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-rubans" class="btn-noir btn-hero">
          Descendre le temps &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION BANDEAUX DU TEMPS (PARALLÈLES, STRICTEMENT CÔTE À CÔTE) ================= -->
  <section class="bandeaux-timeline-section" id="chronologie-rubans">
    <div class="timeline-viewport">
      <!-- Règle verticale du temps sur la gauche -->
      <aside class="timeline-time-rail" aria-hidden="true">
        {periodesLigneDuTemps.map((periode) => (
          <div class={`rail-node node-${periode.id}`}>
            <span class="rail-year">{periode.label}</span>
            <span class="rail-tick"></span>
          </div>
        ))}
      </aside>

      <!-- Les 10 couloirs parallèles de rubans : STRICTEMENT CÔTE À CÔTE, AUCUN L'UN SUR L'AUTRE -->
      <div class="timeline-parallel-tracks">
        {rubansProjets.map((p) => {
          return (
            <div class="timeline-lane" id={`lane-${p.id}`}>
              {periodesLigneDuTemps.map((periode) => {
                const seg = p.segments[periode.id] || { etat: 'vide' };
                const isVide = seg.etat === 'vide';
                const isEnPause = seg.etat === 'en_pause';
                const isDebut = seg.etat === 'debut';
                const isActif = seg.etat === 'actif';
                const isTempsFort = seg.etat === 'temps_fort';
                const isFentePause = seg.etat === 'fente_pause';
                const isSortiePhase = seg.etat === 'sortie_phase';
                const isSortieTempsFort = seg.etat === 'sortie_temps_fort';
                const isSortieStatut = seg.etat === 'sortie_statut';
                const isStatut = seg.etat === 'statut';
                const isTerminal = isStatut || isSortieStatut;
                const isEmerging = isSortiePhase || isSortieTempsFort;

                return (
                  <div class={`lane-segment seg-${seg.etat}`}>
                    {/* 1. VIDE OU EN PAUSE : Rien sur le mur ! */}
                    {(isVide || isEnPause) && (
                      <div class="ribbon-empty-space" aria-hidden="true"></div>
                    )}

                    {/* 2. DÉBUT DU RUBAN NOIR */}
                    {isDebut && (
                      <div class="ribbon-band ribbon-start">
                        <div class="ribbon-rivet" aria-hidden="true"></div>
                        <div class="ribbon-head-info">
                          <span class="r-num">{p.numero}</span>
                          <span class="r-title">{p.titre}</span>
                        </div>
                        <div class="ribbon-step-box">
                          <span class="r-step-title">{seg.titre}</span>
                        </div>
                      </div>
                    )}

                    {/* 3. RUBAN EN CONTINU */}
                    {isActif && (
                      <div class="ribbon-band ribbon-running">
                        <div class="ribbon-step-box">
                          <span class="r-step-title">{seg.titre}</span>
                        </div>
                      </div>
                    )}

                    {/* 4. TEMPS FORT (★) BRODÉ SUR LE RUBAN */}
                    {isTempsFort && (
                      <div class="ribbon-band ribbon-running is-star">
                        <div class="r-star-pill">&#9733;</div>
                        <div class="ribbon-step-box">
                          <span class="r-step-title">{seg.titre}</span>
                        </div>
                      </div>
                    )}

                    {/* 5. LE RUBAN RENTRE DANS LA FENTE 3D (PAUSE R&D) */}
                    {isFentePause && (
                      <div class="ribbon-dive-container">
                        <div class="ribbon-band ribbon-pre-dive">
                          <div class="ribbon-step-box">
                            <span class="r-step-title">{seg.titre}</span>
                          </div>
                        </div>
                        <!-- Fente 3D dans le mur -->
                        <div class="wall-slit slit-entry" title={`Le ruban rentre dans la fente : ${seg.titre}`}>
                          <div class="slit-bevel"></div>
                          <div class="slit-hole">
                            <span class="slit-cue">&darr; FENTE &darr;</span>
                          </div>
                        </div>
                      </div>
                    )}

                    {/* 6. LE RUBAN RESSORT DE LA FENTE 3D */}
                    {isEmerging && (
                      <div class="ribbon-emerge-container">
                        <div class="wall-slit slit-exit" title="Le ruban ressort de la fente">
                          <div class="slit-hole">
                            <span class="slit-cue">&uarr; REPRISE &uarr;</span>
                          </div>
                          <div class="slit-bevel"></div>
                        </div>
                        <div class={`ribbon-band ribbon-running ${isSortieTempsFort ? 'is-star' : ''}`}>
                          {isSortieTempsFort && <div class="r-star-pill">&#9733;</div>}
                          <div class="ribbon-step-box">
                            <span class="r-step-title">{seg.titre}</span>
                          </div>
                        </div>
                      </div>
                    )}

                    {/* 7. POINTE FINALE DU FANION (AUJOURD'HUI) */}
                    {isTerminal && (
                      <div class="ribbon-terminal-container">
                        {isSortieStatut && (
                          <div class="wall-slit slit-exit">
                            <div class="slit-hole"><span class="slit-cue">&uarr; REPRISE &uarr;</span></div>
                            <div class="slit-bevel"></div>
                          </div>
                        )}
                        <div class="ribbon-band ribbon-terminal">
                          <div class="r-term-status">
                            <span class="r-term-dot"></span>
                            <span class="r-term-text">{seg.titre}</span>
                          </div>
                          <div class="r-term-actions">
                            <a href={p.lien} class="r-btn r-btn-white" title={`Fiche projet ${p.titre}`}>Fiche &rarr;</a>
                            {p.github && (
                              <a href={p.github} target="_blank" rel="noopener noreferrer" class="r-btn r-btn-ghost" title="Dépôt GitHub">GH ↗</a>
                            )}
                          </div>
                          <!-- Découpe en pointe de fanion (queue de pie / chevron) -->
                          <div class="ribbon-chevron-cut" aria-hidden="true"></div>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ==========================================================================
     ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME
     ========================================================================== */
  .hero-video-screen {
