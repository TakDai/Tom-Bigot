---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT ÉVÉNEMENTIEL & AUDIOVISUEL ================= -->
  <section class="hero-video-screen" id="top">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/videos/hero_event.webm" type="video/webm" />
        <source src="/assets/videos/hero_tours.webm" type="video/webm" />
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <!-- Portrait en incrustation naturelle (fondu vaporeux sans contour artificiel) -->
      <div class="hero-portrait-blend">
        <img
          src="/assets/profile_feathered.webp"
          alt="Tom Bigot — Télépilote de drone & Production audiovisuelle"
          class="hero-portrait-img"
          width="320"
          height="340"
          loading="eager"
          decoding="async"
        />
      </div>

      <h1 class="hero-name">TOM BIGOT</h1>

      <p class="hero-title-main">
        TÉLÉPILOTAGE &amp; PRODUCTION AUDIOVISUELLE
      </p>

      <p class="hero-subtitle">
        Développement logiciel &amp; Systèmes embarqués
      </p>

      <div class="hero-tags">
        <span class="hero-tag">Télépilotage FPV</span>
        <span class="hero-tag">Événementiel</span>
        <span class="hero-tag">Code &amp; Systèmes</span>
      </div>

      <div class="hero-actions">
        <a href="#projets" class="btn-hero-primary" aria-label="Explorer les 10 projets">
          Voir les projets &darr;
        </a>
        <a href="#services" class="btn-hero-secondary">
          Mes services
        </a>
        <a href="#contact" class="btn-hero-secondary">
          Contact
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#actualites" class="scroll-cue" aria-label="Découvrir les actualités">
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= ACTUALITÉS, RÉSEAUX & AVANCEMENTS DES PROJETS (SOUS LA VIDÉO D'ACCUEIL) ================= -->
  <section class="actualites-screen" id="actualites">
    <div class="actualites-container">
      <header class="blueprint-section-head">
        <div class="section-badge-row">
          <span class="etiquette">FLUX EN DIRECT &bull; RÉSEAUX &amp; AVANCEMENTS DE PROJETS</span>
          <span class="actualites-count-badge" id="actuTotalBadge">{actualitesPosts.length} PUBLICATIONS &amp; AVANCEMENTS</span>
        </div>
        <h2 class="section-big-title">ACTUALITÉS, RÉSEAUX &amp; AVANCEMENTS</h2>
        <p class="section-big-subtitle">
          Suivi des déploiements, évolutions des catalogues sur mes sites en production et activité open-source en direct de mes réseaux (GitHub, Twitch, plateformes web).
        </p>

        <!-- Barre de filtres interactive -->
        <div class="actualites-filters-bar" role="tablist" aria-label="Filtrer les actualités">
          <button type="button" class="actu-filter-btn active" data-filter="all">
            <span>Tous les flux</span>
            <span class="filter-count">({actualitesPosts.length})</span>
          </button>
          <button type="button" class="actu-filter-btn" data-filter="projet">
            <span>🌐 Avancements Sites</span>
          </button>
          <button type="button" class="actu-filter-btn" data-filter="reseau">
            <span>🐙 GitHub &amp; Code</span>
          </button>
          <button type="button" class="actu-filter-btn" data-filter="twitch">
            <span>🟣 Twitch &amp; Direct</span>
          </button>
        </div>
      </header>

      <div class="actualites-grid" id="actualitesGrid">
        {actualitesPosts.map((post) => {
          return (
            <article class="actualite-card" data-category={post.sourceType}>
              <!-- Vignette / Illustration compacte -->
              <div class="actualite-thumb-box">
                <img
                  src={post.illustration}
                  alt={post.titre}
                  class="actualite-thumb-img"
                  loading="lazy"
                  width="120"
                  height="88"
                />
                <span class="actualite-thumb-source">{post.sourceNom}</span>
              </div>

              <!-- Contenu textuel et actions compactes -->
              <div class="actualite-card-content">
                <div class="actualite-card-meta">
                  <span class="actualite-date">{formaterDate(post.date)}</span>
                  <span class="actualite-badge-type">{post.badgeType}</span>
                </div>

                <h3 class="actualite-titre" title={post.titre}>{post.titre}</h3>
                <p class="actualite-desc">{post.description}</p>

                <div class="actualite-card-footer">
                  {post.tags && post.tags.length > 0 && (
                    <div class="actualite-tags-mini">
                      {post.tags.slice(0, 2).map((tag: string) => (
                        <span class="actualite-tag-mini">{tag}</span>
                      ))}
                    </div>
                  )}

                  <div class="actualite-mini-actions">
                    {post.projetId && (
                      <button
                        type="button"
                        class="actu-mini-btn btn-open-fiche"
                        data-open-fiche={post.projetId}
                        aria-haspopup="dialog"
                        title={`Ouvrir la fiche de ${post.sourceNom}`}
                      >
                        <span>Fiche</span>
                        <span class="actu-arrow">&rarr;</span>
                      </button>
                    )}
                    {post.lienSite && (
                      <a href={post.lienSite} target="_blank" rel="noopener noreferrer" class="actu-mini-btn primary" title="Visiter le site officiel">
                        <span>Site</span>
                        <span class="actu-arrow">&#8599;</span>
                      </a>
                    )}
                    {post.lienGitHub && !post.lienSite && (
                      <a href={post.lienGitHub} target="_blank" rel="noopener noreferrer" class="actu-mini-btn" title="Voir le code source sur GitHub">
                        <span>GitHub</span>
                        <span class="actu-arrow">&#8599;</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="actualites-footer-actions">
        <a href="https://github.com/TakDai" target="_blank" rel="noopener noreferrer" class="btn-noir">
          <span>Suivre mon activité sur GitHub (@TakDai)</span>
          <span class="btn-arrow">&#8599;</span>
        </a>
        <a href="#projets" class="btn-outline">
          <span>Explorer les 10 projets</span>
          <span class="btn-arrow">&darr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= TIMELINE DU SCROLL CLIQUABLE (INDICATEUR INTERACTIF COMPLET) ================= -->
  <aside class="scroll-timeline-nav" id="scrollTimeline" aria-label="Timeline de navigation du scroll">
    <div class="timeline-rail-wrap">
      <!-- Ligne de rail continue avec progression en temps réel -->
      <div class="timeline-track-line">
        <div class="timeline-track-progress" id="timelineProgressBar"></div>
      </div>

      <!-- Les 10 nœuds de projets cliquables avec logos authentiques -->
      <nav class="timeline-nodes-list">
        {projects.map((p, idx) => (
          <a
            href={`#${p.id}`}
            class={`timeline-node-item node-${p.id}`}
            data-target-id={p.id}
            data-index={idx}
            aria-label={`Aller au projet ${p.num} : ${p.titre}`}
          >
            <span class="node-bullet">
              <span class="node-logo-circle">
                <img src={p.logo} alt="" class="node-bullet-logo" loading="lazy" />
              </span>
              <span class="node-num-tag">{p.num}</span>
            </span>
            <span class="node-flyout">
              <span class="node-flyout-logo-frame">
                <img src={p.logo} alt="" class="node-flyout-logo" loading="lazy" />
              </span>
              <span class="node-flyout-num">{p.num}</span>
              <span class="node-flyout-title">{p.titre}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </aside>

  <!-- ================= TIMELINE HORIZONTALE COMPACTE (MOBILE / TABLETTE) ================= -->
  <nav class="mobile-timeline-bar" id="mobileTimeline" aria-label="Navigation rapide mobile">
    <div class="mobile-timeline-track">
      <div class="mobile-timeline-fill" id="mobileTimelineFill"></div>
    </div>
    <div class="mobile-timeline-items">
      {projects.map((p, idx) => (
        <a
          href={`#${p.id}`}
          class="mobile-timeline-btn"
          data-target-id={p.id}
          data-index={idx}
          title={`${p.num} ${p.titre}`}
        >
          <img src={p.logo} alt="" class="mob-logo" loading="lazy" />
          <span class="mob-num">{p.num}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- ================= SECTIONS PLEIN ÉCRAN PASTEL & PARALLAXE ================= -->
  <div class="projets-fullscreen-wrapper" id="projets">
    {projects.map((p, idx) => {
      const nextProject = projects[idx + 1] || null;
      const nextTarget = nextProject ? `#${nextProject.id}` : '#top';
      const nextLabel = nextProject ? `Projet suivant : ${nextProject.num} ${nextProject.titre}` : '↑ Haut de page';
      const shortNextLabel = nextProject ? `0${idx + 2} Suivant` : 'Haut';

      return (
        <article class="project-block-container">
          <section
            class={`project-fullscreen-section project-${p.id}`}
            id={p.id}
            style={`--project-pastel: ${p.color}; --project-accent: ${p.accent};`}
            data-index={idx}
          >
            <!-- Couche Vidéo de Fond Subtile intégrée à la couleur unie pastel -->
            <div class="project-video-layer" aria-hidden="true">
              <video
                class="project-bg-video"
                src={p.video}
                loop
                muted
                playsinline
                preload="none"
              >
                <source src={p.video} type="video/webm" />
              </video>
              <div class="project-video-tint"></div>
            </div>

            <!-- Filigrane Parallaxe Géant en arrière-plan -->
            <div class="parallax-watermark" aria-hidden="true" data-parallax-speed="0.28">
              <span class="watermark-number">{p.num}</span>
            </div>

            <!-- Bandeau supérieur plein écran / Séparation d'en-tête -->
            <header class="section-top-bar">
              <div class="top-bar-left">
                <span class="bar-step-tag">PROJET {p.num} / 10</span>
                <span class="bar-separator">&bull;</span>
                <span class="bar-domain">{p.domaine}</span>
              </div>
              <div class="top-bar-right">
                <span class="bar-date-pill">{p.date}</span>
              </div>
            </header>

            <!-- Zone centrale : grille deux colonnes avec effet parallaxe décalé -->
            <div class="project-main-content">
              <div class="project-left-col">
                <div class="project-title-lockup">
                  <div class="mobile-logo-badge">
                    <img src={p.logo} alt={p.titre} />
                  </div>
                  <div class="title-text-group">
                    <span class="title-subhead">{p.domaine}</span>
                    <h2 class="project-title">{p.titre}</h2>
                  </div>
                </div>

                <p class="project-description">{p.desc}</p>

                <!-- Badges techniques du projet -->
                <div class="tech-pills-row">
                  {p.tech.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>

                <!-- Boutons d'action -->
                <div class="project-actions">
                  <a
                    href={p.lien}
                    class="btn-action btn-primary btn-open-fiche"
                    data-open-fiche={p.id}
                    aria-haspopup="dialog"
                    aria-controls={`fiche-modal-${p.id}`}
                  >
                    <span>Fiche détaillée</span>
                    <span class="btn-action-arrow">&rarr;</span>
                  </a>
                  {p.site && (
                    <a href={p.site} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                      <span>Site officiel</span>
                      <span class="btn-action-arrow">&#8599;</span>
                    </a>
                  )}
                  {p.github && (
                    <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                      <span>Code source</span>
                      <span class="btn-action-arrow">&#8599;</span>
                    </a>
                  )}
                </div>
              </div>

              <!-- Colonne droite : Carte Emblème avec Parallaxe Inversé (Desktop) -->
              <div class="project-right-col" data-parallax-speed="-0.15">
                <div
                  class="emblem-card-frame btn-open-fiche"
                  data-open-fiche={p.id}
                  role="button"
                  tabindex="0"
                  aria-label={`Ouvrir la fiche de ${p.titre}`}
                  title={`Ouvrir la fiche pop-up de ${p.titre}`}
                >
                  <div class="emblem-card-inner">
                    <div class="emblem-logo-circle">
                      <img src={p.logo} alt={p.titre} />
                    </div>
                    <div class="emblem-card-info">
