<script>
  // Activation interactive des bandes de projets au défilement
  function initChronoBandes() {
    const bandes = Array.from(document.querySelectorAll<HTMLElement>('.projet-bande'));
    const railFill = document.getElementById('railFill');
    const chronoCounter = document.getElementById('chronoCounter');
    const track = document.getElementById('bandesTrack');

    if (!bandes.length) return;

    const total = bandes.length;

    // 1. Observer pour activer avec précision la bande la plus visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
          } else {
            // Désactiver seulement si ce n'est pas la seule dans la zone
            entry.target.classList.remove('is-active');
          }
        });
      },
      {
        rootMargin: '-18% 0px -25% 0px',
        threshold: 0.15,
      }
    );

    bandes.forEach((b) => observer.observe(b));

    // 2. Progression dynamique du rail vertical et mise à jour du compteur
    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const winH = window.innerHeight;
          const centerY = winH * 0.45;

          // Mise à jour de la bande la plus proche du centre de lecture
          let closestBande: HTMLElement | null = null;
          let minDistance = Infinity;

          bandes.forEach((bande) => {
            const rect = bande.getBoundingClientRect();
            const bandeCenter = rect.top + rect.height / 2;
            const dist = Math.abs(bandeCenter - centerY);

            if (dist < minDistance) {
              minDistance = dist;
              closestBande = bande;
            }
          });

          if (closestBande) {
            bandes.forEach((b) => {
              if (b === closestBande) {
                b.classList.add('is-active');
              }
            });

            const indexVal = (closestBande as HTMLElement).dataset.index || '01';
            if (chronoCounter) {
              chronoCounter.textContent = `${indexVal} / ${String(total).padStart(2, '0')}`;
            }
          }

          // Remplissage progressif du rail vertical
          if (track && railFill) {
            const trackRect = track.getBoundingClientRect();
            const start = trackRect.top - winH * 0.7;
            const end = trackRect.bottom - winH * 0.3;
            const totalTravel = end - start;

            if (totalTravel > 0) {
              const currentTravel = -start;
              const ratio = Math.max(0, Math.min(1, currentTravel / totalTravel));
              railFill.style.height = `${(ratio * 100).toFixed(1)}%`;
            }
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // Exécuter une première fois
  }

  // Initialisation immédiate et support des navigations Astro
  initChronoBandes();
  document.addEventListener('astro:page-load', initChronoBandes);
</script>
