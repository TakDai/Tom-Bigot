<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-verticale" class="btn-noir btn-hero">
          Descendre dans la chronologie &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-verticale" class="scroll-cue" aria-label="Découvrir la chronologie en rubans">
      <span class="scroll-label">CHRONOLOGIE &bull; RUBANS VERTICAUX</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION CHRONOLOGIE VERTICALE AU SCROLL ================= -->
  <section class="chrono-verticale-section" id="chronologie-verticale">
    <!-- Barre temporelle sticky en haut : navigation directe dans les dates -->
    <nav class="sticky-time-bar" aria-label="Navigation chronologique des dates">
      <div class="time-bar-inner">
        <span class="time-bar-legend">AXE CHRONOLOGIQUE :</span>
        <div class="time-bar-pills">
          {epoques.map((ep, idx) => (
            <a
              href={`#epoque-${ep.id}`}
              class={`time-pill ${idx === 0 ? 'is-active' : ''}`}
              data-target={`epoque-${ep.id}`}
            >
              <span class="time-pill-date">{ep.dateLabel}</span>
              <span class="time-pill-count">
                {ep.rubans.length} ruban{ep.rubans.length > 1 ? 's' : ''}
                {ep.fentesPause.length > 0 && ` &bull; ${ep.fentesPause.length} fente${ep.fentesPause.length > 1 ? 's' : ''}`}
              </span>
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Déroulé vertical des époques au fil du scroll -->
    <div class="epoques-vertical-flow">
      {epoques.map((epoque, epIndex) => (
        <section class="epoque-vertical-slice" id={`epoque-${epoque.id}`}>
          <!-- En-tête de date de la période -->
          <header class="epoque-header-block">
            <div class="epoque-date-badge-row">
              <span class="epoque-tag">{epoque.badge}</span>
              <span class="epoque-year">{epoque.dateLabel}</span>
            </div>
            <h2 class="epoque-titre">{epoque.titre}</h2>
            <p class="epoque-desc">{epoque.desc}</p>
          </header>

          <!-- Zone centrale : les rubans actifs descendent verticalement côte à côte -->
          <div class="rubans-active-stage">
            <div class="rubans-row">
              {epoque.rubans.map((r) => {
                const isTempsFort = r.statutType === 'temps_fort' || r.statutType === 'temps_fort_emergent';
                const isEmergent = r.statutType === 'phase_emergente' || r.statutType === 'temps_fort_emergent';
                const isStatut = r.statutType === 'statut';

                return (
                  <article class={`ruban-vertical-band ${isTempsFort ? 'has-temps-fort' : ''} ${isStatut ? 'is-statut-final' : ''}`}>
                    <!-- Si le ruban ressort d'une fente à cette date -->
                    {isEmergent && (
                      <div class="ruban-fente-emergence-top" title="Le ruban ressort de la fente">
                        <div class="fente-levre-haut"></div>
                        <div class="fente-abyme-shadow">
                          <span class="fente-indic">&uarr; RESSORT DE LA FENTE &uarr;</span>
                        </div>
                        <div class="fente-levre-bas"></div>
                      </div>
                    )}

                    <!-- Suspension du ruban : rivets et barre métallique -->
                    {!isEmergent && (
                      <div class="ruban-suspension-tete" aria-hidden="true">
                        <span class="rivet-oeillet"></span>
                        <div class="tringle-fil"></div>
                        <span class="rivet-oeillet"></span>
                      </div>
                    )}

                    <!-- Corps du ruban textile -->
                    <div class="ruban-tissu-surface">
                      <!-- Surpiqûres de couture le long des liserés du ruban -->
                      <div class="surpiqure-bord-gauche" aria-hidden="true"></div>
                      <div class="surpiqure-bord-droite" aria-hidden="true"></div>

                      <!-- En-tête imprimé sur le ruban -->
                      <div class="ruban-imprime-head">
                        <div class="ruban-meta-row">
                          <span class="ruban-num">{r.numero}</span>
                          <span class="ruban-domaine">{r.domaine}</span>
                        </div>

                        <div class="ruban-identite">
                          <div class="ruban-logo-box">
                            <img src={r.logo} alt={`Logo ${r.titre}`} loading="lazy" />
                          </div>
                          <div>
                            <h3 class="ruban-nom">{r.titre}</h3>
                            <span class="ruban-badge-tissu">{r.badgeTissu}</span>
                          </div>
                        </div>
                      </div>

                      <!-- Contenu de l'étape sur le tissu -->
                      {isTempsFort ? (
                        <div class="ecusson-patch-noir">
                          <div class="ecusson-fil-bordure">
                            <div class="ecusson-top">
                              <span class="ecusson-etoile">&#9733;</span>
                              <span class="ecusson-mention">POINT FORT</span>
                              <span class="ecusson-date">{r.etapeDate}</span>
                            </div>
                            <h4 class="ecusson-titre">{r.etapeTitre}</h4>
                            <p class="ecusson-texte">{r.etapeDesc}</p>
                          </div>
                        </div>
                      ) : (
                        <div class="etape-imprimee-tissu">
                          <div class="etape-top">
                            <span class="etape-bullet">&#9632;</span>
                            <span class="etape-date">{r.etapeDate}</span>
                          </div>
                          <h4 class="etape-titre">{r.etapeTitre}</h4>
                          <p class="etape-texte">{r.etapeDesc}</p>
                        </div>
                      )}

                      <!-- Bas de ruban : ourlet en biseau & actions -->
                      <div class="ruban-base-ourlet">
                        <div class="ruban-actions">
                          <a href={r.lien} class="btn-noir ruban-btn">
                            Fiche &rarr;
                          </a>
                          {r.github && (
                            <a
                              href={r.github}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="btn-outline ruban-btn"
                              title={`Dépôt GitHub de ${r.titre}`}
                            >
                              GitHub ↗
                            </a>
                          )}
                        </div>
                        <div class="ruban-queue-biseau" aria-hidden="true"></div>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>

          <!-- Si des projets sont en pause à cette date : ils plongent et disparaissent dans une fente -->
          {epoque.fentesPause.length > 0 && (
            <div class="fentes-pause-zone">
              <div class="fentes-pause-intro">
                <span class="fentes-pause-badge">&#9208; EN PAUSE R&amp;D &bull; LE RUBAN RENTRE DANS UNE FENTE</span>
                <span class="fentes-pause-count">{epoque.fentesPause.length} projet{epoque.fentesPause.length > 1 ? 's' : ''} en retrait sous la paroi</span>
              </div>

              <div class="fentes-pause-grid">
                {epoque.fentesPause.map((f) => (
                  <div class="fente-pause-artefact">
                    <!-- Partie supérieure : ruban qui plonge vers la fente -->
                    <div class="ruban-plongeon-slot-in">
                      <div class="ruban-plongeon-etiquette">
                        <span class="ruban-mini-num">{f.numero}</span>
                        <span class="ruban-mini-nom">{f.titre}</span>
                      </div>
                    </div>

                    <!-- FENTE PHYSIQUE 3D DANS LAQUELLE LE RUBAN RENTRE -->
                    <div class="fente-cavite-physique" title={`${f.titre} rentre dans la fente`}>
                      <div class="fente-levre-haut"></div>
                      <div class="fente-abyme-shadow">
                        <span class="fente-indic">&darr; RENTRE DANS LA FENTE &darr;</span>
                      </div>
                      <div class="fente-levre-bas"></div>
                    </div>

                    <!-- Sous la fente : le ruban a disparu dans la paroi -->
                    <div class="fente-sous-paroi">
                      <div class="fente-pause-motif" aria-hidden="true"></div>
                      <div class="fente-pause-fiche">
                        <div class="fente-pause-meta">
                          <span class="fente-pause-tag">PAUSE R&amp;D</span>
                          <span class="fente-pause-date">{f.date}</span>
                        </div>
                        <h4 class="fente-pause-titre">{f.titrePause}</h4>
                        <p class="fente-pause-desc">{f.descPause}</p>
                        <div class="fente-pause-sub">
                          <span class="fente-pause-dot"></span>
                          Ruban rétracté dans la fente &bull; absent de l'établi
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>
      ))}
    </div>
  </section>
</Base>

<script>
  // Mise à jour de la barre temporelle sticky au scroll vertical
  document.addEventListener('DOMContentLoaded', () => {
    const timePills = document.querySelectorAll<HTMLAnchorElement>('.time-pill');
    const slices = document.querySelectorAll<HTMLElement>('.epoque-vertical-slice');

    if (slices.length === 0 || timePills.length === 0) return;

    function onScroll() {
      const scrollY = window.scrollY + 180;
      let activeIndex = 0;

      slices.forEach((slice, idx) => {
        const top = slice.offsetTop;
        if (scrollY >= top) {
          activeIndex = idx;
        }
      });

      timePills.forEach((pill, idx) => {
        if (idx === activeIndex) {
          pill.classList.add('is-active');
        } else {
          pill.classList.remove('is-active');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Défilement doux lors du clic sur une puce de date
    timePills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = pill.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          const top = targetEl.getBoundingClientRect().top + window.scrollY - 70;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });
  });
</script>

<style>
