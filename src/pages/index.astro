---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-section" class="btn-noir btn-hero">
          Faire défiler le bandeau &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-section" class="scroll-cue" aria-label="Découvrir le bandeau de projets">
      <span class="scroll-label">BANDEAU PROJETS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION BANDEAUX TISSU & FENTES AU SCROLL ================= -->
  <section class="chrono-fluid-section" id="chronologie-section">
    <div class="chrono-sticky-viewport">
      <!-- En-tête de la chronologie -->
      <header class="chrono-fluid-header">
        <div class="header-main-row">
          <div class="header-brand-block">
            <span class="etiquette">CHRONOLOGIE DU TRAVAIL &bull; 10 BANDEAUX TISSU</span>
            <h2 class="chrono-main-title">BANDEAUX TECHNIQUES &bull; POINTS FORTS &bull; FENTES R&amp;D</h2>
          </div>

          <!-- Légende monochrome explicite -->
          <div class="bandeaux-legende" aria-label="Légende des rubans">
            <span class="legende-pill"><span class="leg-patch-icon">&#9733;</span> Écusson Temps Fort</span>
            <span class="legende-pill"><span class="leg-tissu-icon"></span> Ruban Tissu</span>
            <span class="legende-pill"><span class="leg-fente-icon"></span> Fente (Entrée / Sortie)</span>
            <span class="legende-pill"><span class="leg-dot statut-dot">&#9679;</span> Statut Actuel</span>
          </div>
        </div>

        <!-- Sélecteur rapide des 10 bandeaux de projet -->
        <nav class="ribbon-selector-nav" aria-label="Sélectionner un bandeau de projet">
          {bandeauxProjets.map((p, idx) => (
            <button
              type="button"
              class={`ribbon-tab-btn ${idx === 0 ? 'is-active' : ''}`}
              data-target={`ruban-${p.id}`}
              id={`tab-btn-${p.id}`}
            >
              <span class="tab-num">{p.numero}</span>
              <span class="tab-titre">{p.titre}</span>
            </button>
          ))}
        </nav>

        <!-- Jauge continue de défilement horizontal (0% -> 100%) -->
        <div class="chrono-progress-bar-wrap" aria-hidden="true">
          <div class="chrono-progress-bar-fill" id="chronoProgressFill"></div>
        </div>
      </header>

      <!-- Fenêtre de défilement des bandeaux de tissu verticaux -->
      <div class="chrono-track-window" id="chronoTrackWindow">
        <div class="chrono-continuous-track" id="chronoContinuousTrack">
          {
            bandeauxProjets.map((projet) => (
              <article class="ruban-col-wrap" id={`ruban-${projet.id}`}>
                <!-- Suspension supérieure : barre métallique et œillets d'attache -->
                <div class="ruban-suspension">
                  <div class="ruban-attaches" aria-hidden="true">
                    <span class="oeillet-rivet"></span>
                    <div class="tringle-support"></div>
                    <span class="oeillet-rivet"></span>
                  </div>

                  <div class="ruban-top-header">
                    <div class="top-meta">
                      <span class="ruban-numero">{projet.numero}</span>
                      <span class="domaine-pill">{projet.domaine}</span>
                    </div>

                    <div class="ruban-brand">
                      <div class="ruban-logo">
                        <img src={projet.logo} alt={`Logo ${projet.titre}`} loading="lazy" />
                      </div>
                      <div class="ruban-brand-info">
                        <h3 class="ruban-title">{projet.titre}</h3>
                        <p class="ruban-sub">{projet.sousTitre}</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- CORPS DU RUBAN VERTICAL EN TISSU -->
                <div class="ruban-tissu-corps">
                  {projet.etapes.map((etape) => {
                    const isTempsFort = etape.type === 'temps_fort';
                    const isPause = etape.type === 'pause';
                    const isStatut = etape.type === 'statut';

                    if (isPause) {
                      return (
                        <div class="fente-sequence-container">
                          {/* FENTE D'ENTRÉE : Le ruban de tissu plonge dans la fente */}
                          <div class="fente-zone fente-entree">
                            <div class="ruban-plongeon-slot" aria-hidden="true">
                              <div class="point-couture-g"></div>
                              <div class="point-couture-d"></div>
                            </div>
                            <div class="fente-fissure-barre" title="Le ruban plonge dans la fente">
                              <div class="fente-levre-top"></div>
                              <div class="fente-cavite-ombre">
                                <span class="fente-slot-texte">&darr; RENTRE DANS LA FENTE &darr;</span>
                              </div>
                              <div class="fente-levre-bot"></div>
                            </div>
                          </div>

                          {/* ZONE EN RETRAIT SOUS LA PAROI (pendant la pause) */}
                          <div class="zone-sous-paroi">
                            <div class="trace-sous-paroi" aria-hidden="true"></div>
                            <div class="pause-card-interne">
                              <div class="pause-topline">
                                <span class="badge-pause-fente">PAUSE R&amp;D</span>
                                <span class="pause-date">{etape.date}</span>
                              </div>
                              <h4 class="pause-titre">{etape.titre}</h4>
                              <p class="pause-desc">{etape.desc}</p>
                              <div class="pause-fente-info">
                                <span class="pause-pulse-indicator"></span>
                                Ruban rétracté dans la fente
                              </div>
                            </div>
                          </div>

                          {/* FENTE DE SORTIE : Le ruban de tissu ressort de la fente */}
                          <div class="fente-zone fente-sortie">
                            <div class="fente-fissure-barre" title="Le ruban ressort de la fente">
                              <div class="fente-levre-top"></div>
                              <div class="fente-cavite-ombre">
                                <span class="fente-slot-texte">&uarr; RESSORT DE LA FENTE &uarr;</span>
                              </div>
                              <div class="fente-levre-bot"></div>
                            </div>
                            <div class="ruban-emergence-slot" aria-hidden="true">
                              <div class="point-couture-g"></div>
                              <div class="point-couture-d"></div>
                            </div>
                          </div>
                        </div>
                      );
                    }

                    if (isTempsFort) {
                      return (
                        <div class="ruban-section section-temps-fort">
                          <div class="fil-couture-ruban-g" aria-hidden="true"></div>
                          <div class="fil-couture-ruban-d" aria-hidden="true"></div>

                          {/* Écusson noir brodé cousu sur le tissu */}
                          <div class="ecusson-brode-noir">
                            <div class="ecusson-stitch-cadre">
                              <div class="ecusson-head">
                                <span class="ecusson-star">&#9733;</span>
                                <span class="ecusson-tag">POINT FORT</span>
                                <span class="ecusson-date">{etape.date}</span>
                              </div>
                              <h4 class="ecusson-titre">{etape.titre}</h4>
                              <p class="ecusson-desc">{etape.desc}</p>
                            </div>
                          </div>
                        </div>
                      );
                    }

                    if (isStatut) {
                      return (
                        <div class="ruban-section section-statut-final">
                          <div class="fil-couture-ruban-g" aria-hidden="true"></div>
                          <div class="fil-couture-ruban-d" aria-hidden="true"></div>

                          <div class="etiquette-statut-tissu">
                            <div class="statut-topline">
                              <span class="statut-pulse-dot"></span>
                              <span class="statut-tag">STATUT ACTUEL</span>
                              <span class="statut-date">{etape.date}</span>
                            </div>
                            <h4 class="statut-titre">{etape.titre}</h4>
                            <p class="statut-desc">{etape.desc}</p>
                          </div>
                        </div>
                      );
                    }

                    // Phase active ordinaire
                    return (
                      <div class="ruban-section section-phase-active">
                        <div class="fil-couture-ruban-g" aria-hidden="true"></div>
                        <div class="fil-couture-ruban-d" aria-hidden="true"></div>

                        <div class="etiquette-phase-tissu">
                          <div class="phase-topline">
                            <span class="phase-carre">&#9632;</span>
                            <span class="phase-tag">PHASE ACTIVE</span>
                            <span class="phase-date">{etape.date}</span>
                          </div>
                          <h4 class="phase-titre">{etape.titre}</h4>
                          <p class="phase-desc">{etape.desc}</p>
                        </div>
                      </div>
                    );
                  })}

                  <!-- Extrémité inférieure du ruban : pointe biseautée (queue d'aronde) et actions -->
                  <div class="ruban-terminaison">
                    <div class="ruban-queue-aronde" aria-hidden="true"></div>
                    <div class="ruban-actions-seam">
                      <a href={projet.lien} class="btn-noir ruban-btn-action">
                        Fiche projet &rarr;
                      </a>
                      {projet.github && (
                        <a
                          href={projet.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-outline ruban-btn-action"
                          title={`Dépôt GitHub de ${projet.titre}`}
                        >
                          GitHub ↗
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Défilement 1:1 continu des bandeaux au scroll + navigation par onglets
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('chronologie-section');
    const track = document.getElementById('chronoContinuousTrack');
    const fill = document.getElementById('chronoProgressFill');
    const windowEl = document.getElementById('chronoTrackWindow');
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.ribbon-tab-btn');

    if (!section || !track) return;

    function getTrackLimits() {
      const trackWidth = track.scrollWidth;
      const viewportWidth = window.innerWidth;
      const totalDistance = Math.max(0, trackWidth - viewportWidth + 80);
      return { trackWidth, viewportWidth, totalDistance };
    }

    function updateLayoutHeight() {
      if (window.innerWidth < 900) {
        section.style.height = 'auto';
        track.style.transform = 'none';
        return;
      }
      const { totalDistance } = getTrackLimits();
      section.style.height = `${window.innerHeight + totalDistance}px`;
    }

    let isTicking = false;

    function updateActiveTab(progress: number) {
      if (tabButtons.length === 0) return;
      const index = Math.min(
        tabButtons.length - 1,
        Math.floor(progress * tabButtons.length)
      );
      tabButtons.forEach((btn, idx) => {
        if (idx === index) {
          btn.classList.add('is-active');
        } else {
          btn.classList.remove('is-active');
        }
      });
    }

    function onScroll() {
      if (window.innerWidth < 900) {
        if (windowEl && fill) {
          const maxLeft = windowEl.scrollWidth - windowEl.clientWidth;
          const pct = maxLeft > 0 ? (windowEl.scrollLeft / maxLeft) * 100 : 0;
          fill.style.width = `${pct.toFixed(1)}%`;
          updateActiveTab(pct / 100);
        }
        return;
      }

      const rect = section.getBoundingClientRect();
      const { totalDistance } = getTrackLimits();

      if (totalDistance <= 0) return;

      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalDistance));
      const translateX = progress * totalDistance;

      track.style.transform = `translate3d(-${translateX.toFixed(1)}px, 0, 0)`;

      if (fill) {
        fill.style.width = `${(progress * 100).toFixed(1)}%`;
      }
      updateActiveTab(progress);

      isTicking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!isTicking) {
          window.requestAnimationFrame(onScroll);
          isTicking = true;
        }
      },
      { passive: true }
    );

    // Clic sur un bouton d'onglet ruban pour glisser directement vers le projet
    tabButtons.forEach((btn, btnIdx) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        if (window.innerWidth < 900 && windowEl) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
          }
          return;
        }

        const { totalDistance } = getTrackLimits();
        const targetProgress = btnIdx / Math.max(1, tabButtons.length - 1);
        const sectionTop = section.getBoundingClientRect().top + window.scrollY;
        const targetScrollY = sectionTop + targetProgress * totalDistance;

        window.scrollTo({
          top: targetScrollY,
          behavior: 'smooth',
        });
      });
    });

    if (windowEl) {
      windowEl.addEventListener(
        'scroll',
        () => {
          if (window.innerWidth < 900 && fill) {
            const maxLeft = windowEl.scrollWidth - windowEl.clientWidth;
            const pct = maxLeft > 0 ? (windowEl.scrollLeft / maxLeft) * 100 : 0;
            fill.style.width = `${pct.toFixed(1)}%`;
            updateActiveTab(pct / 100);
          }
        },
        { passive: true }
      );
    }

    window.addEventListener('resize', () => {
      updateLayoutHeight();
      onScroll();
    });

    updateLayoutHeight();
    onScroll();
  });
</script>

