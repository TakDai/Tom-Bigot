---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-section" class="btn-noir btn-hero">
          Faire défiler le bandeau &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-section" class="scroll-cue" aria-label="Découvrir le bandeau de projets">
      <span class="scroll-label">BANDEAU PROJETS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION BANDEAU FLUIDE AU SCROLL ================= -->
  <section class="chrono-fluid-section" id="chronologie-section">
    <div class="chrono-sticky-viewport">
      <!-- En-tête du bandeau avec jauge continue de progression -->
      <header class="chrono-fluid-header">
        <div class="header-main-row">
          <div class="header-brand-block">
            <span class="etiquette">CHRONOLOGIE DU TRAVAIL &bull; 10 PROJETS</span>
            <h2 class="chrono-main-title">BANDEAU TECHNIQUE &amp; POINTS FORTS</h2>
          </div>

          <!-- Légende monochrome -->
          <div class="bandeaux-legende" aria-label="Légende des étapes">
            <span class="legende-pill"><span class="leg-dot tf-dot">&#9733;</span> Temps Fort</span>
            <span class="legende-pill"><span class="leg-dot phase-dot">&#9632;</span> Phase</span>
            <span class="legende-pill"><span class="leg-dot pause-dot">&#9208;</span> Pause R&amp;D</span>
            <span class="legende-pill"><span class="leg-dot statut-dot">&#9679;</span> Statut Actuel</span>
          </div>
        </div>

        <!-- Jauge continue de défilement horizontal (0% -> 100%) -->
        <div class="chrono-progress-bar-wrap" aria-hidden="true">
          <div class="chrono-progress-bar-fill" id="chronoProgressFill"></div>
        </div>
      </header>

      <!-- Fenêtre de défilement du bandeau horizontal continu -->
      <div class="chrono-track-window" id="chronoTrackWindow">
        <div class="chrono-continuous-track" id="chronoContinuousTrack">
          {
            bandeauxProjets.map((projet) => (
              <article class="chrono-card-col" id={`projet-${projet.id}`}>
                <!-- En-tête de la colonne de projet -->
                <div class="col-head">
                  <div class="col-topline">
                    <span class="col-num">{projet.numero}</span>
                    <span class="domaine-pill">{projet.domaine}</span>
                  </div>

                  <div class="col-brand">
                    <div class="col-logo">
                      <img src={projet.logo} alt={`Logo ${projet.titre}`} loading="lazy" />
                    </div>
                    <div>
                      <h3 class="col-title">{projet.titre}</h3>
                      <p class="col-sub">{projet.sousTitre}</p>
                    </div>
                  </div>
                </div>

                <!-- Parcours chronologique vertical du projet avec ses points forts -->
                <div class="col-track">
                  <div class="col-track-spine" aria-hidden="true"></div>
                  <div class="col-steps-list">
                    {projet.etapes.map((etape) => {
                      const isTempsFort = etape.type === 'temps_fort';
                      const isPause = etape.type === 'pause';
                      const isStatut = etape.type === 'statut';

                      return (
                        <div
                          class={`v-step-node ${isTempsFort ? 'is-temps-fort' : ''} ${isPause ? 'is-pause' : ''} ${isStatut ? 'is-statut' : ''}`}
                        >
                          <div class="v-step-bullet" aria-hidden="true">
                            {isTempsFort ? '★' : isPause ? '⏸' : isStatut ? '●' : '■'}
                          </div>
                          <div class="v-step-card">
                            <div class="v-step-head">
                              <span class="v-step-date">{etape.date}</span>
                              {isTempsFort && <span class="v-tf-badge">TEMPS FORT</span>}
                              {isPause && <span class="v-pause-badge">PAUSE R&amp;D</span>}
                              {isStatut && <span class="v-statut-badge">STATUT ACTUEL</span>}
                            </div>
                            <h4 class="v-step-title">{etape.titre}</h4>
                            <p class="v-step-desc">{etape.desc}</p>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>

                <!-- Pied de colonne : liens fiche & dépôt -->
                <div class="col-foot">
                  <a href={projet.lien} class="btn-noir col-btn-fiche">
                    Fiche projet &rarr;
                  </a>
                  {projet.github && (
                    <a
                      href={projet.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-outline col-btn-gh"
                      title={`Dépôt GitHub de ${projet.titre}`}
                    >
                      GitHub ↗
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Défilement 1:1 ultra-fluide et continu du bandeau au scroll
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('chronologie-section');
    const track = document.getElementById('chronoContinuousTrack');
    const fill = document.getElementById('chronoProgressFill');
    const windowEl = document.getElementById('chronoTrackWindow');

    if (!section || !track) return;

    function updateLayoutHeight() {
      // Sur mobile (< 900px), on laisse le scroll horizontal natif fluide
      if (window.innerWidth < 900) {
        section.style.height = 'auto';
        track.style.transform = 'none';
        return;
      }

      // Sur desktop, on calibre exactement la hauteur de scroll pour parcourir 100% du bandeau
      const trackWidth = track.scrollWidth;
      const viewportWidth = window.innerWidth;
      const totalDistance = Math.max(0, trackWidth - viewportWidth + 120);

      section.style.height = `${window.innerHeight + totalDistance}px`;
    }

    let isTicking = false;

    function onScroll() {
      if (window.innerWidth < 900) {
        // Sur mobile, mise à jour de la jauge via le scroll natif du container
        if (windowEl && fill) {
          const maxLeft = windowEl.scrollWidth - windowEl.clientWidth;
          const pct = maxLeft > 0 ? (windowEl.scrollLeft / maxLeft) * 100 : 0;
          fill.style.width = `${pct.toFixed(1)}%`;
        }
        return;
      }

      const rect = section.getBoundingClientRect();
      const trackWidth = track.scrollWidth;
      const viewportWidth = window.innerWidth;
      const totalDistance = Math.max(0, trackWidth - viewportWidth + 120);

      if (totalDistance <= 0) return;

      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalDistance));
      const translateX = progress * totalDistance;

      // Déplacement matériel direct sans à-coups
      track.style.transform = `translate3d(-${translateX.toFixed(1)}px, 0, 0)`;

      if (fill) {
        fill.style.width = `${(progress * 100).toFixed(1)}%`;
      }

      isTicking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!isTicking) {
          window.requestAnimationFrame(onScroll);
          isTicking = true;
        }
      },
      { passive: true }
    );

    if (windowEl) {
      windowEl.addEventListener(
        'scroll',
        () => {
          if (window.innerWidth < 900 && fill) {
            const maxLeft = windowEl.scrollWidth - windowEl.clientWidth;
            const pct = maxLeft > 0 ? (windowEl.scrollLeft / maxLeft) * 100 : 0;
            fill.style.width = `${pct.toFixed(1)}%`;
          }
        },
        { passive: true }
      );
    }

    window.addEventListener('resize', () => {
      updateLayoutHeight();
      onScroll();
    });

    updateLayoutHeight();
    onScroll();
  });
</script>

