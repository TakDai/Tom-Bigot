    text-transform: uppercase;
    padding: 1.5px 5px;
    border-radius: 999px;
  }

  .step-status-dot {
    font: 700 8px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a0a0a0;
  }

  .step-title {
    margin: 0;
    font: 700 11.5px/1.25 var(--font);
