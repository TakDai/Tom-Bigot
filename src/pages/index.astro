---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT ÉVÉNEMENTIEL & AUDIOVISUEL ================= -->
  <section class="hero-video-screen" id="top">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/videos/hero_event.webm" type="video/webm" />
        <source src="/assets/videos/hero_tours.webm" type="video/webm" />
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#multi-motors" class="btn-noir btn-hero">
          Explorer les 10 projets &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#multi-motors" class="scroll-cue" aria-label="Découvrir les projets plein écran">
      <span class="scroll-label">PROJETS PLEIN ÉCRAN</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= TIMELINE DU SCROLL CLIQUABLE (INDICATEUR INTERACTIF COMPLET) ================= -->
  <aside class="scroll-timeline-nav" id="scrollTimeline" aria-label="Timeline de navigation du scroll">
    <div class="timeline-rail-wrap">
      <!-- Ligne de rail continue avec progression en temps réel -->
      <div class="timeline-track-line">
        <div class="timeline-track-progress" id="timelineProgressBar"></div>
      </div>

      <!-- Les 10 nœuds de projets cliquables avec logos authentiques -->
      <nav class="timeline-nodes-list">
        {projects.map((p, idx) => (
          <a
            href={`#${p.id}`}
            class={`timeline-node-item node-${p.id}`}
            data-target-id={p.id}
            data-index={idx}
            aria-label={`Aller au projet ${p.num} : ${p.titre}`}
          >
            <span class="node-bullet">
              <span class="node-logo-circle">
                <img src={p.logo} alt="" class="node-bullet-logo" loading="lazy" />
              </span>
              <span class="node-num-tag">{p.num}</span>
            </span>
            <span class="node-flyout">
              <span class="node-flyout-logo-frame">
                <img src={p.logo} alt="" class="node-flyout-logo" loading="lazy" />
              </span>
              <span class="node-flyout-num">{p.num}</span>
              <span class="node-flyout-title">{p.titre}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </aside>

  <!-- ================= TIMELINE HORIZONTALE COMPACTE (MOBILE / TABLETTE) ================= -->
  <nav class="mobile-timeline-bar" id="mobileTimeline" aria-label="Navigation rapide mobile">
    <div class="mobile-timeline-track">
      <div class="mobile-timeline-fill" id="mobileTimelineFill"></div>
    </div>
    <div class="mobile-timeline-items">
      {projects.map((p, idx) => (
        <a
          href={`#${p.id}`}
          class="mobile-timeline-btn"
          data-target-id={p.id}
          data-index={idx}
          title={`${p.num} ${p.titre}`}
        >
          <img src={p.logo} alt="" class="mob-logo" loading="lazy" />
          <span class="mob-num">{p.num}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- ================= SECTIONS PLEIN ÉCRAN PASTEL & PARALLAXE ================= -->
  <div class="projets-fullscreen-wrapper" id="projets">
    {projects.map((p, idx) => {
      const nextProject = projects[idx + 1] || null;
      const nextTarget = nextProject ? `#${nextProject.id}` : '#top';
      const nextLabel = nextProject ? `Projet suivant : ${nextProject.num} ${nextProject.titre}` : '↑ Haut de page';
      const shortNextLabel = nextProject ? `0${idx + 2} Suivant` : 'Haut';

      return (
        <article class="project-block-container">
          <section
            class={`project-fullscreen-section project-${p.id}`}
            id={p.id}
            style={`--project-pastel: ${p.color}; --project-accent: ${p.accent};`}
            data-index={idx}
          >
            <!-- Couche Vidéo de Fond Subtile intégrée à la couleur unie pastel -->
            <div class="project-video-layer" aria-hidden="true">
              <video
                class="project-bg-video"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
              >
                <source src={p.video} type="video/webm" />
              </video>
              <div class="project-video-tint"></div>
            </div>

            <!-- Filigrane Parallaxe Géant en arrière-plan -->
            <div class="parallax-watermark" aria-hidden="true" data-parallax-speed="0.28">
              <span class="watermark-number">{p.num}</span>
            </div>

            <!-- Bandeau supérieur plein écran / Séparation d'en-tête -->
            <header class="section-top-bar">
              <div class="top-bar-left">
                <span class="bar-step-tag">PROJET {p.num} / 10</span>
                <span class="bar-separator">&bull;</span>
                <span class="bar-domain">{p.domaine}</span>
              </div>
              <div class="top-bar-right">
                <span class="bar-date-pill">{p.date}</span>
              </div>
            </header>

            <!-- Zone centrale : grille deux colonnes avec effet parallaxe décalé -->
            <div class="project-main-content">
              <div class="project-left-col">
                <div class="project-title-lockup">
                  <div class="mobile-logo-badge">
                    <img src={p.logo} alt={p.titre} />
                  </div>
                  <div class="title-text-group">
                    <span class="title-subhead">{p.domaine}</span>
                    <h2 class="project-title">{p.titre}</h2>
                  </div>
                </div>

                <p class="project-description">{p.desc}</p>

                <!-- Badges techniques du projet -->
                <div class="tech-pills-row">
                  {p.tech.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>

                <!-- Boutons d'action -->
                <div class="project-actions">
                  <a href={p.lien} class="btn-action btn-primary">Fiche détaillée &rarr;</a>
                  {p.site && (
                    <a href={p.site} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                      Site officiel &#8599;
                    </a>
                  )}
                  {p.github && (
                    <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                      Code source &#8599;
                    </a>
                  )}
                </div>
              </div>

              <!-- Colonne droite : Carte Emblème avec Parallaxe Inversé (Desktop) -->
              <div class="project-right-col" data-parallax-speed="-0.15">
                <div class="emblem-card-frame">
                  <div class="emblem-card-inner">
                    <div class="emblem-logo-circle">
                      <img src={p.logo} alt={p.titre} />
                    </div>
                    <div class="emblem-card-info">
                      <span class="emblem-num">PROJET #{p.num}</span>
                      <span class="emblem-title">{p.titre}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bandeau inférieur plein écran / Séparation de transition -->
            <footer class="section-bottom-seam">
              <div class="seam-progress-track">
                <div class="seam-progress-fill" style={`width: ${((idx + 1) / projects.length) * 100}%;`}></div>
              </div>
              <div class="seam-info-row">
                <span class="seam-counter">{p.num} sur 10</span>
                <a href={nextTarget} class="seam-next-link" aria-label={nextLabel}>
                  <span class="seam-label-full">{nextLabel}</span>
                  <span class="seam-label-mobile">{shortNextLabel}</span>
                  <span class="seam-arrow">{nextProject ? '↓' : '↑'}</span>
                </a>
              </div>
            </footer>
          </section>

          <!-- ================= LONGUE TRANSITION PROPRE SANS ÉLÉMENTS ENTRE PROJETS ================= -->
          {nextProject && (() => {
            const v = transitionVariants[idx % transitionVariants.length];
            return (
              <div
                class="project-nonlinear-transition"
                style={`--curr-pastel: ${p.color}; --next-pastel: ${nextProject.color};`}
                aria-hidden="true"
              >
                <!-- Vague 1 : Décrochage organique supérieur avec ombre portée volumétrique -->
                <div class="trans-wave-top">
                  <svg class="wave-svg" viewBox="0 0 1440 200" preserveAspectRatio="none">
                    <defs>
                      <filter id={`top-shadow-${idx}`} x="-5%" y="-20%" width="110%" height="160%">
                        <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000000" flood-opacity="0.10" />
                      </filter>
                    </defs>
                    <path d={v.topD} fill="var(--curr-pastel)" filter={`url(#top-shadow-${idx})`} />
                    <path d={v.topLine} class="trans-wave-line" />
                  </svg>
                </div>

                <!-- Vague 2 : Courbe médiane fluide en profondeur / brume organique -->
                <div class="trans-wave-mid">
                  <svg class="wave-svg" viewBox="0 0 1440 200" preserveAspectRatio="none">
                    <path d={v.midD} fill="rgba(255, 255, 255, 0.40)" />
                    <path d={v.topLine} stroke="rgba(0, 0, 0, 0.16)" stroke-width="2" stroke-dasharray="8 6" fill="none" />
                  </svg>
                </div>

                <!-- Vague 3 : Vague organique inférieure annonçant le projet suivant -->
                <div class="trans-wave-bottom">
                  <svg class="wave-svg" viewBox="0 0 1440 200" preserveAspectRatio="none">
                    <defs>
                      <filter id={`bot-shadow-${idx}`} x="-5%" y="-20%" width="110%" height="160%">
                        <feDropShadow dx="0" dy="-8" stdDeviation="12" flood-color="#000000" flood-opacity="0.12" />
                      </filter>
                    </defs>
                    <path d={v.botD} fill="var(--next-pastel)" filter={`url(#bot-shadow-${idx})`} />
                    <path d={v.botLine} class="trans-wave-line" />
                  </svg>
                </div>
              </div>
            );
          })()}
        </article>
      );
    })}
  </div>

  <!-- ================= GESTIONNAIRE DE TIMELINE DU SCROLL, PARALLAXE & VIDÉOS ================= -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.project-fullscreen-section');
      const timelineNodes = document.querySelectorAll('.timeline-node-item');
      const mobileNodes = document.querySelectorAll('.mobile-timeline-btn');
      const timelineNav = document.getElementById('scrollTimeline');
      const mobileTimeline = document.getElementById('mobileTimeline');
      const timelineProgressBar = document.getElementById('timelineProgressBar');
      const mobileTimelineFill = document.getElementById('mobileTimelineFill');
      const hero = document.getElementById('top');
      const wrapper = document.getElementById('projets');
      let ticking = false;

      function updateScrollTimeline() {
        const windowHeight = window.innerHeight;
        const scrollY = window.scrollY;

        // 1. Émergence dynamique de la timeline depuis l'arrière de la vidéo principale
        if (hero) {
          const heroRect = hero.getBoundingClientRect();
          const heroHeight = heroRect.height || windowHeight;
          const scrolledPastTop = -heroRect.top;

          if (timelineNav) {
            // Dès que le scroll quitte le sommet (le hero commence à défiler vers le haut)
            if (scrolledPastTop > 30) {
              timelineNav.classList.add('is-visible');
              const emergeRatio = Math.max(0, Math.min(1, scrolledPastTop / (heroHeight * 0.55)));
              // Glissement depuis l'arrière de la vidéo principale vers sa position d'ancrage
              const slideX = (1 - emergeRatio) * 65;
              const scale = 0.88 + (emergeRatio * 0.12);
              const blur = (1 - emergeRatio) * 6;
              const opacity = Math.min(1, emergeRatio * 1.5);

              timelineNav.style.transform = `translate3d(${slideX.toFixed(1)}px, -50%, 0) scale(${scale.toFixed(3)})`;
              timelineNav.style.opacity = opacity.toFixed(2);
              timelineNav.style.filter = `blur(${blur.toFixed(1)}px)`;
              timelineNav.style.pointerEvents = emergeRatio >= 0.7 ? 'auto' : 'none';

              // Gestion de la profondeur : la timeline est physiquement sous le hero (z-index 5 < 10),
              // et s'élève au-dessus des sections de projets (z-index 100) dès que le hero a quitté l'écran
              if (heroRect.bottom <= 60) {
                timelineNav.style.zIndex = '100';
              } else {
                timelineNav.style.zIndex = '5';
              }
            } else {
              timelineNav.classList.remove('is-visible');
              timelineNav.style.transform = 'translate3d(75px, -50%, 0) scale(0.85)';
              timelineNav.style.opacity = '0';
              timelineNav.style.filter = 'blur(8px)';
              timelineNav.style.pointerEvents = 'none';
              timelineNav.style.zIndex = '5';
            }
          }

          if (mobileTimeline) {
            if (heroRect.bottom <= windowHeight * 0.6) mobileTimeline.classList.add('is-visible');
            else mobileTimeline.classList.remove('is-visible');
          }
        }

        // 2. Calcul du pourcentage d'avancement global dans la section projets
        if (wrapper) {
          const wrapperRect = wrapper.getBoundingClientRect();
          const totalScrollable = wrapperRect.height - windowHeight;
          if (totalScrollable > 0) {
            const currentScrolled = -wrapperRect.top;
            const progressRatio = Math.max(0, Math.min(1, currentScrolled / totalScrollable));
            const pct = (progressRatio * 100).toFixed(1) + '%';
            if (timelineProgressBar) timelineProgressBar.style.height = pct;
            if (mobileTimelineFill) mobileTimelineFill.style.width = pct;
          }
        }

        // 3. Identification du projet actif et parallaxe
        sections.forEach((section, idx) => {
          const rect = section.getBoundingClientRect();

          // Nœud actif de la timeline
          if (rect.top <= windowHeight * 0.5 && rect.bottom >= windowHeight * 0.5) {
            timelineNodes.forEach((n) => n.classList.remove('is-active'));
            mobileNodes.forEach((m) => m.classList.remove('is-active'));

            if (timelineNodes[idx]) timelineNodes[idx].classList.add('is-active');
            if (mobileNodes[idx]) mobileNodes[idx].classList.add('is-active');
          }

          // Marquage des nœuds passés (complétés)
          if (rect.bottom < windowHeight * 0.5) {
            if (timelineNodes[idx]) timelineNodes[idx].classList.add('is-past');
            if (mobileNodes[idx]) mobileNodes[idx].classList.add('is-past');
          } else {
            if (timelineNodes[idx]) timelineNodes[idx].classList.remove('is-past');
            if (mobileNodes[idx]) mobileNodes[idx].classList.remove('is-past');
          }

          // Effet de parallaxe sur les éléments visibles
          if (rect.bottom > -150 && rect.top < windowHeight + 150) {
            const progress = (windowHeight - rect.top) / (windowHeight + rect.height);
            const centeredProgress = progress - 0.5;

            // Filigrane géant
            const watermark = section.querySelector('.parallax-watermark');
            if (watermark) {
              const speed = parseFloat(watermark.getAttribute('data-parallax-speed') || 0.28);
              const translateY = centeredProgress * speed * 220;
              watermark.style.transform = `translate3d(0, calc(-50% + ${translateY}px), 0)`;
            }

            // Carte emblème
            const rightCol = section.querySelector('.project-right-col');
            if (rightCol) {
              const speed = parseFloat(rightCol.getAttribute('data-parallax-speed') || -0.15);
              const translateY = centeredProgress * speed * 120;
              rightCol.style.transform = `translate3d(0, ${translateY}px, 0)`;
            }
          }
        });

        // 4. Parallaxe dynamique fluide sur les longues transitions de projets
        const transitions = document.querySelectorAll('.project-nonlinear-transition');
        transitions.forEach((trans) => {
          const rect = trans.getBoundingClientRect();
          if (rect.bottom > -100 && rect.top < windowHeight + 100) {
            const progress = (windowHeight - rect.top) / (windowHeight + rect.height);
            const centered = progress - 0.5;
            const topWave = trans.querySelector('.trans-wave-top');
            const midWave = trans.querySelector('.trans-wave-mid');
            const botWave = trans.querySelector('.trans-wave-bottom');
            if (topWave) topWave.style.transform = `translate3d(0, ${(centered * -45).toFixed(1)}px, 0)`;
            if (midWave) midWave.style.transform = `translate3d(0, ${(centered * 65).toFixed(1)}px, 0) scaleY(-1)`;
            if (botWave) botWave.style.transform = `translate3d(0, ${(centered * 45).toFixed(1)}px, 0)`;
          }
        });

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(updateScrollTimeline);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateScrollTimeline();
    });
  </script>
