const stripeWidth = 6;
const stripeGap = 5;
const pitch = stripeWidth + stripeGap; // 11px
const numTracks = projectsInfographique.length; // 10

const innerRadius = 26;
const bundleStartX = 350;
const arcOriginX = bundleStartX - innerRadius;
const arcCenterY = 175;

const cardStartX = bundleStartX + (numTracks * pitch) + 38;
const itemHeight = 158;
const cardsStartY = arcCenterY + 25;

const renderedTracks = projectsInfographique.map((p, idx) => {
  const trackIdx = numTracks - 1 - idx;
  const R = innerRadius + (trackIdx * pitch);
  const startX = 205 + (trackIdx * 10);
  const lineY_horiz = arcCenterY - R;
  const verticalX = arcOriginX + R;
  const targetCardY = cardsStartY + (idx * itemHeight);
  const spurY = targetCardY + 44;

  const logoX = startX - 14;
  const logoY = lineY_horiz;

  let d = `M ${startX} ${lineY_horiz} `;
  d += `H ${arcOriginX} `;
  d += `A ${R} ${R} 0 0 1 ${verticalX} ${arcCenterY} `;
  d += `V ${spurY - 10} `;
  d += `Q ${verticalX} ${spurY} ${verticalX + 10} ${spurY} `;
  d += `H ${cardStartX - 15}`;

  return {
    ...p,
    trackIdx,
    d,
    spurY,
    logoX,
    logoY,
    targetCardY,
  };
});

const totalTimelineHeight = cardsStartY + (projectsInfographique.length * itemHeight) + 40;
