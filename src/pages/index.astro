<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-rubans" class="btn-noir btn-hero">
          Descendre le temps &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION BANDEAUX VERTICAUX (GROSSES LIGNES DU TEMPS) ================= -->
  <section class="chrono-table-section" id="chronologie-rubans">
    <!-- En-tête explicatif de la section -->
    <div class="chrono-table-intro">
      <div class="intro-left">
        <span class="etiquette">AXE VERTICAL = TEMPS &bull; 10 BANDEAUX PARALLÈLES</span>
        <h2 class="intro-titre">CHRONOLOGIE PAR BANDEAUX VERTICAUX</h2>
        <p class="intro-desc">
          Chaque projet possède son propre <strong>bandeau vertical (une grosse ligne continue de tissu)</strong> qui descend le long du temps. Le ruban <strong>commence</strong> à sa date de début, affiche ses <strong>points forts ★</strong>, et lors d'une pause, <strong>rentre physiquement dans une fente</strong> avant d'en ressortir à la reprise.
        </p>
      </div>

      <div class="intro-legende">
        <div class="legende-item">
          <span class="leg-tissu-echantillon"></span>
          <span>Bandeau Actif</span>
        </div>
        <div class="legende-item">
          <span class="leg-patch-echantillon">&#9733;</span>
          <span>Écusson Point Fort</span>
        </div>
        <div class="legende-item">
          <span class="leg-fente-echantillon"></span>
          <span>Fente R&amp;D (Entrée / Sortie)</span>
        </div>
      </div>
    </div>

    <!-- La grande grille de temps : le scroll vertical descend le temps -->
    <div class="timeline-viewport-scroll">
      <div class="timeline-matrix-board">
        <!-- Colonne d'axe du temps (à gauche, sticky) -->
        <aside class="time-axis-col">
          <div class="axis-header-placeholder">
            <span class="axis-title">TEMPS &darr;</span>
          </div>
          {periodesLigneDuTemps.map((p) => (
            <div class="time-axis-marker" id={`date-marker-${p.id}`}>
              <span class="axis-year">{p.label}</span>
              <span class="axis-sub">{p.sousLabel}</span>
              <div class="axis-notch"></div>
            </div>
          ))}
        </aside>

        <!-- Les 10 colonnes de projet côte à côte, traversées par leurs bandeaux verticaux -->
        <div class="projects-lanes-container">
          {rubansProjets.map((projet) => (
            <div class="project-lane" id={`col-${projet.id}`}>
              <!-- En-tête de la colonne du projet -->
              <header class="lane-header">
                <span class="lane-num">{projet.numero}</span>
                <div class="lane-logo">
                  <img src={projet.logo} alt={`Logo ${projet.titre}`} loading="lazy" />
                </div>
                <h3 class="lane-title">{projet.titre}</h3>
                <span class="lane-domain">{projet.domaine}</span>
              </header>

              <!-- Rail vertical où coule le bandeau du projet -->
              <div class="lane-ribbon-track">
                {periodesLigneDuTemps.map((periode) => {
                  const seg = projet.segments[periode.id] || { etat: 'vide' };
                  const isVide = seg.etat === 'vide';
                  const isDebut = seg.etat === 'debut';
                  const isActif = seg.etat === 'actif';
                  const isTempsFort = seg.etat === 'temps_fort';
                  const isFentePause = seg.etat === 'fente_pause';
                  const isSortiePhase = seg.etat === 'sortie_phase';
                  const isSortieTempsFort = seg.etat === 'sortie_temps_fort';
                  const isSortieStatut = seg.etat === 'sortie_statut';
                  const isStatut = seg.etat === 'statut';

                  return (
                    <div class={`ribbon-cell-block cell-${seg.etat}`} data-periode={periode.id}>
                      {/* 1. ÉTAT VIDE : Le projet n'a pas encore commencé à cette date */}
                      {isVide && (
                        <div class="cell-empty-space" aria-hidden="true">
                          <div class="faint-guide-line"></div>
                        </div>
                      )}

                      {/* 2. DÉBUT DU RUBAN : Le ruban commence et descend */}
                      {isDebut && (
                        <div class="cell-debut-ribbon">
                          <div class="ribbon-suspension-mount">
                            <span class="mount-rivet"></span>
                            <div class="mount-rod"></div>
                            <span class="mount-rivet"></span>
                          </div>
                          <div class="thick-fabric-ribbon ribbon-running-down">
                            <div class="ribbon-stitch-left"></div>
                            <div class="ribbon-stitch-right"></div>
                            <div class="ribbon-content-tag">
                              <span class="cell-tag-date">{periode.label}</span>
                              <h4 class="cell-node-title">{seg.titre}</h4>
                              <p class="cell-node-desc">{seg.desc}</p>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* 3. RUBAN ACTIF : Le bandeau continue de descendre */}
                      {isActif && (
                        <div class="cell-active-ribbon">
                          <div class="thick-fabric-ribbon ribbon-running-down">
                            <div class="ribbon-stitch-left"></div>
                            <div class="ribbon-stitch-right"></div>
                            <div class="ribbon-content-tag">
                              <span class="cell-tag-date">{periode.label}</span>
                              <h4 class="cell-node-title">{seg.titre}</h4>
                              <p class="cell-node-desc">{seg.desc}</p>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* 4. POINT FORT BRODÉ ★ : Écusson noir cousu sur le bandeau */}
                      {isTempsFort && (
                        <div class="cell-temps-fort-ribbon">
                          <div class="thick-fabric-ribbon ribbon-running-down has-patch">
                            <div class="ribbon-stitch-left"></div>
                            <div class="ribbon-stitch-right"></div>
                            <div class="stitched-patch-black">
                              <div class="patch-header">
                                <span class="patch-star">&#9733;</span>
                                <span class="patch-label">POINT FORT</span>
                              </div>
                              <h4 class="patch-title">{seg.titre}</h4>
                              <p class="patch-desc">{seg.desc}</p>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* 5. PAUSE R&D : LE RUBAN RENTRE DANS UNE FENTE */}
                      {isFentePause && (
                        <div class="cell-fente-pause">
                          <!-- Le ruban plonge dans la fente d'entrée -->
                          <div class="ribbon-into-slot">
                            <div class="thick-fabric-ribbon ribbon-diving">
                              <div class="ribbon-stitch-left"></div>
                              <div class="ribbon-stitch-right"></div>
                            </div>
                            <div class="architectural-slit slit-in" title="Le ruban rentre dans la fente">
                              <div class="slit-bevel-top"></div>
                              <div class="slit-deep-shadow">
                                <span class="slit-caption">&darr; RENTRE DANS LA FENTE &darr;</span>
                              </div>
                              <div class="slit-bevel-bot"></div>
                            </div>
                          </div>

                          <!-- Zone sous la paroi : le ruban est en retrait, caché dans la fente -->
                          <div class="slot-hidden-void">
                            <div class="pause-ghost-card">
                              <span class="pause-tag">PAUSE R&amp;D</span>
                              <h4 class="pause-title">{seg.titre}</h4>
                              <p class="pause-desc">{seg.desc}</p>
                              <span class="pause-status-sub">Ruban sous la fente</span>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* 6. LE RUBAN RESSORT DE LA FENTE (phase ou point fort) */}
                      {(isSortiePhase || isSortieTempsFort) && (
                        <div class="cell-sortie-fente">
                          <!-- Fente de sortie d'où émerge le ruban -->
                          <div class="architectural-slit slit-out" title="Le ruban ressort de la fente">
                            <div class="slit-bevel-top"></div>
                            <div class="slit-deep-shadow">
                              <span class="slit-caption">&uarr; RESSORT DE LA FENTE &uarr;</span>
                            </div>
                            <div class="slit-bevel-bot"></div>
                          </div>

                          <!-- Le ruban qui continue sa course après la sortie -->
                          <div class={`thick-fabric-ribbon ribbon-running-down ${isSortieTempsFort ? 'has-patch' : ''}`}>
                            <div class="ribbon-stitch-left"></div>
                            <div class="ribbon-stitch-right"></div>

                            {isSortieTempsFort ? (
                              <div class="stitched-patch-black">
                                <div class="patch-header">
                                  <span class="patch-star">&#9733;</span>
                                  <span class="patch-label">SORTIE &bull; POINT FORT</span>
                                </div>
                                <h4 class="patch-title">{seg.titre}</h4>
                                <p class="patch-desc">{seg.desc}</p>
                              </div>
                            ) : (
                              <div class="ribbon-content-tag">
                                <span class="cell-tag-date">{periode.label}</span>
                                <h4 class="cell-node-title">{seg.titre}</h4>
                                <p class="cell-node-desc">{seg.desc}</p>
                              </div>
                            )}
                          </div>
                        </div>
                      )}

                      {/* 7. STATUT FINAL DU RUBAN (Aujourd'hui) : ourlet en pointe et boutons */}
                      {(isStatut || isSortieStatut) && (
                        <div class="cell-terminal-ribbon">
                          {isSortieStatut && (
                            <div class="architectural-slit slit-out" title="Le ruban ressort de la fente vers le statut actuel">
                              <div class="slit-bevel-top"></div>
                              <div class="slit-deep-shadow">
                                <span class="slit-caption">&uarr; RESSORT DE LA FENTE &uarr;</span>
                              </div>
                              <div class="slit-bevel-bot"></div>
                            </div>
                          )}
                          <div class="thick-fabric-ribbon ribbon-terminal">
                            <div class="ribbon-stitch-left"></div>
                            <div class="ribbon-stitch-right"></div>
                            <div class="terminal-content">
                              <div class="terminal-badge">
                                <span class="terminal-dot"></span>
                                <span>STATUT ACTUEL</span>
                              </div>
                              <h4 class="terminal-title">{seg.titre}</h4>
                              <p class="terminal-desc">{seg.desc}</p>

                              <div class="terminal-actions">
                                <a href={projet.lien} class="btn-noir btn-terminal">
                                  Fiche &rarr;
                                </a>
                                {projet.github && (
                                  <a
                                    href={projet.github}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn-outline btn-terminal"
                                    title={`GitHub ${projet.titre}`}
                                  >
                                    GitHub ↗
                                  </a>
                                )}
                              </div>
                            </div>
                            <!-- Ourlet en pointe de ruban (queue d'aronde) -->
                            <div class="ribbon-swallowtail" aria-hidden="true"></div>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Surveillance de la ligne du temps lors du scroll vertical naturel
  document.addEventListener('DOMContentLoaded', () => {
    const markers = document.querySelectorAll<HTMLElement>('.time-axis-marker');
    if (markers.length === 0) return;

    function onScroll() {
      const scrollY = window.scrollY + 200;
      markers.forEach((marker) => {
        const top = marker.offsetTop;
        const height = marker.offsetHeight;
        if (scrollY >= top && scrollY < top + height) {
          marker.classList.add('is-current');
        } else {
          marker.classList.remove('is-current');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>

