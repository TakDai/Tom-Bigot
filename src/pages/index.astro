<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-rubans" class="btn-noir btn-hero">
          Descendre le temps &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION BANDEAUX NOIRS DU TEMPS ================= -->
  <section class="bandeaux-section" id="chronologie-rubans">
    <div class="bandeaux-flow-container">
      {bandeauxProjets.map((p) => {
        const etapesAvantPause = [];
        let etapePause = null;
        const etapesApresPause = [];

        let passedPause = false;
        for (const e of p.etapes) {
          if (e.type === 'pause') {
            etapePause = e;
            passedPause = true;
          } else if (!passedPause) {
            etapesAvantPause.push(e);
          } else {
            etapesApresPause.push(e);
          }
        }

        const dateGenese = p.etapes[0]?.date || '2026';
        const is2025 = dateGenese === '2025';

        return (
          <article class={`bandeau-tissu-noir ${is2025 ? 'is-genese-2025' : ''}`} id={`bandeau-${p.id}`}>
            <!-- Œillet supérieur de suspension -->
            <div class="bandeau-suspension" aria-hidden="true">
              <span class="ring-rivet"></span>
            </div>

            <!-- Tête du bandeau noir -->
            <header class="bandeau-head">
              <div class="bandeau-meta-top">
                <span class="bandeau-num">{p.numero}</span>
                <span class={`bandeau-origin-tag ${is2025 ? 'origin-2025' : ''}`}>
                  {is2025 ? 'GENÈSE 2025' : dateGenese}
                </span>
              </div>
              <h3 class="bandeau-title">{p.titre}</h3>
              <span class="bandeau-sub">{p.sousTitre}</span>
            </header>

            <!-- PARTIE 1 DU RUBAN : Étapes actives initiales -->
            <div class="bandeau-ribbon-section ribbon-active">
              {etapesAvantPause.map((etape) => {
                const isTempsFort = etape.type === 'temps_fort';
                return (
                  <div class={`bandeau-step ${isTempsFort ? 'is-star-step' : ''}`}>
                    <div class="step-meta">
                      <span class="step-date">{etape.date}</span>
                      {isTempsFort && (
                        <span class="step-star-badge">&#9733; POINT FORT</span>
                      )}
                    </div>
                    <h4 class="step-title">{etape.titre}</h4>
                    <p class="step-desc">{etape.desc}</p>
                  </div>
                );
              })}
            </div>

            <!-- SI LE RUBAN RENTRE DANS LA FENTE (PAUSE R&D) -->
            {etapePause && (
              <div class="bandeau-fente-zone">
                <!-- Entrée dans la fente 3D -->
                <div class="slit-entry" title={`Le ruban rentre dans la fente : ${etapePause.titre}`}>
                  <div class="slit-bevel-top"></div>
                  <div class="slit-opening">
                    <span class="slit-txt">&darr; RENTRE DANS LA FENTE (PAUSE) &darr;</span>
                  </div>
                </div>

                <!-- Sous la paroi / derrière le mur : le ruban est suspendu dans le vide -->
                <div class="slit-subterranean" title={`Hibernation R&D : ${etapePause.titre}`}>
                  <span class="sub-pause-pill">PAUSE R&amp;D</span>
                  <span class="sub-pause-title">{etapePause.titre}</span>
                  <span class="sub-pause-desc">{etapePause.desc}</span>
                </div>

                <!-- Sortie de la fente 3D -->
                <div class="slit-exit" title="Le ruban ressort de la fente">
                  <div class="slit-opening">
                    <span class="slit-txt">&uarr; RESSORT DE LA FENTE &uarr;</span>
                  </div>
                  <div class="slit-bevel-bottom"></div>
                </div>
              </div>
            )}

            <!-- PARTIE 2 DU RUBAN : Reprise et statut actuel -->
            <div class="bandeau-ribbon-section ribbon-resumed">
              {etapesApresPause.map((etape) => {
                const isTempsFort = etape.type === 'temps_fort';
                const isStatut = etape.type === 'statut';
                return (
                  <div class={`bandeau-step ${isTempsFort ? 'is-star-step' : ''} ${isStatut ? 'is-terminal-step' : ''}`}>
                    <div class="step-meta">
                      <span class="step-date">{etape.date}</span>
                      {isTempsFort && (
                        <span class="step-star-badge">&#9733; POINT FORT</span>
                      )}
                      {isStatut && (
                        <span class="step-status-dot">&bull; ACTIF</span>
                      )}
                    </div>
                    <h4 class="step-title">{etape.titre}</h4>
                    <p class="step-desc">{etape.desc}</p>
                  </div>
                );
              })}
            </div>

            <!-- BAS DU BANDEAU : Boutons d'accès et pointe en chevron de fanion -->
            <footer class="bandeau-terminal-tip">
              <div class="terminal-actions">
                <a href={p.lien} class="btn-bandeau btn-fiche">Fiche &rarr;</a>
                {p.github && (
                  <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-bandeau btn-gh">GH ↗</a>
                )}
              </div>
              <!-- Découpe physique en pointe chevron / queue d'aronde -->
              <div class="pennant-swallowtail-cut" aria-hidden="true"></div>
            </footer>
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
