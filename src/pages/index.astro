<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-rubans" class="btn-noir btn-hero">
          Descendre le temps &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION FANIONS VERTICAUX DU TEMPS ================= -->
  <section class="fanions-time-section" id="chronologie-rubans">
    <!-- En-tête épuré de la section -->
    <header class="fanions-header">
      <div class="fanions-title-block">
        <span class="etiquette">CHRONOLOGIE DU TRAVAIL &bull; 10 FANIONS VERTICAUX</span>
        <h2 class="fanions-main-title">BANDEAUX DU TEMPS (FANIONS)</h2>
        <p class="fanions-sub">
          L'axe vertical représente le temps (2025 &rarr; Aujourd'hui). Chaque projet est matérialisé par un <strong>fanion vertical (une ligne épaisse en tissu)</strong> qui commence à sa date de début, porte ses étoiles <strong>★</strong> pour les points forts, et <strong>plonge dans une fente</strong> lors d'une pause R&amp;D.
        </p>
      </div>

      <div class="fanions-legend" aria-label="Légende des fanions">
        <div class="f-leg-item"><span class="f-leg-band"></span><span>Fanion actif</span></div>
        <div class="f-leg-item"><span class="f-leg-star">&#9733;</span><span>Point fort</span></div>
        <div class="f-leg-item"><span class="f-leg-slit"></span><span>Fente R&amp;D (entrée / sortie)</span></div>
      </div>
    </header>

    <!-- La scène des fanions suspendus avec défilement vertical du temps -->
    <div class="fanions-board-viewport">
      <div class="fanions-board-canvas">
        <!-- Règle de temps verticale (à gauche, sticky) -->
        <aside class="fanions-time-ruler">
          <div class="ruler-head">TEMPS &darr;</div>
          {periodesLigneDuTemps.map((p) => (
            <div class="ruler-date-node" id={`ruler-${p.id}`}>
              <span class="ruler-year">{p.label}</span>
              <span class="ruler-sub">{p.sousLabel}</span>
              <span class="ruler-tick"></span>
            </div>
          ))}
        </aside>

        <!-- Les 10 fanions verticaux suspendus en parallèle -->
        <div class="fanions-lanes">
          {rubansProjets.map((p) => (
            <div class="fanion-column" id={`fanion-${p.id}`}>
              <!-- Tête de colonne : numéro, logo et titre compact -->
              <div class="fanion-pennant-head">
                <span class="f-num">{p.numero}</span>
                <div class="f-logo">
                  <img src={p.logo} alt={`Logo ${p.titre}`} loading="lazy" />
                </div>
                <h3 class="f-name">{p.titre}</h3>
                <span class="f-domaine">{p.domaine}</span>
              </div>

              <!-- Tracé vertical du fanion à travers les 6 époques du temps -->
              <div class="fanion-vertical-track">
                {periodesLigneDuTemps.map((periode) => {
                  const seg = p.segments[periode.id] || { etat: 'vide' };
                  const isVide = seg.etat === 'vide';
                  const isDebut = seg.etat === 'debut';
                  const isActif = seg.etat === 'actif';
                  const isTempsFort = seg.etat === 'temps_fort';
                  const isFentePause = seg.etat === 'fente_pause';
                  const isSortiePhase = seg.etat === 'sortie_phase';
                  const isSortieTempsFort = seg.etat === 'sortie_temps_fort';
                  const isSortieStatut = seg.etat === 'sortie_statut';
                  const isStatut = seg.etat === 'statut';

                  return (
                    <div class={`fanion-tier-slot tier-${seg.etat}`}>
                      {/* 1. ÉTAT VIDE : Le projet n'a pas encore commencé à cette date */}
                      {isVide && (
                        <div class="f-void-guide" aria-hidden="true"></div>
                      )}

                      {/* 2. DÉBUT DU FANION : Attache supérieure et départ de la ligne épaisse */}
                      {isDebut && (
                        <div class="f-ribbon-wrapper">
                          <div class="f-mount-ring" aria-hidden="true">
                            <span class="ring-rivet"></span>
                          </div>
                          <div class="fanion-thick-band band-running">
                            <div class="fanion-stitch-left"></div>
                            <div class="fanion-stitch-right"></div>
                            <div class="fanion-label-tag">
                              <span class="f-tag-date">{periode.label}</span>
                              <span class="f-tag-titre">{seg.titre}</span>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* 3. FANION ACTIF : La ligne épaisse continue de descendre */}
                      {isActif && (
                        <div class="f-ribbon-wrapper">
                          <div class="fanion-thick-band band-running">
                            <div class="fanion-stitch-left"></div>
                            <div class="fanion-stitch-right"></div>
                            <div class="fanion-label-tag">
                              <span class="f-tag-titre">{seg.titre}</span>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* 4. TEMPS FORT (★) : Étoile brodée directement sur le fanion */}
                      {isTempsFort && (
                        <div class="f-ribbon-wrapper">
                          <div class="fanion-thick-band band-running is-temps-fort" title={`${seg.titre} : ${seg.desc}`}>
                            <div class="fanion-stitch-left"></div>
                            <div class="fanion-stitch-right"></div>
                            <div class="fanion-star-badge">
                              <span class="f-star-glyph">&#9733;</span>
                              <span class="f-star-name">{seg.titre}</span>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* 5. PAUSE R&D : LE FANION RENTRE DANS UNE FENTE */}
                      {isFentePause && (
                        <div class="f-pause-wrapper">
                          <!-- Le fanion plonge dans la fente -->
                          <div class="fanion-thick-band band-diving">
                            <div class="fanion-stitch-left"></div>
                            <div class="fanion-stitch-right"></div>
                          </div>
                          <!-- Fente physique 3D -->
                          <div class="fanion-slot-slit slot-entry" title={`Le fanion rentre dans la fente : ${seg.titre}`}>
                            <div class="slit-bevel"></div>
                            <div class="slit-hole">
                              <span class="slit-arrow">&darr; FENTE &darr;</span>
                            </div>
                          </div>
                          <!-- Sous la paroi : le fanion a disparu à l'intérieur -->
                          <div class="fanion-under-wall" title={`Pause R&D : ${seg.titre} (${seg.desc})`}>
                            <span class="pause-tag-tiny">PAUSE</span>
                            <span class="pause-title-tiny">{seg.titre}</span>
                          </div>
                        </div>
                      )}

                      {/* 6. LE FANION RESSORT DE LA FENTE */}
                      {(isSortiePhase || isSortieTempsFort) && (
                        <div class="f-sortie-wrapper">
                          <!-- Fente de sortie -->
                          <div class="fanion-slot-slit slot-exit" title="Le fanion ressort de la fente">
                            <div class="slit-hole">
                              <span class="slit-arrow">&uarr; SORTIE &uarr;</span>
                            </div>
                            <div class="slit-bevel"></div>
                          </div>
                          <!-- Le fanion qui continue sa descente -->
                          <div class={`fanion-thick-band band-running ${isSortieTempsFort ? 'is-temps-fort' : ''}`} title={`${seg.titre} : ${seg.desc}`}>
                            <div class="fanion-stitch-left"></div>
                            <div class="fanion-stitch-right"></div>
                            {isSortieTempsFort ? (
                              <div class="fanion-star-badge">
                                <span class="f-star-glyph">&#9733;</span>
                                <span class="f-star-name">{seg.titre}</span>
                              </div>
                            ) : (
                              <div class="fanion-label-tag">
                                <span class="f-tag-titre">{seg.titre}</span>
                              </div>
                            )}
                          </div>
                        </div>
                      )}

                      {/* 7. POINTE DU FANION (Aujourd'hui) : ourlet en biseau / queue d'aronde */}
                      {(isStatut || isSortieStatut) && (
                        <div class="f-terminal-wrapper">
                          {isSortieStatut && (
                            <div class="fanion-slot-slit slot-exit" title="Le fanion ressort de la fente vers le statut actuel">
                              <div class="slit-hole">
                                <span class="slit-arrow">&uarr; SORTIE &uarr;</span>
                              </div>
                              <div class="slit-bevel"></div>
                            </div>
                          )}
                          <div class="fanion-thick-band band-terminal">
                            <div class="fanion-stitch-left"></div>
                            <div class="fanion-stitch-right"></div>
                            <div class="terminal-status-info">
                              <span class="terminal-dot"></span>
                              <span class="terminal-titre">{seg.titre}</span>
                            </div>
                            <div class="terminal-buttons">
                              <a href={p.lien} class="f-btn btn-fiche" title="Fiche projet">Fiche &rarr;</a>
                              {p.github && (
                                <a href={p.github} target="_blank" rel="noopener noreferrer" class="f-btn btn-gh" title="Dépôt GitHub">GH ↗</a>
                              )}
                            </div>
                            <!-- Découpe en pointe de fanion (queue de pie / chevron) -->
                            <div class="fanion-chevron-tip" aria-hidden="true"></div>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Suivi de la date courante sur l'axe vertical lors du scroll
  document.addEventListener('DOMContentLoaded', () => {
    const nodes = document.querySelectorAll<HTMLElement>('.ruler-date-node');
    if (nodes.length === 0) return;

    function onScroll() {
      const scrollY = window.scrollY + 220;
      nodes.forEach((node) => {
        const top = node.offsetTop;
        const height = node.offsetHeight;
        if (scrollY >= top && scrollY < top + height) {
          node.classList.add('is-current');
        } else {
          node.classList.remove('is-current');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>

