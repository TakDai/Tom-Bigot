<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#chronologie-rubans" class="btn-noir btn-hero">
          Descendre le temps &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= SECTION BANDEAUX DU TEMPS (PARALLÈLES, STRICTEMENT CÔTE À CÔTE) ================= -->
  <section class="bandeaux-timeline-section" id="chronologie-rubans">
    <div class="timeline-viewport">
      <!-- Règle verticale du temps sur la gauche -->
      <aside class="timeline-time-rail" aria-hidden="true">
        {periodesLigneDuTemps.map((periode) => (
          <div class={`rail-node node-${periode.id}`}>
            <span class="rail-year">{periode.label}</span>
            <span class="rail-tick"></span>
          </div>
        ))}
      </aside>

      <!-- Les 10 couloirs parallèles de rubans : BANDES FINES, RÉCENT EN HAUT & ANCIEN VERS LE BAS -->
      <div class="timeline-parallel-tracks">
        {rubansProjets.map((p, idx) => {
          const isLeftTooltip = idx < 3;
          const isRightTooltip = idx > 6;
          const tooltipPosClass = isLeftTooltip ? 'tip-left' : isRightTooltip ? 'tip-right' : 'tip-center';
          const isTourangeaux = p.id === 'lestourangeaux';

          return (
            <div class="timeline-lane" id={`lane-${p.id}`}>
              {periodesLigneDuTemps.map((periode) => {
                const seg = p.segments[periode.id] || { etat: 'vide' };
                const isAujourdhui = periode.id === 'aujourdhui';
                const is2025 = periode.id === '2025';
                const isDebut2026 = periode.id === 'debut-2026';

                // Détermination de la fin de course (Genèse) :
                // Les Tourangeaux se termine en 2025, les 9 autres se terminent en Début 2026
                const isGenesisCut = is2025 ? isTourangeaux : isDebut2026 ? !isTourangeaux : false;
                const isBlank = is2025 && !isTourangeaux;
                const isPauseSlit = seg.etat === 'fente_pause' || seg.etat === 'sortie_phase' || seg.etat === 'sortie_temps_fort';
                const isStar = seg.etat === 'temps_fort';
                const isEnPause = seg.etat === 'en_pause';

                return (
                  <div class={`lane-segment seg-${periode.id}`}>
                    {/* 1. ESPACE BLANC VIERGE : Rien en 2025 pour les 9 projets nés en 2026, ou quand en pause */}
                    {(isBlank || isEnPause) && (
                      <div class="ribbon-empty-space" aria-hidden="true"></div>
                    )}

                    {/* 2. EN TÊTE (AUJOURD'HUI) : JUSTE LE LOGO EN TÊTE */}
                    {isAujourdhui && (
                      <div class="ribbon-segment-flow flow-head">
                        <a href={p.lien} class="ribbon-head-anchor" title={`${p.titre} — Voir la fiche`}>
                          <div class="ribbon-head-medallion">
                            <img src={p.logo} alt={p.titre} class="ribbon-logo-img" />
                          </div>
                        </a>
                        <div class="fine-ribbon-strip strip-from-head"></div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-active-tag">AUJOURD'HUI</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                        </div>
                      </div>
                    )}

                    {/* 3. TERMINAISON EN POINTE CHEVRON (GENÈSE DU PROJET) */}
                    {isGenesisCut && (
                      <div class="ribbon-segment-flow terminal-flow">
                        <div class="fine-ribbon-strip strip-terminal"></div>
                        <div class="fine-chevron-cut"></div>
                        <a href={p.lien} class="fine-terminal-link" title={`Voir la fiche de ${p.titre}`}>
                          <span class="link-label">Fiche</span>
                          <span class="link-arr">&rarr;</span>
                        </a>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-active-tag">{is2025 ? 'GENÈSE 2025' : 'GENÈSE 2026'}</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                        </div>
                      </div>
                    )}

                    {/* 4. PASSAGE EN FENTE (PAUSE / REPRISE) */}
                    {!isAujourdhui && !isGenesisCut && !isBlank && !isEnPause && isPauseSlit && (
                      <div class="ribbon-segment-flow">
                        <div class="fine-ribbon-strip strip-to-slit"></div>
                        <div class="fine-wall-slit slit-entry" title={`Fente R&D : ${seg.titre}`}>
                          <span class="fine-slit-hole"></span>
                        </div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-pause-tag">PAUSE R&D</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                        </div>
                      </div>
                    )}

                    {/* 5. TEMPS FORT (★) */}
                    {!isAujourdhui && !isGenesisCut && !isBlank && !isEnPause && !isPauseSlit && isStar && (
                      <div class="ribbon-segment-flow">
                        <div class="fine-ribbon-strip is-star-strip">
                          <span class="strip-star-icon">&#9733;</span>
                        </div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-star-tag">&#9733; POINT FORT</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                        </div>
                      </div>
                    )}

                    {/* 6. RUBAN ACTIF EN CONTINU */}
                    {!isAujourdhui && !isGenesisCut && !isBlank && !isEnPause && !isPauseSlit && !isStar && (
                      <div class="ribbon-segment-flow">
                        <div class="fine-ribbon-strip">
                          <span class="strip-node-dot"></span>
                        </div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ==========================================================================
     ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME
     ========================================================================== */
  .hero-video-screen {
    position: relative;
