<script>
  // Progression au scroll vertical pour les bandeaux de chaque projet
  function initBandeauxScroll() {
    const section = document.getElementById('projets-chronologie');
    const fills = Array.from(document.querySelectorAll<HTMLElement>('.v-track-fill'));
    const nodes = Array.from(document.querySelectorAll<HTMLElement>('.v-step-node'));

    if (!section || !fills.length) return;

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const winH = window.innerHeight;
          const rect = section.getBoundingClientRect();

          // Calcul de la progression du scroll dans la section
          const start = rect.top - winH * 0.7;
          const totalDist = rect.height - winH * 0.2;
          const currentTravel = -start;
          const ratio = Math.max(0, Math.min(1, currentTravel / (totalDist || 1)));
          const pct = (ratio * 100).toFixed(1) + '%';

          fills.forEach((fill) => {
            fill.style.height = pct;
          });

          // Activation des étapes franchies par le scroll
          nodes.forEach((node) => {
            const nodeRect = node.getBoundingClientRect();
            if (nodeRect.top < winH * 0.6) {
              node.classList.add('is-passed');
            } else {
              node.classList.remove('is-passed');
            }

            if (nodeRect.top >= winH * 0.35 && nodeRect.top <= winH * 0.6) {
              node.classList.add('is-active-scroll');
            } else {
              node.classList.remove('is-active-scroll');
            }
          });

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initBandeauxScroll();
  document.addEventListener('astro:page-load', initBandeauxScroll);
</script>
