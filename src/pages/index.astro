    <!-- Indicateur de défilement vers le bas -->
    <a href="#chronologie-rubans" class="scroll-cue" aria-label="Découvrir les rubans verticaux du temps">
      <span class="scroll-label">BANDEAUX VERTICAUX DU TEMPS</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

      <!-- ================= SECTION BANDEAUX DU TEMPS (SERRÉS, HARMONIEUX, DESIGN) ================= -->
  <section class="bandeaux-timeline-section" id="chronologie-rubans">
    <div class="timeline-viewport">
      <!-- Règle verticale du temps sur la gauche -->
      <aside class="timeline-time-rail" aria-hidden="true">
        {periodesLigneDuTemps.map((periode) => (
          <div class={`rail-node node-${periode.id}`}>
            <span class="rail-year">{periode.label}</span>
            <span class="rail-tick"></span>
          </div>
        ))}
      </aside>

      <!-- Les 10 couloirs de rubans : BIEN SERRÉS, CASCADE ORGANIQUE DIAGONALE -->
      <div class="timeline-parallel-tracks">
        {rubansProjets.map((p, idx) => {
          const isLeftTooltip = idx < 4;
          const tooltipPosClass = isLeftTooltip ? 'tip-left' : 'tip-right';

          return (
            <div class="timeline-lane" id={`lane-${p.id}`}>
              {periodesLigneDuTemps.map((periode) => {
                const seg = p.segments[periode.id] || { etat: 'vide' };
                const isStatut = seg.etat === 'statut';
                const isGenesis = seg.etat === 'genesis';
                const isPause = seg.etat === 'fente_pause';
                const isStar = seg.etat === 'temps_fort';
                const isActif = seg.etat === 'actif';
                const isVide = seg.etat === 'vide';

                return (
                  <div class={`lane-segment seg-${seg.etat}`}>
                    {/* 1. ESPACE VIERGE AVANT GENÈSE */}
                    {isVide && (
                      <div class="ribbon-empty-space" aria-hidden="true"></div>
                    )}

                    {/* 2. EN TÊTE (AUJOURD'HUI) : JUSTE LE LOGO EN TÊTE DANS SON MÉDAILLON */}
                    {isStatut && (
                      <div class="ribbon-segment-flow flow-head">
                        <a href={p.lien} class="ribbon-head-anchor" title={`${p.titre} — Voir la fiche`}>
                          <span class="suspension-rivet" aria-hidden="true"></span>
                          <div class="ribbon-head-medallion">
                            <img src={p.logo} alt={p.titre} class="ribbon-logo-img" />
                          </div>
                        </a>
                        <div class="fine-ribbon-strip strip-from-head"></div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-active-tag">AUJOURD'HUI</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                          <a href={p.lien} class="tip-cta">Fiche du projet &rarr;</a>
                        </div>
                      </div>
                    )}

                    {/* 3. TERMINAISON EN POINTE CHEVRON ÉPURÉE (GENÈSE DU PROJET) */}
                    {isGenesis && (
                      <div class="ribbon-segment-flow terminal-flow">
                        <div class="fine-ribbon-strip strip-terminal"></div>
                        <a href={p.lien} class="fine-chevron-link" title={`Genèse ${p.titre} — Voir la fiche`}>
                          <div class="fine-chevron-cut"></div>
                        </a>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-genesis-tag">GENÈSE {periode.label}</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                          <a href={p.lien} class="tip-cta">Fiche du projet &rarr;</a>
                        </div>
                      </div>
                    )}

                    {/* 4. PASSAGE EN FENTE 3D (PAUSE R&D) */}
                    {isPause && (
                      <div class="ribbon-segment-flow">
                        <div class="fine-ribbon-strip strip-to-slit"></div>
                        <div class="fine-wall-slit slit-entry" title={`Pause R&D : ${seg.titre}`}>
                          <span class="fine-slit-incision"></span>
                        </div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-pause-tag">PAUSE R&D</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                          <a href={p.lien} class="tip-cta">Fiche du projet &rarr;</a>
                        </div>
                      </div>
                    )}

                    {/* 5. TEMPS FORT (★) */}
                    {isStar && (
                      <div class="ribbon-segment-flow">
                        <div class="fine-ribbon-strip is-star-strip">
                          <span class="strip-star-icon">&#9733;</span>
                        </div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                            <span class="tip-star-tag">&#9733; POINT FORT</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                          <a href={p.lien} class="tip-cta">Fiche du projet &rarr;</a>
                        </div>
                      </div>
                    )}

                    {/* 6. RUBAN ACTIF EN CONTINU */}
                    {isActif && (
                      <div class="ribbon-segment-flow">
                        <div class="fine-ribbon-strip">
                          <span class="strip-node-dot"></span>
                        </div>
                        <div class={`fine-ribbon-tooltip ${tooltipPosClass}`}>
                          <div class="tip-top">
                            <span class="tip-num">{p.numero}</span>
                            <span class="tip-title">{p.titre}</span>
                          </div>
                          <span class="tip-step">{seg.titre}</span>
                          <span class="tip-desc">{seg.desc}</span>
                          <a href={p.lien} class="tip-cta">Fiche du projet &rarr;</a>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>

