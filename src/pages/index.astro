---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Récupération de tous les projets publiés
const tousProjets = await getCollection('projets', ({ data }) => !data.brouillon);

// Tri chronologique décroissant (2026, 2025...) puis par ordre croissant
const projetsChronologiques = tousProjets.sort((a, b) => {
  const anneeA = Number(a.data.annee) || 0;
  const anneeB = Number(b.data.annee) || 0;
  if (anneeB !== anneeA) {
    return anneeB - anneeA;
  }
  return a.data.ordre - b.data.ordre || a.data.titre.localeCompare(b.data.titre, 'fr');
});

// Regroupement par année
const projetsParAnnee = projetsChronologiques.reduce((groupes, projet) => {
  const annee = projet.data.annee || 'Autres';
  if (!groupes[annee]) {
    groupes[annee] = [];
  }
  groupes[annee].push(projet);
  return groupes;
}, {} as Record<string | number, typeof tousProjets>);

const annees = Object.keys(projetsParAnnee).sort((a, b) => Number(b) - Number(a));

// Derniers articles de blog (3 plus récents)
const derniersArticles = (await getCollection('blog', ({ data }) => !data.brouillon))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function formaterDate(d: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(d);
}

const logoMap: Record<string, string> = {
  '127il': '/assets/logos/127il.svg',
  'fix-my-drone': '/assets/logos/fix-my-drone.svg',
  'inskin': '/assets/logos/inskin.png',
  'komeon': '/assets/logos/komeon.png',
  'lestourangeaux': '/assets/logos/lestourangeaux.svg',
  'multi-motors': '/assets/logos/multi-motors.png',
  'openbots': '/assets/logos/openbots.png',
  'pensee-nocturne': '/assets/logos/pensee-nocturne.svg',
  'superviseur': '/assets/logos/superviseur.svg',
  'tete-de-piaf': '/assets/logos/tdp.png',
  'tours2tours': '/assets/logos/tours2tours.png',
};

const raisonProjet: Record<string, string> = {
  'multi-motors': 'Mesurer, calibrer et optimiser le rendement réel des motorisations électriques sans approximations.',
  'fix-my-drone': 'Fournir aux pilotes FPV les guides et protocoles de diagnostic précis pour dépanner et régler leurs machines.',
  'openbots': 'Démocratiser la robotique mobile grâce à du matériel modulaire open-source et à limpression 3D.',
  'superviseur': 'Garder la souveraineté sur mes serveurs et homelabs avec un monitoring autonome sans usine à gaz.',
  '127il': 'Diffuser sans filtre la réalité du code, de lélectronique et de la soudure en direct.',
  'lestourangeaux': 'Créer un point de ralliement numérique indépendant pour lécosystème et les artisans de Tours.',
  'komeon': 'Expérimenter une messagerie collaborative temps réel sobre, réactive et modulaire.',
  'pensee-nocturne': 'Prendre du recul critique sur lévolution du numérique et nos dépendances technologiques.',
  'inskin': 'Explorer des interactions tactiles et des interfaces ergonomiques réduites à lessentiel.',
  'tete-de-piaf': 'Laboratoire dexpérimentations graphiques et de créations visuelles débridées.',
};
---

<Base>
  <!-- ================= 01. ACCUEIL PLEIN FORMAT VIDÉO ================= -->
  <section class="hero-video-screen">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; MAKER &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du code et de l'électronique. Je conçois des machines, des logiciels légers et des infrastructures autonomes — guidé par une règle : comprendre et maîtriser chaque couche technique, du fer à souder au terminal.
      </p>

      <div class="hero-actions">
        <a href="#demarche" class="btn-noir btn-hero">
          Ma démarche &bull; Pourquoi &darr;
        </a>
        <a href="#projets-chronologie" class="btn-outline btn-hero">
          Parcourir les projets &darr;
        </a>
        <a href="/blog" class="nav-pill nav-pill-hero">
          Blog technique &rarr;
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#demarche" class="scroll-cue" aria-label="Découvrir la démarche">
      <span class="scroll-label">DÉMARCHE</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= 02. CE QUE JE FAIS & POURQUOI JE LE FAIS ================= -->
  <section id="demarche" class="conteneur section-manifeste">
    <header class="timeline-header">
      <div class="header-pre">
        <span class="etiquette">01 &bull; MANIFESTE PERSONNEL</span>
      </div>
      <h2 class="timeline-main-title">CE QUE JE FAIS &bull; POURQUOI JE LE FAIS</h2>
      <p class="timeline-main-desc">
        « Si je ne peux pas l'ouvrir, comprendre son code ou réparer ses circuits, je refuse d'en dépendre. »
      </p>
    </header>

    <!-- Bandeau de repères d'identité et de pratique -->
    <div class="reperes-band">
      <div class="repere-col">
        <span class="repere-label">MATÉRIEL</span>
        <span class="repere-val">Drones FPV, STM32, Bancs moteurs, 3D</span>
      </div>
      <div class="repere-col">
        <span class="repere-label">LOGICIEL</span>
        <span class="repere-val">Web moderne, zéro dépendance inutile</span>
      </div>
      <div class="repere-col">
        <span class="repere-label">SYSTÈMES</span>
        <span class="repere-val">Homelab Debian, Docker, Sécurité HSTS</span>
      </div>
      <div class="repere-col">
        <span class="repere-label">POSTURE</span>
        <span class="repere-val">100% Autonome, Maker &amp; Partage ouvert</span>
      </div>
    </div>

    <div class="manifeste-grid">
      <!-- Colonne 1 : CE QUE JE FAIS -->
      <div class="manifeste-card">
        <div class="manifeste-card-head">
          <span class="etiquette">01.1 &bull; DU FER À SOUDER AU CODE</span>
          <h3 class="manifeste-card-title">CE QUE JE FAIS AU QUOTIDIEN</h3>
        </div>
        <p class="manifeste-intro">
          Je ne sépare jamais l'écran de l'établi. Mon activité relie mécanique de haute précision, programmation et gestion de serveurs :
        </p>
        <ul class="manifeste-list">
          <li>
            <strong>Drones FPV, Robotique &amp; Matériel :</strong> Je conçois des multirotors de voltige, teste des motorisations sur banc télémétrique, calibre des boucles d'asservissement PID à la microseconde et développe du firmware sur microcontrôleurs STM32 en C/C++.
          </li>
          <li>
            <strong>Développement Web &amp; Applications Nettes :</strong> Je bâtis des outils web taillés pour la vitesse, la lisibilité et l'ergonomie. Je fuis les usines à gaz et frameworks obèses pour privilégier du code propre, maintenable et rapide comme l'éclair.
          </li>
          <li>
            <strong>Infrastructures Autonomes &amp; Homelab :</strong> J'administre mes propres machines physiques sous Linux Debian. Zéro dépendance aveugle aux écosystèmes propriétaires : conteneurisation Docker maîtrisée, certificats durcis et monitoring sur mesure.
          </li>
        </ul>
      </div>

      <!-- Colonne 2 : POURQUOI JE LE FAIS -->
      <div class="manifeste-card">
        <div class="manifeste-card-head">
          <span class="etiquette">01.2 &bull; MES CONVICTIONS</span>
          <h3 class="manifeste-card-title">POURQUOI JE LE FAIS</h3>
        </div>
        <p class="manifeste-intro">
          Une philosophie d'indépendance technique, de rigueur et d'authenticité sans artifice :
        </p>
        <ul class="manifeste-list">
          <li>
            <strong>Le refus des boîtes noires (Souveraineté) :</strong> L'industrie moderne pousse à la passivité et au tout-jetable. Je choisis l'exact opposé : démonter, analyser, comprendre et réparer moi-même pour conserver une liberté technique absolue.
          </li>
          <li>
            <strong>L'exigence du geste utile (Pragmatisme) :</strong> Pas de projets gadgets ou de lignes de code superflues pour alimenter des slides. Chaque outil que je crée naît d'un besoin réel, testé en vol, à l'établi ou sur mes propres serveurs.
          </li>
          <li>
            <strong>La transmission sans détour (Partage) :</strong> Que ce soit à travers des lives de fabrication (127IL), des dépôts ouverts ou les articles de ce blog, je partage ce que j'apprends pour contribuer concrètement à l'écosystème open-source.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= 03. PRÉSENTATION CHRONOLOGIQUE VERTICALE ================= -->
  <section id="projets-chronologie" class="conteneur section-timeline">
    <header class="timeline-header">
      <div class="header-pre">
        <span class="etiquette">PORTFOLIO &bull; {projetsChronologiques.length} RÉALISATIONS</span>
      </div>
      <h2 class="timeline-main-title">CHRONOLOGIE DES PROJETS</h2>
      <p class="timeline-main-desc">
        Parcours vertical et chronologique de mes réalisations logicielles, expérimentations matérielles et plateformes numériques.
      </p>
    </header>

    <!-- Flux chronologique vertical -->
    <div class="timeline-track">
      {
        annees.map((annee) => (
          <div class="timeline-year-group">
            <!-- Balise de l'année -->
            <div class="year-milestone">
              <span class="year-pill">{annee}</span>
            </div>

            <!-- Liste des projets de l'année -->
            <div class="year-items">
              {projetsParAnnee[annee].map((projet) => {
                const { titre, resume, nature, statut, domaines } = projet.data;
                const meta = [nature, statut].filter(Boolean).join(' · ');
                const logo = logoMap[projet.id];

                return (
                  <div class="timeline-item">
                    <!-- Point d'ancrage sur la ligne verticale -->
                    <div class="timeline-pin">
                      <span class="pin-dot" />
                    </div>

                    <!-- Carte de projet -->
                    <a class="timeline-card" href={`/projets/${projet.id}`}>
                      <span class="card-ext">↗</span>

                      <div class="card-top">
                        {logo && (
                          <div class="card-logo-frame">
                            <img src={logo} alt={titre} loading="lazy" />
                          </div>
                        )}
                        <div class="card-titles">
                          {meta && <span class="etiquette card-meta">{meta}</span>}
                          <h3 class="card-name">{titre}</h3>
                        </div>
                      </div>

                      <p class="card-summary">{resume}</p>

                      {raisonProjet[projet.id] && (
                        <div class="card-why">
                          <span class="why-label">RAISON D'ÊTRE //</span>
                          <span class="why-text">{raisonProjet[projet.id]}</span>
                        </div>
                      )}

                      <div class="card-footer">
                        {domaines && domaines.length > 0 && (
                          <div class="card-tags">
                            {domaines.map((d: string) => (
                              <span class="domaine-pill">{d}</span>
                            ))}
                          </div>
                        )}
                        <span class="card-cta">Découvrir la fiche &rarr;</span>
                      </div>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= 03. DERNIERS ARTICLES DU BLOG ================= -->
  <section class="conteneur section-blog-home">
    <header class="timeline-header">
      <div class="header-pre">
        <span class="etiquette">PUBLICATIONS &bull; ANALYSES TECHNIQUES</span>
      </div>
      <div class="blog-head-row">
        <div>
          <h2 class="timeline-main-title">DERNIERS ARTICLES DU BLOG</h2>
          <p class="timeline-main-desc">
            Retours d'expérience, architectures logicielles et bonnes pratiques d'ingénierie.
          </p>
        </div>
        <a href="/blog" class="nav-pill">Tous les articles &rarr;</a>
      </div>
    </header>

    <div class="grille-articles-home">
      {
        derniersArticles.map((art) => (
          <a class="article-carte-home" href={`/blog/${art.id}`}>
            <span class="card-ext">↗</span>
            <div class="article-meta-row">
              <span class="article-date">{formaterDate(art.data.date)}</span>
              {art.data.tempsLecture && (
                <>
                  <span class="meta-sep">&bull;</span>
                  <span class="article-lecture">{art.data.tempsLecture}</span>
                </>
              )}
            </div>
            <h3 class="article-home-titre">{art.data.titre}</h3>
            <p class="article-home-desc">{art.data.description}</p>
            {art.data.tags && art.data.tags.length > 0 && (
              <div class="article-tags-home">
                {art.data.tags.map((t) => (
                  <span class="domaine-pill">{t}</span>
                ))}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- ================= 04. CONTACT CTA ================= -->
  <section class="conteneur section-fin">
    <article class="prose-card end-card">
      <span class="etiquette">COLLABORATION &bull; DISPONIBILITÉ</span>
      <h3 class="end-title">UN PROJET EN TÊTE ?</h3>
      <p class="end-desc">
        Disponible pour concevoir, prototyper ou déployer des projets informatiques, web et électroniques de haute précision.
      </p>
      <div class="end-actions">
        <a href="mailto:contact@tom-bigot.fr" class="btn-noir">contact@tom-bigot.fr</a>
        <a href="/contact" class="btn-outline">Formulaire & moyens de contact</a>
      </div>
    </article>
  </section>
</Base>

<style>
  /* ==========================================================================
     HERO PLEIN FORMAT VIDÉO
     ========================================================================== */
  .hero-video-screen {
    position: relative;
    width: 100%;
    height: calc(100svh - 64px);
    min-height: 520px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #000000;
    color: #ffffff;
    border-bottom: 2px dashed var(--dash);
  }

  .video-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .video-element {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
    filter: grayscale(100%) contrast(1.15) brightness(0.65);
  }

  /* Voile monochrome pour une lisibilité parfaite */
  .video-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.8) 100%),
                linear-gradient(to bottom, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.7) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
    padding: 0 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border: 2px dashed rgba(255, 255, 255, 0.45);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    margin-bottom: 24px;
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff;
    display: inline-block;
  }

  .etiquette-hero {
    font: 700 11px var(--font);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .hero-title {
    margin: 0 0 20px;
    font: 700 clamp(32px, 7vw, 64px)/1.08 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }

  .hero-subtitle {
    margin: 0 0 32px;
    font: 400 clamp(13px, 2vw, 16px)/1.55 var(--font);
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    max-width: 640px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-hero {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .nav-pill-hero {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(4px);
  }

  .nav-pill-hero:hover {
    color: #000000;
    background: #ffffff;
    border-color: #ffffff;
  }

  /* Indicateur de défilement */
  .scroll-cue {
    position: absolute;
    bottom: 24px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s, transform 0.2s;
  }

  .scroll-cue:hover {
    color: #ffffff;
    transform: translateY(3px);
  }

  .scroll-label {
    font: 700 10px var(--font);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    font-size: 16px;
    line-height: 1;
    animation: bounceDown 2s infinite;
  }

  @keyframes bounceDown {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(6px);
    }
    60% {
      transform: translateY(3px);
    }
  }

  /* ==========================================================================
     MANIFESTE : CE QUE JE FAIS & POURQUOI JE LE FAIS
     ========================================================================== */
  .section-manifeste {
    padding-top: clamp(48px, 8vh, 80px);
    padding-bottom: clamp(16px, 3vh, 32px);
    max-width: 860px;
  }

  .reperes-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 28px;
    padding: 16px 20px;
    border: 2px dashed var(--dash);
    background: #fafafa;
  }

  @media (max-width: 768px) {
    .reperes-band {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .reperes-band {
      grid-template-columns: 1fr;
    }
  }

  .repere-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .repere-label {
    font: 700 10px var(--font);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
  }

  .repere-val {
    font: 700 12px/1.4 var(--font);
    letter-spacing: 0.04em;
    color: #000000;
  }

  .manifeste-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 720px) {
    .manifeste-grid {
      grid-template-columns: 1fr;
    }
  }

  .manifeste-card {
    background: #ffffff;
    border: 2px dashed var(--dash);
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .manifeste-card:hover {
    border-color: #000000;
  }

  .manifeste-card-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .manifeste-card-title {
    margin: 0;
    font: 700 20px/1.2 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000000;
  }

  .manifeste-intro {
    margin: 0;
    font: 400 13px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.7);
    letter-spacing: 0.02em;
    padding-bottom: 14px;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.2);
  }

  .manifeste-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .manifeste-list li {
    font: 400 13px/1.6 var(--font);
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.85);
    position: relative;
    padding-left: 18px;
  }

  .manifeste-list li::before {
    content: "■";
    position: absolute;
    left: 0;
    top: 2px;
    font-size: 8px;
    color: #000000;
  }

  .manifeste-list strong {
    font-weight: 700;
    color: #000000;
    letter-spacing: 0.04em;
    display: inline;
  }

  /* ==========================================================================
     PRÉSENTATION CHRONOLOGIQUE VERTICALE
     ========================================================================== */
  .section-timeline {
    padding-top: clamp(48px, 8vh, 80px);
    padding-bottom: clamp(32px, 5vh, 48px);
    max-width: 860px;
  }

  .timeline-header {
    border-bottom: 2px dashed var(--dash);
    padding-bottom: 24px;
    margin-bottom: 40px;
  }

  .header-pre {
    margin-bottom: 6px;
  }

  .timeline-main-title {
    margin: 4px 0 10px;
    font: 700 clamp(24px, 4.5vw, 36px)/1.15 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .timeline-main-desc {
    margin: 0;
    font: 400 14px/1.6 var(--font);
    letter-spacing: 0.03em;
    color: rgba(0, 0, 0, 0.7);
    max-width: 640px;
  }

  /* La colonne chronologique avec ligne pointillée verticale */
  .timeline-track {
    position: relative;
    padding-left: clamp(28px, 5vw, 44px);
    border-left: 2px dashed var(--dash);
    margin-left: clamp(14px, 3vw, 24px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .timeline-year-group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .year-milestone {
    position: relative;
    margin-bottom: 4px;
  }

  .year-pill {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 16px;
    border: 2px solid var(--ink);
    border-radius: 16px;
    background: var(--ink);
    color: var(--paper);
    font: 700 13px var(--font);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

