  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff;
    display: inline-block;
  }

  .etiquette-hero {
    font: 700 11px var(--font);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .hero-title {
    margin: 0 0 20px;
    font: 700 clamp(32px, 7vw, 64px)/1.08 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }

  .hero-subtitle {
    margin: 0 0 32px;
    font: 400 clamp(13px, 2vw, 16px)/1.55 var(--font);
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    max-width: 640px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-hero {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .scroll-cue {
    position: absolute;
    bottom: 24px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #ffffff;
    opacity: 0.8;
    transition: opacity 0.2s, transform 0.2s;
  }

  .scroll-cue:hover {
    opacity: 1;
    transform: translateY(3px);
  }

  .scroll-label {
    font: 700 10px var(--font);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    font-size: 16px;
    animation: bounceDown 2s infinite ease-in-out;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ==========================================================================
     SECTION DES BANDEAUX DU TEMPS (PARALLÈLES, AUCUN L'UN SUR L'AUTRE)
     ========================================================================== */
  .bandeaux-timeline-section {
    position: relative;
    background: #ffffff;
    padding: clamp(40px, 6vh, 80px) clamp(10px, 2vw, 24px);
    overflow-x: hidden !important;
    border-bottom: 2px dashed var(--dash);
  }

  .timeline-viewport {
    display: flex;
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
    gap: 16px;
    align-items: stretch;
    overflow-x: hidden !important;
  }

  /* Règle de temps verticale discrète */
  .timeline-time-rail {
    width: 85px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1.5px dashed rgba(0, 0, 0, 0.2);
  }

  .rail-node {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 10px;
    position: relative;
    box-sizing: border-box;
  }

  .rail-year {
    font: 800 10.5px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    text-align: right;
  }

  .rail-tick {
    position: absolute;
    right: -4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #000000;
  }

  /* Piste des 10 couloirs parallèles : BANDES FINES */
  .timeline-parallel-tracks {
    display: flex;
    flex: 1;
    min-width: 0;
    gap: 12px;
    width: 100%;
    overflow-x: hidden !important;
  }

  .timeline-lane {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .lane-segment {
    height: 180px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
  }

  /* Espace vide */
  .ribbon-empty-space {
    width: 100%;
    height: 100%;
  }

  /* Flux vertical du ruban fin */
  .ribbon-segment-flow {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .ribbon-segment-flow.flow-head {
    justify-content: flex-start;
    padding-top: 4px;
  }

  .ribbon-segment-flow.terminal-flow {
    justify-content: flex-start;
  }

  /* Tête du ruban : JUSTE LE LOGO EN TÊTE */
  .ribbon-head-anchor {
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ribbon-head-anchor:hover {
    transform: scale(1.18);
  }

  .ribbon-head-medallion {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    box-sizing: border-box;
    padding: 6px;
    cursor: pointer;
  }

  .ribbon-logo-img {
    width: 100%;
    height: 100%;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
  }

  /* Bande fine noire */
  .fine-ribbon-strip {
    width: 14px;
    flex: 1;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    transition: background 0.15s ease, width 0.15s ease;
  }

  .strip-from-head {
    margin-top: -3px;
  }

  .strip-node-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffffff;
    opacity: 0.75;
  }

  /* Temps fort */
  .fine-ribbon-strip.is-star-strip {
    background: #000000;
  }

  .strip-star-icon {
    font-size: 8px;
    color: #ffffff;
    line-height: 1;
  }

  /* Fente fine mécanique */
  .fine-wall-slit {
    width: 26px;
    height: 8px;
    background: #000000;
    border-radius: 1px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .fine-slit-hole {
    width: 18px;
    height: 2px;
    background: #ffffff;
    border-radius: 1px;
    opacity: 0.9;
  }

  .slit-entry {
    margin-bottom: 12px;
  }

  .slit-exit {
    margin-top: 6px;
  }

  .strip-to-slit {
    flex: 1;
  }

  .strip-from-slit {
    flex: 1;
    margin-top: -2px;
  }

  /* Pointe chevron swallowtail (Aujourd'hui) */
  .strip-terminal {
    flex: 1;
  }

  .fine-chevron-cut {
    width: 14px;
    height: 12px;
    background: #000000;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    margin-bottom: 6px;
  }

  .fine-terminal-link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    text-decoration: none;
    font: 800 8px var(--font);
    color: #000000;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 5px;
    border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: #ffffff;
    transition: all 0.2s ease;
    white-space: nowrap;
    margin-bottom: 4px;
  }

  .fine-terminal-link:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
    transform: translateY(-2px);
  }

  /* Tooltip flottant au survol */
  .fine-ribbon-tooltip {
    position: absolute;
    top: 50%;
    transform: translateY(-50%) scale(0.92);
    background: #000000;
    color: #ffffff;
    padding: 8px 12px;
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    gap: 3px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
    z-index: 100;
    min-width: 150px;
    max-width: 220px;
    box-sizing: border-box;
  }

  .fine-ribbon-tooltip.tip-center {
    left: calc(50% + 14px);
  }

  .fine-ribbon-tooltip.tip-left {
    left: calc(50% + 14px);
  }

  .fine-ribbon-tooltip.tip-right {
    right: calc(50% + 14px);
    left: auto;
  }

  .ribbon-segment-flow:hover .fine-ribbon-tooltip,
  .ribbon-head-anchor:hover ~ .fine-ribbon-tooltip {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    pointer-events: auto;
  }

  .tip-top {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tip-num {
    font-family: monospace;
    font-size: 8px;
    color: #888888;
  }

  .tip-title {
    font: 800 9.5px var(--font);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ffffff;
  }

