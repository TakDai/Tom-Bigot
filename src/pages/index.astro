---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME ================= -->
  <section class="hero-video-screen" id="top">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-dot"></span>
        <span class="etiquette-hero">TOM BIGOT &bull; PORTFOLIO &bull; SYSTÈMES &bull; CODE</span>
      </div>
      <h1 class="hero-title">DE L'ÉTABLI<br />AU SERVEUR.</h1>
      <p class="hero-subtitle">
        Artisan du matériel et du code. Bancs d'essai de motorisation électrique, électronique embarquée STM32, drones FPV cinématiques, logiciels sobres et infrastructures souveraines.
      </p>

      <div class="hero-actions">
        <a href="#multi-motors" class="btn-noir btn-hero">
          Explorer les 10 projets &darr;
        </a>
        <a
          href="https://github.com/TakDai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-hero"
        >
          GitHub @TakDai ↗
        </a>
        <a
          href="mailto:contact@tom-bigot.fr"
          class="btn-outline btn-hero"
        >
          contact@tom-bigot.fr
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#multi-motors" class="scroll-cue" aria-label="Découvrir les projets plein écran">
      <span class="scroll-label">PROJETS PLEIN ÉCRAN</span>
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= DOCK LATÉRAL DE NAVIGATION RAPIDE ================= -->
  <nav class="quick-nav-dock" aria-label="Accès direct aux 10 projets">
    {projects.map((p) => (
      <a href={`#${p.id}`} class="dock-dot" data-dock-id={p.id} title={`${p.num} ${p.titre}`}>
        <span>{p.num}</span>
      </a>
    ))}
  </nav>

  <!-- ================= SECTIONS PLEIN ÉCRAN PASTEL & PARALLAXE ================= -->
  <div class="projets-fullscreen-wrapper" id="projets">
    {projects.map((p, idx) => {
      const nextProject = projects[idx + 1] || null;
      const nextTarget = nextProject ? `#${nextProject.id}` : '#top';
      const nextLabel = nextProject ? `Projet suivant : ${nextProject.num} ${nextProject.titre}` : '↑ Haut de page';
      const shortNextLabel = nextProject ? `0${idx + 2} Suivant` : 'Haut';

      return (
        <section
          class={`project-fullscreen-section project-${p.id}`}
          id={p.id}
          style={`--project-pastel: ${p.color}; --project-accent: ${p.accent};`}
          data-index={idx}
        >
          <!-- Filigrane Parallaxe Géant en arrière-plan -->
          <div class="parallax-watermark" aria-hidden="true" data-parallax-speed="0.28">
            <span class="watermark-number">{p.num}</span>
          </div>

          <!-- Bandeau supérieur plein écran / Séparation d'en-tête -->
          <header class="section-top-bar">
            <div class="top-bar-left">
              <span class="bar-step-tag">PROJET {p.num} / 10</span>
              <span class="bar-separator">&bull;</span>
              <span class="bar-domain">{p.domaine}</span>
            </div>
            <div class="top-bar-right">
              <span class="bar-date-pill">{p.date}</span>
            </div>
          </header>

          <!-- Zone centrale : grille deux colonnes avec effet parallaxe décalé -->
          <div class="project-main-content">
            <div class="project-left-col">
              <div class="project-title-lockup">
                <div class="mobile-logo-badge">
                  <img src={p.logo} alt={p.titre} />
                </div>
                <div class="title-text-group">
                  <span class="title-subhead">{p.domaine}</span>
                  <h2 class="project-title">{p.titre}</h2>
                </div>
              </div>

              <p class="project-description">{p.desc}</p>

              <!-- Badges techniques du projet -->
              <div class="tech-pills-row">
                {p.tech.map((t) => (
                  <span class="tech-pill">{t}</span>
                ))}
              </div>

              <!-- Boutons d'action -->
              <div class="project-actions">
                <a href={p.lien} class="btn-action btn-primary">Fiche détaillée &rarr;</a>
                {p.site && (
                  <a href={p.site} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                    Site officiel &#8599;
                  </a>
                )}
                {p.github && (
                  <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                    Code source &#8599;
                  </a>
                )}
              </div>
            </div>

            <!-- Colonne droite : Carte Emblème avec Parallaxe Inversé (Desktop) -->
            <div class="project-right-col" data-parallax-speed="-0.15">
              <div class="emblem-card-frame">
                <div class="emblem-card-inner">
                  <div class="emblem-logo-circle">
                    <img src={p.logo} alt={p.titre} />
                  </div>
                  <div class="emblem-card-info">
                    <span class="emblem-num">PROJET #{p.num}</span>
                    <span class="emblem-title">{p.titre}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bandeau inférieur plein écran / Séparation de transition -->
          <footer class="section-bottom-seam">
            <div class="seam-progress-track">
              <div class="seam-progress-fill" style={`width: ${((idx + 1) / projects.length) * 100}%;`}></div>
            </div>
            <div class="seam-info-row">
              <span class="seam-counter">{p.num} sur 10</span>
              <a href={nextTarget} class="seam-next-link" aria-label={nextLabel}>
                <span class="seam-label-full">{nextLabel}</span>
                <span class="seam-label-mobile">{shortNextLabel}</span>
                <span class="seam-arrow">{nextProject ? '↓' : '↑'}</span>
              </a>
            </div>
          </footer>
        </section>
      );
    })}
  </div>

  <!-- ================= GESTIONNAIRE DE PARALLAXE & DOCK ================= -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.project-fullscreen-section');
      const dots = document.querySelectorAll('.dock-dot');
      const dock = document.querySelector('.quick-nav-dock');
      const hero = document.getElementById('top');
      let ticking = false;

      function updateParallax() {
        const windowHeight = window.innerHeight;

        // Afficher le dock uniquement lorsqu'on a dépassé le hero
        if (dock && hero) {
          const heroBottom = hero.getBoundingClientRect().bottom;
          if (heroBottom <= windowHeight * 0.5) {
            dock.classList.add('is-visible');
          } else {
            dock.classList.remove('is-visible');
          }
        }

        sections.forEach((section, idx) => {
          const rect = section.getBoundingClientRect();

          // Indicateur actif sur le dock latéral
          if (rect.top <= windowHeight * 0.45 && rect.bottom >= windowHeight * 0.45) {
            dots.forEach((d) => d.classList.remove('is-active'));
            if (dots[idx]) dots[idx].classList.add('is-active');
          }

          // Effet de parallaxe sur les éléments visibles
          if (rect.bottom > -150 && rect.top < windowHeight + 150) {
            const progress = (windowHeight - rect.top) / (windowHeight + rect.height);
            const centeredProgress = progress - 0.5;

            // 1. Chiffre géant en filigrane (déplacement lent vertical)
            const watermark = section.querySelector('.parallax-watermark');
            if (watermark) {
              const speed = parseFloat(watermark.getAttribute('data-parallax-speed') || 0.28);
              const translateY = centeredProgress * speed * 220;
              watermark.style.transform = `translate3d(0, calc(-50% + ${translateY}px), 0)`;
            }

            // 2. Carte emblème (flotte en contre-vitesse)
            const rightCol = section.querySelector('.project-right-col');
            if (rightCol) {
              const speed = parseFloat(rightCol.getAttribute('data-parallax-speed') || -0.15);
              const translateY = centeredProgress * speed * 120;
              rightCol.style.transform = `translate3d(0, ${translateY}px, 0)`;
            }
          }
        });

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        updateParallax();
      }
    });
  </script>
</Base>

<style>
  /* ==========================================================================
     ACCUEIL VIDÉO PLEIN FORMAT MONOCHROME
     ========================================================================== */
  .hero-video-screen {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 540px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #000000;
    color: #ffffff;
    border-bottom: 3.5px solid #000000;
  }

  .video-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(100%) contrast(1.15) brightness(0.65);
    transform: scale(1.02);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.8) 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  }

  .etiquette-hero {
    font: 700 11px var(--font);
    letter-spacing: 0.15em;
    color: #ffffff;
  }

  .hero-title {
    font: 900 clamp(36px, 6.5vw, 68px) / 1.05 var(--font);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.8);
  }

  .hero-subtitle {
    font: 400 clamp(15px, 1.8vw, 19px) / 1.55 var(--font);
    color: rgba(255, 255, 255, 0.85);
    max-width: 680px;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-hero {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .scroll-cue {
    position: absolute;
    bottom: 24px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #ffffff;
    opacity: 0.85;
    transition: opacity 0.2s, transform 0.2s;
  }

  .scroll-cue:hover {
    opacity: 1;
    transform: translateY(3px);
  }

  .scroll-label {
    font: 700 10px var(--font);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .scroll-arrow {
    font-size: 16px;
    animation: bounceDown 2s infinite ease-in-out;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ==========================================================================
     BARRE FLOTTANTE D'ACCÈS RAPIDE AUX 10 PROJETS (DOCK LATÉRAL)
     ========================================================================== */
  .quick-nav-dock {
    position: fixed;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
    display: none;
    flex-direction: column;
    gap: 6px;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
    padding: 10px 7px;
    border-radius: 30px;
    border: 2px solid #ffffff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  @media (min-width: 1280px) {
    .quick-nav-dock {
      display: flex;
    }
  }
  .quick-nav-dock.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .dock-dot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    font-weight: 900;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dock-dot:hover, .dock-dot.is-active {
    background: #ffffff;
    color: #000000;
    transform: scale(1.15);
  }

  /* ==========================================================================
     SECTIONS PLEIN ÉCRAN PASTEL POUR CHAQUE PROJET
     ========================================================================== */
  .projets-fullscreen-wrapper {
    position: relative;
    width: 100%;
    background: #000000;
  }

  .project-fullscreen-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    background-color: var(--project-pastel, #f0f0f0);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(24px, 4vh, 44px) clamp(20px, 4.5vw, 80px);
    overflow: hidden;
    border-bottom: 3.5px solid #000000;
    box-sizing: border-box;
  }

  /* FILIGRANE GÉANT EN PARALLAXE */
  .parallax-watermark {
    position: absolute;
    right: clamp(10px, 5vw, 90px);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 1;
    user-select: none;
    will-change: transform;
    opacity: 0.16;
  }
  .watermark-number {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(200px, 30vw, 400px);
    font-weight: 900;
    line-height: 0.75;
    color: #000000;
    letter-spacing: -0.06em;
  }

  /* ==========================================================================
     BANDEAU SUPÉRIEUR PLEIN ÉCRAN
     ========================================================================== */
  .section-top-bar {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-bottom: 18px;
    border-bottom: 2px solid #000000;
  }
  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 12px;
