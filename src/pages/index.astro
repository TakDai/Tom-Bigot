    height: 100%;
    width: 100%;
    background: #ffffff;
    transform-origin: left;
    transform: scaleX(0);
    will-change: transform;
  }

  .mobile-timeline-items {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .mobile-timeline-items::-webkit-scrollbar {
    display: none;
  }

  .mobile-timeline-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 4px 7px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition: all 0.15s ease;
    flex-shrink: 0;
    line-height: 1;
  }

  .mob-logo {
    width: 13px;
    height: 13px;
    object-fit: contain;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .mob-num {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 9px;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1;
    display: inline-block;
  }

  .mobile-timeline-btn.is-active {
    background: #ffffff;
    border-color: #ffffff;
    transform: scale(1.08);
  }

  .mobile-timeline-btn.is-active .mob-logo {
    filter: brightness(0);
    opacity: 1;
  }

  .mobile-timeline-btn.is-active .mob-num {
    color: #000000;
  }

  .mobile-timeline-btn.is-past {
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* ==========================================================================
     CONTENEUR GLOBAL DES PROJETS & COUCHE VIDÉO DÉDIÉE PAR PROJET
     ========================================================================== */
  .projets-fullscreen-wrapper {
    position: relative;
    width: 100%;
    background: #000000;
  }

  .project-block-container {
    position: relative;
    width: 100%;
    contain: layout paint;
  }

  .project-fullscreen-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    background-color: var(--project-pastel, #f0f0f0);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(28px, 4.5vh, 48px) clamp(20px, 4.5vw, 80px);
    overflow: hidden;
    box-sizing: border-box;
  }

  /* VIDÉO DE FOND DÉDIÉE PAR PROJET (SUBTILE & ÉLÉGANTE) */
  .project-video-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
    opacity: 0.20;
    mix-blend-mode: multiply;
    mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%);
  }

  /* Rendu net et contrasté pour les interfaces logicielles sombres (OpenBots & Inskin) */
  .project-openbots .project-video-layer,
  .project-inskin .project-video-layer {
    mix-blend-mode: normal;
    opacity: 0.28;
  }

  .project-bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.18);
  }

  .project-video-tint {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(0, 0, 0, 0.15) 100%
    );
  }

  /* FILIGRANE GÉANT EN PARALLAXE */
  .parallax-watermark {
    position: absolute;
    right: clamp(10px, 5vw, 90px);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 2;
    user-select: none;
    will-change: transform;
    opacity: 0.16;
  }

  .watermark-number {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(200px, 30vw, 400px);
    font-weight: 900;
    line-height: 0.75;
    color: #000000;
    letter-spacing: -0.06em;
  }

  /* ==========================================================================
     BANDEAU SUPÉRIEUR PLEIN ÉCRAN
     ========================================================================== */
  .section-top-bar {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bar-step-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    font-weight: 900;
    background: #000000;
    color: #ffffff;
    padding: 5px 12px;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .bar-separator {
    font-weight: 900;
    color: #000000;
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .bar-domain {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #000000;
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .bar-date-pill {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    padding: 6px 14px;
    box-shadow: 3px 3px 0px #000000;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  /* ==========================================================================
     ZONE CENTRALE : 2 COLONNES AVEC PARALLAXE & ÉQUILIBRE VISUEL
     ========================================================================== */
  .project-main-content {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: clamp(24px, 3.5vw, 50px);
    align-items: center;
    max-width: 1060px;
    width: 100%;
    margin: auto 0;
  }

  .project-left-col {
    display: flex;
    flex-direction: column;
  }

  .project-title-lockup {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .mobile-logo-badge {
    display: none;
    width: 52px;
    height: 52px;
    background: #ffffff;
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 6px;
    overflow: hidden;
  }

  .mobile-logo-badge img {
    width: 100%;
    height: 100%;
    max-width: 36px;
    max-height: 36px;
    object-fit: contain;
    display: block;
    margin: auto;
  }

  .title-text-group {
    display: flex;
    flex-direction: column;
  }

  .title-subhead {
    display: inline-block;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--project-accent, #000000);
    margin-bottom: 4px;
  }

  .project-title {
    margin: 0;
    font-size: clamp(34px, 4.8vw, 60px);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: #000000;
  }

  .project-description {
    margin: 0 0 22px 0;
    font-size: clamp(15.5px, 1.4vw, 18.5px);
    line-height: 1.55;
    color: #1a1a1a;
    font-weight: 500;
    max-width: 720px;
  }

  /* BADGES TECHNIQUES */
  .tech-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
  }

  .tech-pill {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.88);
    color: #000000;
    border: 1.8px solid #000000;
    padding: 5px 12px;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  /* BOUTONS D'ACTION */
  .project-actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 12px 24px;
    border: 2.5px solid #000000;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    line-height: 1;
  }

  .btn-action-arrow {
    display: inline-block;
    font-size: 14px;
    line-height: 1;
    transform: translateY(-0.5px);
    transition: transform 0.18s ease;
  }

  .btn-action:hover .btn-action-arrow {
    transform: translate(2px, -0.5px);
  }

  .btn-primary {
    background: #000000;
    color: #ffffff;
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.4);
  }

  .btn-primary:hover {
    background: #ffffff;
    color: #000000;
    box-shadow: 6px 6px 0px #000000;
    transform: translate(-2px, -2px);
  }

  .btn-secondary {
    background: #ffffff;
    color: #000000;
    box-shadow: 4px 4px 0px #000000;
  }

  .btn-secondary:hover {
    background: #000000;
    color: #ffffff;
    box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.35);
    transform: translate(-2px, -2px);
  }

  /* ==========================================================================
     COLONNE DROITE : CARTE EMBLÈME FLOTTANTE AVEC PARALLAXE
     ========================================================================== */
  .project-right-col {
    position: relative;
    will-change: transform;
    display: flex;
    justify-content: center;
  }

  .emblem-card-frame {
    background: #ffffff;
    border: 3.5px solid #000000;
    box-shadow: 9px 9px 0px #000000;
    width: 100%;
    max-width: 270px;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .emblem-card-frame:hover {
    transform: translate(-3px, -3px);
    box-shadow: 13px 13px 0px #000000;
  }

  .emblem-logo-circle {
    width: 84px;
    height: 84px;
    background: #ffffff;
    border: 3px solid #000000;
    box-shadow: 3.5px 3.5px 0px #000000;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px auto;
    box-sizing: border-box;
    padding: 10px;
    overflow: hidden;
  }

  .emblem-logo-circle img {
    width: 100%;
    height: 100%;
    max-width: 58px;
    max-height: 58px;
    object-fit: contain;
    display: block;
    margin: auto;
  }

  .emblem-card-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .emblem-num {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    background: #000000;
    color: #ffffff;
    padding: 4px 10px;
    align-self: center;
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .emblem-title {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #000000;
  }

  /* ==========================================================================
     BANDEAU INFÉRIEUR PLEIN ÉCRAN / SÉPARATION BASSE
     ========================================================================== */
  .section-bottom-seam {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
  }

  .seam-progress-track {
    width: 100%;
    height: 3px;
    background: rgba(0, 0, 0, 0.15);
    position: relative;
  }

  .seam-progress-fill {
    height: 100%;
    background: #000000;
    transition: width 0.3s ease;
  }

  .seam-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .seam-counter {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #000000;
    color: #ffffff;
    padding: 4px 10px;
  }

  .seam-next-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #000000;
    text-decoration: none;
    background: #ffffff;
    border: 2px solid #000000;
    padding: 6px 14px;
    box-shadow: 2px 2px 0px #000000;
    transition: all 0.15s ease;
  }

  .seam-next-link:hover {
    background: #000000;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.3);
  }

  .seam-label-mobile {
    display: none;
  }

  /* ==========================================================================
     TRANSITION ÉPURÉE À LIGNE UNIQUE ENTRE PROJETS
     ========================================================================== */
  .project-nonlinear-transition {
    position: relative;
    width: 100%;
    height: clamp(120px, 16vh, 190px);
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    line-height: 0;
    margin-top: -1px;
    margin-bottom: -1px;
    z-index: 2;
    background-color: var(--curr-pastel);
  }

  .single-line-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .single-transition-line {
    fill: none;
    stroke: #000000;
    stroke-width: 2.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  html {
    scroll-behavior: smooth;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .project-main-content {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .project-right-col {
      display: none;
    }
    .mobile-logo-badge {
      display: inline-flex;
    }
    .sep-cue {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .project-fullscreen-section {
      min-height: 100vh;
      min-height: 100svh;
      padding: 20px 16px;
      overflow-x: hidden;
    }
    .top-bar-left {
      gap: 6px;
    }
    .bar-step-tag {
      font-size: 11px;
      padding: 3px 8px;
    }
    .bar-domain, .bar-separator {
      display: none;
    }
    .bar-date-pill {
      font-size: 10px;
      padding: 3px 8px;
      box-shadow: 2px 2px 0px #000000;
    }
    .parallax-watermark {
      opacity: 0.1;
      right: 8px;
    }
    .watermark-number {
      font-size: 160px;
    }
    .project-title {
      font-size: 28px;
    }
    .mobile-logo-badge {
      width: 44px;
      height: 44px;
    }
    .mobile-logo-badge img {
      width: 28px;
      height: 28px;
    }
    .project-description {
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 14px;
    }
    .tech-pills-row {
      margin-bottom: 16px;
      gap: 6px;
    }
    .tech-pill {
      font-size: 11px;
      padding: 4px 8px;
    }
    .project-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .btn-action {
      padding: 10px 16px;
      font-size: 12px;
      justify-content: center;
      width: 100%;
    }
    .seam-counter {
      font-size: 10px;
      padding: 3px 8px;
    }
    .seam-next-link {
      font-size: 10px;
      padding: 4px 10px;
    }
    .seam-label-full {
      display: none;
    }
    .seam-label-mobile {
      display: inline;
    }
    .project-nonlinear-transition {
      height: clamp(80px, 12vh, 130px);
    }
  }

  /* ==========================================================================
     FICHES PROJETS EN POP-UP MODALE HAUTE QUALITÉ
     ========================================================================== */
  body.fiche-modal-open {
    overflow: hidden !important;
  }

  .emblem-card-frame.btn-open-fiche {
    cursor: pointer;
  }

  .fiche-modal {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.22s ease, visibility 0.22s ease;
  }

  .fiche-modal[open] {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .fiche-modal::backdrop {
    background: rgba(12, 12, 12, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: modalBackdropFade 0.25s ease forwards;
  }

  @keyframes modalBackdropFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .fiche-modal-card {
    width: min(880px, calc(100vw - 32px));
    height: min(880px, calc(100vh - 48px));
    background: #ffffff;
    border: 3.5px solid #000000;
    border-radius: 16px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45), 10px 10px 0px #000000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.96) translateY(14px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    color: #000000;
  }

  .fiche-modal[open] .fiche-modal-card {
    transform: scale(1) translateY(0);
  }

  /* Barre supérieure fixe (Sticky Topbar) */
  .fiche-modal-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    background: #ffffff;
    border-bottom: 2.5px dashed rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
    gap: 12px;
  }

  .modal-topbar-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .modal-badge-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: 700 11px var(--font);
    letter-spacing: 0.1em;
    background: #000000;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .modal-badge-meta {
    font: 600 12px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.65);
  }

  .modal-topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .modal-btn-permalink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: transparent;
    color: #000000;
    border: 1.5px solid #000000;
    border-radius: 14px;
    font: 700 11px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .modal-btn-permalink:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .modal-btn-close {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: #000000;
    color: #ffffff;
    border: 1.5px solid #000000;
    border-radius: 14px;
    font: 700 11px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .modal-btn-close:hover {
    background: #ffffff;
    color: #000000;
    transform: scale(1.02);
  }

  .close-icon,
  .close-cross {
    font-size: 16px;
    line-height: 1;
    font-weight: 700;
  }

  /* Corps défilable de la fiche */
  .fiche-modal-scrollable {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    padding: 24px clamp(16px, 4vw, 36px) 36px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: #ffffff;
  }

  /* En-tête coloré façon blueprint */
  .modal-hero-header {
    border: 2.5px solid #000000;
    border-radius: 14px;
    padding: clamp(18px, 3vw, 26px);
    background: var(--modal-pastel, #f0f0f0);
    color: #000000;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 4px 4px 0px #000000;
  }

  .modal-hero-top {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .modal-logo-wrapper {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    background: #ffffff;
    border: 2.5px solid #000000;
    border-radius: 14px;
    box-shadow: 3px 3px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }

  .modal-logo-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .modal-hero-titles {
    flex: 1;
    min-width: 0;
  }

  .modal-domaine-tag {
    display: block;
    font: 700 11px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--modal-accent, #000000);
    margin-bottom: 4px;
  }

  .modal-project-title {
    margin: 0 0 6px;
    font: 700 clamp(24px, 4vw, 34px) / 1.15 var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000000;
  }

  .modal-project-resume {
    margin: 0;
    font: 400 13.5px / 1.55 var(--font);
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.8);
  }

  .modal-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 6px;
    border-top: 1.5px dashed rgba(0, 0, 0, 0.35);
  }

  .modal-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    font: 700 12px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 15px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .modal-action-primary {
    background: #000000;
    color: #ffffff;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px rgba(0, 0, 0, 0.4);
  }

  .modal-action-primary:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0px rgba(0, 0, 0, 0.5);
  }

  .modal-action-secondary {
    background: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px rgba(0, 0, 0, 0.2);
  }

  .modal-action-secondary:hover {
    background: #f7f7f7;
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0px rgba(0, 0, 0, 0.3);
  }

  .modal-action-close {
    background: #000000;
    color: #ffffff;
    border: 2px solid #000000;
  }

  .modal-action-close:hover {
    background: #ffffff;
    color: #000000;
  }

  .modal-action-sm {
    padding: 7px 14px;
    font-size: 11px;
    background: #ffffff;
    color: #000000;
    border: 2px solid #000000;
  }

  /* Domaines & Stack */
  .modal-meta-section {
    border: 2px dashed rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    padding: 16px 20px;
    background: #fafafa;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .modal-section-heading {
    margin: 0;
    font: 700 12px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .modal-section-heading::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #000000;
  }

  .modal-domaines-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .modal-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    font: 600 11px var(--font);
    letter-spacing: 0.06em;
    background: #ffffff;
    border: 1.5px solid rgba(0, 0, 0, 0.35);
    border-radius: 14px;
    color: #000000;
  }

  /* Markdown body */
  .modal-markdown-body {
    border: 2px dashed rgba(0, 0, 0, 0.4);
    border-radius: 14px;
    padding: clamp(20px, 3vw, 30px);
    background: #ffffff;
    font: 400 14px/1.65 var(--font);
    color: rgba(0, 0, 0, 0.88);
  }

  .modal-markdown-body :global(h2) {
    margin: 28px 0 12px;
    font: 700 17px/1.3 var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000000;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .modal-markdown-body :global(h2:first-child) {
    margin-top: 0;
  }

  .modal-markdown-body :global(h2)::before {
    content: "■";
    font-size: 10px;
    color: #000000;
  }

  .modal-markdown-body :global(h3) {
    margin: 24px 0 10px;
    font: 700 14.5px/1.35 var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
  }

  .modal-markdown-body :global(h4) {
    margin: 18px 0 8px;
    font: 700 13px/1.3 var(--font);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .modal-markdown-body :global(p) {
    margin: 0 0 14px;
    line-height: 1.65;
  }

  .modal-markdown-body :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .modal-markdown-body :global(li) {
    margin-bottom: 6px;
    line-height: 1.6;
  }

  .modal-markdown-body :global(strong) {
    font-weight: 700;
    color: #000000;
  }

  .modal-markdown-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 18px 0 24px;
    font-size: 12.5px;
  }

  .modal-markdown-body :global(th),
  .modal-markdown-body :global(td) {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.3);
  }

  .modal-markdown-body :global(th) {
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.03);
    border-bottom: 2px solid #000000;
  }

  .modal-markdown-body :global(hr) {
    border: none;
    border-top: 1.5px dashed rgba(0, 0, 0, 0.25);
    margin: 28px 0;
  }

  .modal-markdown-body :global(code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.88em;
    background: rgba(0, 0, 0, 0.05);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  /* Footer bar */
  .modal-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: #fafafa;
    border: 2px dashed rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    flex-wrap: wrap;
  }

  .modal-bottom-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .modal-bottom-brand {
    font: 700 11px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000000;
  }

  .modal-bottom-proj {
    font: 600 11.5px var(--font);
    letter-spacing: 0.06em;
    color: rgba(0, 0, 0, 0.6);
  }

  .modal-bottom-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (max-width: 680px) {
    .fiche-modal-card {
      width: 100vw;
      height: 94vh;
      max-height: 94vh;
      border-radius: 16px 16px 0 0;
      border-bottom: none;
      box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.45);
      align-self: flex-end;
    }
    .modal-badge-meta {
      display: none;
    }
    .modal-hero-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .modal-logo-wrapper {
      width: 64px;
      height: 64px;
    }
    .modal-bottom-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .modal-bottom-right {
      flex-direction: column;
    }
    .modal-btn-permalink .permalink-text {
      display: none;
    }
  }

  /* ==========================================================================
     SECTIONS GLOBALES BLUEPRINT (ACTUALITÉS, SERVICES, AGENDA, CONTACT)
     ========================================================================== */
  .actualites-screen,
  .services-screen,
  .agenda-screen,
  .contact-screen {
    position: relative;
    width: 100%;
    background: #ffffff;
    color: #000000;
    padding: clamp(60px, 8vh, 100px) clamp(20px, 5vw, 60px);
    border-top: 2px dashed #000000;
    z-index: 10;
  }

  .actualites-container,
  .services-container,
  .agenda-container,
  .contact-container {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vh, 48px);
  }

  .blueprint-section-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-bottom: 2px dashed #000000;
    padding-bottom: 24px;
  }

  .section-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .actualites-count-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border: 1.5px solid #000000;
    border-radius: 999px;
    font: 700 10px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: #f4f4f4;
    color: #000000;
  }

  .section-big-title {
    margin: 0;
    font: 700 clamp(28px, 4.5vw, 42px)/1.1 var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
  }

  .section-big-subtitle {
    margin: 0;
    font: 400 clamp(14px, 1.8vw, 17px)/1.6 var(--font);
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.75);
    max-width: 880px;
  }

  /* ==========================================================================
     GRILLE ACTUALITÉS, RÉSEAUX & AVANCEMENTS DES SITES
     ========================================================================== */
  .actualites-filters-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .actu-filter-btn {
    padding: 7px 15px;
    border: 1.5px solid #000000;
    border-radius: 999px;
    background: #ffffff;
    font: 700 11px var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .actu-filter-btn:hover {
    background: #f0f0f0;
    transform: translateY(-1px);
  }

  .actu-filter-btn.active {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .filter-count {
    opacity: 0.7;
    font-size: 10px;
  }

  .actualites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 12px;
  }

  .actualite-card {
    border: 1.5px dashed #000000;
    border-radius: 8px;
    background: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 12px;
    padding: 8px;
    min-height: 104px;
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1),
                border-style 0.15s ease,
                box-shadow 0.15s ease;
  }

  .actualite-card:hover {
    border-style: solid;
    transform: translateY(-2px);
    box-shadow: 4px 4px 0px #000000;
  }

  /* Vignette / Illustration */
  .actualite-thumb-box {
    position: relative;
    width: 112px;
    min-width: 112px;
    height: 100%;
    min-height: 90px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid #000000;
    background: #f4f4f4;
    flex-shrink: 0;
  }

  .actualite-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }

  .actualite-card:hover .actualite-thumb-img {
    transform: scale(1.05);
  }

  .actualite-thumb-source {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    font: 700 8px/1.2 var(--font);
    letter-spacing: 0.05em;
    padding: 2px 4px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Contenu textuel */
  .actualite-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    gap: 4px;
  }

  .actualite-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    font: 700 9px var(--font);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .actualite-date {
    color: rgba(0, 0, 0, 0.55);
  }

  .actualite-badge-type {
    background: #f2f2f2;
    color: rgba(0, 0, 0, 0.75);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 8px;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .actualite-titre {
    margin: 0;
    font: 700 12.5px/1.25 var(--font);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #000000;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .actualite-desc {
    margin: 0;
    font: 400 11px/1.3 var(--font);
    color: rgba(0, 0, 0, 0.7);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .actualite-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-top: 2px;
    padding-top: 4px;
    border-top: 1px dashed rgba(0, 0, 0, 0.15);
  }

  .actualite-tags-mini {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow: hidden;
  }

  .actualite-tag-mini {
    font: 700 8px var(--font);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
    background: #fafafa;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 3px;
    padding: 1px 4px;
    white-space: nowrap;
  }

  .actualite-mini-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .actu-mini-btn {
    height: 20px;
    padding: 0 6px;
    border-radius: 3px;
    font: 700 9px var(--font);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    cursor: pointer;
    background: #ffffff;
    color: #000000;
    border: 1px solid #000000;
    transition: all 0.12s ease;
  }

  .actu-mini-btn:hover {
    background: #000000;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .actu-mini-btn.primary {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .actu-mini-btn.primary:hover {
    background: rgba(0, 0, 0, 0.85);
  }

  .actu-arrow {
    font-size: 10px;
    line-height: 1;
    font-weight: 700;
  }

  .actualites-footer-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 12px;
  }

  /* ==========================================================================
     GRILLE MES SERVICES (3 PÔLES TECHNIQUES)
     ========================================================================== */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .service-card {
    border: 2px dashed #000000;
    border-radius: 14px;
    background: #ffffff;
    padding: clamp(24px, 3.5vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                border-style 0.2s ease,
                box-shadow 0.2s ease;
  }

  .service-card:hover {
    border-style: solid;
    transform: translateY(-4px);
    box-shadow: 6px 6px 0px #000000;
  }

  .service-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .service-pole-num {
    font: 700 11px var(--font);
    letter-spacing: 0.14em;
    padding: 3px 8px;
    background: #000000;
    color: #ffffff;
    border-radius: 4px;
  }

  .service-pole-tag {
    font: 700 10px var(--font);
    letter-spacing: 0.1em;
    color: rgba(0, 0, 0, 0.6);
  }

  .service-card-icon {
    font-size: 32px;
    line-height: 1;
  }

  .service-card-title {
    margin: 0;
    font: 700 clamp(20px, 2.5vw, 24px)/1.2 var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
  }

  .service-card-desc {
    margin: 0;
    font: 400 14px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.8);
  }

  .service-checklist {
    list-style: none;
    margin: 0;
    padding: 16px 0;
    border-top: 1.5px dashed rgba(0, 0, 0, 0.2);
    border-bottom: 1.5px dashed rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .service-checklist li {
    font: 400 13px/1.5 var(--font);
    color: rgba(0, 0, 0, 0.85);
    position: relative;
    padding-left: 18px;
  }

  .service-checklist li::before {
    content: "■";
    position: absolute;
    left: 0;
    top: 2px;
    font-size: 8px;
    color: #000000;
  }

  .service-checklist li strong {
    font-weight: 700;
    color: #000000;
  }

  .service-card-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  /* ==========================================================================
     SECTION AGENDA (HUB + PREVIEW)
     ========================================================================== */
  .agenda-hub-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .agenda-hub-card {
    border: 2px dashed #000000;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: #000000;
    background: #ffffff;
    transition: transform 0.15s ease, border-style 0.15s ease, box-shadow 0.15s ease;
  }

  .agenda-hub-card:hover {
    border-style: solid;
    transform: translateY(-2px);
    box-shadow: 4px 4px 0px #000000;
  }

  .hub-card-icon {
    font-size: 26px;
    line-height: 1;
  }

  .hub-card-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .hub-card-body strong {
    font: 700 14px var(--font);
    letter-spacing: 0.05em;
  }

  .hub-card-body small {
    font: 400 11px var(--font);
    color: rgba(0, 0, 0, 0.65);
  }

  .hub-card-arrow {
    font-size: 16px;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .agenda-hub-card:hover .hub-card-arrow {
    transform: translateX(3px);
    color: #000000;
  }

  .agenda-preview-box {
    border: 2.5px solid #000000;
    border-radius: 14px;
    background: #fafafa;
    padding: clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 6px 6px 0px #000000;
  }

  .preview-box-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-bottom: 2px dashed rgba(0, 0, 0, 0.2);
    padding-bottom: 16px;
  }

  .preview-tabs {
    display: inline-flex;
    gap: 8px;
  }

  .preview-tab {
    padding: 8px 16px;
    border: 2px solid #000000;
    border-radius: 8px;
    background: #ffffff;
    font: 700 12px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .preview-tab.active {
    background: #000000;
    color: #ffffff;
  }

  .preview-month-label {
    font: 700 12px var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.65);
  }

  .preview-tab-content.is-hidden {
    display: none;
  }

  .preview-calendar-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .summary-stat-item {
    border: 1.5px dashed rgba(0, 0, 0, 0.3);
    border-radius: 10px;
    background: #ffffff;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-number {
    font: 700 32px/1 var(--font);
    letter-spacing: 0.04em;
    color: #000000;
  }

  .stat-label {
    font: 700 11px/1.4 var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.65);
  }

  .preview-note {
    margin: 0;
    font: 400 13.5px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.75);
    background: #ffffff;
    border: 1px dashed rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    padding: 14px 18px;
  }

  .agenda-box-footer {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 10px;
  }

  /* ==========================================================================
     SECTION CONTACT & PIED DE PAGE
     ========================================================================== */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .contact-card {
    border: 2px dashed #000000;
    border-radius: 12px;
    padding: 24px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-card.primary-contact {
    border: 2.5px solid #000000;
    box-shadow: 5px 5px 0px #000000;
  }

  .contact-card-title {
    margin: 0;
    font: 700 18px/1.25 var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

