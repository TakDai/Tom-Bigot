---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { getFilActualites } from '../data/filActualites';

const allProjetsDocs = await getCollection('projets', ({ data }) => !data.brouillon);
const projetsRendered = await Promise.all(
  allProjetsDocs.map(async (doc) => {
    const { Content } = await render(doc);
    return { id: doc.id, doc, Content };
  })
);
const docMap = new Map(projetsRendered.map((item) => [item.id, item]));

const actualitesPosts = await getFilActualites();

function formaterDate(date: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}

