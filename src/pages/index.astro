    pause: 'Validation thermique des ESC et tests de contraintes mécaniques avant essais en vol réel.',
    resume: 'Plateforme et expérimentations autour du banc d\'essai et de l\'optimisation de moteurs brushless pour multirotors.',
    statut: 'En cours',
    domaines: ['Embarqué', 'Moteurs', 'Électronique'],
    logo: '/assets/logos/multi-motors.png',
    lien: '/projets/multi-motors',
  },
  {
    id: 'fix-my-drone',
    type: 'projet',
