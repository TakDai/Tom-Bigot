    pause: 'Stabilisation des seuils d\'alerte et durcissement des règles de pare-feu et certificats SSL.',
    resume: 'Solution de supervision légère et autonome pour suivre en continu la santé des serveurs auto-hébergés.',
    statut: 'En production',
    domaines: ['DevOps', 'Système', 'Sécurité'],
    logo: '/assets/logos/superviseur.svg',
    lien: '/projets/superviseur',
  },
  {
    id: '127il',
    type: 'projet',
    annee: '2026',
    titre: '127IL',
    sousTitre: 'Live streaming technique & fabrication',
    tempsFort: 'Première session marathon de 6h en direct : conception de circuit imprimé, soudure CMS et code en live sans coupure.',
    pause: 'Pause de diffusion pour repenser la régie vidéo locale et l\'éclairage macroscopique de l\'établi.',
    resume: 'Sessions en direct sur Twitch consacrées à la programmation, à l\'électronique et aux retours d\'expérience.',
    statut: 'En cours',
    domaines: ['Streaming', 'Live', 'Partage'],
    logo: '/assets/logos/127il.svg',
    lien: '/projets/127il',
  },
  {
    id: 'pause-printemps-2026',
    type: 'pause',
    annee: 'Printemps 2026',
    titre: 'Pause & Prise de Hauteur',
    sousTitre: 'Maturation critique & essais',
    tempsFort: 'Rédaction d\'une série de manifestes techniques sur l\'autonomie numérique et le refus des technologies propriétaires opaques.',
    pause: 'Période sans développement de code, dédiée à la lecture d\'architectures décentralisées.',
    resume: 'Prise de recul indispensable sur l\'impact de nos choix technologiques et nos dépendances.',
    statut: 'Jalon clé',
    domaines: ['Éditorial', 'Réflexion', 'Souveraineté'],
  },
  {
    id: 'pensee-nocturne',
    type: 'projet',
    annee: '2026',
    titre: 'Pensée Nocturne',
    sousTitre: 'Essais & questionnements technologiques',
    tempsFort: 'Publication d\'articles critiques sur le droit à la réparation et la souveraineté numérique individuelle.',
    pause: 'Période d\'incubation pour laisser mûrir les sujets avant chaque nouvelle publication.',
    resume: 'Recueil d\'articles et de réflexions nocturnes autour du monde numérique et des choix d\'ingénierie.',
    statut: 'En cours',
    domaines: ['Éditorial', 'Écriture', 'Web'],
    logo: '/assets/logos/pensee-nocturne.svg',
    lien: '/projets/pensee-nocturne',
  },
  {
    id: 'komeon',
    type: 'projet',
    annee: '2026',
    titre: 'Komeon',
    sousTitre: 'Messagerie collaborative basse latence',
    tempsFort: 'Validation d\'un protocole d\'échange temps réel ultra-léger avec latence mesurée inférieure à 12 ms.',
    pause: 'Nettoyage d\'architecture pour supprimer 40% de dépendances superflues.',
    resume: 'Plateforme collaborative temps réel développée pour centraliser les échanges techniques sans fioritures.',
    statut: 'En cours',
    domaines: ['Web', 'Plateforme', 'Temps réel'],
    logo: '/assets/logos/komeon.png',
