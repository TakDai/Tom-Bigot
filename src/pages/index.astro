    titre: 'Fix-My-Drone',
    sousTitre: 'Diagnostic & sauvetage FPV haute cadence',
    tempsFort: 'Mise au point de protocoles de diagnostic de contrôleurs de vol STM32 et de filtres notch dynamiques en vol.',
    pause: 'Pause opérationnelle pour formaliser les fiches de maintenance et cartographier les pannes récurrentes.',
    resume: 'Outils et guides techniques pour diagnostiquer, régler et réparer les drones FPV et multirotors.',
    statut: 'En cours',
    domaines: ['Drones', 'Hardware', 'Diagnostic'],
    logo: '/assets/logos/fix-my-drone.svg',
