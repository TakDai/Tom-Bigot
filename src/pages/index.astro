    topLine: "M 0,120 C 90,80 240,210 460,150 C 820,20 1120,170 1440,90",
    midD: "M 0,0 L 1440,0 L 1440,95 C 1040,180 760,10 400,140 C 200,190 70,60 0,95 Z",
