<script>
  // Activation interactive des bandes verticales et réactivité au scroll
  function initChronoBandesVerticales() {
    const stage = document.getElementById('bandesVStage');
    const section = document.getElementById('projets-chronologie');
    const counter = document.getElementById('chronoCounter');
    const btnPrev = document.getElementById('btnPrevBande');
    const btnNext = document.getElementById('btnNextBande');

    if (!stage || !section) return;

    const bandes = Array.from(stage.querySelectorAll<HTMLElement>('.bande-v'));
    const total = bandes.length;
    if (!total) return;

    let currentIndex = 0;

    function activateBande(index: number, scrollIntoStage = true) {
      if (index < 0) index = 0;
      if (index >= total) index = total - 1;
      currentIndex = index;

      bandes.forEach((b, i) => {
        if (i === currentIndex) {
          b.classList.add('is-active');
          b.setAttribute('aria-expanded', 'true');
        } else {
          b.classList.remove('is-active');
          b.setAttribute('aria-expanded', 'false');
        }
      });

      const numero = bandes[currentIndex].dataset.index || String(currentIndex + 1).padStart(2, '0');
      if (counter) {
        counter.textContent = `${numero} / ${String(total).padStart(2, '0')}`;
      }

      if (scrollIntoStage) {
        const activeBande = bandes[currentIndex];
        const stageWidth = stage.clientWidth;
        const targetLeft = activeBande.offsetLeft - stageWidth / 2 + activeBande.offsetWidth / 2;
        stage.scrollTo({
          left: Math.max(0, targetLeft),
          behavior: 'smooth',
        });
      }
    }

    // 1. Clic direct sur une bande pour la déployer
    bandes.forEach((b, idx) => {
      b.addEventListener('click', () => {
        activateBande(idx, true);
      });

      b.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activateBande(idx, true);
        }
      });
    });

    // 2. Boutons Précédent / Suivant
    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        activateBande(currentIndex - 1, true);
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        activateBande(currentIndex + 1, true);
      });
    }

    // 3. Réactivité au défilement vertical de la page
    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const winH = window.innerHeight;
          const rect = section.getBoundingClientRect();

          // La section est-elle dans la zone de lecture active ?
          const start = rect.top - winH * 0.4;
          const end = rect.bottom - winH * 0.4;
          const totalDist = end - start;

          if (rect.top <= winH * 0.55 && rect.bottom >= winH * 0.35) {
            const travel = (winH * 0.55 - rect.top);
            const progress = Math.max(0, Math.min(0.99, travel / (rect.height || 1)));
            const targetIdx = Math.floor(progress * total);

            if (targetIdx !== currentIndex && targetIdx >= 0 && targetIdx < total) {
              activateBande(targetIdx, true);
            }
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Initialiser la première bande
    activateBande(0, false);
  }

  // Initialisation immédiate et support des navigations Astro
  initChronoBandesVerticales();
  document.addEventListener('astro:page-load', initChronoBandesVerticales);
</script>
