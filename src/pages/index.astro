---

<Base sansNav={true} titre="Portfolio" description="Tom Bigot — Portfolio d'ingénierie, systèmes embarqués, drones FPV & développement logiciel.">
  <!-- ================= ACCUEIL VIDÉO PLEIN FORMAT ÉVÉNEMENTIEL & AUDIOVISUEL ================= -->
  <section class="hero-video-screen" id="top">
    <div class="video-container">
      <video
        id="heroVideo"
        class="video-element"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/favicon.svg"
      >
        <source src="/assets/videos/hero_event.webm" type="video/webm" />
        <source src="/assets/videos/hero_tours.webm" type="video/webm" />
        <source src="/assets/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <!-- Portrait en incrustation naturelle (fondu vaporeux sans contour artificiel) -->
      <div class="hero-portrait-blend">
        <img
          src="/assets/profile_feathered.webp"
          alt="Tom Bigot — Télépilote de drone & Production audiovisuelle"
          class="hero-portrait-img"
          width="300"
          height="352"
          loading="eager"
          decoding="async"
        />
      </div>

      <h1 class="hero-name">TOM BIGOT</h1>

      <p class="hero-title-main">
        TÉLÉPILOTAGE &amp; PRODUCTION AUDIOVISUELLE
      </p>

      <p class="hero-subtitle">
        Développement logiciel &amp; Systèmes embarqués
      </p>

      <div class="hero-tags">
        <span class="hero-tag">Télépilotage FPV</span>
        <span class="hero-tag">Événementiel</span>
        <span class="hero-tag">Code &amp; Systèmes</span>
      </div>

      <div class="hero-actions">
        <a href="#multi-motors" class="btn-hero-primary" aria-label="Explorer les 10 projets">
          Voir les projets &darr;
        </a>
        <a href="mailto:contact@tom-bigot.fr" class="btn-hero-secondary">
          Contact
        </a>
      </div>
    </div>

    <!-- Indicateur de défilement vers le bas -->
    <a href="#multi-motors" class="scroll-cue" aria-label="Découvrir les projets plein écran">
      <span class="scroll-arrow">&darr;</span>
    </a>
  </section>

  <!-- ================= TIMELINE DU SCROLL CLIQUABLE (INDICATEUR INTERACTIF COMPLET) ================= -->
  <aside class="scroll-timeline-nav" id="scrollTimeline" aria-label="Timeline de navigation du scroll">
    <div class="timeline-rail-wrap">
      <!-- Ligne de rail continue avec progression en temps réel -->
      <div class="timeline-track-line">
        <div class="timeline-track-progress" id="timelineProgressBar"></div>
      </div>

      <!-- Les 10 nœuds de projets cliquables avec logos authentiques -->
      <nav class="timeline-nodes-list">
        {projects.map((p, idx) => (
          <a
            href={`#${p.id}`}
            class={`timeline-node-item node-${p.id}`}
            data-target-id={p.id}
            data-index={idx}
            aria-label={`Aller au projet ${p.num} : ${p.titre}`}
          >
            <span class="node-bullet">
              <span class="node-logo-circle">
                <img src={p.logo} alt="" class="node-bullet-logo" loading="lazy" />
              </span>
              <span class="node-num-tag">{p.num}</span>
            </span>
            <span class="node-flyout">
              <span class="node-flyout-logo-frame">
                <img src={p.logo} alt="" class="node-flyout-logo" loading="lazy" />
              </span>
              <span class="node-flyout-num">{p.num}</span>
              <span class="node-flyout-title">{p.titre}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </aside>

  <!-- ================= TIMELINE HORIZONTALE COMPACTE (MOBILE / TABLETTE) ================= -->
  <nav class="mobile-timeline-bar" id="mobileTimeline" aria-label="Navigation rapide mobile">
    <div class="mobile-timeline-track">
      <div class="mobile-timeline-fill" id="mobileTimelineFill"></div>
    </div>
    <div class="mobile-timeline-items">
      {projects.map((p, idx) => (
        <a
          href={`#${p.id}`}
          class="mobile-timeline-btn"
          data-target-id={p.id}
          data-index={idx}
          title={`${p.num} ${p.titre}`}
        >
          <img src={p.logo} alt="" class="mob-logo" loading="lazy" />
          <span class="mob-num">{p.num}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- ================= SECTIONS PLEIN ÉCRAN PASTEL & PARALLAXE ================= -->
  <div class="projets-fullscreen-wrapper" id="projets">
    {projects.map((p, idx) => {
      const nextProject = projects[idx + 1] || null;
      const nextTarget = nextProject ? `#${nextProject.id}` : '#top';
      const nextLabel = nextProject ? `Projet suivant : ${nextProject.num} ${nextProject.titre}` : '↑ Haut de page';
      const shortNextLabel = nextProject ? `0${idx + 2} Suivant` : 'Haut';

      return (
        <article class="project-block-container">
          <section
            class={`project-fullscreen-section project-${p.id}`}
            id={p.id}
            style={`--project-pastel: ${p.color}; --project-accent: ${p.accent};`}
            data-index={idx}
          >
            <!-- Couche Vidéo de Fond Subtile intégrée à la couleur unie pastel -->
            <div class="project-video-layer" aria-hidden="true">
              <video
                class="project-bg-video"
                loop
                muted
                playsinline
                preload="none"
              >
                <source src={p.video} type="video/webm" />
              </video>
              <div class="project-video-tint"></div>
            </div>

            <!-- Filigrane Parallaxe Géant en arrière-plan -->
            <div class="parallax-watermark" aria-hidden="true" data-parallax-speed="0.28">
              <span class="watermark-number">{p.num}</span>
            </div>

            <!-- Bandeau supérieur plein écran / Séparation d'en-tête -->
            <header class="section-top-bar">
              <div class="top-bar-left">
                <span class="bar-step-tag">PROJET {p.num} / 10</span>
                <span class="bar-separator">&bull;</span>
                <span class="bar-domain">{p.domaine}</span>
              </div>
              <div class="top-bar-right">
                <span class="bar-date-pill">{p.date}</span>
              </div>
            </header>

            <!-- Zone centrale : grille deux colonnes avec effet parallaxe décalé -->
            <div class="project-main-content">
              <div class="project-left-col">
                <div class="project-title-lockup">
                  <div class="mobile-logo-badge">
                    <img src={p.logo} alt={p.titre} />
                  </div>
                  <div class="title-text-group">
                    <span class="title-subhead">{p.domaine}</span>
                    <h2 class="project-title">{p.titre}</h2>
                  </div>
                </div>

                <p class="project-description">{p.desc}</p>

                <!-- Badges techniques du projet -->
                <div class="tech-pills-row">
                  {p.tech.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>

                <!-- Boutons d'action -->
                <div class="project-actions">
                  <a href={p.lien} class="btn-action btn-primary">
                    <span>Fiche détaillée</span>
                    <span class="btn-action-arrow">&rarr;</span>
                  </a>
                  {p.site && (
                    <a href={p.site} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                      <span>Site officiel</span>
                      <span class="btn-action-arrow">&#8599;</span>
                    </a>
                  )}
                  {p.github && (
                    <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-action btn-secondary">
                      <span>Code source</span>
                      <span class="btn-action-arrow">&#8599;</span>
                    </a>
                  )}
                </div>
              </div>

              <!-- Colonne droite : Carte Emblème avec Parallaxe Inversé (Desktop) -->
              <div class="project-right-col" data-parallax-speed="-0.15">
                <div class="emblem-card-frame">
                  <div class="emblem-card-inner">
                    <div class="emblem-logo-circle">
                      <img src={p.logo} alt={p.titre} />
                    </div>
                    <div class="emblem-card-info">
                      <span class="emblem-num">PROJET #{p.num}</span>
                      <span class="emblem-title">{p.titre}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bandeau inférieur plein écran / Séparation de transition -->
            <!-- Bandeau de pied uniquement pour le dernier projet -->
            {!nextProject && (
              <footer class="section-bottom-seam">
                <div class="seam-progress-track">
                  <div class="seam-progress-fill" style="width: 100%;"></div>
                </div>
                <div class="seam-info-row">
                  <span class="seam-counter">{p.num} sur 10</span>
                  <a href="#top" class="seam-next-link" aria-label="Retour au sommet">
                    <span class="seam-label-full">RETOUR AU SOMMET</span>
                    <span class="seam-label-mobile">SOMMET</span>
                    <span class="seam-arrow">↑</span>
                  </a>
                </div>
              </footer>
            )}
          </section>

          <!-- ================= TRANSITION À LIGNE UNIQUE NON-LINÉAIRE ENTRE PROJETS ================= -->
          {nextProject && (() => {
            const v = transitionVariants[idx % transitionVariants.length];
            return (
              <div
                class="project-nonlinear-transition"
                style={`--curr-pastel: ${p.color}; --next-pastel: ${nextProject.color};`}
                aria-hidden="true"
              >
                <svg viewBox="0 0 1440 180" preserveAspectRatio="none" class="single-line-svg">
                  <!-- Fond haut : pastel du projet actuel -->
                  <rect width="1440" height="180" fill="var(--curr-pastel)" />
                  <!-- Forme basse : pastel du projet suivant délimité par la courbe non-linéaire -->
                  <path d={v.shapeD} fill="var(--next-pastel)" />
                  <!-- La ligne unique : trait net continu séparant les deux projets -->
                  <path d={v.lineD} class="single-transition-line" />
                </svg>
              </div>
            );
          })()}
        </article>
      );
    })}
  </div>

  <!-- ================= GESTIONNAIRE LENIS 120FPS, PARALLAXE & VIDÉOS ================= -->
  <script>
    import Lenis from 'lenis';
    import 'lenis/dist/lenis.css';

    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.project-fullscreen-section');
      const timelineNodes = document.querySelectorAll('.timeline-node-item');
      const mobileNodes = document.querySelectorAll('.mobile-timeline-btn');
      const timelineNav = document.getElementById('scrollTimeline');
      const mobileTimeline = document.getElementById('mobileTimeline');
      const timelineProgressBar = document.getElementById('timelineProgressBar');
      const mobileTimelineFill = document.getElementById('mobileTimelineFill');
      const hero = document.getElementById('top');
      const wrapper = document.getElementById('projets');

      // 1. Initialisation de Lenis pour un défilement ultra-fluide avec inertie cinématographique
      const lenis = new Lenis({
        duration: 1.15,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 0.95,
        touchMultiplier: 1.2,
        infinite: false,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // 2. Mise en cache des positions pour éliminer les recalculs de reflow
      let sectionData: Array<{
        el: Element;
        idx: number;
        top: number;
        height: number;
        watermark: HTMLElement | null;
        watermarkSpeed: number;
        rightCol: HTMLElement | null;
        rightColSpeed: number;
      }> = [];

      let heroHeight = window.innerHeight;
      let wrapperTop = 0;
      let wrapperHeight = 0;
      let currentActiveIdx = -1;

      function measureLayout() {
        const windowHeight = window.innerHeight;
        heroHeight = hero ? hero.offsetHeight : windowHeight;
        if (wrapper) {
          const wRect = wrapper.getBoundingClientRect();
          wrapperTop = wRect.top + window.scrollY;
          wrapperHeight = wrapper.offsetHeight;
        }

        sectionData = Array.from(sections).map((section, idx) => {
          const rect = section.getBoundingClientRect();
          const top = rect.top + window.scrollY;
          const height = section.offsetHeight || rect.height;
          return {
            el: section,
            idx,
            top,
            height,
            watermark: section.querySelector('.parallax-watermark'),
            watermarkSpeed: parseFloat(section.querySelector('.parallax-watermark')?.getAttribute('data-parallax-speed') || '0.28'),
            rightCol: section.querySelector('.project-right-col'),
            rightColSpeed: parseFloat(section.querySelector('.project-right-col')?.getAttribute('data-parallax-speed') || '-0.15'),
          };
        });
      }
      measureLayout();

      // 3. Mise à jour de la timeline et des éléments visuels synchronisée sur le tick Lenis
      function updateVisuals(scrollY: number) {
        const windowHeight = window.innerHeight;

        // A. Émergence dynamique de la timeline
        if (hero && timelineNav) {
          if (scrollY > 30) {
            timelineNav.classList.add('is-visible');
            const emergeRatio = Math.max(0, Math.min(1, scrollY / (heroHeight * 0.55)));
            const slideX = (1 - emergeRatio) * 60;
            const scale = 0.90 + (emergeRatio * 0.10);
            const opacity = Math.min(1, emergeRatio * 1.5);

            timelineNav.style.transform = `translate3d(${slideX.toFixed(1)}px, -50%, 0) scale(${scale.toFixed(3)})`;
            timelineNav.style.opacity = opacity.toFixed(2);
            timelineNav.style.pointerEvents = emergeRatio >= 0.7 ? 'auto' : 'none';

            if (scrollY >= heroHeight - 60) {
              timelineNav.style.zIndex = '100';
            } else {
              timelineNav.style.zIndex = '5';
            }
          } else {
            timelineNav.classList.remove('is-visible');
            timelineNav.style.transform = 'translate3d(70px, -50%, 0) scale(0.90)';
            timelineNav.style.opacity = '0';
            timelineNav.style.pointerEvents = 'none';
            timelineNav.style.zIndex = '5';
          }
        }

        if (mobileTimeline) {
          if (scrollY >= heroHeight * 0.4) mobileTimeline.classList.add('is-visible');
          else mobileTimeline.classList.remove('is-visible');
        }

        // B. Barre de progression globale (via transform scale GPU sans reflow)
        if (wrapperHeight > windowHeight) {
          const currentScrolled = scrollY - wrapperTop;
          const totalScrollable = wrapperHeight - windowHeight;
          const progressRatio = Math.max(0, Math.min(1, currentScrolled / totalScrollable));
          if (timelineProgressBar) {
            timelineProgressBar.style.transform = `scaleY(${progressRatio.toFixed(4)})`;
          }
          if (mobileTimelineFill) {
            mobileTimelineFill.style.transform = `scaleX(${progressRatio.toFixed(4)})`;
          }
        }

        // C. Nœud actif calculé par coordonnées pures
        const midPoint = scrollY + windowHeight * 0.5;
        let activeIdx = 0;
        for (let i = 0; i < sectionData.length; i++) {
          if (midPoint >= sectionData[i].top) {
            activeIdx = i;
          }
        }

        if (activeIdx !== currentActiveIdx) {
          currentActiveIdx = activeIdx;
          timelineNodes.forEach((n, idx) => {
            n.classList.toggle('is-active', idx === activeIdx);
            n.classList.toggle('is-past', idx < activeIdx);
          });
          mobileNodes.forEach((m, idx) => {
            m.classList.toggle('is-active', idx === activeIdx);
            m.classList.toggle('is-past', idx < activeIdx);
          });
        }

        // D. Parallaxe doux uniquement sur les sections visibles
        for (let i = 0; i < sectionData.length; i++) {
          const item = sectionData[i];
          const relTop = item.top - scrollY;
          if (relTop > -item.height && relTop < windowHeight) {
            const progress = (windowHeight - relTop) / (windowHeight + item.height);
            const centeredProgress = progress - 0.5;

            if (item.watermark) {
              const translateY = centeredProgress * item.watermarkSpeed * 180;
              item.watermark.style.transform = `translate3d(0, calc(-50% + ${translateY.toFixed(1)}px), 0)`;
            }
            if (item.rightCol) {
              const translateY = centeredProgress * item.rightColSpeed * 100;
              item.rightCol.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
            }
          }
        }
      }

      lenis.on('scroll', (e: { scroll: number }) => {
        updateVisuals(e.scroll);
      });

      window.addEventListener('resize', () => {
        measureLayout();
        updateVisuals(lenis.scroll);
      });
      window.addEventListener('load', () => {
        measureLayout();
        updateVisuals(lenis.scroll);
      });
      updateVisuals(window.scrollY);

      // 4. Optimisation vidéo : ne lire QUE les vidéos visibles à l'écran
      const allVideos = document.querySelectorAll('video');
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const vid = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (vid.preload === 'none') vid.preload = 'auto';
            if (vid.paused) vid.play().catch(() => {});
          } else {
            if (!vid.paused) vid.pause();
          }
        });
      }, { rootMargin: '250px 0px 250px 0px', threshold: 0.05 });

      allVideos.forEach((vid) => {
        if (vid.id !== 'heroVideo') {
          vid.pause();
        }
        videoObserver.observe(vid);
      });

      // 5. Navigation fluide au clic gérée par Lenis
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (!href || href === '#') return;
          if (href === '#top') {
            e.preventDefault();
            lenis.scrollTo(0, {
              duration: 1.2,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
            if (history.pushState) history.pushState(null, '', href);
            return;
          }
          const targetEl = document.querySelector(href);
          if (targetEl) {
            e.preventDefault();
            lenis.scrollTo(targetEl as HTMLElement, {
              offset: 0,
              duration: 1.2,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
            if (history.pushState) history.pushState(null, '', href);
          }
        });
      });
    });
  </script>
