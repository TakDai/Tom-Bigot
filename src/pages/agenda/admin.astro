---
import Base from '../../layouts/Base.astro';
import {
  planningCinemaMois,
  planningFpvMois
} from '../../data/planning';
---

<Base
  titre="Supervision Globale — Espace Superviseur & Administration Agenda"
  description="Console d'administration et gestionnaire des demandes SMS / Email pour Tom Bigot. Centralisation, validation en 1 clic et liens magiques."
>
  <main class="prose-screen dedicated-agenda-page">
    <!-- Header Supervision -->
    <header class="page-head dedicated-header">
      <div class="dedicated-badge-row">
        <span class="etiquette">SUPERVISION GLOBALE &bull; TOM BIGOT</span>
        <span class="badge-partner">CONSOLE ADMINISTRATEUR</span>
      </div>
      <h1 class="page-title">ESPACE SUPERVISEUR &bull; MASTER PLANNING</h1>
      <p class="page-subtitle">
        Gestion centralisée des demandes reçues par <strong>SMS, Email ou lien dédié</strong>. Ajoutez les demandes au planning en attente, confirmez-les en 1 clic et expédiez instantanément le message de validation au client.
      </p>
    </header>

    <!-- Zone d'authentification Superviseur (ou déverrouillage automatique par lien) -->
    <section class="partner-auth-box">
      <div id="adminAuthLoggedOut" class="auth-card">
        <div class="auth-icon">🛡️</div>
        <div class="auth-info">
          <div class="auth-status-tag">ACCÈS ADMINISTRATEUR RESTREINT</div>
          <h2>AUTHENTIFICATION SUPERVISEUR</h2>
          <p>
            Entrez votre code d'administration maître ou utilisez votre lien superviseur pour accéder à la console complète et à la boîte de réception des demandes.
          </p>
          <form id="adminLoginForm" class="partner-login-form">
            <div class="input-row">
              <input
                type="password"
                id="adminPasscode"
                placeholder="Code superviseur maître..."
                autocomplete="current-password"
                required
              />
              <button type="submit" class="btn-noir">Déverrouiller le master agenda &rarr;</button>
            </div>
            <div id="adminFeedback" class="feedback-msg" style="display: none;"></div>
            <span class="demo-hint">💡 Code administrateur : <code>TOM-2026</code></span>
          </form>
        </div>
      </div>

      <div id="adminAuthLoggedIn" class="auth-card logged-in" style="display: none;">
        <div class="auth-icon">🔓</div>
        <div class="auth-info">
          <div class="auth-status-tag active">SESSION MAÎTRE ACTIVE &bull; TOM BIGOT</div>
          <h2>CONSOLE SUPERVISEUR DÉVERROUILLÉE</h2>
          <p>
            Vous pilotez l'ensemble des plannings Cinémas et Drone FPV. Traitez les demandes SMS/Email ci-dessous, validez les réservations et partagez les liens directs à vos partenaires.
          </p>
          <div class="logged-actions">
            <a href="#adminInboxSection" class="btn-noir">📥 Boîte des demandes SMS/Email &darr;</a>
            <button type="button" id="btnAdminExport" class="btn-outline">Copier le récapitulatif &rarr;</button>
            <button type="button" id="btnAdminLogout" class="btn-outline">Verrouiller la console ✕</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Console de commande & Boîte de réception (Visible quand connecté) -->
    <section id="adminDashboardView" style="display: none;">
      <!-- Stats globales -->
      <div class="admin-stats-grid">
        <div class="stat-card">
          <span class="stat-number">10</span>
          <span class="stat-label">Vacations Les Studios</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">8</span>
          <span class="stat-label">Tournées Ciné-Off</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">10</span>
          <span class="stat-label">Jours CFA / Formation</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">5</span>
          <span class="stat-label">Missions Drone FPV</span>
        </div>
        <div class="stat-card highlight">
          <span class="stat-number" id="statPendingCount">0</span>
          <span class="stat-label">Demandes en attente</span>
        </div>
      </div>

      <!-- ======================================================================
           MODULE GESTION DES DEMANDES SMS / EMAIL / LIENS
           ====================================================================== -->
      <section id="adminInboxSection" class="admin-inbox-section">
        <div class="inbox-grid-two-cols">
          <!-- Colonne 1 : Boîte de réception des demandes en attente -->
          <div class="inbox-card">
            <div class="inbox-header">
              <span class="etiquette">BOÎTE DE RÉCEPTION</span>
              <h3>📥 DEMANDES EN ATTENTE DE CONFIRMATION</h3>
              <p>
                Demandes soumises via les liens dédiés ou ajoutées manuellement depuis un SMS/Email reçu.
              </p>
            </div>

            <div id="pendingRequestsList" class="pending-requests-container">
              <!-- Rempli dynamiquement en JS -->
              <div class="empty-inbox-state">
                <span>Aucune demande en attente actuellement.</span>
                <small>Les demandes reçues par lien, formulaire ou ajoutées ci-contre apparaîtront ici.</small>
              </div>
            </div>
          </div>

          <!-- Colonne 2 : Enregistrer une demande reçue par SMS ou Email -->
          <div class="inbox-card">
            <div class="inbox-header">
              <span class="etiquette">SAISIE RAPIDE</span>
              <h3>➕ AJOUTER UNE DEMANDE REÇUE (SMS / MAIL)</h3>
              <p>
                Un partenaire vous a envoyé un SMS ou un mail ? Enregistrez la date en 1 clic pour la bloquer en attente sur le planning.
              </p>
            </div>

            <form id="formAddManualRequest" class="styled-agenda-form manual-entry-form">
              <div class="form-field">
                <label for="manualOrg"><strong>ORGANISATION / CLIENT *</strong></label>
                <select id="manualOrg" required>
                  <option value="Ciné-Off">Ciné-Off (Circuit itinérant 37)</option>
                  <option value="Les Studios">Cinémas Les Studios (Tours)</option>
                  <option value="Drone FPV">Client Tournage Drone FPV</option>
                  <option value="Autre">Autre demande</option>
                </select>
              </div>

              <div class="form-field">
                <label for="manualDate"><strong>DATE DU CRÉNEAU *</strong></label>
                <input type="date" id="manualDate" required />
              </div>

              <div class="form-field">
                <label for="manualContact"><strong>CONTACT / NUMÉRO DE TÉLÉPHONE OU EMAIL *</strong></label>
                <input type="text" id="manualContact" placeholder="Ex : 06 12 34 56 78 ou regie@cine-off.fr" required />
              </div>

              <div class="form-field">
                <label for="manualSource"><strong>SOURCE DU MESSAGE *</strong></label>
                <select id="manualSource">
                  <option value="SMS">Message SMS reçu</option>
                  <option value="Email">Courrier électronique reçu</option>
                  <option value="Téléphone">Appel téléphonique direct</option>
                </select>
              </div>

              <div class="form-field">
                <label for="manualNotes"><strong>DÉTAIL DU MESSAGE REÇU</strong></label>
                <textarea id="manualNotes" rows="2" placeholder="Ex : Besoin cabine salle 1 ou tournée à Loches..."></textarea>
              </div>

              <button type="submit" class="btn-noir">+ Ajouter la demande au calendrier en attente &rarr;</button>
            </form>
          </div>
        </div>
      </section>

      <!-- ======================================================================
           MODULE LIENS MAGIQUES À PARTAGER PAR SMS / EMAIL
           ====================================================================== -->
      <section class="magic-links-section">
        <div class="magic-links-header">
          <span class="etiquette">LIENS PARTENAIRES &bull; ZÉRO CODE</span>
          <h3>🔗 LIENS DIRECTS À ENVOYER PAR SMS OU EMAIL</h3>
          <p>
            Vos partenaires n'ont aucun mot de passe à retenir. Envoyez-leur simplement leur lien dédié par SMS ou par email pour qu'ils posent leurs dates en 1 tap.
          </p>
        </div>

        <div class="magic-links-grid">
          <!-- Carte Ciné-Off -->
          <div class="magic-card">
            <div class="magic-topline">
              <span class="magic-icon">🎞️</span>
              <span class="magic-tag">CIRCUIT ITINÉRANT</span>
            </div>
            <h4>Ciné-Off (37)</h4>
            <input type="text" class="magic-input" value="https://tom-bigot.fr/agenda/cine-off/" readonly />
            <div class="magic-actions">
              <a
                href="sms:?body=Salut%2C%20voici%20ton%20lien%20direct%20pour%20poser%20tes%20prochaines%20dates%20de%20tourn%C3%A9e%20Cin%C3%A9-Off%20%3A%20https%3A%2F%2Ftom-bigot.fr%2Fagenda%2Fcine-off%2F"
                class="btn-noir btn-sm"
              >
                📱 Partager par SMS &rarr;
              </a>
              <button type="button" class="btn-outline btn-sm btn-copy-link" data-link="https://tom-bigot.fr/agenda/cine-off/">
                Copier lien
              </button>
            </div>
          </div>

          <!-- Carte Les Studios -->
          <div class="magic-card">
            <div class="magic-topline">
              <span class="magic-icon">🏛️</span>
              <span class="magic-tag">7 ÉCRANS TOURS</span>
            </div>
            <h4>Cinémas Les Studios</h4>
            <input type="text" class="magic-input" value="https://tom-bigot.fr/agenda/les-studios/" readonly />
            <div class="magic-actions">
              <a
                href="sms:?body=Bonjour%2C%20voici%20le%20lien%20direct%20pour%20r%C3%A9server%20vos%20vacations%20cabine%20Les%20Studios%20%3A%20https%3A%2F%2Ftom-bigot.fr%2Fagenda%2Fles-studios%2F"
                class="btn-noir btn-sm"
              >
                📱 Partager par SMS &rarr;
              </a>
              <button type="button" class="btn-outline btn-sm btn-copy-link" data-link="https://tom-bigot.fr/agenda/les-studios/">
                Copier lien
              </button>
            </div>
          </div>

          <!-- Carte Drone FPV -->
          <div class="magic-card">
            <div class="magic-topline">
              <span class="magic-icon">🚁</span>
              <span class="magic-tag">TOURNAGES VIDÉO</span>
            </div>
            <h4>Clients Drone FPV</h4>
            <input type="text" class="magic-input" value="https://tom-bigot.fr/agenda/fpv/" readonly />
            <div class="magic-actions">
              <a
                href="sms:?body=Bonjour%2C%20voici%20mon%20planning%20de%20tournage%20Drone%20FPV%20et%20simulateur%20de%20devis%20%3A%20https%3A%2F%2Ftom-bigot.fr%2Fagenda%2Ffpv%2F"
                class="btn-noir btn-sm"
              >
                📱 Partager par SMS &rarr;
              </a>
              <button type="button" class="btn-outline btn-sm btn-copy-link" data-link="https://tom-bigot.fr/agenda/fpv/">
                Copier lien
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Barre d'outils et Filtres Master Planning -->
      <div class="agenda-toolbar">
        <div class="filter-controls-row">
          <div class="filter-group">
            <span class="filter-title">FILTRE D'AFFICHAGE :</span>
            <div class="btn-group-filter">
              <button type="button" class="btn-filter is-active" data-filter="all">Tous (Global)</button>
              <button type="button" class="btn-filter" data-filter="cinema">Cabines Cinéma (7 Écrans & Itinérant)</button>
              <button type="button" class="btn-filter" data-filter="fpv">Drone FPV (Tournages & Repérages)</button>
            </div>
          </div>

          <div class="month-selector-bar admin-month-nav">
            <button type="button" id="btnPrevMonthAdmin" class="btn-outline btn-month">&larr; Mois précédent</button>
            <div class="current-month-display">
              <span class="etiquette">CONSOLE 2026</span>
              <h2 id="calendarMonthTitleAdmin" class="month-heading">NOVEMBRE 2026</h2>
            </div>
            <button type="button" id="btnNextMonthAdmin" class="btn-outline btn-month">Mois suivant &rarr;</button>
          </div>
        </div>

        <div class="legend-grid">
          <div class="legend-item">
            <span class="legend-box box-studios"></span>
            <div class="legend-text">
              <strong>LES STUDIOS</strong>
              <span>Cabines 7 écrans / 35mm</span>
            </div>
          </div>
          <div class="legend-item">
            <span class="legend-box box-cineoff"></span>
            <div class="legend-text">
              <strong>CINÉ-OFF</strong>
              <span>Circuit itinérant 37</span>
            </div>
          </div>
          <div class="legend-item">
            <span class="legend-box box-pending"></span>
            <div class="legend-text">
              <strong>EN ATTENTE</strong>
              <span>Demande SMS/Mail reçue</span>
            </div>
          </div>
          <div class="legend-item">
            <span class="legend-box box-fpv"></span>
            <div class="legend-text">
              <strong>DRONE FPV</strong>
              <span>Tournage / Repérage</span>
            </div>
          </div>
          <div class="legend-item">
            <span class="legend-box box-libre"></span>
            <div class="legend-text">
              <strong>DISPONIBLE</strong>
              <span>Créneau non réservé</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Master Calendriers -->
      {planningCinemaMois.map((moisCinema, indexMois) => {
        const moisFpv = planningFpvMois[indexMois];

        return (
          <section
            id={`admin-calendar-${indexMois}`}
            class={`calendar-card admin-month-view ${indexMois === 0 ? 'is-active-month' : 'is-hidden-month'}`}
            data-month-index={indexMois}
            data-month-name={`${moisCinema.nom.toUpperCase()} ${moisCinema.annee}`}
          >
            <div class="calendar-grid">
              <div class="weekday-col">LUN</div>
              <div class="weekday-col">MAR</div>
              <div class="weekday-col">MER</div>
              <div class="weekday-col">JEU</div>
              <div class="weekday-col">VEN</div>
              <div class="weekday-col">SAM</div>
              <div class="weekday-col">DIM</div>

              {Array.from({ length: moisCinema.decalageLundi }).map(() => (
                <div class="day-cell day-empty" aria-hidden="true"></div>
              ))}

              {moisCinema.jours.map((itemCinema, dayIdx) => {
                const itemFpv = moisFpv ? moisFpv.jours[dayIdx] : null;

                const isStudios = itemCinema.ownerId === 'studios';
                const isCineoff = itemCinema.ownerId === 'cineoff';
                const isCfa = itemCinema.ownerId === 'cfa';
                const isCinemaLibre = itemCinema.statut === 'libre';

                const hasFpvActivity = itemFpv && itemFpv.statut !== 'libre' && itemFpv.statut !== 'indisponible';

                return (
                  <div
                    class={`day-cell day-admin-cell ${isStudios ? 'slot-studios' : ''} ${isCineoff ? 'slot-cineoff' : ''} ${isCfa ? 'slot-cfa' : ''} ${hasFpvActivity ? 'slot-fpv' : ''}`}
                    data-date={itemCinema.dateStr}
                    data-has-cinema={(!isCinemaLibre).toString()}
                    data-has-fpv={hasFpvActivity ? 'true' : 'false'}
                  >
                    <div class="day-topline">
                      <span class="day-number">{itemCinema.jour}</span>
                      <div class="badges-stack">
                        {isStudios && <span class="tag-studios">Studios</span>}
                        {isCineoff && <span class="tag-cineoff">Ciné-Off</span>}
                        {isCfa && <span class="tag-cfa">CFA</span>}
                        {hasFpvActivity && <span class="tag-fpv">FPV</span>}
                        {isCinemaLibre && !hasFpvActivity && <span class="tag-dispo">Libre</span>}
                      </div>
                    </div>

                    <div class="day-body">
                      <!-- Section Cinéma -->
                      <div class="admin-event-block event-cinema">
                        <span class="event-type-label">🎬 CINÉMA :</span>
                        {isStudios && <span class="event-desc studios-text"><strong>Les Studios</strong> — {itemCinema.detail}</span>}
                        {isCineoff && <span class="event-desc cineoff-text"><strong>Ciné-Off</strong> — {itemCinema.detail}</span>}
                        {isCfa && <span class="event-desc cfa-text"><strong>CFA</strong> — {itemCinema.detail}</span>}
                        {isCinemaLibre && <span class="event-desc dispo-text">Disponible cabine</span>}
                      </div>

                      <!-- Section Drone FPV -->
                      <div class="admin-event-block event-fpv">
                        <span class="event-type-label">🚁 DRONE FPV :</span>
                        {itemFpv && itemFpv.statut === 'reserve_tournage' && (
                          <span class="event-desc fpv-tournage-text"><strong>Tournage</strong> — {itemFpv.detail}</span>
                        )}
                        {itemFpv && itemFpv.statut === 'reserve_reperage' && (
                          <span class="event-desc fpv-reperage-text"><strong>Repérage</strong> — {itemFpv.detail}</span>
                        )}
                        {itemFpv && itemFpv.statut === 'option_meteo' && (
                          <span class="event-desc fpv-option-text"><strong>Option</strong> — {itemFpv.detail}</span>
                        )}
                        {itemFpv && itemFpv.statut === 'libre' && (
                          <span class="event-desc dispo-text">Vol disponible</span>
                        )}
                        {itemFpv && itemFpv.statut === 'indisponible' && (
                          <span class="event-desc indispo-text">Bloqué cabine</span>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}

      <!-- Modal de confirmation automatique pour le client -->
      <div id="confirmActionModal" class="result-box" style="display: none;">
        <div class="result-head">
          <span class="etiquette">SÉANCE CONFIRMÉE &bull; ENVOI DU MESSAGE</span>
          <h3>✅ SÉANCE VALIDÉE DANS LE PLANNING</h3>
        </div>
        <p>
          Le créneau a été basculé en <strong>CONFIRMÉ</strong>. Cliquez sur l'un des boutons ci-dessous pour renvoyer instantanément la confirmation au client par SMS ou par email :
        </p>
        <pre id="confirmMessagePayload" class="result-pre"></pre>
        <div class="result-actions">
          <a id="btnSendConfirmSms" href="#" class="btn-noir">📱 Envoyer la confirmation par SMS &rarr;</a>
          <a id="btnSendConfirmEmail" href="#" class="btn-outline">✉️ Envoyer la confirmation par Email &rarr;</a>
          <button type="button" id="btnCopyConfirmMsg" class="btn-outline">Copier le message</button>
          <button type="button" id="btnCloseConfirmModal" class="btn-clear" style="color: #000; border-color: #000;">Fermer</button>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Module Superviseur & Inbox des demandes
    interface PendingItem {
      id: string;
      org: string;
      date: string;
      contact: string;
      source: string;
      notes: string;
      status: 'en_attente' | 'confirme';
      createdAt: number;
    }

    const ADMIN_HASH = '796dc21b3eeab2f920eccd168f7ae13f03a4d6d370761731f5e49e4ab949ccab'; // SHA-256('TOM-2026')
    const SESSION_KEY = 'tom_admin_session_v1';
    const INBOX_KEY = 'tom_supervisor_inbox_v1';

    let currentMonthIndex = 0;

    async function sha256(str: string): Promise<string> {
      const buffer = new TextEncoder().encode(str);
      const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
      return Array.from(new Uint8Array(hashBuffer)).map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    function constantTimeEqual(a: string, b: string): boolean {
      if (a.length !== b.length) return false;
      let diff = 0;
      for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
      return diff === 0;
    }

    function getInbox(): PendingItem[] {
      try {
        const raw = localStorage.getItem(INBOX_KEY);
        if (!raw) {
          // Échantillon de départ réaliste
          const defaultItems: PendingItem[] = [
            {
              id: 'req_1',
              org: 'Ciné-Off',
              date: '2026-11-24',
              contact: 'Régie Ciné-Off (06 47 11 22 33)',
              source: 'SMS',
              notes: 'Tournée communale — projection soirée salle des fêtes',
              status: 'en_attente',
              createdAt: Date.now() - 3600000
            },
            {
              id: 'req_2',
              org: 'Les Studios',
              date: '2026-11-29',
              contact: 'Direction (direction@cinemas-les-studios.fr)',
              source: 'Email',
              notes: 'Vacation après-midi renfort cabine',
              status: 'en_attente',
              createdAt: Date.now() - 7200000
            }
          ];
          localStorage.setItem(INBOX_KEY, JSON.stringify(defaultItems));
          return defaultItems;
        }
        return JSON.parse(raw);
      } catch {
        return [];
      }
    }

    function saveInbox(items: PendingItem[]) {
      try {
        localStorage.setItem(INBOX_KEY, JSON.stringify(items));
      } catch {}
    }

    function initAdminPage() {
      setupAuth();
      setupMonthNavigation();
      setupFilters();
      setupInbox();
      setupMagicLinks();
    }

    function setupAuth() {
      const form = document.getElementById('adminLoginForm') as HTMLFormElement | null;
      const input = document.getElementById('adminPasscode') as HTMLInputElement | null;
      const feedback = document.getElementById('adminFeedback');
      const boxLoggedOut = document.getElementById('adminAuthLoggedOut');
      const boxLoggedIn = document.getElementById('adminAuthLoggedIn');
      const dashboard = document.getElementById('adminDashboardView');
      const btnLogout = document.getElementById('btnAdminLogout');

      // Vérifier paramètre URL ?auth=tom ou session
      const params = new URLSearchParams(window.location.search);
      if (params.get('auth') === 'tom' || sessionStorage.getItem(SESSION_KEY) === 'true') {
        showLoggedInState();
      }

      function showLoggedInState() {
        sessionStorage.setItem(SESSION_KEY, 'true');
        if (boxLoggedOut) boxLoggedOut.style.display = 'none';
        if (boxLoggedIn) boxLoggedIn.style.display = 'flex';
        if (dashboard) dashboard.style.display = 'block';
        renderInbox();
      }

      function showLoggedOutState() {
        sessionStorage.removeItem(SESSION_KEY);
        if (boxLoggedOut) boxLoggedOut.style.display = 'flex';
        if (boxLoggedIn) boxLoggedIn.style.display = 'none';
        if (dashboard) dashboard.style.display = 'none';
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const entered = (input?.value || '').trim();
        const hash = await sha256(entered);
        if (constantTimeEqual(hash, ADMIN_HASH)) {
          showLoggedInState();
        } else {
          if (feedback) {
            feedback.style.display = 'block';
            feedback.textContent = 'Code administrateur incorrect.';
          }
        }
      });

      btnLogout?.addEventListener('click', showLoggedOutState);
    }

    function setupInbox() {
      const formAdd = document.getElementById('formAddManualRequest') as HTMLFormElement | null;
      formAdd?.addEventListener('submit', (e) => {
        e.preventDefault();
        const org = (document.getElementById('manualOrg') as HTMLSelectElement).value;
        const date = (document.getElementById('manualDate') as HTMLInputElement).value;
        const contact = (document.getElementById('manualContact') as HTMLInputElement).value.trim();
        const source = (document.getElementById('manualSource') as HTMLSelectElement).value;
        const notes = (document.getElementById('manualNotes') as HTMLTextAreaElement).value.trim();

        if (!date || !contact) return;

        const inbox = getInbox();
        inbox.unshift({
          id: 'req_' + Date.now(),
          org,
          date,
          contact,
          source,
          notes,
          status: 'en_attente',
          createdAt: Date.now()
        });
        saveInbox(inbox);
        renderInbox();
        formAdd.reset();
        alert(`Demande ${org} du ${date} ajoutée au calendrier en attente !`);
      });

      const btnCloseModal = document.getElementById('btnCloseConfirmModal');
      btnCloseModal?.addEventListener('click', () => {
        const modal = document.getElementById('confirmActionModal');
        if (modal) modal.style.display = 'none';
      });
    }

    function renderInbox() {
      const container = document.getElementById('pendingRequestsList');
      const countStat = document.getElementById('statPendingCount');
      if (!container) return;

      const inbox = getInbox();
      const pendingItems = inbox.filter((i) => i.status === 'en_attente');

      if (countStat) countStat.textContent = pendingItems.length.toString();

      // Appliquer les badges sur les cellules du calendrier
      pendingItems.forEach((item) => {
        const cell = document.querySelector(`.admin-month-view .day-cell[data-date="${item.date}"]`);
        if (cell) {
          cell.classList.add('day-pending-cell');
          const badges = cell.querySelector('.badges-stack');
          if (badges && !badges.querySelector('.tag-pending-badge')) {
            const b = document.createElement('span');
            b.className = 'tag-pending-badge';
            b.textContent = '⏳ En attente';
            badges.prepend(b);
          }
        }
      });

      if (pendingItems.length === 0) {
        container.innerHTML = `
          <div class="empty-inbox-state">
            <span>Toutes les demandes ont été traitées !</span>
            <small>Les prochaines demandes SMS ou Email ajoutées apparaîtront ici.</small>
          </div>
        `;
        return;
      }

      container.innerHTML = '';
      pendingItems.forEach((item) => {
        const card = document.createElement('div');
        card.className = 'pending-req-card';

        card.innerHTML = `
          <div class="pending-top">
            <span class="pending-org-tag">${item.org}</span>
            <span class="pending-date-tag">📅 ${item.date}</span>
            <span class="pending-source-tag">Source : ${item.source}</span>
          </div>
          <div class="pending-body">
            <strong>Contact : ${item.contact}</strong>
            <p>${item.notes || 'Aucun détail précisé'}</p>
          </div>
          <div class="pending-actions-row">
            <button type="button" class="btn-noir btn-sm btn-confirm-req" data-id="${item.id}">
              ✅ Valider & Répondre &rarr;
            </button>
            <button type="button" class="btn-clear btn-sm btn-delete-req" data-id="${item.id}" style="color: #666;">
              Supprimer
            </button>
          </div>
        `;

        container.appendChild(card);
      });

      // Actions sur les demandes
      container.querySelectorAll('.btn-confirm-req').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;
          confirmRequest(id);
        });
      });

      container.querySelectorAll('.btn-delete-req').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (!id) return;
          const filtered = getInbox().filter((x) => x.id !== id);
          saveInbox(filtered);
          renderInbox();
        });
      });
    }

    function confirmRequest(id: string) {
      const inbox = getInbox();
      const item = inbox.find((x) => x.id === id);
      if (!item) return;

      item.status = 'confirme';
      saveInbox(inbox);
      renderInbox();

      // Mettre à jour visuellement la cellule
      const cell = document.querySelector(`.admin-month-view .day-cell[data-date="${item.date}"]`);
      if (cell) {
        cell.classList.remove('day-pending-cell');
        const pendingBadge = cell.querySelector('.tag-pending-badge');
        if (pendingBadge) pendingBadge.remove();

        const desc = cell.querySelector('.event-cinema .dispo-text');
        if (desc) {
          desc.className = 'event-desc studios-text';
          desc.textContent = `Confirmé (${item.org}) — ${item.notes || 'Séance validée'}`;
        }
      }

      // Préparer le message de confirmation
      const confirmText = `Bonjour,\n\nJe vous confirme avec plaisir la réservation pour le ${item.date} (${item.org}).\nLa date est désormais validée et réservée dans mon planning d'intervention.\n\nÀ très vite,\nTom Bigot`;

      const modal = document.getElementById('confirmActionModal');
      const payload = document.getElementById('confirmMessagePayload');
      const btnSms = document.getElementById('btnSendConfirmSms') as HTMLAnchorElement | null;
      const btnEmail = document.getElementById('btnSendConfirmEmail') as HTMLAnchorElement | null;
      const btnCopy = document.getElementById('btnCopyConfirmMsg');

      if (payload) payload.textContent = confirmText;

      const encodedMsg = encodeURIComponent(confirmText);
      const isEmail = item.contact.includes('@');

      if (btnSms) {
        const telClean = isEmail ? '' : item.contact.replace(/[^0-9+]/g, '');
        btnSms.href = telClean ? `sms:${telClean}?body=${encodedMsg}` : `sms:?body=${encodedMsg}`;
      }

      if (btnEmail) {
        const mailTarget = isEmail ? item.contact : 'contact@cine-off.fr';
        const mailSub = encodeURIComponent(`Confirmation de séance — Tom Bigot (${item.date})`);
        btnEmail.href = `mailto:${mailTarget}?subject=${mailSub}&body=${encodedMsg}`;
      }

      btnCopy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(confirmText);
          btnCopy.textContent = 'Copié !';
          setTimeout(() => (btnCopy.textContent = 'Copier le message'), 2000);
        } catch {}
      });

      if (modal) {
        modal.style.display = 'block';
        modal.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function setupMagicLinks() {
      document.querySelectorAll('.btn-copy-link').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const link = btn.getAttribute('data-link');
          if (!link) return;
          try {
            await navigator.clipboard.writeText(link);
            const prev = btn.textContent;
            btn.textContent = 'Lien copié !';
            setTimeout(() => (btn.textContent = prev), 2000);
          } catch {}
        });
      });
    }

    function setupMonthNavigation() {
      const btnPrev = document.getElementById('btnPrevMonthAdmin');
      const btnNext = document.getElementById('btnNextMonthAdmin');
      const titleElem = document.getElementById('calendarMonthTitleAdmin');
      const months = document.querySelectorAll<HTMLElement>('.admin-month-view');

      function updateMonthView() {
        months.forEach((m, idx) => {
          if (idx === currentMonthIndex) {
            m.classList.remove('is-hidden-month');
            m.classList.add('is-active-month');
            const name = m.getAttribute('data-month-name');
            if (titleElem && name) titleElem.textContent = name;
          } else {
            m.classList.remove('is-active-month');
            m.classList.add('is-hidden-month');
          }
        });

        if (btnPrev) (btnPrev as HTMLButtonElement).disabled = (currentMonthIndex === 0);
        if (btnNext) (btnNext as HTMLButtonElement).disabled = (currentMonthIndex === months.length - 1);
      }

      btnPrev?.addEventListener('click', () => {
        if (currentMonthIndex > 0) {
          currentMonthIndex--;
          updateMonthView();
        }
      });

      btnNext?.addEventListener('click', () => {
        if (currentMonthIndex < months.length - 1) {
          currentMonthIndex++;
          updateMonthView();
        }
      });

      updateMonthView();
    }

    function setupFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.btn-filter');
      const eventBlocksCinema = document.querySelectorAll<HTMLElement>('.event-cinema');
      const eventBlocksFpv = document.querySelectorAll<HTMLElement>('.event-fpv');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');

          const mode = btn.getAttribute('data-filter');

          if (mode === 'all') {
            eventBlocksCinema.forEach((el) => (el.style.display = 'block'));
            eventBlocksFpv.forEach((el) => (el.style.display = 'block'));
          } else if (mode === 'cinema') {
            eventBlocksCinema.forEach((el) => (el.style.display = 'block'));
            eventBlocksFpv.forEach((el) => (el.style.display = 'none'));
          } else if (mode === 'fpv') {
            eventBlocksCinema.forEach((el) => (el.style.display = 'none'));
            eventBlocksFpv.forEach((el) => (el.style.display = 'block'));
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAdminPage);
    } else {
      initAdminPage();
    }
  </script>

