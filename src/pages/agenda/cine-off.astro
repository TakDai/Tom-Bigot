---
import Base from '../../layouts/Base.astro';
import { planningCinemaMois } from '../../data/planning';
---

<Base
  titre="Espace Dédié Ciné-Off — Réservations & Tournées Cabine"
  description="Portail officiel et exclusif de réservation de dates pour le circuit de cinéma itinérant Ciné-Off (Indre-et-Loire). Planifiez vos tournées et vacations cabine avec Tom Bigot sans code."
>
  <main class="prose-screen dedicated-agenda-page">
    <!-- Header dédié Ciné-Off -->
    <header class="page-head dedicated-header">
      <div class="dedicated-badge-row">
        <span class="etiquette">CIRCUIT ITINÉRANT 37 &bull; INDRE-ET-LOIRE</span>
        <span class="badge-partner">PORTAIL DÉDIÉ CINÉ-OFF</span>
      </div>
      <h1 class="page-title">ESPACE RÉSERVATIONS &bull; CINÉ-OFF</h1>
      <p class="page-subtitle">
        Planning exclusif pour la coordination des projections itinérantes, tournées communales et séances en plein air du circuit Ciné-Off. Vos séances sont affichées en clair ci-dessous.
      </p>
    </header>

    <!-- Carte d'accueil & Accès direct sans code -->
    <section class="partner-auth-box">
      <div class="auth-card logged-in">
        <div class="auth-icon">🎞️</div>
        <div class="auth-info">
          <div class="auth-status-tag active">ACCÈS DIRECT PAR LIEN RÉSERVÉ &bull; SANS CODE</div>
          <h2>CIRCUIT ITINÉRANT CINÉ-OFF</h2>
          <p>
            Bienvenue sur votre espace de tournée exclusif. Vos dates de projection itinérante sont déjà affichées en clair ci-dessous. Les séances des salles sédentaires (Les Studios) et périodes de formation CFA restent confidentielles et grisées.
          </p>
          <div class="logged-actions">
            <a href="#formCineoff" class="btn-noir">+ Poser une date de tournée &darr;</a>
            <a href="sms:?body=Bonjour%20Tom%2C%20voici%20mes%20prochaines%20dates%20Cin%C3%A9-Off%20%3A%20" class="btn-outline">📱 Envoyer un SMS direct à Tom &rarr;</a>
            <a href="mailto:contact@tom-bigot.fr?subject=[Cin%C3%A9-Off]%20Demande%20de%20dates%20de%20tourn%C3%A9e" class="btn-outline">✉️ Envoyer un Email direct &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Barre d'outils et Légende -->
    <div class="agenda-toolbar">
      <div class="legend-grid">
        <div class="legend-item">
          <span class="legend-box box-libre"></span>
          <div class="legend-text">
            <strong>DISPONIBLE</strong>
            <span>Créneau ouvert pour Ciné-Off</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-cineoff"></span>
          <div class="legend-text">
            <strong>VOTRE TOURNÉE</strong>
            <span>Séance confirmée Ciné-Off</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-pending"></span>
          <div class="legend-text">
            <strong>EN ATTENTE</strong>
            <span>Demande en cours de validation</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-masked"></span>
          <div class="legend-text">
            <strong>AUTRE EXPLOITANT / CFA</strong>
            <span>Séance privée (confidentiel)</span>
          </div>
        </div>
      </div>

      <div class="month-selector-bar">
        <button type="button" id="btnPrevMonth" class="btn-outline btn-month">&larr; Mois précédent</button>
        <div class="current-month-display">
          <span class="etiquette">TOURNÉES 37</span>
          <h2 id="calendarMonthTitle" class="month-heading">NOVEMBRE 2026</h2>
        </div>
        <button type="button" id="btnNextMonth" class="btn-outline btn-month">Mois suivant &rarr;</button>
      </div>
    </div>

    <!-- Calendriers Ciné-Off -->
    {planningCinemaMois.map((mois, indexMois) => (
      <section
        id={`cineoff-calendar-${indexMois}`}
        class={`calendar-card cinema-month-view ${indexMois === 0 ? 'is-active-month' : 'is-hidden-month'}`}
        data-month-index={indexMois}
        data-month-name={`${mois.nom.toUpperCase()} ${mois.annee}`}
      >
        <div class="calendar-grid">
          <div class="weekday-col">LUN</div>
          <div class="weekday-col">MAR</div>
          <div class="weekday-col">MER</div>
          <div class="weekday-col">JEU</div>
          <div class="weekday-col">VEN</div>
          <div class="weekday-col">SAM</div>
          <div class="weekday-col">DIM</div>

          {Array.from({ length: mois.decalageLundi }).map(() => (
            <div class="day-cell day-empty" aria-hidden="true"></div>
          ))}

          {mois.jours.map((item) => {
            const isLibre = item.statut === 'libre';
            const isCineoff = item.ownerId === 'cineoff';
            const isOther = !isLibre && !isCineoff;

            return (
              <div
                class={`day-cell ${isLibre ? 'day-selectable' : (isCineoff ? 'day-cineoff-active' : 'day-masked-grise')}`}
                data-date={item.dateStr}
                data-owner={item.ownerId}
                data-detail={item.detail || ''}
                role={isLibre ? 'button' : 'region'}
                tabindex={isLibre ? '0' : '-1'}
              >
                <div class="day-topline">
                  <span class="day-number">{item.jour}</span>
                  {isLibre && <span class="tag-libre">+ Choisir</span>}
                  {isCineoff && <span class="tag-cineoff">Ciné-Off</span>}
                  {isOther && <span class="tag-masked">🔒 Occupé</span>}
                </div>
                <div class="day-body">
                  {isLibre && (
                    <>
                      <div class="day-title">Disponible Cabine</div>
                      <div class="day-desc">Ouvert aux tournées</div>
                    </>
                  )}
                  {isCineoff && (
                    <>
                      <div class="day-title" data-cineoff-title>Ciné-Off (Tournée)</div>
                      <div class="day-desc" data-cineoff-desc>{item.detail}</div>
                    </>
                  )}
                  {isOther && (
                    <>
                      <div class="day-title" style="color: #666666; font-style: italic;">🔒 Indisponible</div>
                      <div class="day-desc" style="color: #999999;">Créneau engagé (Confidentiel)</div>
                    </>
                  )}
                </div>
                <div class="day-hint">
                  {isLibre && <span>Poser une date</span>}
                  {isCineoff && <span style="color: #000000; font-weight: 700;">Votre séance</span>}
                  {isOther && <span style="color: #777777;">🔒 Réservé tiers</span>}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <!-- Panier de sélection de dates avec options rapides SMS & Email -->
    <div id="selectionBarCineoff" class="selection-summary-bar" style="display: none;">
      <div class="selection-info">
        <span class="etiquette">DATES DE TOURNÉE SÉLECTIONNÉES</span>
        <div id="selectedCineoffDatesList" class="selected-tags-container"></div>
      </div>
      <div class="selection-actions">
        <button type="button" id="btnClearCineoffDates" class="btn-clear">Vider</button>
        <a id="btnQuickSmsCineoff" href="#" class="btn-action-pill">📱 Par SMS &rarr;</a>
        <a id="btnQuickMailCineoff" href="#" class="btn-action-pill">✉️ Par Email &rarr;</a>
        <a href="#formCineoff" class="btn-noir btn-jump-form">Finaliser formulaire &darr;</a>
      </div>
    </div>

    <!-- Formulaire dédié Ciné-Off -->
    <section id="formCineoff" class="prose-card form-container">
      <div class="form-header">
        <span class="etiquette">RÉGIE TECHNIQUE &bull; CIRCUIT DE TOURNÉE</span>
        <h2>TRANSMETTRE UNE DEMANDE DE TOURNÉE CINÉ-OFF</h2>
        <p class="form-intro">
          Ce formulaire est pré-configuré pour l'équipe et la régie de <strong>Ciné-Off</strong>. Choisissez vos dates sur le calendrier ci-dessus et transmettez votre demande. Dès que Tom confirme la date, vous recevez un message de validation.
        </p>
      </div>

      <form id="agendaFormCineoff" class="styled-agenda-form">
        <!-- Honeypot anti-bot OWASP OAT-007 -->
        <div class="hp-field-guard" aria-hidden="true" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none; width: 0; height: 0; overflow: hidden;">
          <label for="cineoff_guard">Ne pas remplir</label>
          <input type="text" id="cineoff_guard" name="cineoff_guard" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-grid-fields">
          <div class="form-field">
            <label for="cineoffStructure"><strong>STRUCTURE *</strong></label>
            <input type="text" id="cineoffStructure" name="cineoffStructure" value="Ciné-Off (Circuit itinérant 37)" readonly required />
          </div>

          <div class="form-field">
            <label for="cineoffContact"><strong>RESPONSABLE TOURNÉE / COORDINATEUR *</strong></label>
            <input type="text" id="cineoffContact" name="cineoffContact" placeholder="Ex : Régie Ciné-Off" required />
          </div>

          <div class="form-field">
            <label for="cineoffEmail"><strong>EMAIL DE CONTACT *</strong></label>
            <input type="email" id="cineoffEmail" name="cineoffEmail" value="contact@cine-off.fr" required />
          </div>

          <div class="form-field">
            <label for="cineoffTel"><strong>TÉLÉPHONE DU CONDUCTEUR / CABINE</strong></label>
            <input type="tel" id="cineoffTel" name="cineoffTel" placeholder="Ex : 02 47 XX XX XX" />
          </div>

          <div class="form-field full-width">
            <label for="cineoffDatesInput"><strong>DATE(S) RETENUE(S) *</strong></label>
            <input type="text" id="cineoffDatesInput" name="cineoffDatesInput" placeholder="Cliquez sur les dates disponibles ci-dessus..." required />
          </div>

          <div class="form-field">
            <label for="cineoffTypeSeance"><strong>TYPE DE TOURNÉE *</strong></label>
            <select id="cineoffTypeSeance" name="cineoffTypeSeance" required>
              <option value="Séance communale en salle polyvalente">Séance en salle communale / polyvalente</option>
              <option value="Projection en plein air (Écran gonflable)">Projection en plein air (Écran gonflable)</option>
              <option value="Séance scolaire / jeune public">Séance scolaire / jeune public</option>
              <option value="Festival / Événement spécial">Festival / Événement spécial</option>
            </select>
          </div>

          <div class="form-field">
            <label for="cineoffCommunes"><strong>COMMUNE(S) D'INTERVENTION *</strong></label>
            <input type="text" id="cineoffCommunes" name="cineoffCommunes" placeholder="Ex : Loches, Montrésor, Chinon..." required />
          </div>

          <div class="form-field full-width">
            <label for="cineoffNotes"><strong>DÉTAILS COMPLÉMENTAIRES (FILM, HORAIRES, RÉGIE)</strong></label>
            <textarea id="cineoffNotes" name="cineoffNotes" rows="4" placeholder="Précisez le titre du film, format DCP / bluray, heure de début souhaitée..."></textarea>
          </div>
        </div>

        <div class="form-submit-row">
          <button type="submit" id="btnSubmitCineoff" class="btn-noir btn-large">
            Transmettre la demande de tournée &rarr;
          </button>
        </div>
      </form>

      <!-- Résultat / Confirmation -->
      <div id="resultModalCineoff" class="result-box" style="display: none;">
        <div class="result-head">
          <span class="etiquette">DEMANDE ENVOYÉE &bull; EN ATTENTE DE CONFIRMATION</span>
          <h3>DEMANDE DE TOURNÉE TRANSMIS À TOM BIGOT</h3>
        </div>
        <p>
          Votre demande a été ajoutée en attente de validation sur le calendrier. Vous pouvez également notifier Tom directement par SMS ou par email :
        </p>
        <pre id="resultPayloadCineoff" class="result-pre"></pre>
        <div class="result-actions">
          <a id="btnSmsCineoffModal" href="#" class="btn-noir">📱 Envoyer par SMS à Tom &rarr;</a>
          <a id="btnMailtoCineoffModal" href="#" class="btn-outline">✉️ Envoyer par Email à Tom &rarr;</a>
          <button type="button" id="btnCopyCineoff" class="btn-outline">Copier le récapitulatif</button>
        </div>
      </div>
    </section>

    <!-- Navigation alternative -->
    <nav class="dedicated-footer-nav" aria-label="Espaces dédiés par établissement">
      <span class="etiquette">AUTRES ESPACES DÉDIÉS</span>
      <div class="footer-nav-links">
        <a href="/agenda/les-studios" class="portal-card">
          <span class="portal-badge">SALLES SÉDENTAIRES</span>
          <strong>Cinémas Les Studios &rarr;</strong>
          <small>Planning cabines 7 écrans & 35mm</small>
        </a>
        <a href="/agenda/fpv" class="portal-card">
          <span class="portal-badge">TOURNAGES VIDÉO</span>
          <strong>Drone FPV & Devis &rarr;</strong>
          <small>Réservations de vol cinématique</small>
        </a>
        <a href="/agenda" class="portal-card">
          <span class="portal-badge">ACCUEIL GÉNÉRAL</span>
          <strong>Agenda Global Tom Bigot &rarr;</strong>
          <small>Vue d'ensemble et supervision</small>
        </a>
      </div>
    </nav>
  </main>

  <script>
    // Module Ciné-Off — Accès direct par lien (Zéro code / Frictionless)
    let selectedDates: string[] = [];
    let currentMonthIndex = 0;
    const formMountedAt = Date.now();
    const PENDING_STORAGE_KEY = 'tom_cineoff_pending_dates';

    function initCineoffPage() {
      setupMonthNavigation();
      setupDateSelection();
      loadPendingDates();
      setupFormSubmission();
    }

    function setupMonthNavigation() {
      const btnPrev = document.getElementById('btnPrevMonth');
      const btnNext = document.getElementById('btnNextMonth');
      const titleElem = document.getElementById('calendarMonthTitle');
      const months = document.querySelectorAll<HTMLElement>('.cinema-month-view');

      function updateMonthView() {
        months.forEach((m, idx) => {
          if (idx === currentMonthIndex) {
            m.classList.remove('is-hidden-month');
            m.classList.add('is-active-month');
            const name = m.getAttribute('data-month-name');
            if (titleElem && name) titleElem.textContent = name;
          } else {
            m.classList.remove('is-active-month');
            m.classList.add('is-hidden-month');
          }
        });

        if (btnPrev) (btnPrev as HTMLButtonElement).disabled = (currentMonthIndex === 0);
        if (btnNext) (btnNext as HTMLButtonElement).disabled = (currentMonthIndex === months.length - 1);
      }

      btnPrev?.addEventListener('click', () => {
        if (currentMonthIndex > 0) {
          currentMonthIndex--;
          updateMonthView();
        }
      });

      btnNext?.addEventListener('click', () => {
        if (currentMonthIndex < months.length - 1) {
          currentMonthIndex++;
          updateMonthView();
        }
      });

      updateMonthView();
    }

    function setupDateSelection() {
      const selectableCells = document.querySelectorAll<HTMLElement>('.cinema-month-view .day-selectable');
      const selectionBar = document.getElementById('selectionBarCineoff');
      const tagsContainer = document.getElementById('selectedCineoffDatesList');
      const inputDates = document.getElementById('cineoffDatesInput') as HTMLInputElement | null;
      const btnClear = document.getElementById('btnClearCineoffDates');
      const btnQuickSms = document.getElementById('btnQuickSmsCineoff') as HTMLAnchorElement | null;
      const btnQuickMail = document.getElementById('btnQuickMailCineoff') as HTMLAnchorElement | null;

      selectableCells.forEach((cell) => {
        cell.addEventListener('click', () => {
          const dateStr = cell.getAttribute('data-date');
          if (!dateStr) return;

          const idx = selectedDates.indexOf(dateStr);
          if (idx >= 0) {
            selectedDates.splice(idx, 1);
            cell.classList.remove('day-is-selected');
          } else {
            selectedDates.push(dateStr);
            selectedDates.sort();
            cell.classList.add('day-is-selected');
          }
          renderSelectedDates();
        });

        cell.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            cell.click();
          }
        });
      });

      function renderSelectedDates() {
        if (!selectionBar || !tagsContainer || !inputDates) return;

        if (selectedDates.length === 0) {
          selectionBar.style.display = 'none';
          inputDates.value = '';
          return;
        }

        selectionBar.style.display = 'flex';
        tagsContainer.innerHTML = '';
        inputDates.value = selectedDates.join(', ');

        const datesText = selectedDates.join(', ');
        const smsBody = encodeURIComponent(`Bonjour Tom, voici ma demande de tournée Ciné-Off pour le(s) : ${datesText}. Peux-tu me confirmer la disponibilité ? Merci !`);
        const mailSub = encodeURIComponent(`[Ciné-Off] Demande de tournée : ${datesText}`);
        const mailBody = encodeURIComponent(`Bonjour Tom,\n\nVoici les dates de tournée envisagées pour Ciné-Off :\n${datesText}\n\nMerci de me confirmer dès que possible.\n\nRégie Ciné-Off`);

        if (btnQuickSms) btnQuickSms.href = `sms:?body=${smsBody}`;
        if (btnQuickMail) btnQuickMail.href = `mailto:contact@tom-bigot.fr?subject=${mailSub}&body=${mailBody}`;

        selectedDates.forEach((dateStr) => {
          const tag = document.createElement('span');
          tag.className = 'date-tag';
          tag.textContent = dateStr;

          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.innerHTML = '&times;';
          removeBtn.title = `Retirer le ${dateStr}`;
          removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const i = selectedDates.indexOf(dateStr);
            if (i >= 0) {
              selectedDates.splice(i, 1);
              const cell = document.querySelector(`.cinema-month-view .day-cell[data-date="${dateStr}"]`);
              if (cell) cell.classList.remove('day-is-selected');
              renderSelectedDates();
            }
          });

          tag.appendChild(removeBtn);
          tagsContainer.appendChild(tag);
        });
      }

      btnClear?.addEventListener('click', () => {
        selectedDates = [];
        document.querySelectorAll('.cinema-month-view .day-is-selected').forEach((c) => {
          c.classList.remove('day-is-selected');
        });
        renderSelectedDates();
      });
    }

    function loadPendingDates() {
      try {
        const raw = localStorage.getItem(PENDING_STORAGE_KEY);
        if (!raw) return;
        const pendingList: string[] = JSON.parse(raw);
        pendingList.forEach((dateStr) => {
          const cell = document.querySelector(`.cinema-month-view .day-cell[data-date="${dateStr}"]`);
          if (cell) {
            cell.classList.add('day-pending-approval');
            const topTag = cell.querySelector('.day-topline');
            if (topTag) {
              const existingTag = topTag.querySelector('.tag-libre');
              if (existingTag) existingTag.textContent = '⏳ En attente';
            }
            const desc = cell.querySelector('.day-desc');
            if (desc) desc.textContent = 'Demande envoyée — En attente validation';
          }
        });
      } catch {}
    }

    function setupFormSubmission() {
      const form = document.getElementById('agendaFormCineoff') as HTMLFormElement | null;
      const modal = document.getElementById('resultModalCineoff');
      const payloadPre = document.getElementById('resultPayloadCineoff');
      const btnSmsModal = document.getElementById('btnSmsCineoffModal') as HTMLAnchorElement | null;
      const btnMailtoModal = document.getElementById('btnMailtoCineoffModal') as HTMLAnchorElement | null;
      const btnCopy = document.getElementById('btnCopyCineoff');

      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Protection honeypot
        const hp = (document.getElementById('cineoff_guard') as HTMLInputElement)?.value;
        if (hp && hp.trim().length > 0) return;

        // Protection soumission trop rapide
        const elapsed = (Date.now() - formMountedAt) / 1000;
        if (elapsed < 1.5) {
          alert('Veuillez vérifier votre saisie.');
          return;
        }

        const structure = (document.getElementById('cineoffStructure') as HTMLInputElement).value.trim();
        const contact = (document.getElementById('cineoffContact') as HTMLInputElement).value.trim();
        const email = (document.getElementById('cineoffEmail') as HTMLInputElement).value.trim();
        const tel = (document.getElementById('cineoffTel') as HTMLInputElement).value.trim();
        const dates = (document.getElementById('cineoffDatesInput') as HTMLInputElement).value.trim();
        const typeSeance = (document.getElementById('cineoffTypeSeance') as HTMLSelectElement).value;
        const communes = (document.getElementById('cineoffCommunes') as HTMLInputElement).value.trim();
        const notes = (document.getElementById('cineoffNotes') as HTMLTextAreaElement).value.trim();

        // Enregistrer dans le stockage local des dates en attente
        try {
          const currentPending = JSON.parse(localStorage.getItem(PENDING_STORAGE_KEY) || '[]');
          selectedDates.forEach((d) => {
            if (!currentPending.includes(d)) currentPending.push(d);
          });
          localStorage.setItem(PENDING_STORAGE_KEY, JSON.stringify(currentPending));
          loadPendingDates();
        } catch {}

        const recap = [
          'DEMANDE DE TOURNÉE &bull; CINÉ-OFF (37)',
          '======================================',
          `Structure   : ${structure}`,
          `Contact     : ${contact}`,
          `Email       : ${email}`,
          `Téléphone   : ${tel || 'Non précisé'}`,
          `Date(s)     : ${dates}`,
          `Commune(s)  : ${communes}`,
          `Format      : ${typeSeance}`,
          `Détails     : ${notes || 'Aucun'}`,
          '--------------------------------------',
          'État        : EN ATTENTE DE CONFIRMATION TOM BIGOT',
          '======================================'
        ].join('\n');

        if (payloadPre) payloadPre.textContent = recap;

        const smsText = encodeURIComponent(`Bonjour Tom, demande Ciné-Off de ${contact} pour le(s) ${dates} à ${communes}. Peux-tu me confirmer ? Merci !`);
        const mailSubject = encodeURIComponent(`[Ciné-Off] Demande de tournée : ${communes} (${dates})`);
        const mailBody = encodeURIComponent(recap);

        if (btnSmsModal) btnSmsModal.href = `sms:?body=${smsText}`;
        if (btnMailtoModal) btnMailtoModal.href = `mailto:contact@tom-bigot.fr?subject=${mailSubject}&body=${mailBody}`;

        if (modal) {
          modal.style.display = 'block';
          modal.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });

      btnCopy?.addEventListener('click', async () => {
        if (!payloadPre || !payloadPre.textContent) return;
        try {
          await navigator.clipboard.writeText(payloadPre.textContent);
          btnCopy.textContent = 'Copié !';
          setTimeout(() => {
            btnCopy.textContent = 'Copier le récapitulatif';
          }, 2500);
        } catch {
          alert('Veuillez copier manuellement le texte ci-dessus.');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCineoffPage);
    } else {
      initCineoffPage();
    }
  </script>

  <style>
    .dedicated-agenda-page {
      padding-top: 1.5rem;
      padding-bottom: 4rem;
    }

    .dedicated-header {
      margin-bottom: 2rem;
    }

    .dedicated-badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 1rem;
    }

    .badge-partner {
      display: inline-block;
      font-family: var(--font-mono, monospace);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      background: #000000;
      color: #ffffff;
      border: 1px solid #000000;
    }

    .partner-auth-box {
      margin-bottom: 2.5rem;
    }

    .auth-card {
      display: flex;
      gap: 1.5rem;
      padding: 1.75rem;
      background: #fdfdfd;
      border: 2px solid #000000;
      box-shadow: 6px 6px 0px #000000;
      align-items: flex-start;
    }

    .auth-card.logged-in {
