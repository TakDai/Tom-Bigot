---
import Base from '../../layouts/Base.astro';
import { planningFpvMois } from '../../data/planning';
---

<Base
  titre="Espace Tournages & Devis Drone FPV — Tom Bigot"
  description="Portail de planification et demande de devis instantané pour tournages drone FPV. Disponibilités en temps réel, cinewhoop intérieur et prises de vue cinématiques."
>
  <main class="prose-screen dedicated-agenda-page">
    <!-- Header dédié Drone FPV -->
    <header class="page-head dedicated-header">
      <div class="dedicated-badge-row">
        <span class="etiquette">CADRAGE AÉRIEN IMMERSIF &bull; TOURNAGES CINÉMA & PUB</span>
        <span class="badge-partner">PORTAIL DÉDIÉ TOURNAGES FPV</span>
      </div>
      <h1 class="page-title">ESPACE TOURNAGES & DEVIS &bull; DRONE FPV</h1>
      <p class="page-subtitle">
        Planning officiel pour les sociétés de production, réalisateurs, agences et diffuseurs. Consultez les créneaux ouverts, sélectionnez vos dates de tournage et générez votre demande de devis détaillée.
      </p>
    </header>

    <!-- Fiche Récapitulatif Matériel & Homologation -->
    <section class="partner-auth-box">
      <div class="auth-card logged-in">
        <div class="auth-icon">🚁</div>
        <div class="auth-info">
          <div class="auth-status-tag active">TÉLÉPILOTE HOMOLOGUÉ DGAC &bull; SCÉNARIOS S1 - S2 - S3</div>
          <h2>TOURNAGES FPV HAUTE PRÉCISION</h2>
          <p>
            Équipements cinématiques haute performance : Cinewhoop 2.5" & 3.5" carénés pour le vol intérieur sécurisé à proximité des personnes, quad 5" pour la dynamique et le suivi de vitesse, 7" longue portée. Caméras 4K / 5.3K 10-bit avec gyro-données synchronisées Gyroflow.
          </p>
          <div class="logged-actions">
            <a href="#formFpv" class="btn-noir">+ Demander un devis / Poser une option &darr;</a>
            <a href="/fpv" class="btn-outline">Voir le showroom vidéo FPV &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Barre d'outils et Légende -->
    <div class="agenda-toolbar">
      <div class="legend-grid">
        <div class="legend-item">
          <span class="legend-box box-libre"></span>
          <div class="legend-text">
            <strong>VOL DISPONIBLE</strong>
            <span>Créneau ouvert pour tournage</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-tournage"></span>
          <div class="legend-text">
            <strong>TOURNAGE CONFIRMÉ</strong>
            <span>Prise de vue validée</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-reperage"></span>
          <div class="legend-text">
            <strong>REPÉRAGE SITE</strong>
            <span>Validation espace & protocole</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-option"></span>
          <div class="legend-text">
            <strong>OPTION MÉTÉO / PROD</strong>
            <span>Date pré-réservée</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-masked"></span>
          <div class="legend-text">
            <strong>INDISPONIBLE</strong>
            <span>Autre engagement (cabine/pro)</span>
          </div>
        </div>
      </div>

      <div class="month-selector-bar">
        <button type="button" id="btnPrevMonth" class="btn-outline btn-month">&larr; Mois précédent</button>
        <div class="current-month-display">
          <span class="etiquette">TOURNAGES 2026</span>
          <h2 id="calendarMonthTitle" class="month-heading">NOVEMBRE 2026</h2>
        </div>
        <button type="button" id="btnNextMonth" class="btn-outline btn-month">Mois suivant &rarr;</button>
      </div>
    </div>

    <!-- Calendriers Drone FPV -->
    {planningFpvMois.map((mois, indexMois) => (
      <section
        id={`fpv-calendar-${indexMois}`}
        class={`calendar-card fpv-month-view ${indexMois === 0 ? 'is-active-month' : 'is-hidden-month'}`}
        data-month-index={indexMois}
        data-month-name={`${mois.nom.toUpperCase()} ${mois.annee}`}
      >
        <div class="calendar-grid">
          <div class="weekday-col">LUN</div>
          <div class="weekday-col">MAR</div>
          <div class="weekday-col">MER</div>
          <div class="weekday-col">JEU</div>
          <div class="weekday-col">VEN</div>
          <div class="weekday-col">SAM</div>
          <div class="weekday-col">DIM</div>

          {Array.from({ length: mois.decalageLundi }).map(() => (
            <div class="day-cell day-empty" aria-hidden="true"></div>
          ))}

          {mois.jours.map((item) => {
            const isLibre = item.statut === 'libre';
            const isTournage = item.statut === 'reserve_tournage';
            const isReperage = item.statut === 'reserve_reperage';
            const isOption = item.statut === 'option_meteo';
            const isIndispo = item.statut === 'indisponible';

            let cellClass = 'day-masked-grise';
            let tagText = 'Indisponible';
            let tagClass = 'tag-masked';

            if (isLibre) {
              cellClass = 'day-selectable';
              tagText = '+ Choisir';
              tagClass = 'tag-libre';
            } else if (isTournage) {
              cellClass = 'day-fpv-tournage';
              tagText = 'Tournage';
              tagClass = 'tag-tournage';
            } else if (isReperage) {
              cellClass = 'day-fpv-reperage';
              tagText = 'Repérage';
              tagClass = 'tag-reperage';
            } else if (isOption) {
              cellClass = 'day-fpv-option';
              tagText = 'Option';
              tagClass = 'tag-option';
            }

            return (
              <div
                class={`day-cell ${cellClass}`}
                data-date={item.dateStr}
                data-statut={item.statut}
                data-detail={item.detail || ''}
                role={isLibre ? 'button' : 'region'}
                tabindex={isLibre ? '0' : '-1'}
              >
                <div class="day-topline">
                  <span class="day-number">{item.jour}</span>
                  <span class={tagClass}>{tagText}</span>
                </div>
                <div class="day-body">
                  <div class="day-title">{item.label}</div>
                  <div class="day-desc">{item.detail || (isLibre ? 'Créneau ouvert' : 'Indisponible')}</div>
                </div>
                <div class="day-hint">
                  {isLibre && <span>Sélectionner date</span>}
                  {isTournage && <span style="font-weight: 700;">Prise de vue validée</span>}
                  {isReperage && <span>Visite protocole</span>}
                  {isOption && <span>Sous réserve</span>}
                  {isIndispo && <span>Non disponible</span>}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <!-- Panier de sélection de dates -->
    <div id="selectionBarFpv" class="selection-summary-bar" style="display: none;">
      <div class="selection-info">
        <span class="etiquette">DATES DE TOURNAGE SÉLECTIONNÉES</span>
        <div id="selectedFpvDatesList" class="selected-tags-container"></div>
      </div>
      <div class="selection-actions">
        <button type="button" id="btnClearFpvDates" class="btn-clear">Vider</button>
        <a id="btnQuickSmsFpv" href="#" class="btn-action-pill">📱 Par SMS &rarr;</a>
        <a id="btnQuickMailFpv" href="#" class="btn-action-pill">✉️ Par Email &rarr;</a>
        <a href="#formFpv" class="btn-noir btn-jump-form">Finaliser le devis &darr;</a>
      </div>
    </div>

    <!-- Formulaire dédié Drone FPV & Devis -->
    <section id="formFpv" class="prose-card form-container">
      <div class="form-header">
        <span class="etiquette">ESTIMATION &bull; TOURNAGE DRONE FPV</span>
        <h2>DEMANDE DE DEVIS & RÉSERVATION DE VOL</h2>
        <p class="form-intro">
          Remplissez les paramètres de votre projet pour recevoir un devis chiffré sous 24h avec protocole DGAC adapté à votre zone de vol.
        </p>
      </div>

      <form id="agendaFormFpv" class="styled-agenda-form">
        <!-- Honeypot anti-bot OWASP OAT-007 -->
        <div class="hp-field-guard" aria-hidden="true" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none; width: 0; height: 0; overflow: hidden;">
          <label for="fpv_guard">Ne pas remplir</label>
          <input type="text" id="fpv_guard" name="fpv_guard" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-grid-fields">
          <div class="form-field">
            <label for="fpvStructure"><strong>STRUCTURE / SOCIÉTÉ DE PRODUCTION *</strong></label>
            <input type="text" id="fpvStructure" name="fpvStructure" placeholder="Ex : Studio Horizon, Agence Com, Réalisateur..." required />
          </div>

          <div class="form-field">
            <label for="fpvContact"><strong>NOM & PRÉNOM DU CONTACT *</strong></label>
            <input type="text" id="fpvContact" name="fpvContact" placeholder="Ex : Sarah Bernard (Directrice de prod)" required />
          </div>

          <div class="form-field">
            <label for="fpvEmail"><strong>EMAIL PROFESSIONNEL *</strong></label>
            <input type="email" id="fpvEmail" name="fpvEmail" placeholder="contact@production.com" required />
          </div>

          <div class="form-field">
            <label for="fpvTel"><strong>TÉLÉPHONE DIRECT *</strong></label>
            <input type="tel" id="fpvTel" name="fpvTel" placeholder="Ex : 06 XX XX XX XX" required />
          </div>

          <div class="form-field full-width">
            <label for="fpvDatesInput"><strong>DATE(S) DE TOURNAGE ENVISAGÉE(S) *</strong></label>
            <input type="text" id="fpvDatesInput" name="fpvDatesInput" placeholder="Cliquez sur les dates disponibles sur le planning ci-dessus..." required />
          </div>

          <div class="form-field">
            <label for="fpvTypePrestation"><strong>FORMAT DE PRESTATION *</strong></label>
            <select id="fpvTypePrestation" name="fpvTypePrestation" required>
              <option value="Tournage demi-journée (4h sur site)">Tournage demi-journée (jusqu'à 4h sur site)</option>
              <option value="Tournage journée complète (8h sur site)">Tournage journée complète (jusqu'à 8h sur site)</option>
              <option value="Pack 2 jours tournage consécutifs">Pack 2 jours consécutifs (Tournage multi-sites)</option>
              <option value="Repérage technique seul">Repérage technique seul (Validation zone & DGAC)</option>
              <option value="Option météo pré-réservation">Option météo pré-réservée (Validation 48h avant)</option>
            </select>
          </div>

          <div class="form-field">
            <label for="fpvTypeVol"><strong>CONFIGURATION DE VOL PRINCIPALE *</strong></label>
            <select id="fpvTypeVol" name="fpvTypeVol" required>
              <option value="Cinewhoop intérieur protégé (Bureaux, entrepôt, usine, ERP)">Cinewhoop intérieur sécurisé (Bureaux, entrepôts, commerces, ERP)</option>
              <option value="Extérieur cinématique fluide 5 pouces">Extérieur cinématique fluide 5" (Paysage, architecture, live)</option>
              <option value="Suivi dynamique haute vitesse (Véhicules, sports)">Suivi dynamique haute vitesse (Automobile, sports, action)</option>
              <option value="Mix intérieur & extérieur one-shot">Mix intérieur & extérieur en plan-séquence continu</option>
              <option value="Patrimoine historique & monuments">Monuments, châteaux & patrimoine classé</option>
            </select>
          </div>

          <div class="form-field">
            <label for="fpvLivrable"><strong>FORMAT DES RUSHES & LIVRABLES *</strong></label>
            <select id="fpvLivrable" name="fpvLivrable" required>
              <option value="4K 60fps Gyroflow stabilisé (Prêt au montage)">4K 60fps Gyroflow stabilisé (Prêt au montage)</option>
              <option value="5.3K 10-bit D-Log M avec métadonnées gyroscopiques brutes">5.3K 10-bit Log + Gyro-data brutes (Pour étalonnage studio)</option>
              <option value="Rushes bruts + Version étalonnée colorisée">Rushes bruts + Version étalonnée / colorisée</option>
              <option value="Montage vidéo final complet livré prêt à diffuser">Montage vidéo final complet livré prêt à diffuser</option>
            </select>
          </div>

          <div class="form-field">
            <label for="fpvLieu"><strong>LOCALISATION DU TOURNAGE &bull; COMMUNE / CP *</strong></label>
            <input type="text" id="fpvLieu" name="fpvLieu" placeholder="Ex : Tours (37000), Amboise, Blois..." required />
          </div>

          <div class="form-field full-width">
            <label for="fpvBrief"><strong>BRIEF CRÉATIF, CAHIER DES CHARGES & CONTRAINTES PARTICULIÈRES *</strong></label>
            <textarea
              id="fpvBrief"
              name="fpvBrief"
              rows="5"
              placeholder="Décrivez votre projet : type de plans souhaités, présence de public ou figurants, horaires particuliers, diffusion prévue (web, pub TV, réseau social)..."
              required
            ></textarea>
          </div>
        </div>

        <div class="form-security-note">
          <span>🔒 Déclaration AlphaTango & protocoles de sécurité DGAC systématiquement pris en charge par Tom Bigot (télépilote assuré responsabilité civile professionnelle aéronautique).</span>
        </div>

        <div class="form-submit-row">
          <button type="submit" id="btnSubmitFpv" class="btn-noir btn-large">
            Générer et envoyer la demande de devis &rarr;
          </button>
        </div>
      </form>

      <!-- Résultat de validation -->
      <div id="resultModalFpv" class="result-box" style="display: none;">
        <div class="result-head">
          <span class="etiquette">SYNTHÈSE DE LA DEMANDE</span>
          <h3>DEMANDE DE TOURNAGE FPV PRÊTE</h3>
        </div>
        <p>
          Votre brief a été formaté avec l'ensemble des spécifications techniques. Vous pouvez l'expédier directement par email ou copier le récapitulatif :
        </p>
        <pre id="resultPayloadFpv" class="result-pre"></pre>
        <div class="result-actions">
          <a id="btnSmsFpv" href="#" class="btn-noir">📱 Envoyer par SMS à Tom &rarr;</a>
          <a id="btnMailtoFpv" href="#" class="btn-outline">✉️ Envoyer par Email à Tom &rarr;</a>
          <button type="button" id="btnCopyFpv" class="btn-outline">Copier le récapitulatif</button>
        </div>
      </div>
    </section>

    <!-- Navigation croisée -->
    <nav class="dedicated-footer-nav" aria-label="Espaces partenaires alternatifs">
      <span class="etiquette">AUTRES ESPACES DÉDIÉS</span>
      <div class="footer-nav-links">
        <a href="/agenda/les-studios" class="portal-card">
          <span class="portal-badge">SALLES SÉDENTAIRES</span>
          <strong>Cinémas Les Studios &rarr;</strong>
          <small>Planning cabines 7 écrans & 35mm</small>
        </a>
        <a href="/agenda/cine-off" class="portal-card">
          <span class="portal-badge">CIRCUIT ITINÉRANT</span>
          <strong>Ciné-Off (37) &rarr;</strong>
          <small>Tournées communales & plein air</small>
        </a>
        <a href="/agenda" class="portal-card">
          <span class="portal-badge">ACCUEIL GÉNÉRAL</span>
          <strong>Agenda Global &bull; Tom Bigot &rarr;</strong>
          <small>Vue d'ensemble et supervision</small>
        </a>
      </div>
    </nav>
  </main>

  <script>
    // Module de gestion de la page dédiée FPV
    let selectedDates: string[] = [];
    let currentMonthIndex = 0;
    const formMountedAt = Date.now();

    function initFpvPage() {
      setupMonthNavigation();
      setupDateSelection();
      setupFormSubmission();
    }

    function setupMonthNavigation() {
      const btnPrev = document.getElementById('btnPrevMonth');
      const btnNext = document.getElementById('btnNextMonth');
      const titleElem = document.getElementById('calendarMonthTitle');
      const months = document.querySelectorAll<HTMLElement>('.fpv-month-view');

      function updateMonthView() {
        months.forEach((m, idx) => {
          if (idx === currentMonthIndex) {
            m.classList.remove('is-hidden-month');
            m.classList.add('is-active-month');
            const name = m.getAttribute('data-month-name');
            if (titleElem && name) titleElem.textContent = name;
          } else {
            m.classList.remove('is-active-month');
            m.classList.add('is-hidden-month');
          }
        });

        if (btnPrev) (btnPrev as HTMLButtonElement).disabled = (currentMonthIndex === 0);
        if (btnNext) (btnNext as HTMLButtonElement).disabled = (currentMonthIndex === months.length - 1);
      }

      btnPrev?.addEventListener('click', () => {
        if (currentMonthIndex > 0) {
          currentMonthIndex--;
          updateMonthView();
        }
      });

      btnNext?.addEventListener('click', () => {
        if (currentMonthIndex < months.length - 1) {
          currentMonthIndex++;
          updateMonthView();
        }
      });

      updateMonthView();
    }

    function setupDateSelection() {
      const selectableCells = document.querySelectorAll<HTMLElement>('.fpv-month-view .day-selectable');
      const selectionBar = document.getElementById('selectionBarFpv');
      const tagsContainer = document.getElementById('selectedFpvDatesList');
      const inputDates = document.getElementById('fpvDatesInput') as HTMLInputElement | null;
      const btnClear = document.getElementById('btnClearFpvDates');
      const btnQuickSms = document.getElementById('btnQuickSmsFpv') as HTMLAnchorElement | null;
      const btnQuickMail = document.getElementById('btnQuickMailFpv') as HTMLAnchorElement | null;

      selectableCells.forEach((cell) => {
        cell.addEventListener('click', () => {
          const dateStr = cell.getAttribute('data-date');
          if (!dateStr) return;

          const idx = selectedDates.indexOf(dateStr);
          if (idx >= 0) {
            selectedDates.splice(idx, 1);
            cell.classList.remove('day-is-selected');
          } else {
            selectedDates.push(dateStr);
            selectedDates.sort();
            cell.classList.add('day-is-selected');
          }
          renderSelectedDates();
        });

        cell.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            cell.click();
          }
        });
      });

      function renderSelectedDates() {
        if (!selectionBar || !tagsContainer || !inputDates) return;

        if (selectedDates.length === 0) {
          selectionBar.style.display = 'none';
          inputDates.value = '';
          return;
        }

        selectionBar.style.display = 'flex';
        tagsContainer.innerHTML = '';
        inputDates.value = selectedDates.join(', ');

        const datesText = selectedDates.join(', ');
        const smsBody = encodeURIComponent(`Bonjour Tom, voici ma demande de tournage Drone FPV pour le(s) : ${datesText}. Peux-tu me confirmer les disponibilités ? Merci !`);
        const mailSub = encodeURIComponent(`[Devis FPV] Demande de tournage : ${datesText}`);
        const mailBody = encodeURIComponent(`Bonjour Tom,\n\nVoici les dates de tournage envisagées en drone FPV :\n${datesText}\n\nMerci de me recontacter pour établir le protocole et devis.\n\nProduction`);

        if (btnQuickSms) btnQuickSms.href = `sms:?body=${smsBody}`;
        if (btnQuickMail) btnQuickMail.href = `mailto:contact@tom-bigot.fr?subject=${mailSub}&body=${mailBody}`;

        selectedDates.forEach((dateStr) => {
          const tag = document.createElement('span');
          tag.className = 'date-tag';
          tag.textContent = dateStr;

          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.innerHTML = '&times;';
          removeBtn.title = `Retirer le ${dateStr}`;
          removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const i = selectedDates.indexOf(dateStr);
            if (i >= 0) {
              selectedDates.splice(i, 1);
              const cell = document.querySelector(`.fpv-month-view .day-cell[data-date="${dateStr}"]`);
              if (cell) cell.classList.remove('day-is-selected');
              renderSelectedDates();
            }
          });

          tag.appendChild(removeBtn);
          tagsContainer.appendChild(tag);
        });
      }

      btnClear?.addEventListener('click', () => {
        selectedDates = [];
        document.querySelectorAll('.fpv-month-view .day-is-selected').forEach((c) => {
          c.classList.remove('day-is-selected');
        });
        renderSelectedDates();
      });
    }

    function setupFormSubmission() {
      const form = document.getElementById('agendaFormFpv') as HTMLFormElement | null;
      const modal = document.getElementById('resultModalFpv');
      const payloadPre = document.getElementById('resultPayloadFpv');
      const btnMailto = document.getElementById('btnMailtoFpv') as HTMLAnchorElement | null;
      const btnSmsModal = document.getElementById('btnSmsFpv') as HTMLAnchorElement | null;
      const btnCopy = document.getElementById('btnCopyFpv');

      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Sécurité honeypot OWASP OAT-007
        const hp = (document.getElementById('fpv_guard') as HTMLInputElement)?.value;
        if (hp && hp.trim().length > 0) {
          console.warn('[SECURITY] Bot trap déclenché sur formulaire FPV.');
          return;
        }

        // Sécurité temps d'interaction minimal
        const elapsed = (Date.now() - formMountedAt) / 1000;
        if (elapsed < 2.0) {
          alert('Soumission trop rapide. Veuillez vérifier votre saisie.');
          return;
        }

        const structure = (document.getElementById('fpvStructure') as HTMLInputElement).value.trim();
        const contact = (document.getElementById('fpvContact') as HTMLInputElement).value.trim();
        const email = (document.getElementById('fpvEmail') as HTMLInputElement).value.trim();
        const tel = (document.getElementById('fpvTel') as HTMLInputElement).value.trim();
        const dates = (document.getElementById('fpvDatesInput') as HTMLInputElement).value.trim();
        const prestation = (document.getElementById('fpvTypePrestation') as HTMLSelectElement).value;
        const vol = (document.getElementById('fpvTypeVol') as HTMLSelectElement).value;
        const livrable = (document.getElementById('fpvLivrable') as HTMLSelectElement).value;
        const lieu = (document.getElementById('fpvLieu') as HTMLInputElement).value.trim();
        const brief = (document.getElementById('fpvBrief') as HTMLTextAreaElement).value.trim();

        const recapText = [
          'DEMANDE DE DEVIS & TOURNAGE DRONE FPV',
          '======================================',
          `Structure / Société : ${structure}`,
          `Responsable Projet  : ${contact}`,
          `Email               : ${email}`,
          `Téléphone           : ${tel}`,
          `Date(s) envisagée(s): ${dates}`,
          `Prestation          : ${prestation}`,
          `Configuration de vol: ${vol}`,
          `Livrables / Rushes  : ${livrable}`,
          `Lieu du tournage    : ${lieu}`,
          '--------------------------------------',
          'BRIEF & CAHIER DES CHARGES :',
          brief,
          '======================================',
          'Transmis via le portail fpv.tom-bigot.fr'
        ].join('\n');

        if (payloadPre) payloadPre.textContent = recapText;

        const mailtoSubject = encodeURIComponent(`[DEVIS FPV] ${structure} — ${dates}`);
        const mailtoBody = encodeURIComponent(recapText);
        const mailtoUrl = `mailto:contact@tom-bigot.fr?subject=${mailtoSubject}&body=${mailtoBody}`;

        if (btnMailto) {
          btnMailto.href = mailtoUrl;
        }

        const smsBrief = encodeURIComponent(`Bonjour Tom, devis FPV ${structure} pour le(s) ${dates} (${prestation} à ${lieu}). Peux-tu me confirmer ?`);
        if (btnSmsModal) {
          btnSmsModal.href = `sms:?body=${smsBrief}`;
        }

        if (modal) {
          modal.style.display = 'block';
          modal.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });

      btnCopy?.addEventListener('click', async () => {
        if (!payloadPre || !payloadPre.textContent) return;
        try {
          await navigator.clipboard.writeText(payloadPre.textContent);
          btnCopy.textContent = 'Copié dans le presse-papier !';
          setTimeout(() => {
            btnCopy.textContent = 'Copier le texte dans le presse-papier';
          }, 3000);
        } catch {
