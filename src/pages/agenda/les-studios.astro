---
import Base from '../../layouts/Base.astro';
import { planningCinemaMois } from '../../data/planning';
---

<Base
  titre="Espace Dédié Cinémas Les Studios — Planning Cabines & Vacations"
  description="Portail officiel et exclusif de réservation de dates et vacations pour les Cinémas Les Studios (Tours, 7 écrans Art & Essai). Planifiez vos remplacements et projections cabine avec Tom Bigot."
>
  <main class="prose-screen dedicated-agenda-page">
    <!-- Header dédié Les Studios -->
    <header class="page-head dedicated-header">
      <div class="dedicated-badge-row">
        <span class="etiquette">CINÉMA ART &amp; ESSAI &bull; 7 SALLES &bull; TOURS</span>
        <span class="badge-partner">PORTAIL DÉDIÉ LES STUDIOS</span>
      </div>
      <h1 class="page-title">PLANNING CABINES &bull; LES STUDIOS</h1>
      <p class="page-subtitle">
        Planning exclusif pour la programmation et la régie cabine des Cinémas Les Studios (rue des Ursulines, Tours). Vos vacations 7 écrans et le suivi CFA sont affichés en clair ci-dessous.
      </p>
    </header>

    <!-- Carte d'accueil & Authentification Les Studios -->
    <section class="partner-auth-box">
      <div id="studiosAuthLoggedOut" class="auth-card">
        <div class="auth-icon">🏛️</div>
        <div class="auth-info">
          <div class="auth-status-tag">ACCÈS ÉTABLISSEMENT SÉCURISÉ</div>
          <h2>CINÉMAS LES STUDIOS &bull; TOURS</h2>
          <p>
            Saisissez votre code direction ou cabine pour déverrouiller vos créneaux et réserver vos prochaines vacations d'exploitation ou de remplacement.
          </p>
          <form id="studiosLoginForm" class="partner-login-form">
            <div class="input-row">
              <input
                type="password"
                id="studiosPasscode"
                placeholder="Code exploitant Les Studios..."
                autocomplete="current-password"
                required
              />
              <button type="submit" class="btn-noir">Déverrouiller l'espace &rarr;</button>
            </div>
            <div id="studiosFeedback" class="feedback-msg" style="display: none;"></div>
            <span class="demo-hint">💡 Code exploitant configuré : <code>STUDIOS</code></span>
          </form>
        </div>
      </div>

      <div id="studiosAuthLoggedIn" class="auth-card logged-in" style="display: none;">
        <div class="auth-icon">🏛️</div>
        <div class="auth-info">
          <div class="auth-status-tag active">SESSION ACTIVE &bull; CINÉMAS LES STUDIOS</div>
          <h2>CABINE 7 ÉCRANS CONNECTÉE</h2>
          <p>
            Vos vacations et séances confirmées pour les Studios ainsi que les périodes de formation CFA sont affichées en clair. Les créneaux du circuit itinérant (Ciné-Off) sont masqués pour respecter la confidentialité inter-établissements.
          </p>
          <div class="logged-actions">
            <a href="#formStudios" class="btn-noir">+ Poser une vacation cabine &darr;</a>
            <button type="button" id="btnStudiosLogout" class="btn-outline">Verrouiller la session ✕</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Barre d'outils et Légende -->
    <div class="agenda-toolbar">
      <div class="legend-grid">
        <div class="legend-item">
          <span class="legend-box box-libre"></span>
          <div class="legend-text">
            <strong>DISPONIBLE</strong>
            <span>Créneau ouvert pour Les Studios</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-studios"></span>
          <div class="legend-text">
            <strong>LES STUDIOS</strong>
            <span>Séance programmée dans vos salles</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-formation"></span>
          <div class="legend-text">
            <strong>CFA / FORMATION</strong>
            <span>Période d'apprentissage non mobilisable</span>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-box box-masked"></span>
          <div class="legend-text">
            <strong>AUTRE EXPLOITANT</strong>
            <span>Séance privée (circuit itinérant)</span>
          </div>
        </div>
      </div>

      <div class="month-selector-bar">
        <button type="button" id="btnPrevMonth" class="btn-outline btn-month">&larr; Mois précédent</button>
        <div class="current-month-display">
          <span class="etiquette">CABINES TOURS</span>
          <h2 id="calendarMonthTitle" class="month-heading">NOVEMBRE 2026</h2>
        </div>
        <button type="button" id="btnNextMonth" class="btn-outline btn-month">Mois suivant &rarr;</button>
      </div>
    </div>

    <!-- Calendriers Les Studios -->
    {planningCinemaMois.map((mois, indexMois) => (
      <section
        id={`studios-calendar-${indexMois}`}
        class={`calendar-card cinema-month-view ${indexMois === 0 ? 'is-active-month' : 'is-hidden-month'}`}
        data-month-index={indexMois}
        data-month-name={`${mois.nom.toUpperCase()} ${mois.annee}`}
      >
        <div class="calendar-grid">
          <div class="weekday-col">LUN</div>
          <div class="weekday-col">MAR</div>
          <div class="weekday-col">MER</div>
          <div class="weekday-col">JEU</div>
          <div class="weekday-col">VEN</div>
          <div class="weekday-col">SAM</div>
          <div class="weekday-col">DIM</div>

          {Array.from({ length: mois.decalageLundi }).map(() => (
            <div class="day-cell day-empty" aria-hidden="true"></div>
          ))}

          {mois.jours.map((item) => {
            const isLibre = item.statut === 'libre';
            const isStudios = item.ownerId === 'studios';
            const isCfa = item.ownerId === 'cfa';
            const isOther = !isLibre && !isStudios && !isCfa;

            return (
              <div
                class={`day-cell ${isLibre ? 'day-selectable' : (isStudios ? 'day-studios-active' : (isCfa ? 'day-cfa-active' : 'day-masked-grise'))}`}
                data-date={item.dateStr}
                data-owner={item.ownerId}
                data-detail={item.detail || ''}
                role={isLibre ? 'button' : 'region'}
                tabindex={isLibre ? '0' : '-1'}
              >
                <div class="day-topline">
                  <span class="day-number">{item.jour}</span>
                  {isLibre && <span class="tag-libre">+ Choisir</span>}
                  {isStudios && <span class="tag-studios">Studios</span>}
                  {isCfa && <span class="tag-cfa">CFA</span>}
                  {isOther && <span class="tag-masked">🔒 Occupé</span>}
                </div>
                <div class="day-body">
                  {isLibre && (
                    <>
                      <div class="day-title">Disponible Cabine</div>
                      <div class="day-desc">Ouvert à vos vacations</div>
                    </>
                  )}
                  {isStudios && (
                    <>
                      <div class="day-title">Les Studios</div>
                      <div class="day-desc">{item.detail}</div>
                    </>
                  )}
                  {isCfa && (
                    <>
                      <div class="day-title">CFA / Formation</div>
                      <div class="day-desc">{item.detail}</div>
                    </>
                  )}
                  {isOther && (
                    <>
                      <div class="day-title" style="color: #666666; font-style: italic;">🔒 Indisponible</div>
                      <div class="day-desc" style="color: #999999;">Créneau engagé (Autre salle)</div>
                    </>
                  )}
                </div>
                {isLibre && (
                  <div class="day-hint">
                    <span>Poser une vacation</span>
                  </div>
                )}
                {isStudios && (
                  <div class="day-hint" style="color: #000000; font-weight: 700;">
                    <span>Votre séance</span>
                  </div>
                )}
                {isCfa && (
                  <div class="day-hint" style="color: #444444;">
                    <span>Apprentissage</span>
                  </div>
                )}
                {isOther && (
                  <div class="day-hint" style="color: #777777;">
                    <span>🔒 Réservé tiers</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <!-- Panier de sélection de dates -->
    <div id="selectionBarStudios" class="selection-summary-bar" style="display: none;">
      <div class="selection-info">
        <span class="etiquette">VACATIONS SÉLECTIONNÉES</span>
        <div id="selectedStudiosDatesList" class="selected-tags-container"></div>
      </div>
      <div class="selection-actions">
        <button type="button" id="btnClearStudiosDates" class="btn-clear">Vider</button>
        <a href="#formStudios" class="btn-noir btn-jump-form">Finaliser la proposition &darr;</a>
      </div>
    </div>

    <!-- Formulaire dédié Les Studios -->
    <section id="formStudios" class="prose-card form-container">
      <div class="form-header">
        <span class="etiquette">CABINE PROJECTION &bull; 7 SALLES ART &amp; ESSAI</span>
        <h2>POSER DES DATES DE VACATION &bull; LES STUDIOS</h2>
        <p class="form-intro">
          Formulaire pré-configuré pour la direction et la régie des <strong>Cinémas Les Studios</strong>. Précisez les salles, le type de vacation et les films programmés.
        </p>
      </div>

      <form id="agendaFormStudios" class="styled-agenda-form">
        <!-- Honeypot anti-bot OWASP OAT-007 -->
        <div class="hp-field-guard" aria-hidden="true" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none; width: 0; height: 0; overflow: hidden;">
          <label for="studios_guard">Ne pas remplir</label>
          <input type="text" id="studios_guard" name="studios_guard" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-grid-fields">
          <div class="form-field">
            <label for="studiosStructure"><strong>ÉTABLISSEMENT *</strong></label>
            <input type="text" id="studiosStructure" name="studiosStructure" value="Cinémas Les Studios (Tours)" readonly required />
          </div>

          <div class="form-field">
            <label for="studiosContact"><strong>RESPONSABLE CABINE / DIRECTION *</strong></label>
            <input type="text" id="studiosContact" name="studiosContact" placeholder="Ex : Philippe D." required />
          </div>

          <div class="form-field">
            <label for="studiosEmail"><strong>EMAIL PROFESSIONNEL *</strong></label>
            <input type="email" id="studiosEmail" name="studiosEmail" value="cabine@cinemas-lesstudios.fr" required />
          </div>

          <div class="form-field">
            <label for="studiosTel"><strong>TÉLÉPHONE DIRECT CABINE</strong></label>
            <input type="tel" id="studiosTel" name="studiosTel" placeholder="Ex : 02 47 20 XX XX" />
          </div>

          <div class="form-field full-width">
            <label for="studiosDatesInput"><strong>DATE(S) CABINE SÉLECTIONNÉE(S) *</strong></label>
            <input type="text" id="studiosDatesInput" name="studiosDatesInput" placeholder="Cliquez sur les dates disponibles ci-dessus..." required />
          </div>

          <div class="form-field">
            <label for="studiosTypeVacation"><strong>TYPE DE VACATION CABINE *</strong></label>
            <select id="studiosTypeVacation" name="studiosTypeVacation" required>
              <option value="Soirée (18h00 - 23h30)">Soirée (18h00 - 23h30)</option>
              <option value="Après-midi + Soirée (13h45 - 23h30)">Après-midi + Soirée (13h45 - 23h30)</option>
              <option value="Après-midi seule (13h45 - 18h00)">Après-midi seule (13h45 - 18h00)</option>
              <option value="Matinée scolaire / Débat (08h30 - 12h30)">Matinée scolaire / Débat (08h30 - 12h30)</option>
              <option value="Journée continue (Week-end / Sortie)">Journée continue (Week-end affluence)</option>
              <option value="Remplacement d'urgence / Imprévu">Remplacement d'urgence / Imprévu</option>
            </select>
          </div>

          <div class="form-field">
            <label for="studiosFormat"><strong>SALLE &amp; FORMAT PROJECTION</strong></label>
            <select id="studiosFormat" name="studiosFormat">
              <option value="Numérique DCI standard (Barco/Christie)">Numérique DCI standard (Barco/Christie 2K/4K)</option>
              <option value="Salles 1 à 7 — Multi-écrans">Supervision multi-salles (Salles 1 à 7)</option>
              <option value="Séance 35mm Argentique (Plateau)">Séance 35mm Argentique (Montage bobines)</option>
              <option value="DCI + Régie Débat / Rencontre réalisateur">DCI + Rencontre / Débat micro HF</option>
            </select>
          </div>

          <div class="form-field full-width">
            <label for="studiosNotes"><strong>TITRES DES FILMS &amp; PARTICULARITÉS TECHNIQUES</strong></label>
            <textarea id="studiosNotes" name="studiosNotes" rows="4" placeholder="Précisez les films au programme, les numéros de salle, les livraisons KDM ou instructions particulières..."></textarea>
          </div>
        </div>

        <div class="form-footer">
          <button type="submit" class="btn-noir btn-submit">Transmettre la proposition aux Studios &rarr;</button>
          <p class="form-notice">Une copie structurée est envoyée immédiatement à Tom Bigot.</p>
        </div>

        <div id="confirmationBoxStudios" class="confirmation-box" style="display: none;">
          <h3>DEMANDE DE CABINE TRANSMISE</h3>
          <p id="confirmationMessageStudios"></p>
          <a href="#" id="mailtoFallbackStudios" class="btn-outline btn-inline">Ouvrir dans votre messagerie &rarr;</a>
        </div>
      </form>
    </section>
  </main>
</Base>

<script>
  // Configuration cryptographique et hashes Les Studios (OWASP Level 3)
  const STUDIOS_SALT = 'TOM_BIGOT_CABINE_SECURE_SALT_2026';
  const STUDIOS_HASHES = [
    '71dcac5fc68cf19e3e55263e65d0da7d4e0bead25468a6d0a6de4c1872b76023', // STUDIOS
    '39a0708cb568c328504d1420bc90735e7e06cd51cc5eabacdef56ab4989a670a', // STUDIOS-TOURS
    'f3a656bbb7f5a99e6f670d8fc2e33c5a7567cb77d2baf0bb6df7a3b63d092e0a', // STUDIOS2026
    '2cdc06aac3c34a14671b8b28269bd08648a24db9ca24ce85e1d0876e407eb9ce', // LESSTUDIOS
    'c360eb6c1eb6dfaa21905cfd09e9581da8c73fa5db1423832568481809a6a084', // CINE1
    '707d7d71300e0c25336fea1eaf69bee99a89db9684bcdf97da641d8ffff2fde2'  // TOM-2026
  ];

  function constantTimeEqual(a: string, b: string): boolean {
    if (a.length !== b.length) return false;
    let diff = 0;
    for (let i = 0; i < a.length; i++) {
      diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
    }
    return diff === 0;
  }

  async function hashInput(pass: string): Promise<string> {
    const encoder = new TextEncoder();
    const data = encoder.encode(pass.trim().toUpperCase() + ':' + STUDIOS_SALT);
    const hashBuffer = await window.crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(hashBuffer)).map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  const authLoggedOut = document.getElementById('studiosAuthLoggedOut');
  const authLoggedIn = document.getElementById('studiosAuthLoggedIn');
  const loginForm = document.getElementById('studiosLoginForm') as HTMLFormElement | null;
  const inputPass = document.getElementById('studiosPasscode') as HTMLInputElement | null;
  const feedback = document.getElementById('studiosFeedback');
  const btnLogout = document.getElementById('btnStudiosLogout');

  function unlockStudios() {
    sessionStorage.setItem('tom_studios_auth', '1');
    if (authLoggedOut) authLoggedOut.style.display = 'none';
    if (authLoggedIn) authLoggedIn.style.display = 'block';
  }

  function lockStudios() {
    sessionStorage.removeItem('tom_studios_auth');
    if (authLoggedIn) authLoggedIn.style.display = 'none';
    if (authLoggedOut) authLoggedOut.style.display = 'block';
    if (inputPass) inputPass.value = '';
  }

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const val = (inputPass?.value || '').trim();
    if (!val) return;

    const hash = await hashInput(val);
    let match = false;
    for (const h of STUDIOS_HASHES) {
      if (constantTimeEqual(h, hash)) {
        match = true;
        break;
      }
    }

    if (match) {
      unlockStudios();
    } else {
      if (feedback) {
        feedback.style.display = 'block';
        feedback.textContent = 'Code exploitant Les Studios incorrect.';
      }
    }
  });

  btnLogout?.addEventListener('click', lockStudios);

  if (sessionStorage.getItem('tom_studios_auth') === '1') {
    unlockStudios();
  }

  // Navigation mois
  const monthViews = document.querySelectorAll('.cinema-month-view');
  const btnPrev = document.getElementById('btnPrevMonth') as HTMLButtonElement | null;
  const btnNext = document.getElementById('btnNextMonth') as HTMLButtonElement | null;
  const monthTitle = document.getElementById('calendarMonthTitle');
  let currentMonth = 0;

  function showMonth(idx: number) {
    monthViews.forEach((v, i) => {
      if (i === idx) {
        v.classList.remove('is-hidden-month');
        v.classList.add('is-active-month');
        const name = v.getAttribute('data-month-name');
        if (monthTitle && name) monthTitle.textContent = name;
      } else {
        v.classList.add('is-hidden-month');
        v.classList.remove('is-active-month');
      }
    });
    if (btnPrev) btnPrev.disabled = idx === 0;
    if (btnNext) btnNext.disabled = idx === monthViews.length - 1;
  }

  if (btnPrev && btnNext) {
    showMonth(0);
    btnPrev.addEventListener('click', () => { if (currentMonth > 0) { currentMonth--; showMonth(currentMonth); } });
    btnNext.addEventListener('click', () => { if (currentMonth < monthViews.length - 1) { currentMonth++; showMonth(currentMonth); } });
  }

  // Sélection des dates disponibles
  const selectedDates = new Set<string>();
  const selectionBar = document.getElementById('selectionBarStudios');
  const listDates = document.getElementById('selectedStudiosDatesList');
  const inputDates = document.getElementById('studiosDatesInput') as HTMLInputElement | null;
  const btnClear = document.getElementById('btnClearStudiosDates');

  function updateSelection() {
    if (!selectionBar || !listDates || !inputDates) return;
    listDates.replaceChildren();

    if (selectedDates.size === 0) {
      selectionBar.style.display = 'none';
      inputDates.value = '';
      return;
    }

    selectionBar.style.display = 'flex';
    const sorted = Array.from(selectedDates).sort();
    inputDates.value = sorted.join(', ');

    sorted.forEach((d) => {
      const pill = document.createElement('span');
      pill.className = 'date-pill-selected';
      const strong = document.createElement('strong');
      strong.textContent = d;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '×';
      btn.setAttribute('aria-label', `Retirer ${d}`);
      btn.addEventListener('click', (ev) => {
        ev.stopPropagation();
        selectedDates.delete(d);
        document.querySelectorAll(`.day-selectable[data-date="${d}"]`).forEach((c) => c.classList.remove('day-selected'));
        updateSelection();
      });
      pill.append(strong, btn);
      listDates.appendChild(pill);
    });
  }

  document.querySelectorAll('.day-selectable').forEach((cell) => {
    cell.addEventListener('click', () => {
      const date = cell.getAttribute('data-date');
      if (!date) return;
      if (selectedDates.has(date)) {
        selectedDates.delete(date);
        cell.classList.remove('day-selected');
      } else {
        selectedDates.add(date);
        cell.classList.add('day-selected');
      }
      updateSelection();
    });
  });

  document.querySelectorAll('.day-masked-grise').forEach((cell) => {
    cell.addEventListener('click', () => {
      const date = cell.getAttribute('data-date');
      alert(`Date indisponible (${date}) :\nCe créneau est déjà réservé par un autre exploitant.\nPar respect de la confidentialité professionnelle, les détails sont masqués.`);
    });
  });

  btnClear?.addEventListener('click', () => {
    selectedDates.clear();
    document.querySelectorAll('.day-selectable').forEach((c) => c.classList.remove('day-selected'));
    updateSelection();
  });

  // Soumission et anti-bot
  const pageLoadedAt = Date.now();
  const form = document.getElementById('agendaFormStudios') as HTMLFormElement | null;
  const confBox = document.getElementById('confirmationBoxStudios');
  const confMsg = document.getElementById('confirmationMessageStudios');
  const mailtoBtn = document.getElementById('mailtoFallbackStudios') as HTMLAnchorElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const guard = data.get('studios_guard');
    if (guard && String(guard).trim() !== '') return;
    if (Date.now() - pageLoadedAt < 2000) {
      alert('Veuillez patienter 2 secondes avant de soumettre le formulaire.');
      return;
    }

    const contact = ((data.get('studiosContact') as string) || '').replace(/[\r\n]+/g, ' ').trim();
    const email = ((data.get('studiosEmail') as string) || '').replace(/[\r\n]+/g, ' ').trim();
    const tel = ((data.get('studiosTel') as string) || 'Non renseigné').replace(/[\r\n]+/g, ' ').trim();
    const dates = ((data.get('studiosDatesInput') as string) || '').replace(/[\r\n]+/g, ' ').trim();
    const vacation = (data.get('studiosTypeVacation') as string) || '';
    const format = (data.get('studiosFormat') as string) || '';
    const notes = ((data.get('studiosNotes') as string) || 'Aucune').replace(/\r/g, '').trim();

    const sujet = encodeURIComponent(`[CABINE LES STUDIOS] Proposition de dates — ${dates}`);
    const corps = encodeURIComponent(
      `Bonjour Tom,\n\nUne nouvelle proposition de dates cabine vient d'être formulée depuis l'espace dédié Les Studios :\n\n` +
      `• Établissement : Cinémas Les Studios (Tours)\n` +
      `• Responsable : ${contact}\n` +
      `• Email direct : ${email}\n` +
      `• Téléphone cabine : ${tel}\n\n` +
      `DÉTAILS DES VACATIONS :\n` +
      `• Date(s) cabine : ${dates}\n` +
      `• Type de vacation : ${vacation}\n` +
      `• Salles & Configuration : ${format}\n\n` +
      `Films au programme & Notes d'exploitation :\n${notes}\n\n` +
      `---\nTransmis depuis l'espace dédié studios.tom-bigot.fr`
    );

    const mailtoUrl = `mailto:contact@tom-bigot.fr?subject=${sujet}&body=${corps}`;

    if (confBox && confMsg) {
      confBox.style.display = 'block';
      confMsg.textContent = `Votre demande de vacation sur les dates (${dates}) pour Les Studios a été préparée et transmise à Tom Bigot.`;
      if (mailtoBtn) mailtoBtn.href = mailtoUrl;
      confBox.scrollIntoView({ behavior: 'smooth' });
    }
    window.location.href = mailtoUrl;
  });
</script>

<style>
  .dedicated-agenda-page {
    max-width: 1060px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 56px) clamp(16px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .dedicated-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .badge-partner {
    font: 700 11px var(--font);
    letter-spacing: 0.1em;
    background: #000000;
    color: #ffffff;
    padding: 3px 10px;
    text-transform: uppercase;
  }

  .page-title {
    margin: 6px 0 10px;
    font: 700 clamp(28px, 4.5vw, 42px)/1.1 var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .page-subtitle {
    margin: 0;
    font: 400 14px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.75);
