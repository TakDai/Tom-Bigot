---
import { planningCinemaMois } from '../../data/planning';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Cinémas Les Studios — Planning Cabines 7 Écrans</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    @font-face {
      font-family: 'Glacial Indifference';
      src: url('/fonts/glacial-indifference-400.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Glacial Indifference';
      src: url('/fonts/glacial-indifference-700.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --font-main: 'Glacial Indifference', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-main);
      background: #ffffff;
      color: #000000;
      line-height: 1.4;
      padding: 1.5rem 1rem 5rem 1rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    /* En-tête : UNIQUEMENT LE LOGO */
    .org-pure-header {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1.5rem 0 2rem 0;
      border-bottom: 2px solid #000000;
      margin-bottom: 2rem;
    }

    .org-logo-img {
      max-width: 340px;
      width: 100%;
      height: auto;
      display: block;
    }

    /* Barre de navigation du mois */
    .month-nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      border: 2px solid #000000;
      background: #fafafa;
      margin-bottom: 1.5rem;
    }

    .month-nav-btn {
      background: #ffffff;
      border: 2px solid #000000;
      font-family: var(--font-main);
      font-size: 0.9rem;
      font-weight: 700;
      padding: 0.5rem 1rem;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .month-nav-btn:hover:not(:disabled) {
      background: #000000;
      color: #ffffff;
    }

    .month-nav-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .current-month-label {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    /* Légende épurée */
    .pure-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      justify-content: center;
      margin-bottom: 1.5rem;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .legend-bullet {
      width: 14px;
      height: 14px;
      border: 1px solid #000000;
      display: inline-block;
    }

    .bullet-dispo {
      background: #ffffff;
      border: 2px solid #000000;
    }

    .bullet-studios {
      background: #000000;
    }

    .bullet-cfa {
      background: #555555;
    }

    .bullet-masked {
      background: #ebebeb;
      border-color: #888888;
    }

    /* Grille Calendrier */
    .calendar-container {
      border: 2px solid #000000;
      background: #ffffff;
      box-shadow: 4px 4px 0px #000000;
      margin-bottom: 2rem;
    }

    .calendar-container.is-hidden {
      display: none;
    }

    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      background: #000000;
      gap: 1px;
    }

    .weekday-header {
      background: #000000;
      color: #ffffff;
      text-align: center;
      padding: 0.65rem 0.25rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .calendar-cell {
      background: #ffffff;
      min-height: 115px;
      padding: 0.6rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .cell-empty {
      background: #f7f7f7;
    }

    .cell-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      margin-bottom: 0.35rem;
    }

    .cell-number {
      font-size: 1rem;
      font-weight: 800;
    }

    .tag-state {
      font-size: 0.62rem;
      font-weight: 700;
      padding: 0.15rem 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .tag-open {
      background: #000000;
      color: #ffffff;
    }

    .tag-booked {
      background: #000000;
      color: #ffffff;
    }

    .tag-cfa {
      background: #555555;
      color: #ffffff;
    }

    .tag-masked {
      background: #888888;
      color: #ffffff;
    }

    .cell-body {
      flex: 1;
      font-size: 0.76rem;
      line-height: 1.25;
    }

    .cell-title {
      font-weight: 800;
      margin-bottom: 0.15rem;
    }

    .cell-detail {
      color: #555555;
      font-size: 0.72rem;
    }

    .cell-footer-hint {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: #666666;
      border-top: 1px dashed #dddddd;
      padding-top: 0.25rem;
      margin-top: 0.35rem;
      text-transform: uppercase;
    }

    /* Interactions */
    .cell-selectable {
      cursor: pointer;
      transition: background 0.1s ease;
    }

    .cell-selectable:hover {
      background: #f4f4f4;
    }

    .cell-is-selected {
      background: #000000 !important;
      color: #ffffff !important;
    }

    .cell-is-selected .cell-detail,
    .cell-is-selected .cell-footer-hint {
      color: #cccccc !important;
    }

    .cell-is-selected .tag-open {
      background: #ffffff;
      color: #000000;
    }

    .cell-is-studios {
      border-left: 4px solid #000000;
      background: #fafafa;
    }

    .cell-is-cfa {
      border-left: 4px solid #555555;
      background: #fbfbfb;
    }

    .cell-is-masked {
      background: #eeeeee;
      color: #888888;
    }

    .cell-is-masked .cell-detail {
      color: #888888;
    }

    /* Barre d'action basse (flottante) */
    .floating-action-bar {
      position: fixed;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 2rem);
      max-width: 850px;
      background: #000000;
      color: #ffffff;
      border: 2px solid #ffffff;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      padding: 0.85rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      z-index: 100;
    }

    .action-bar-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .action-bar-label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #aaaaaa;
    }

    .selected-tags-wrap {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    .date-badge {
      background: #ffffff;
      color: #000000;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 800;
      padding: 0.2rem 0.5rem;
      border-radius: 2px;
    }

    .action-bar-btns {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .btn-action-sms {
      background: #ffffff;
      color: #000000;
      font-family: var(--font-main);
      font-size: 0.85rem;
      font-weight: 800;
      padding: 0.55rem 1rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: 2px solid #ffffff;
    }

    .btn-action-sms:hover {
      background: #e5e5e5;
    }

    .btn-action-mail {
      background: transparent;
      color: #ffffff;
      font-family: var(--font-main);
      font-size: 0.85rem;
      font-weight: 800;
      padding: 0.55rem 1rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: 2px solid #ffffff;
    }

    .btn-action-mail:hover {
      background: #ffffff;
      color: #000000;
    }

    .btn-reset-dates {
      background: transparent;
      border: none;
      color: #aaaaaa;
      font-size: 0.8rem;
      cursor: pointer;
      text-decoration: underline;
    }

    .btn-reset-dates:hover {
      color: #ffffff;
    }

    @media (max-width: 768px) {
      body {
        padding: 1rem 0.5rem 6rem 0.5rem;
      }
      .org-logo-img {
        max-width: 260px;
      }
      .calendar-grid {
        grid-template-columns: repeat(7, minmax(40px, 1fr));
      }
      .calendar-cell {
        min-height: 75px;
        padding: 0.3rem;
      }
      .cell-body {
        display: none;
      }
      .cell-footer-hint {
        display: none;
      }
      .floating-action-bar {
        flex-direction: column;
        align-items: stretch;
      }
      .action-bar-btns {
        justify-content: stretch;
      }
      .btn-action-sms, .btn-action-mail {
        flex: 1;
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <!-- EN-TÊTE : UNIQUEMENT LE LOGO DE L'ORGANISATION -->
  <header class="org-pure-header">
    <img src="/assets/logos/les-studios.svg" alt="Cinémas Les Studios — 7 Écrans Tours" class="org-logo-img" />
  </header>

  <!-- NAVIGATION DU MOIS -->
  <div class="month-nav-bar">
    <button type="button" id="btnPrev" class="month-nav-btn">&larr; Mois précédent</button>
    <div id="monthDisplay" class="current-month-label">NOVEMBRE 2026</div>
    <button type="button" id="btnNext" class="month-nav-btn">Mois suivant &rarr;</button>
  </div>

  <!-- LÉGENDE RAPIDE -->
  <div class="pure-legend">
    <div class="legend-item">
      <span class="legend-bullet bullet-dispo"></span>
      <span>Disponible</span>
    </div>
    <div class="legend-item">
      <span class="legend-bullet bullet-studios"></span>
      <span>Vacation Les Studios</span>
    </div>
    <div class="legend-item">
      <span class="legend-bullet bullet-cfa"></span>
      <span>Formation CFA</span>
    </div>
    <div class="legend-item">
      <span class="legend-bullet bullet-masked"></span>
      <span>Autre engagement</span>
    </div>
  </div>

  <!-- CALENDRIERS (AGENDA PUR) -->
  {planningCinemaMois.map((mois, indexMois) => (
    <div
      id={`cal-${indexMois}`}
      class={`calendar-container ${indexMois === 0 ? '' : 'is-hidden'}`}
      data-month-index={indexMois}
      data-month-name={`${mois.nom.toUpperCase()} ${mois.annee}`}
    >
      <div class="calendar-grid">
        <div class="weekday-header">LUN</div>
        <div class="weekday-header">MAR</div>
        <div class="weekday-header">MER</div>
        <div class="weekday-header">JEU</div>
        <div class="weekday-header">VEN</div>
        <div class="weekday-header">SAM</div>
        <div class="weekday-header">DIM</div>

        {Array.from({ length: mois.decalageLundi }).map(() => (
          <div class="calendar-cell cell-empty" aria-hidden="true"></div>
        ))}

        {mois.jours.map((item) => {
          const isLibre = item.statut === 'libre';
          const isStudios = item.ownerId === 'studios';
          const isCfa = item.ownerId === 'cfa';
          const isOther = !isLibre && !isStudios && !isCfa;

          return (
            <div
              class={`calendar-cell ${isLibre ? 'cell-selectable' : (isStudios ? 'cell-is-studios' : (isCfa ? 'cell-is-cfa' : 'cell-is-masked'))}`}
              data-date={item.dateStr}
              role={isLibre ? 'button' : 'region'}
              tabindex={isLibre ? '0' : '-1'}
            >
              <div class="cell-top">
                <span class="cell-number">{item.jour}</span>
                {isLibre && <span class="tag-state tag-open">+ Choisir</span>}
                {isStudios && <span class="tag-state tag-booked">Studios</span>}
                {isCfa && <span class="tag-state tag-cfa">CFA</span>}
                {isOther && <span class="tag-state tag-masked">Occupé</span>}
              </div>

              <div class="cell-body">
                {isLibre && (
                  <>
                    <div class="cell-title">Disponible</div>
                    <div class="cell-detail">Ouvert aux vacations</div>
                  </>
                )}
                {isStudios && (
                  <>
                    <div class="cell-title">Les Studios</div>
                    <div class="cell-detail">{item.detail}</div>
                  </>
                )}
                {isCfa && (
                  <>
                    <div class="cell-title" style="color: #444;">Formation CFA</div>
                    <div class="cell-detail" style="color: #666;">{item.detail}</div>
                  </>
                )}
                {isOther && (
                  <>
                    <div class="cell-title" style="color: #888;">Occupé</div>
                    <div class="cell-detail" style="color: #999;">Autre exploitant</div>
                  </>
                )}
              </div>

              <div class="cell-footer-hint">
                {isLibre && <span>Cliquer pour poser</span>}
                {isStudios && <span>Vacation validée</span>}
                {isCfa && <span>Période école</span>}
                {isOther && <span>Indisponible</span>}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ))}

  <!-- BARRE FLOTTANTE EN CAS DE SÉLECTION -->
  <div id="selectionBar" class="floating-action-bar" style="display: none;">
    <div class="action-bar-info">
      <span class="action-bar-label">Dates sélectionnées :</span>
      <div id="selectedBadges" class="selected-tags-wrap"></div>
      <button type="button" id="btnReset" class="btn-reset-dates">Effacer</button>
    </div>

    <div class="action-bar-btns">
      <a id="btnSms" href="#" class="btn-action-sms">📱 Envoyer par SMS à Tom &rarr;</a>
      <a id="btnMail" href="#" class="btn-action-mail">✉️ Envoyer par Email &rarr;</a>
    </div>
  </div>

  <script>
    let currentMonth = 0;
    const selectedDates: string[] = [];

    const containers = document.querySelectorAll<HTMLElement>('.calendar-container');
    const labelMonth = document.getElementById('monthDisplay');
    const btnPrev = document.getElementById('btnPrev') as HTMLButtonElement | null;
    const btnNext = document.getElementById('btnNext') as HTMLButtonElement | null;

    function showMonth(idx: number) {
      containers.forEach((c, i) => {
        if (i === idx) {
          c.classList.remove('is-hidden');
          const name = c.getAttribute('data-month-name');
          if (labelMonth && name) labelMonth.textContent = name;
        } else {
          c.classList.add('is-hidden');
        }
      });
      if (btnPrev) btnPrev.disabled = idx === 0;
      if (btnNext) btnNext.disabled = idx === containers.length - 1;
    }

    btnPrev?.addEventListener('click', () => {
      if (currentMonth > 0) {
        currentMonth--;
        showMonth(currentMonth);
      }
    });

    btnNext?.addEventListener('click', () => {
      if (currentMonth < containers.length - 1) {
        currentMonth++;
        showMonth(currentMonth);
      }
    });

    showMonth(0);

    // Sélection des dates
    const bar = document.getElementById('selectionBar');
    const badgesWrap = document.getElementById('selectedBadges');
    const btnSms = document.getElementById('btnSms') as HTMLAnchorElement | null;
    const btnMail = document.getElementById('btnMail') as HTMLAnchorElement | null;
    const btnReset = document.getElementById('btnReset');

    document.querySelectorAll<HTMLElement>('.cell-selectable').forEach((cell) => {
      cell.addEventListener('click', () => {
        const d = cell.getAttribute('data-date');
        if (!d) return;

        const idx = selectedDates.indexOf(d);
        if (idx >= 0) {
          selectedDates.splice(idx, 1);
          cell.classList.remove('cell-is-selected');
        } else {
          selectedDates.push(d);
          selectedDates.sort();
          cell.classList.add('cell-is-selected');
        }
        updateBar();
      });
    });

    function updateBar() {
      if (!bar || !badgesWrap) return;

      if (selectedDates.length === 0) {
        bar.style.display = 'none';
        return;
      }

      bar.style.display = 'flex';
      badgesWrap.innerHTML = '';

      selectedDates.forEach((d) => {
        const span = document.createElement('span');
        span.className = 'date-badge';
        span.textContent = d;
        badgesWrap.appendChild(span);
      });

      const datesText = selectedDates.join(', ');
      const smsText = encodeURIComponent(`Bonjour Tom, voici les vacations cabine Les Studios pour le(s) : ${datesText}. Peux-tu nous confirmer la disponibilité ? Merci !`);
      const mailSub = encodeURIComponent(`[Les Studios] Demande de vacations : ${datesText}`);
      const mailBody = encodeURIComponent(`Bonjour Tom,\n\nVoici les vacations cabine envisagées pour Les Studios :\n${datesText}\n\nMerci de nous confirmer la prise en charge.\n\nDirection Les Studios`);

      if (btnSms) btnSms.href = `sms:?body=${smsText}`;
      if (btnMail) btnMail.href = `mailto:contact@tom-bigot.fr?subject=${mailSub}&body=${mailBody}`;
    }

    btnReset?.addEventListener('click', () => {
      selectedDates.length = 0;
      document.querySelectorAll('.cell-is-selected').forEach((c) => c.classList.remove('cell-is-selected'));
      updateBar();
    });
  </script>
</body>
</html>
