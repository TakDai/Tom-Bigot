---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.brouillon);
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { titre, description, date, tags, tempsLecture } = article.data;

function formaterDate(d: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(d);
}
---

<Base titre={titre} description={description}>
  <main class="prose-screen">
    <div class="retour-bar">
      <a href="/blog" class="nav-pill">&larr; Tous les articles</a>
    </div>

    <header class="page-head article-head">
      <div class="article-meta-row">
        <span class="article-date">{formaterDate(date)}</span>
        {tempsLecture && (
          <>
            <span class="meta-sep">&bull;</span>
            <span class="article-lecture">{tempsLecture} de lecture</span>
          </>
        )}
      </div>

      <h1 class="page-title">{titre}</h1>
      <p class="page-subtitle">{description}</p>

      {tags && tags.length > 0 && (
        <div class="tags-row">
          {tags.map((t) => (
            <span class="domaine-pill">{t}</span>
          ))}
        </div>
      )}
    </header>

    <article class="prose-card article-contenu">
      <Content />
    </article>

    <div class="actions-fin">
      <a href="/blog" class="nav-pill">&larr; Retour aux articles du blog</a>
      <a href="/contact" class="btn-noir">Échanger à propos de cet article &rarr;</a>
    </div>
  </main>
</Base>

<style>
  .prose-screen {
    flex: 1;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 48px) clamp(16px, 4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .retour-bar {
    display: flex;
    align-items: center;
  }

  .article-head {
    border-bottom: 2px dashed var(--dash);
    padding-bottom: 24px;
  }

  .article-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font: 700 11px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
  }

  .meta-sep {
    opacity: 0.4;
  }

  .page-title {
    margin: 6px 0 12px;
    font: 700 clamp(26px, 5vw, 38px)/1.18 var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-subtitle {
    margin: 0 0 16px;
    font: 400 15px/1.6 var(--font);
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.8);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .domaine-pill {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border: 1px dashed var(--dash);
    border-radius: 11px;
    font: 700 9px var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
    background: #fafafa;
  }

  .prose-card {
    border: 2px dashed var(--dash);
    border-radius: 12px;
    padding: clamp(24px, 4vw, 36px);
    background: var(--paper);
  }

  .article-contenu :global(h2) {
    margin: 28px 0 12px;
    font: 700 clamp(18px, 3.5vw, 22px)/1.25 var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 2px dashed rgba(0, 0, 0, 0.2);
    padding-bottom: 8px;
  }

  .article-contenu :global(h3) {
    margin: 20px 0 10px;
    font: 700 16px/1.3 var(--font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-contenu :global(p) {
    margin: 0 0 16px;
    font: 400 14px/1.7 var(--font);
    color: rgba(0, 0, 0, 0.85);
  }

  .article-contenu :global(ul),
  .article-contenu :global(ol) {
    margin: 0 0 16px;
    padding-left: 20px;
    font: 400 14px/1.7 var(--font);
    color: rgba(0, 0, 0, 0.85);
  }

  .article-contenu :global(li) {
    margin-bottom: 6px;
  }

  .article-contenu :global(pre) {
    border: 2px dashed var(--dash);
    border-radius: 8px;
    padding: 16px;
    background: #fafafa !important;
    overflow-x: auto;
    font-size: 13px;
    margin: 20px 0;
  }

  .article-contenu :global(code) {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.9em;
  }

  .article-contenu :global(p code) {
    background: #f1f1f1;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .actions-fin {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
</style>
