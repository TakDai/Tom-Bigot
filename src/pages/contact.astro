---
import Base from '../layouts/Base.astro';
---

<Base titre="Contact">
  <section class="conteneur page">
    <p class="etiquette">Contact</p>
    <h1>Parlons-en.</h1>
    <!-- À COMPLÉTER : adresse de contact, réseaux (Twitch 127IL, etc.). -->
    <p class="chapo discret">Coordonnées à compléter.</p>
  </section>
</Base>

<style>
  .page { padding-top: var(--espace); max-width: 46rem; }
  h1 { margin: 0.5rem 0 1.5rem; font-size: clamp(2.25rem, 6vw, 4rem); }
  .chapo { font-size: 1.25rem; }
</style>
