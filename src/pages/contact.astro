---
import Base from '../layouts/Base.astro';
---

<Base titre="Contact" description="Prendre contact avec Tom Bigot — projets, collaborations et échanges techniques.">
  <main class="prose-screen">
    <header class="page-head">
      <span class="etiquette">COMMUNICATION &bull; COLLABORATION</span>
      <h1 class="page-title">PARLONS-EN</h1>
      <p class="page-subtitle">
        Un projet à développer, un défi technique à relever, ou simplement l’envie d’échanger autour du code, de l’embarqué
        ou des infrastructures autonomes ?
      </p>
    </header>

    <div class="grille-contacts">
      <!-- Email -->
      <a class="carte-seeworld-contact" href="mailto:contact@tom-bigot.fr">
        <span class="carte-ext">↗</span>
        <span class="etiquette">Email Direct</span>
        <h2 class="contact-titre">contact@tom-bigot.fr</h2>
        <p class="contact-desc">Le moyen le plus simple et rapide pour toute proposition, projet ou échange technique.</p>
      </a>

      <!-- GitHub -->
      <a class="carte-seeworld-contact" href="https://github.com/TakDai" target="_blank" rel="noopener noreferrer">
        <span class="carte-ext">↗</span>
        <span class="etiquette">Open Source</span>
        <h2 class="contact-titre">GitHub &bull; @TakDai</h2>
        <p class="contact-desc">Retrouvez l’ensemble des dépôts, contributions publiques et projets en cours de l’écosystème.</p>
      </a>

      <!-- seeworld -->
      <a class="carte-seeworld-contact" href="https://seeworld.fr" target="_blank" rel="noopener">
        <span class="carte-ext">↗</span>
        <span class="etiquette">Collectif</span>
        <h2 class="contact-titre">SEEWORLD.FR</h2>
        <p class="contact-desc">Portail central et vitrine des initiatives, projets web, drones et plateformes communautaires.</p>
      </a>
    </div>

    <!-- Disponibilité -->
    <article class="prose-card">
      <h2>DISPONIBILITÉ & ENGAGEMENT</h2>
      <p>
        Je suis réactif par courrier électronique. Je réponds à toutes les sollicitations sérieuses concernant le développement
        sur-mesure, l’ingénierie technique, les partenariats open-source et les défis matériels/embarqués.
      </p>
    </article>

    <div class="actions-row">
      <a href="mailto:contact@tom-bigot.fr" class="btn-noir">Écrire un email</a>
      <a href="/" class="nav-pill">&larr; Retour à l'accueil</a>
    </div>
  </main>
</Base>

<style>
  .prose-screen {
    flex: 1;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(32px, 5vh, 64px) clamp(16px, 4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .page-head {
    border-bottom: 2px dashed var(--dash);
    padding-bottom: 24px;
  }

  .page-title {
    margin: 6px 0 12px;
    font: 700 clamp(30px, 5vw, 44px)/1.1 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-subtitle {
    margin: 0;
    font: 400 14px/1.6 var(--font);
    letter-spacing: 0.03em;
    color: rgba(0, 0, 0, 0.75);
  }

  .grille-contacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  .carte-seeworld-contact {
    display: flex;
    flex-direction: column;
    padding: 22px 20px 18px;
    border: 2px dashed var(--dash);
    border-radius: 12px;
    background: var(--paper);
    text-decoration: none;
    position: relative;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s ease,
                border-style 0.2s ease,
                box-shadow 0.2s ease;
  }

  .carte-seeworld-contact:hover {
    transform: translateY(-4px);
    border-style: solid;
    border-color: var(--ink);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .carte-ext {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 13px;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.35);
    transition: color 0.2s, transform 0.2s;
  }

  .carte-seeworld-contact:hover .carte-ext {
    color: var(--ink);
    transform: translate(1px, -1px);
  }

  .contact-titre {
    margin: 6px 0 8px;
    font: 700 16px/1.2 var(--font);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .contact-desc {
    margin: 0;
    font: 400 13px/1.55 var(--font);
    color: rgba(0, 0, 0, 0.75);
  }

  .prose-card {
    border: 2px dashed var(--dash);
    border-radius: 12px;
    padding: clamp(20px, 3vw, 28px);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prose-card h2 {
    margin: 0;
    font: 700 15px/1.3 var(--font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .prose-card h2::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--ink);
  }

  .prose-card p {
    margin: 0;
    font: 400 13px/1.6 var(--font);
    color: rgba(0, 0, 0, 0.85);
  }

  .actions-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
</style>
