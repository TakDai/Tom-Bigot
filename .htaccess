# ==============================================================================
# SÉCURITÉ ET CONFORMITÉ STRICTE OWASP ASVS LEVEL 3 — TOM-BIGOT.FR
# ==============================================================================

# 1. Gestion des erreurs HTTP personnalisées (A05:2021 Security Misconfiguration)
ErrorDocument 400 /404.html
ErrorDocument 401 /404.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# 2. Durcissement du serveur (A01:2021 & A05:2021)
ServerSignature Off
Options -Indexes -MultiViews -ExecCGI
AddDefaultCharset UTF-8

# 3. Restriction stricte des méthodes HTTP (Interdiction de TRACE, TRACK, DEBUG)
<LimitExcept GET POST HEAD>
  Require all denied
</LimitExcept>

# 4. Protection des fichiers cachés et sensibles (A01:2021 Broken Access Control)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Interdiction d'accès aux fichiers sources, logs, sauvegardes et configurations
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env|yaml|yml|jsonl|md|lock|ts|tsx))$">
  Require all denied
</FilesMatch>

# Exception explicite pour le fichier security.txt (RFC 9116)
<Files "security.txt">
  Require all granted
</Files>

# 5. En-têtes HTTP de Sécurité Avancés (OWASP Top 10 & ASVS Level 3)
<IfModule mod_headers.c>
  # HSTS : Forcer HTTPS pendant 1 an avec sous-domaines et preload (A02:2021 Cryptographic Failures)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Protection Anti-Clickjacking (A04:2021 Insecure Design)
  Header always set X-Frame-Options "DENY"

  # Protection contre le MIME Sniffing (A05:2021 Security Misconfiguration)
  Header always set X-Content-Type-Options "nosniff"

  # Politique de Referrer stricte (Confidentialité des URL)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Content Security Policy (A03:2021 Injection / XSS — Aucun domaine externe autorisé)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self' mailto: sms:; base-uri 'self'; object-src 'none';"

  # Permissions-Policy : Autorisation autoplay pour nos vidéos internes, désactivation des API intrusives
  Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()"

  # Isolation d'origine (Spectre / Cross-Origin Attacks)
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "unsafe-none"

  # Protection contre l'exécution de téléchargements arbitraires
  Header always set X-Download-Options "noopen"

  # Restriction stricte des politiques multi-domaines Flash/PDF (A05:2021)
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # Masquer les informations logicielles serveur (Anti-Fingerprinting)
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# 6. Règles de Réécriture, Pare-Feu Applicatif (WAF) et Sous-domaines
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 6.1 Filtrage WAF : Blocage des scanners de vulnérabilités et robots malveillants connus (OAT-014)
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|dirbuster|acunetix|masscan|havij|nmap|zgrab|morfeus|nessus|nuclei|gobuster|ffuf|wpscan|whatweb|openvas|arachni|skipfish|censys|shodan|projectdiscovery|qualys) [NC]
  RewriteRule .* - [F,L]

  # 6.2 Filtrage WAF : Injection de commandes, Path Traversal, Null byte et RFI (A03:2021)
  RewriteCond %{QUERY_STRING} (?:[<>]|%3C|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (?:script|javascript:) [NC,OR]
  RewriteCond %{QUERY_STRING} (%00|%08|%09) [NC,OR]
  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC,OR]
  RewriteCond %{QUERY_STRING} (cmd\.exe|/bin/sh|/bin/bash|wget|curl|eval\(|base64_decode) [NC,OR]
  RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd|windows/win\.ini) [NC]
  RewriteRule .* - [F,L]

  # 6.3 Blocage des sondes de reconnaissance (fichiers cachés, dépôts git, CMS, admin panels)
  RewriteCond %{REQUEST_URI} ^/(?:\.git|\.env|\.svn|\.hg|\.bzr|wp-admin|wp-login\.php|phpmyadmin|pma|actuator|swagger|api-docs|cgi-bin|autodiscover|\.vscode|\.idea|docker-compose\.ya?ml) [NC]
  RewriteRule .* - [F,L]

  # 6.4 Protection contre le Request Smuggling et en-têtes malformés
  RewriteCond %{HTTP:Transfer-Encoding} !^$
  RewriteRule .* - [F,L]

  # 6.5 Protection contre l'usurpation d'en-tête Host (Anti-Host Header Poisoning)
  RewriteCond %{HTTP_HOST} !^([a-z0-9-]+\.)*tom-bigot\.fr$ [NC]
  RewriteRule .* - [F,L]

  # 6.6 Forcer HTTPS pour toute requête non sécurisée (A02:2021)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 6.4 Sous-domaines Organisation : Ciné-Off -> Page dédiée exclusive
  RewriteCond %{HTTP_HOST} ^(cine-off|cineoff|xn--cin-off-cya)\.tom-bigot\.fr$ [NC]
  RewriteRule ^$ /agenda/cine-off/ [R=302,L]

  # 6.5 Sous-domaines Organisation : Cinémas Les Studios -> Page dédiée exclusive
  RewriteCond %{HTTP_HOST} ^(studios|les-studios|lesstudios)\.tom-bigot\.fr$ [NC]
  RewriteRule ^$ /agenda/les-studios/ [R=302,L]

  # 6.6 Sous-domaine Organisation : Administration / Superviseur -> Console dédiée
  RewriteCond %{HTTP_HOST} ^(admin|superviseur)\.tom-bigot\.fr$ [NC]
  RewriteRule ^$ /agenda/admin/ [R=302,L]

  # 6.7 Sous-domaines Drone FPV & Devis -> Portail devis & tournage dédié
  RewriteCond %{HTTP_HOST} ^(fpv|drone)\.tom-bigot\.fr$ [NC]
  RewriteRule ^$ /agenda/fpv/ [R=302,L]

  # 6.8 Sous-domaines Génériques Cabine Cinéma (cine.tom-bigot.fr & cinema.tom-bigot.fr)
  RewriteCond %{HTTP_HOST} ^(cine|cinema)\.tom-bigot\.fr$ [NC]
  RewriteRule ^$ /agenda#agenda-cinema [R=302,NE,L]

  # 6.9 Sous-domaine Développement (dev.tom-bigot.fr)
  RewriteCond %{HTTP_HOST} ^dev\.tom-bigot\.fr$ [NC]
  RewriteRule ^$ /developpement/ [R=302,L]

  # 6.10 Sous-domaine Agenda général (agenda.tom-bigot.fr)
  RewriteCond %{HTTP_HOST} ^agenda\.tom-bigot\.fr$ [NC]
  RewriteRule ^$ /agenda/ [R=302,L]
</IfModule>

# 7. Contrôle du cache et intégrité des ressources statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
